@attribute [Route(RoutingPath.CapitalProjects)]

@implements IDisposable

@inject ICapitalProjectService ProjectService
@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation
@inject IModalDialogService MessageService
@inject ISnackbar Snackbar
@inject IPermissionGuard PermissionGuard

@using Serilog
@using Microsoft.AspNetCore.WebUtilities
@using Estimation.Core.Administration.Models
@using Estimation.Core.Administration.Services
@using Estimation.Core.Train.Services
@using Estimation.Core.Resources.Services
@using Estimation.Core.Shared.Services

<AccessGuard PageKey="CapitalProjects">
<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <MudText Typo="Typo.h6">Agile Release Trains</MudText>

        <MudToolBar>
            <MudSpacer />
            <div style="position:relative; margin-right: 10px;">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ViewColumn"
                           Disabled="_loading"
                           OnClick="() => _columnsPopoverOpen = !_columnsPopoverOpen">
                    Columns
                </MudButton>
                <MudPopover Open="_columnsPopoverOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="pa-4" Style="min-width:280px">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@PlanningDisplayNames.ToggleColumns</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _columnsPopoverOpen = false" />
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <MudSwitch T="bool" @bind-Value="_showDepartment" Label="@PlanningDisplayNames.SolutionTrain" Color="Color.Primary" Dense />
                        <MudSwitch T="bool" @bind-Value="_showName" Label="@PlanningDisplayNames.Art" Color="Color.Primary" Dense />
                        <MudSwitch T="bool" @bind-Value="_showJiraKey" Label="@PlanningDisplayNames.JiraKey" Color="Color.Primary" Dense />
                        <MudSwitch T="bool" @bind-Value="_showTeams" Label="@PlanningDisplayNames.Teams" Color="Color.Primary" Dense />
                        <MudSwitch T="bool" @bind-Value="_showActions" Label="@PlanningDisplayNames.Actions" Color="Color.Primary" Dense />
                    </div>
                </MudPopover>
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       Disabled="_loading"
                       Style="margin-right: 10px"
                       OnClick="() => _drawerOpen = !_drawerOpen">
                Filter
            </MudButton>

            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Style="margin-right: 10px"
                           OnClick="@(() => Navigation.NavigateTo(RoutingPath.CapitalProjectsNew))">
                    New
                </MudButton>
            }
        </MudToolBar>

        <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Elevation="2"
                    Variant="DrawerVariant.Temporary" Width="400px"
                    Style="background: var(--mud-palette-surface)">
            <MudDrawerHeader>
                <div class="d-flex align-center justify-space-between" style="width:100%">
                    <MudText Typo="Typo.h6">@PlanningDisplayNames.Filters</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _drawerOpen = false" />
                </div>
            </MudDrawerHeader>
            <div class="d-flex flex-column gap-3 pa-4">
                <MudTextField @bind-Value="FilterSearch" Label="@PlanningDisplayNames.Search" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable Immediate
                              DebounceInterval="300" Dense Variant="Variant.Outlined" />

                <MudSelect T="string" Label="@PlanningDisplayNames.SolutionTrain" MultiSelection
                           @bind-SelectedValues="FilterDepartmentNames"
                           Dense Variant="Variant.Outlined" Clearable
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var dept in _availableDepartments)
                    {
                        <MudSelectItem T="string" Value="@dept">@dept</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" Label="@PlanningDisplayNames.Teams" MultiSelection
                           @bind-SelectedValues="FilterTeamNames"
                           Dense Variant="Variant.Outlined" Clearable
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var team in _availableTeams)
                    {
                        <MudSelectItem T="string" Value="@team">@team</MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           FullWidth OnClick="ClearFilters" Class="mt-2">
                    @PlanningDisplayNames.ClearFilters
                </MudButton>
            </div>
        </MudDrawer>

        <MudDivider />

        <MudDataGrid T="CpRow" Items="@_filteredRows"
                     Hover="true" Striped="true" Dense="true" Elevation="0"
                     Loading="_loading" LoadingProgressColor="Color.Primary">
            <Columns>
                <PropertyColumn Property="r => r.DepartmentName" Title="@PlanningDisplayNames.SolutionTrain" Sortable="false" Hidden="!_showDepartment" />
                <TemplateColumn Sortable="false" Hidden="!_showName">
                    <HeaderTemplate>
                        <div style="cursor:pointer; display:flex; align-items:center; user-select:none" @onclick="ToggleNameSort">
                            <span>@PlanningDisplayNames.Art</span>
                            @if (_sortColumn == SortableName)
                            {
                                <MudIcon Icon="@(_sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                                         Size="Size.Small" Class="ml-1" />
                            }
                        </div>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudText Class="font-weight-bold">@context.Item.Name</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="r => r.JiraKey" Title="@PlanningDisplayNames.JiraKey" Sortable="false" Hidden="!_showJiraKey" />
                <TemplateColumn Title="@PlanningDisplayNames.Teams" Sortable="false" Hidden="!_showTeams">
                    <CellTemplate>
                        @foreach (var team in context.Item.Teams.Take(3))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                     Class="mr-1" OnClick="@(() => Navigation.NavigateTo($"{RoutingPath.Teams}/{team.Id}"))">@team.Name</MudChip>
                        }
                        @if (context.Item.Teams.Count > 3)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                +@(context.Item.Teams.Count - 3)
                            </MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                @if (_canEdit)
                {
                    <TemplateColumn Title="@PlanningDisplayNames.Actions" CellStyle="text-align:right; width:150px;" Sortable="false" Filterable="false" Hidden="!_showActions">
                        <CellTemplate>
                            <MudFab Class="m-2" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => NavigateToEdit(context.Item.Id))" />
                            <MudFab Class="m-2" StartIcon="@Icons.Material.Filled.DeleteForever" IconColor="Color.Secondary" Size="Size.Small" OnClick="() => ConfirmDeleteAsync(context.Item)" />
                        </CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
            <NoRecordsContent><MudText Class="pa-6 mud-text-secondary">No capital projects found.</MudText></NoRecordsContent>
            <PagerContent><MudDataGridPager T="CpRow" PageSizeOptions="new[] { 10, 25, 50, 100 }" /></PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

</AccessGuard>

@code {
    [CascadingParameter(Name = "UserPageAccess")]
    private Dictionary<string, AccessLevel> UserPageAccess { get; set; } = new();

    private List<CpRow> _rows = new();
    private List<CpRow> _filteredRows = new();
    private UserPermissionSet _permissions = UserPermissionSet.Empty;
    private bool _loading = true;
    private bool _canEdit;
    private bool _drawerOpen;
    private bool _columnsPopoverOpen;

    private const string SortableName = "Name";
    private string? _sortColumn;
    private bool _sortDescending;
    private bool _suppressUrlUpdate = true;

    private bool _showDepartment = true;
    private bool _showJiraKey = true;
    private bool _showName = true;
    private bool _showTeams = false;
    private bool _showActions = true;

    private List<string> _availableDepartments = new();
    private List<string> _availableTeams = new();
    private Dictionary<int, string> _cpToDept = new();

    private Timer? _filterDebounceTimer;
    private const int FilterDebounceMs = 200;

    private void ScheduleRecompute()
    {
        _filterDebounceTimer?.Dispose();
        _filterDebounceTimer = new Timer(_ =>
            InvokeAsync(() => { RecomputeFilteredRows(); UpdateUrl(); StateHasChanged(); }),
            null, FilterDebounceMs, Timeout.Infinite);
    }

    private string? _filterSearchBacking;
    private string? FilterSearch
    {
        get => _filterSearchBacking;
        set { _filterSearchBacking = value; ScheduleRecompute(); }
    }

    private IReadOnlyCollection<string> _filterDepartmentNamesBacking = Array.Empty<string>();
    private HashSet<string> _filterDepartmentNamesSet = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyCollection<string> FilterDepartmentNames
    {
        get => _filterDepartmentNamesBacking;
        set { _filterDepartmentNamesBacking = value; _filterDepartmentNamesSet = new HashSet<string>(value, StringComparer.OrdinalIgnoreCase); ScheduleRecompute(); }
    }

    private IReadOnlyCollection<string> _filterTeamNamesBacking = Array.Empty<string>();
    private HashSet<string> _filterTeamNamesSet = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyCollection<string> FilterTeamNames
    {
        get => _filterTeamNamesBacking;
        set { _filterTeamNamesBacking = value; _filterTeamNamesSet = new HashSet<string>(value, StringComparer.OrdinalIgnoreCase); ScheduleRecompute(); }
    }

    private void ClearFilters()
    {
        _filterSearchBacking = null;
        _filterDepartmentNamesBacking = Array.Empty<string>();
        _filterDepartmentNamesSet.Clear();
        _filterTeamNamesBacking = Array.Empty<string>();
        _filterTeamNamesSet.Clear();
        _sortColumn = null;
        _sortDescending = false;
        RecomputeFilteredRows();
        UpdateUrl();
    }

    private void RecomputeFilteredRows()
    {
        IEnumerable<CpRow> filtered = _rows.Where(MatchesFilter);
        if (_sortColumn == SortableName)
        {
            filtered = _sortDescending
                ? filtered.OrderByDescending(r => r.Name)
                : filtered.OrderBy(r => r.Name);
        }
        _filteredRows = filtered.ToList();
    }

    private bool MatchesFilter(CpRow r)
    {
        if (!string.IsNullOrWhiteSpace(_filterSearchBacking))
        {
            var s = _filterSearchBacking.Trim();
            if (!(r.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                || (r.Description?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)))
            {
                return false;
            }
        }

        if (_filterDepartmentNamesSet.Count > 0
            && (r.DepartmentName is null || !_filterDepartmentNamesSet.Contains(r.DepartmentName)))
        {
            return false;
        }

        if (_filterTeamNamesSet.Count > 0
            && !r.Teams.Any(t => _filterTeamNamesSet.Contains(t.Name)))
        {
            return false;
        }

        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        _canEdit = UserPageAccess.TryGetValue("CapitalProjects", out var access) && access == AccessLevel.Edit;

        try
        {
            var deptTask = DepartmentService.GetAllAsync();
            var itemsTask = ProjectService.GetAllAsync();
            await Task.WhenAll(deptTask, itemsTask);
            var departments = await deptTask;
            var items = await itemsTask;

            _permissions = await PermissionGuard.GetPermissionsAsync();
            if (!_permissions.IsAdmin)
            {
                items = items.Where(cp => _permissions.CanView("CapitalProjects", TrainScope.ForTrains([cp.Id]))).ToList();
            }

            _cpToDept = departments
                .SelectMany(d => d.CapitalProjects.Select(cp => (cp.Id, d.Name)))
                .ToDictionary(x => x.Id, x => x.Name);

            _rows = items.Select(cp => new CpRow(
                Id: cp.Id,
                JiraKey: cp.JiraKey,
                Name: cp.Name,
                Description: cp.Description,
                DepartmentName: _cpToDept.GetValueOrDefault(cp.Id),
                Teams: cp.CapitalProjectTeams
                    .Select(cpt => new NameRef(cpt.TeamId, cpt.Team.Name))
                    .ToList()
            )).ToList();

            _availableDepartments = _rows
                .Where(r => r.DepartmentName is not null)
                .Select(r => r.DepartmentName!).Distinct().OrderBy(n => n).ToList();
            _availableTeams = _rows
                .SelectMany(r => r.Teams.Select(t => t.Name))
                .Where(n => !string.IsNullOrEmpty(n))
                .Distinct().OrderBy(n => n).ToList();

            ReadUrlParams();
            RecomputeFilteredRows();
        }
        finally { _loading = false; _suppressUrlUpdate = false; }
    }

    private async Task ConfirmDeleteAsync(CpRow row)
    {
        try
        {
            if (await MessageService.Confirm($"Delete {row.Name} ?"))
            {
                await ProjectService.DeleteAsync(row.Id);
                _rows.RemoveAll(r => r.Id == row.Id);
                RecomputeFilteredRows();
                UpdateUrl();
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, ex.Message);
            await MessageService.Exception(ex);
        }
    }

    private void ToggleNameSort()
    {
        if (_sortColumn == SortableName)
        {
            if (_sortDescending) { _sortColumn = null; _sortDescending = false; }
            else { _sortDescending = true; }
        }
        else
        {
            _sortColumn = SortableName;
            _sortDescending = false;
        }
        RecomputeFilteredRows();
        UpdateUrl();
    }

    private void ReadUrlParams()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("search", out var search) && !string.IsNullOrWhiteSpace(search))
        {
            _filterSearchBacking = search.ToString();
        }
        if (q.TryGetValue("dept", out var dept) && !string.IsNullOrWhiteSpace(dept))
        {
            var vals = dept.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            _filterDepartmentNamesBacking = vals;
            _filterDepartmentNamesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("team", out var team) && !string.IsNullOrWhiteSpace(team))
        {
            var vals = team.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            _filterTeamNamesBacking = vals;
            _filterTeamNamesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("sortBy", out var sortBy) && !string.IsNullOrWhiteSpace(sortBy))
        {
            _sortColumn = sortBy.ToString();
            _sortDescending = q.TryGetValue("sortDesc", out var sortDesc)
                && string.Equals(sortDesc, "true", StringComparison.OrdinalIgnoreCase);
        }
    }

    private void UpdateUrl()
    {
        if (_suppressUrlUpdate) { return; }
        var query = new Dictionary<string, object?>();
        query["search"] = string.IsNullOrWhiteSpace(_filterSearchBacking) ? null : _filterSearchBacking;
        query["dept"] = _filterDepartmentNamesSet.Count > 0 ? string.Join(",", _filterDepartmentNamesBacking) : null;
        query["team"] = _filterTeamNamesSet.Count > 0 ? string.Join(",", _filterTeamNamesBacking) : null;
        query["sortBy"] = _sortColumn;
        query["sortDesc"] = _sortDescending && _sortColumn is not null ? (object?)true : null;
        var uri = Navigation.GetUriWithQueryParameters(query);
        Navigation.NavigateTo(uri, replace: true);
    }

    private void NavigateToEdit(int id)
    {
        var currentUri = new Uri(Navigation.Uri);
        var returnUrl = currentUri.PathAndQuery;
        var editUri = Navigation.GetUriWithQueryParameters(
            $"{RoutingPath.CapitalProjects}/{id}",
            new Dictionary<string, object?> { ["returnUrl"] = returnUrl });
        Navigation.NavigateTo(editUri);
    }

    public void Dispose()
    {
        _filterDebounceTimer?.Dispose();
    }

    private record NameRef(int Id, string Name);

    private record CpRow(
        int Id,
        string? JiraKey,
        string Name,
        string? Description,
        string? DepartmentName,
        List<NameRef> Teams
    );
}
