@attribute [Route(RoutingPath.AuditLog)]
@inherits LocalTimeComponentBase
@implements IDisposable

@inject IAuditLogService AuditLogService
@inject IDialogService DialogService
@inject NavigationManager Navigation

@using Estimation.Core.Administration.Services
@using Microsoft.AspNetCore.WebUtilities
@using Serilog

<PageTitle>Audit Log</PageTitle>

<AdminOnly>
<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <div class="d-flex align-center flex-wrap gap-2 mb-4">
            <MudText Typo="Typo.h5">Audit Log</MudText>
            <MudSpacer />
            <MudSwitch T="bool" Value="_groupByBatch" ValueChanged="OnGroupByBatchChanged"
                       Color="Color.Primary" Label="Group by operation" />
            <MudBadge Content="@ActiveFilterCount" Color="Color.Secondary" Overlap="true" Bordered="true"
                      Visible="@(ActiveFilterCount > 0)">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="() => _filterDrawerOpen = !_filterDrawerOpen">
                    Filter
                </MudButton>
            </MudBadge>
        </div>

        <MudDrawer @bind-Open="_filterDrawerOpen" Anchor="Anchor.End" Elevation="2"
                   Variant="DrawerVariant.Temporary" Width="400px"
                   Style="background: var(--mud-palette-surface)">
            <MudDrawerHeader>
                <div class="d-flex align-center justify-space-between" style="width:100%">
                    <MudText Typo="Typo.h6">Filters</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _filterDrawerOpen = false" />
                </div>
            </MudDrawerHeader>
            <div class="d-flex flex-column gap-3 pa-4">
                <MudDateRangePicker DateRange="_dateRange" DateRangeChanged="OnDateRangeChanged"
                                    Label="Date range" Clearable Variant="Variant.Outlined"
                                    PlaceholderStart="All" PlaceholderEnd="time" />

                <SearchableDropdown T="string" MultiSelect="true" SelectAll="true"
                                    Items="_entityNames"
                                    Values="_filterEntityNames"
                                    ValuesChanged="OnFilterEntityNamesChanged"
                                    Label="Model" />

                <SearchableDropdown T="string" MultiSelect="true" SelectAll="true"
                                    Items="_userNames"
                                    Values="_filterUserNames"
                                    ValuesChanged="OnFilterUserNamesChanged"
                                    Label="User" />

                <SearchableDropdown T="string" MultiSelect="true" ShowSearch="false"
                                    Items="ActionNames"
                                    Values="_filterActions"
                                    ValuesChanged="OnFilterActionsChanged"
                                    Label="Action" />

                <MudTextField T="string" @bind-Value="_entityId"
                              Label="Entity Id" Placeholder="Exact match"
                              Clearable Variant="Variant.Outlined"
                              Immediate DebounceInterval="500" OnDebounceIntervalElapsed="ReloadAsync" />

                <MudTextField T="string" @bind-Value="_searchText"
                              Label="Search" Placeholder="Entity name, property, id…"
                              Clearable Variant="Variant.Outlined"
                              Immediate DebounceInterval="500" OnDebounceIntervalElapsed="ReloadAsync"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

                <div>
                    <MudSwitch T="bool" Value="_searchValues" ValueChanged="OnSearchValuesChanged"
                               Color="Color.Primary" Label="Search values" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        Also searches inside old and new values (slower).
                        @if (_searchValues && _dateRange?.Start is null)
                        {
                            <span>No date range set — value search covers the last 30 days.</span>
                        }
                    </MudText>
                </div>

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           FullWidth OnClick="ResetFiltersAsync" Class="mt-2">
                    Reset filters
                </MudButton>
            </div>
        </MudDrawer>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" Dense Class="mb-2">
                The audit log could not be loaded. The search may have taken too long: narrow the date range
                or switch off Search values, then try again.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" Class="ml-2"
                           OnClick="ReloadAsync">Try again</MudButton>
            </MudAlert>
        }

        <MudDataGrid @ref="_grid" T="AuditLogListItem" ServerData="LoadGridDataAsync"
                     Dense Hover Striped Bordered
                     SortMode="SortMode.Single"
                     Groupable="@_groupByBatch" GroupExpanded="true"
                     RowsPerPage="25"
                     RowClass="cursor-pointer"
                     RowClick="OnRowClickAsync">
            <Columns>
                <PropertyColumn Property="x => x.Timestamp" Title="Date/Time"
                                InitialDirection="SortDirection.Descending" Groupable="false">
                    <CellTemplate>@UserTime.Format(context.Item.Timestamp, TimestampFormat)</CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.UserName" Title="User" Groupable="false" />
                <PropertyColumn Property="x => x.EntityName" Title="Model" Groupable="false" />
                <PropertyColumn Property="x => x.EntityDisplayName" Title="Name" Groupable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2"
                                 Style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                 title="@context.Item.EntityDisplayName">
                            @(context.Item.EntityDisplayName ?? "—")
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.EntityId" Title="Entity Id" Groupable="false" />
                <PropertyColumn Property="x => x.Action" Title="Action" Groupable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@ActionColor(context.Item.Action)" Variant="Variant.Filled">
                            @context.Item.Action
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.PropertyName" Title="Property" Groupable="false" />
                <PropertyColumn Property="x => x.OldValuePreview" Title="Old Value" Sortable="false" Groupable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2"
                                 Style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @(PreviewText(context.Item.OldValuePreview, context.Item.OldValueIsTruncated))
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.NewValuePreview" Title="New Value" Sortable="false" Groupable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2"
                                 Style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @(PreviewText(context.Item.NewValuePreview, context.Item.NewValueIsTruncated))
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>
                @if (_groupByBatch)
                {
                    <PropertyColumn Property="x => x.BatchId" Title="Operation" Hidden="true"
                                    Grouping GroupBy="@(x => x.BatchId != null ? x.BatchId.ToString()! : $"row-{x.Id}")">
                        <GroupTemplate>
                            @{
                                var rows = context.Grouping.ToList();
                                var first = rows.FirstOrDefault();
                            }
                            @if (first is not null)
                            {
                                <span class="d-inline-flex align-center flex-wrap" style="gap:10px">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                                        @UserTime.Format(first.Timestamp, TimestampFormat)
                                    </MudText>
                                    <MudText Typo="Typo.body2">@first.UserName</MudText>
                                    <MudText Typo="Typo.body2">
                                        @first.EntityName@(string.IsNullOrWhiteSpace(first.EntityDisplayName) ? "" : $" — {first.EntityDisplayName}")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @GroupSizeText(rows.Count, first.BatchSize)
                                    </MudText>
                                </span>
                            }
                        </GroupTemplate>
                    </PropertyColumn>
                }
            </Columns>
            <PagerContent>
                <MudDataGridPager T="AuditLogListItem" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
            Click a row to see the full values and every change saved in the same operation.
        </MudText>
    </MudPaper>
</div>
</AdminOnly>

@code {
    [CascadingParameter(Name = "IsAdmin")]
    private bool IsAdmin { get; set; }

    [SupplyParameterFromQuery(Name = "entity")]
    public string? EntityFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? EntityIdFromQuery { get; set; }

    private const string TimestampFormat = "yyyy-MM-dd HH:mm:ss";

    private MudDataGrid<AuditLogListItem>? _grid;

    private static readonly string[] ActionNames = ["Create", "Update", "Delete"];

    private DateRange? _dateRange = DefaultDateRange();
    private IReadOnlyCollection<string> _filterEntityNames = [];
    private IReadOnlyCollection<string> _filterUserNames = [];
    private IReadOnlyCollection<string> _filterActions = [];
    private string? _entityId;
    private string? _searchText;
    private bool _searchValues;
    private bool _groupByBatch;
    private bool _filterDrawerOpen;
    private bool _loadFailed;
    private bool _disposed;

    private List<string> _entityNames = new();
    private List<string> _userNames = new();

    private int ActiveFilterCount =>
        new[]
        {
            _dateRange?.Start is not null || _dateRange?.End is not null,
            _filterEntityNames.Count > 0,
            _filterUserNames.Count > 0,
            _filterActions.Count > 0,
            !string.IsNullOrWhiteSpace(_entityId),
            !string.IsNullOrWhiteSpace(_searchText),
        }.Count(active => active);

    private static DateRange DefaultDateRange() =>
        new(DateTime.Today.AddDays(-29), DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        ApplyLinkFilters(EntityFromQuery, EntityIdFromQuery);

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        Navigation.LocationChanged += OnLocationChanged;

        _entityNames = await AuditLogService.GetEntityNamesAsync();
        _userNames = await AuditLogService.GetUserNamesAsync();
        KeepEntityNameListed();
    }

    private void ApplyLinkFilters(string? entity, string? id)
    {
        ClearFilters();

        if (!string.IsNullOrWhiteSpace(entity))
        {
            _filterEntityNames = [entity];
            _entityId = string.IsNullOrWhiteSpace(id) ? null : id;
            _dateRange = null;
        }
    }

    private void ClearFilters()
    {
        _dateRange = DefaultDateRange();
        _filterEntityNames = [];
        _filterUserNames = [];
        _filterActions = [];
        _entityId = null;
        _searchText = null;
        _searchValues = false;
    }

    private void KeepEntityNameListed()
    {
        _filterEntityNames = _filterEntityNames
            .Select(name => _entityNames.FirstOrDefault(n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase)) ?? name)
            .ToList();

        foreach (var name in _filterEntityNames.Where(name => !_entityNames.Contains(name)).Reverse())
        {
            _entityNames.Insert(0, name);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = Navigation.ToAbsoluteUri(e.Location);
        var path = "/" + Navigation.ToBaseRelativePath(uri.GetLeftPart(UriPartial.Path)).TrimEnd('/');
        if (_disposed || !string.Equals(path, RoutingPath.AuditLog, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var query = QueryHelpers.ParseQuery(uri.Query);
        var entity = query.TryGetValue("entity", out var entityValue) ? entityValue.ToString() : null;
        var id = query.TryGetValue("id", out var idValue) ? idValue.ToString() : null;
        _ = InvokeAsync(() => FollowLinkAsync(entity, id));
    }

    private async Task FollowLinkAsync(string? entity, string? id)
    {
        if (_disposed)
        {
            return;
        }

        ApplyLinkFilters(entity, id);
        KeepEntityNameListed();
        StateHasChanged();
        await ReloadAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private static GridData<AuditLogListItem> EmptyGridData() => new()
    {
        Items = Array.Empty<AuditLogListItem>(),
        TotalItems = 0
    };

    private GridData<AuditLogListItem> _lastGridData = EmptyGridData();

    private async Task<GridData<AuditLogListItem>> LoadGridDataAsync(
        GridState<AuditLogListItem> state, CancellationToken cancellationToken)
    {
        try
        {
            var sort = state.SortDefinitions.FirstOrDefault();

            var result = await AuditLogService.QueryAsync(
                BuildFilter(),
                state.Page,
                state.PageSize,
                sort?.SortBy,
                sort?.Descending ?? true,
                cancellationToken);

            _lastGridData = new GridData<AuditLogListItem>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
            SetLoadFailed(false);
            return _lastGridData;
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            return _lastGridData;
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Audit log query failed");
            _lastGridData = EmptyGridData();
            SetLoadFailed(true);
            return _lastGridData;
        }
    }

    private void SetLoadFailed(bool failed)
    {
        if (_loadFailed == failed || _disposed)
        {
            return;
        }

        _loadFailed = failed;
        StateHasChanged();
    }

    private AuditLogFilter BuildFilter()
    {
        DateTime? fromUtc = _dateRange?.Start is DateTime start
            ? UserTime.ToUtc(start.Date)
            : null;
        DateTime? toUtc = _dateRange?.End is DateTime end
            ? UserTime.ToUtc(end.Date.AddDays(1))
            : null;

        return new AuditLogFilter
        {
            FromUtc = fromUtc,
            ToUtc = toUtc,
            EntityNames = _filterEntityNames,
            EntityId = _entityId,
            UserNames = _filterUserNames,
            Actions = _filterActions,
            Text = _searchText,
            SearchValues = _searchValues
        };
    }

    private Task ReloadAsync()
    {
        if (_grid is null)
        {
            return Task.CompletedTask;
        }

        if (_grid.CurrentPage == 0)
        {
            return _grid.ReloadServerData();
        }

        _grid.NavigateTo(Page.First);
        return Task.CompletedTask;
    }

    private Task OnDateRangeChanged(DateRange? range)
    {
        _dateRange = range;
        return ReloadAsync();
    }

    private Task OnFilterEntityNamesChanged(IReadOnlyCollection<string> values)
    {
        _filterEntityNames = values;
        return ReloadAsync();
    }

    private Task OnFilterUserNamesChanged(IReadOnlyCollection<string> values)
    {
        _filterUserNames = values;
        return ReloadAsync();
    }

    private Task OnFilterActionsChanged(IReadOnlyCollection<string> values)
    {
        _filterActions = values;
        return ReloadAsync();
    }

    private Task OnSearchValuesChanged(bool value)
    {
        _searchValues = value;
        return string.IsNullOrWhiteSpace(_searchText) ? Task.CompletedTask : ReloadAsync();
    }

    private void OnGroupByBatchChanged(bool value)
    {
        _groupByBatch = value;
    }

    private Task ResetFiltersAsync()
    {
        ClearFilters();
        return ReloadAsync();
    }

    private async Task OnRowClickAsync(DataGridRowClickEventArgs<AuditLogListItem> args)
    {
        var parameters = new DialogParameters
        {
            [nameof(AuditLogDetailDialog.AuditLogId)] = args.Item.Id
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<AuditLogDetailDialog>("Change details", parameters, options);
    }

    private static Color ActionColor(string action) => action switch
    {
        "Create" => Color.Success,
        "Update" => Color.Info,
        "Delete" => Color.Error,
        _ => Color.Default
    };

    private static string GroupSizeText(int shown, int total) =>
        shown >= total
            ? $"{shown} {(shown == 1 ? "change" : "changes")}"
            : $"{shown} of {total} changes";

    private static string PreviewText(string? preview, bool truncated)
    {
        if (string.IsNullOrEmpty(preview))
        {
            return "—";
        }

        return truncated ? preview + "…" : preview;
    }
}
