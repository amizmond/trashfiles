@using Estimation.Core.Train.Models
@using Estimation.Core.Train.Services

<MudDialog>
    <TitleContent>@(IsNew ? "Add Jira key" : $"Edit Jira key {Row.JiraKey}")</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Components and labels narrow the key: a feature needs one of the listed components and one of the listed
            labels. Tick Not to take features with none of them instead, and add (no component) or (no label) to also
            take features without any (with Not: to leave them out). Features created in the tool or not synced yet
            have no components. When several ARTs share a key, a feature goes to the ART whose rules it matches,
            otherwise to the ART that takes the key whole.
        </MudText>

        <MudTextField T="string" Value="_key" ValueChanged="OnKeyChangedAsync"
                      Label="Jira key *" Variant="Variant.Outlined" Class="mb-3"
                      Disabled="!IsNew" MaxLength="ArtJiraKey.MaxKeyLength"
                      Placeholder="Jira project key, e.g. PAY"
                      Error="@(_keyError is not null)" ErrorText="@_keyError" />

        <ArtFilterValuesInput Label="@PlanningDisplayNames.Components" Singular="component" Plural="components"
                              Value="@_components" ValueChanged="OnComponentsChangedAsync"
                              Not="@_componentsNot" NotChanged="OnComponentsNotChangedAsync"
                              Pending="@_pendingComponents" PendingChanged="OnPendingComponentsChangedAsync"
                              Suggestions="@_keyValues?.Components" WithoutCount="@_keyValues?.WithoutComponents"
                              Placeholder="Type a component and press Enter"
                              EmptyText="Any component" />
        <ArtFilterValuesInput Label="@PlanningDisplayNames.Labels" Singular="label" Plural="labels"
                              Value="@_labels" ValueChanged="OnLabelsChangedAsync"
                              Not="@_labelsNot" NotChanged="OnLabelsNotChangedAsync"
                              Pending="@_pendingLabels" PendingChanged="OnPendingLabelsChangedAsync"
                              Suggestions="@_keyValues?.Labels" WithoutCount="@_keyValues?.WithoutLabels"
                              Placeholder="Type a label and press Enter"
                              EmptyText="Any label" />

        <div class="mt-2">
            @if (_previewLoading)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Counting features…</MudText>
            }
            else
            {
                @foreach (var line in _preview)
                {
                    @if (line.Severity == Severity.Error)
                    {
                        <MudAlert Severity="Severity.Error" Dense Class="my-1">@line.Text</MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="@(line.Severity == Severity.Warning ? Color.Warning : Color.Default)"
                                 Class="@(line.Severity == Severity.Warning ? "d-block" : "d-block mud-text-secondary")">@line.Text</MudText>
                    }
                }
            }
        </div>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ArtJiraKey Row { get; set; } = new() { JiraKey = string.Empty };

    [Parameter] public bool IsNew { get; set; }

    [Parameter] public Func<ArtJiraKey, Task<IReadOnlyList<PreviewLine>>>? Preview { get; set; }

    [Parameter] public Func<ArtJiraKey, Task<string?>> Save { get; set; } = null!;

    [Parameter] public Func<string, Task<JiraKeyValues?>>? Values { get; set; }

    public sealed record PreviewLine(string Text, Severity Severity);

    private readonly Dictionary<string, JiraKeyValues> _valuesByKey = new(StringComparer.OrdinalIgnoreCase);
    private string? _key;
    private string? _keyError;
    private string? _components;
    private string? _labels;
    private bool _componentsNot;
    private bool _labelsNot;
    private string? _pendingComponents;
    private string? _pendingLabels;
    private JiraKeyValues? _keyValues;
    private IReadOnlyList<PreviewLine> _preview = [];
    private bool _previewLoading;
    private int _previewVersion;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _key = JiraProjectKeys.Normalize(Row.JiraKey);
        _components = Row.Components;
        _labels = Row.Labels;
        _componentsNot = JiraValueFilter.Parse(Row.Components).IsNot;
        _labelsNot = JiraValueFilter.Parse(Row.Labels).IsNot;
        await RefreshPreviewAsync();
        await LoadValuesAsync();
    }

    private async Task OnKeyChangedAsync(string? value)
    {
        _key = JiraProjectKeys.Normalize(value);
        _keyError = KeyError(_key);
        await RefreshPreviewAsync();
        await LoadValuesAsync();
    }

    private async Task OnComponentsChangedAsync(string? value)
    {
        _components = value;
        await RefreshPreviewAsync();
    }

    private async Task OnLabelsChangedAsync(string? value)
    {
        _labels = value;
        await RefreshPreviewAsync();
    }

    private async Task OnComponentsNotChangedAsync(bool value)
    {
        _componentsNot = value;
        if (!string.IsNullOrWhiteSpace(_pendingComponents))
        {
            await RefreshPreviewAsync();
        }
    }

    private async Task OnLabelsNotChangedAsync(bool value)
    {
        _labelsNot = value;
        if (!string.IsNullOrWhiteSpace(_pendingLabels))
        {
            await RefreshPreviewAsync();
        }
    }

    private async Task OnPendingComponentsChangedAsync(string? value)
    {
        _pendingComponents = value;
        await RefreshPreviewAsync();
    }

    private async Task OnPendingLabelsChangedAsync(string? value)
    {
        _pendingLabels = value;
        await RefreshPreviewAsync();
    }

    private async Task RefreshPreviewAsync()
    {
        _error = null;
        await LoadPreviewAsync();
    }

    private static string? KeyError(string? key) =>
        key is null ? "Enter a Jira project key."
        : ArtService.IsValidKey(key) ? null
        : $"Not a valid Jira project key. A key starts with a letter and has up to {ArtJiraKey.MaxKeyLength} letters, digits or underscores.";

    private async Task LoadPreviewAsync()
    {
        if (Preview is null || _key is null || KeyError(_key) is not null)
        {
            _previewVersion++;
            _preview = [];
            _previewLoading = false;
            return;
        }

        var version = ++_previewVersion;
        _previewLoading = true;
        var lines = await Preview(Draft());
        if (version == _previewVersion)
        {
            _preview = lines;
            _previewLoading = false;
        }
    }

    private async Task LoadValuesAsync()
    {
        var key = _key;
        if (Values is null || key is null || KeyError(key) is not null)
        {
            _keyValues = null;
            return;
        }

        if (_valuesByKey.TryGetValue(key, out var cached))
        {
            _keyValues = cached;
            return;
        }

        _keyValues = null;
        var values = await Values(key);
        if (values is not null)
        {
            _valuesByKey[key] = values;
        }
        if (string.Equals(key, _key, StringComparison.OrdinalIgnoreCase))
        {
            _keyValues = values;
        }
    }

    private ArtJiraKey Draft() => new()
    {
        JiraKey = _key ?? string.Empty,
        Components = ArtFilterValuesInput.Merge(_components, _pendingComponents, _componentsNot, "component"),
        Labels = ArtFilterValuesInput.Merge(_labels, _pendingLabels, _labelsNot, "label")
    };

    private static string? PendingError(string label, string? pending, string singular) =>
        ArtFilterValuesInput.InputError(pending, singular) is { } error ? $"{label}: {error}" : null;

    private async Task SubmitAsync()
    {
        _error = null;
        _keyError = KeyError(_key);
        if (_keyError is not null)
        {
            return;
        }

        _error = PendingError(PlanningDisplayNames.Components, _pendingComponents, "component")
            ?? PendingError(PlanningDisplayNames.Labels, _pendingLabels, "label");
        if (_error is not null)
        {
            return;
        }

        var draft = Draft();
        _error = JiraValueFilter.Parse(draft.Components).Problem("components")
            ?? JiraValueFilter.Parse(draft.Labels).Problem("labels");
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            _error = await Save(draft);
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            MudDialog.Close(DialogResult.Ok(draft));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
