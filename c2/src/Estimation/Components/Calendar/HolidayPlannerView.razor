@code {
    [Parameter] public int TeamId { get; set; }

    [Parameter] public string PageKey { get; set; } = "Teams";

    [Parameter] public bool? CanEditOverride { get; set; }

    [Parameter] public int? SelfServiceHrId { get; set; }

    [Parameter] public RenderFragment? HeaderActions { get; set; }

    private int? _memberSelfHrId;

    private bool _selfIdentityUnresolved;

    private bool _directoryUnavailable;

    [CascadingParameter(Name = "UserPageAccess")]
    private Dictionary<string, AccessLevel> UserPageAccess { get; set; } = new();

    private bool _canEdit;

    private int? SelfHrId => SelfServiceHrId ?? _memberSelfHrId;

    private bool IsSelfService => SelfHrId is not null;

    private bool CanEditRow(Holiday h) =>
        IsSelfService ? h.HumanResourceId == SelfHrId!.Value : _canEdit;

    private bool CanEditMember(int humanResourceId) =>
        IsSelfService ? humanResourceId == SelfHrId!.Value : _canEdit;

    private string SelfMemberName =>
        _members.FirstOrDefault(m => m.HumanResourceId == SelfHrId)?.HumanResource.FullName ?? "You";

    private const double ConflictThreshold = 0.30;

    public enum ViewMode { Month, Year, Gantt }

    private Team? _team;
    private List<HolidayType> _holidayTypes = new();
    private List<TeamMember> _members = new();
    private List<Holiday> _holidays = new();
    private List<Sprint> _sprints = new();
    private List<Pi> _pisInRange = new();
    private Dictionary<DateTime, List<PublicHoliday>> _publicHolidayByDate = new();
    private Dictionary<int, HashSet<DateTime>> _phByMember = new();
    private TeamPeriodCapacity? _capacity;
    private Dictionary<int, TeamPeriodCapacity> _piCapacities = new();
    private List<MemberLeaveUsage> _leaveUsage = new();

    private bool _loading = true;
    private DateTime _anchor = DateTime.Today;
    private ViewMode _view = ViewMode.Month;
    private int _reloadGen;
    private bool _prefsLoaded;
    private int _lastLoadedId = -1;

    private bool _showPopoverOpen;
    private bool _datePickerOpen;
    private bool _showPublicHolidays = true;
    private bool _showSprints = true;
    private readonly Dictionary<int, bool> _memberVisible = new();

    private Dictionary<int, int> _sprintOrder = new();
    private static readonly string[] SprintZebraColors = { "#75b3e5", "#fbae7a" };

    private Holiday? _editing;
    private bool _editDialogOpen;
    private DateTime? _editStart;
    private DateTime? _editEnd;
    private string? _editError;

    private List<Pi> _allPis = new();

    private bool HasTeamEditRights =>
        CanEditOverride ?? (UserPageAccess.TryGetValue(PageKey, out var access) && access == AccessLevel.Edit);

    protected override void OnInitialized()
    {
        _canEdit = IsSelfService || HasTeamEditRights;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastLoadedId == TeamId)
        {
            return;
        }
        _lastLoadedId = TeamId;
        _loading = true;
        _memberSelfHrId = null;
        _selfIdentityUnresolved = false;
        _directoryUnavailable = false;
        _canEdit = SelfServiceHrId is not null || HasTeamEditRights;
        _team = await TeamService.GetByIdAsync(TeamId);
        if (_team is null)
        {
            Navigation.NavigateTo(RoutingPath.Teams);
            return;
        }
        _members = _team.TeamMembers.OrderBy(m => m.HumanResource.FullName).ToList();
        await ResolveMemberSelfServiceAsync();
        _holidayTypes = await HolidayTypeService.GetAllAsync();
        _allPis = await PiService.GetAllLightAsync();
        await ReloadRangeAsync();
        _loading = false;
    }

    private async Task ResolveMemberSelfServiceAsync()
    {
        if (_canEdit || SelfServiceHrId is not null)
        {
            return;
        }
        try
        {
            var resolution = await SelfService.ResolveAsync();
            if (resolution.DirectoryUnavailable)
            {
                _directoryUnavailable = true;
                return;
            }
            var context = resolution.Context;
            if (context is null)
            {
                _selfIdentityUnresolved = true;
                return;
            }
            if (!_members.Any(m => m.HumanResourceId == context.HumanResourceId))
            {
                return;
            }
            _memberSelfHrId = context.HumanResourceId;
            _canEdit = true;
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to resolve the current team member for team {TeamId}", TeamId);
            _selfIdentityUnresolved = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_prefsLoaded)
        {
            _prefsLoaded = true;
            await LoadPrefsAsync();
        }
    }

    private (DateTime From, DateTime To) MonthBounds()
    {
        var first = new DateTime(_anchor.Year, _anchor.Month, 1);
        var last = first.AddMonths(1).AddDays(-1);
        return (first, last);
    }

    private (DateTime From, DateTime To) MonthGridBounds()
    {
        var (first, _) = MonthBounds();
        var gridStart = first.AddDays(-((int)(first.DayOfWeek == DayOfWeek.Sunday ? 6 : first.DayOfWeek - DayOfWeek.Monday)));
        var gridEnd = gridStart.AddDays(41);
        return (gridStart, gridEnd);
    }

    private (DateTime From, DateTime To) RangeBounds() => _view switch
    {
        ViewMode.Year => (new DateTime(_anchor.Year, 1, 1), new DateTime(_anchor.Year, 12, 31)),
        ViewMode.Gantt => MonthBounds(),
        _ => MonthGridBounds(),
    };

    private IEnumerable<DateTime> GridDays()
    {
        var (from, to) = MonthGridBounds();
        var totalDays = (to - from).Days + 1;
        for (var i = 0; i < totalDays; i++)
        {
            yield return from.AddDays(i);
        }
    }

    private static IEnumerable<DateTime> MiniMonthDays(DateTime firstOfMonth)
    {
        var gridStart = firstOfMonth.AddDays(-((int)(firstOfMonth.DayOfWeek == DayOfWeek.Sunday ? 6 : firstOfMonth.DayOfWeek - DayOfWeek.Monday)));
        for (var i = 0; i < 42; i++)
        {
            yield return gridStart.AddDays(i);
        }
    }

    private string RangeTitle => _view == ViewMode.Year
        ? _anchor.ToString("yyyy")
        : _anchor.ToString("MMMM yyyy");

    private async Task ReloadRangeAsync()
    {
        var gen = ++_reloadGen;
        var (from, to) = RangeBounds();
        var holidaysTask = HolidayService.GetForTeamAsync(TeamId, from, to);
        var sprintsTask = SprintService.GetForTeamInRangeAsync(TeamId, from, to);
        var memberScope = _members
            .Select(m => (m.HumanResourceId, m.HumanResource.CityId))
            .ToList();
        var memberCityIds = _members
            .Where(m => m.HumanResource.CityId.HasValue)
            .Select(m => m.HumanResource.CityId!.Value)
            .Distinct()
            .ToList();
        var memberCountryIds = _members
            .Where(m => m.HumanResource.City != null)
            .Select(m => m.HumanResource.City!.CountryId)
            .Distinct()
            .ToList();
        var phTask = PublicHolidayService.GetForScopeInRangeAsync(memberCountryIds, memberCityIds, from, to);
        var phByMemberTask = PublicHolidayService.GetEffectiveDatesByMemberAsync(memberScope, from, to);
        var capacityTask = _view == ViewMode.Year
            ? Task.FromResult<TeamPeriodCapacity?>(null)
            : CapacityService.GetTeamMonthCapacityAsync(TeamId, _anchor.Year, _anchor.Month)
                .ContinueWith(t => (TeamPeriodCapacity?)t.Result);
        var leaveTask = CapacityService.GetTeamLeaveUsageAsync(TeamId, _anchor.Year);

        await Task.WhenAll(holidaysTask, sprintsTask, phTask, phByMemberTask, capacityTask, leaveTask);

        if (gen != _reloadGen)
        {
            return;
        }

        _holidays = holidaysTask.Result;
        _sprints = sprintsTask.Result;
        _publicHolidayByDate = phTask.Result
            .GroupBy(p => p.Date.Date)
            .ToDictionary(g => g.Key, g => g.ToList());
        _phByMember = phByMemberTask.Result;
        _pisInRange = _allPis
            .Where(p => p.StartDate.HasValue && p.EndDate.HasValue
                && p.StartDate.Value.Date <= to && p.EndDate.Value.Date >= from)
            .OrderBy(p => p.StartDate)
            .ToList();
        _capacity = capacityTask.Result;
        _leaveUsage = leaveTask.Result;

        _sprintOrder = _sprints
            .OrderBy(s => s.StartDate)
            .ThenBy(s => s.Id)
            .Select((s, idx) => (s.Id, idx))
            .ToDictionary(x => x.Id, x => x.idx);

        await LoadPiCapacitiesAsync(gen);
    }

    private async Task LoadPiCapacitiesAsync(int gen)
    {
        var pis = _pisInRange
            .Where(p => p.StartDate.HasValue && p.EndDate.HasValue)
            .ToList();

        var capacityTasks = pis
            .Select(p => CapacityService.GetTeamRangeCapacityAsync(
                TeamId, p.StartDate!.Value.Date, p.EndDate!.Value.Date))
            .ToList();

        var results = await Task.WhenAll(capacityTasks);

        if (gen != _reloadGen)
        {
            return;
        }

        _piCapacities = pis
            .Select((p, idx) => (p.Id, Capacity: results[idx]))
            .ToDictionary(x => x.Id, x => x.Capacity);
    }

    private string PiCapacitySuffix(Pi pi) =>
        _piCapacities.TryGetValue(pi.Id, out var c)
            ? $" · {c.CapacityPercent:0.#}%"
            : "";

    private string PiCapacityTooltip(Pi pi)
    {
        if (!_piCapacities.TryGetValue(pi.Id, out var c))
        {
            return $"{pi.Name}: capacity unavailable";
        }
        return $"{pi.Name} capacity: {c.CapacityPercent:0.#}%"
            + $"\nAvailable: {c.AvailablePersonDays:0.#} / {c.GrossPersonDays:0.#} person-days"
            + $"\nWorking days: {c.WorkingDays} · Members: {c.MemberCount}"
            + $"\nPublic holidays: {c.PublicHolidayDays:0.#} pd · Leave: {c.LeaveDays:0.#} pd";
    }

    private string SprintColor(Sprint s)
    {
        if (!string.IsNullOrEmpty(s.ColorHex))
        {
            return s.ColorHex;
        }
        var idx = _sprintOrder.TryGetValue(s.Id, out var i) ? i : 0;
        return SprintZebraColors[idx % SprintZebraColors.Length];
    }

    private record HolidayBreakdown(
        int TotalDays,
        double VacationDays,
        int WeekendDays,
        int PublicHolidayDays,
        List<string> PublicHolidayNames);

    private (int? CityId, int? CountryId) MemberLocation(int hrId)
    {
        var hr = _members.FirstOrDefault(m => m.HumanResourceId == hrId)?.HumanResource;
        return (hr?.CityId, hr?.City?.CountryId);
    }

    private bool IsMemberPublicHoliday(int hrId, DateTime day) =>
        _phByMember.TryGetValue(hrId, out var set) && set.Contains(day.Date);

    private PublicHoliday? ResolveMemberPublicHoliday(int hrId, DateTime day)
    {
        if (!_publicHolidayByDate.TryGetValue(day.Date, out var list))
        {
            return null;
        }
        var (cityId, countryId) = MemberLocation(hrId);
        return (cityId.HasValue ? list.FirstOrDefault(p => p.CityId == cityId) : null)
            ?? (countryId.HasValue ? list.FirstOrDefault(p => p.CountryId == countryId && p.CityId == null) : null)
            ?? list.FirstOrDefault();
    }

    private HolidayBreakdown BuildBreakdown(int hrId, DateTime start, DateTime end, HalfDayPortion half)
    {
        int total = 0, weekend = 0, ph = 0;
        double vacation = 0;
        var phNames = new List<string>();

        for (var d = start.Date; d <= end.Date; d = d.AddDays(1))
        {
            total++;
            var isWeekend = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
            var isPh = IsMemberPublicHoliday(hrId, d);
            if (isWeekend)
            {
                weekend++;
            }
            else if (isPh)
            {
                ph++;
                var match = ResolveMemberPublicHoliday(hrId, d);
                if (match is not null)
                {
                    phNames.Add($"{d:yyyy-MM-dd} · {match.Name}");
                }
            }
            else
            {
                vacation++;
            }
        }

        if (vacation > 0 && half != HalfDayPortion.None && start.Date == end.Date)
        {
            vacation = 0.5;
        }

        return new HolidayBreakdown(total, vacation, weekend, ph, phNames);
    }

    private HolidayBreakdown BuildBreakdown(Holiday h) =>
        BuildBreakdown(h.HumanResourceId, h.StartDate, h.EndDate, h.HalfDay);

    private string HolidayTooltip(Holiday h)
    {
        var b = BuildBreakdown(h);
        var sb = new StringBuilder();
        sb.Append($"{h.HumanResource?.FullName} - {h.HolidayType?.Name}");
        if (h.HalfDay != HalfDayPortion.None)
        {
            sb.Append($" ({h.HalfDay})");
        }
        sb.Append($"\n{h.StartDate:yyyy-MM-dd} → {h.EndDate:yyyy-MM-dd} ({b.TotalDays} day(s))");
        sb.Append($"\nVacation days: {b.VacationDays:0.#}");
        if (b.WeekendDays > 0)
        {
            sb.Append($"\nExcluded weekends: {b.WeekendDays}");
        }
        if (b.PublicHolidayDays > 0)
        {
            sb.Append($"\nExcluded public holidays: {b.PublicHolidayDays}");
            foreach (var n in b.PublicHolidayNames)
            {
                sb.Append($"\n  • {n}");
            }
        }
        if (!string.IsNullOrEmpty(h.Comment))
        {
            sb.Append($"\n{h.Comment}");
        }
        return sb.ToString();
    }

    private bool GetMemberVisible(int hrId) =>
        !_memberVisible.TryGetValue(hrId, out var v) || v;

    private async Task SetMemberVisible(int hrId, bool value)
    {
        _memberVisible[hrId] = value;
        await SaveMemberPrefsAsync();
    }

    private async Task ToggleAllMembersOn()
    {
        foreach (var m in _members)
        {
            _memberVisible[m.HumanResourceId] = true;
        }
        await SaveMemberPrefsAsync();
    }

    private async Task ToggleAllMembersOff()
    {
        foreach (var m in _members)
        {
            _memberVisible[m.HumanResourceId] = false;
        }
        await SaveMemberPrefsAsync();
    }

    private async Task Shift(int direction)
    {
        _anchor = _view == ViewMode.Year ? _anchor.AddYears(direction) : _anchor.AddMonths(direction);
        _loading = true;
        await ReloadRangeAsync();
        _loading = false;
    }

    private async Task GoToday()
    {
        _anchor = DateTime.Today;
        _loading = true;
        await ReloadRangeAsync();
        _loading = false;
    }

    private async Task OnViewChangedAsync(ViewMode mode)
    {
        if (mode == _view)
        {
            return;
        }
        _view = mode;
        _loading = true;
        await ReloadRangeAsync();
        _loading = false;
        await SavePrefsAsync();
    }

    private async Task OnAnchorDatePicked(DateTime? date)
    {
        if (date is null)
        {
            return;
        }
        _datePickerOpen = false;
        _anchor = new DateTime(date.Value.Year, date.Value.Month, 1);
        _loading = true;
        await ReloadRangeAsync();
        _loading = false;
    }

    private async Task JumpToMonth(int month)
    {
        _anchor = new DateTime(_anchor.Year, month, 1);
        _view = ViewMode.Month;
        _loading = true;
        await ReloadRangeAsync();
        _loading = false;
        await SavePrefsAsync();
    }

    private Task OnCellClick(DateTime day) => OpenEditAsync(null, day);

    private Task OpenEditAsync(Holiday? source, DateTime? presetDate, int? presetHumanResourceId = null)
    {
        if (!_canEdit)
        {
            return Task.CompletedTask;
        }

        if (IsSelfService)
        {
            if (source is not null && source.HumanResourceId != SelfHrId!.Value)
            {
                return Task.CompletedTask;
            }
            if (source is null && presetHumanResourceId is not null && presetHumanResourceId != SelfHrId!.Value)
            {
                return Task.CompletedTask;
            }
        }

        _editError = null;
        if (source is null)
        {
            var firstType = _holidayTypes.FirstOrDefault();
            var start = presetDate ?? new DateTime(_anchor.Year, _anchor.Month, 1);
            _editing = new Holiday
            {
                HumanResourceId = IsSelfService
                    ? SelfHrId!.Value
                    : (presetHumanResourceId ?? _members.FirstOrDefault()?.HumanResourceId ?? 0),
                HolidayTypeId = firstType?.Id ?? 0,
                StartDate = start,
                EndDate = start,
            };
        }
        else
        {
            _editing = new Holiday
            {
                Id = source.Id,
                HumanResourceId = source.HumanResourceId,
                HolidayTypeId = source.HolidayTypeId,
                StartDate = source.StartDate,
                EndDate = source.EndDate,
                HalfDay = source.HalfDay,
                Comment = source.Comment,
            };
        }
        _editStart = _editing.StartDate;
        _editEnd = _editing.EndDate;
        _editDialogOpen = true;
        return Task.CompletedTask;
    }

    private void OnEditStartChanged(DateTime? d)
    {
        _editStart = d;
        if (_editStart.HasValue && (_editEnd is null || _editEnd < _editStart))
        {
            _editEnd = _editStart;
        }
        if (_editStart != _editEnd && _editing is not null)
        {
            _editing.HalfDay = HalfDayPortion.None;
        }
    }

    private void OnEditEndChanged(DateTime? d)
    {
        _editEnd = d;
        if (_editStart != _editEnd && _editing is not null)
        {
            _editing.HalfDay = HalfDayPortion.None;
        }
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null || !_canEdit)
        {
            return;
        }
        _editError = null;
        try
        {
            if (_editStart is null || _editEnd is null)
            {
                _editError = "Start and end dates are required.";
                return;
            }
            _editing.StartDate = _editStart.Value;
            _editing.EndDate = _editEnd.Value;
            if (_editing.Id == 0)
            {
                if (IsSelfService)
                {
                    await HolidayService.CreateOwnAsync(_editing, SelfHrId!.Value);
                }
                else
                {
                    await HolidayService.CreateAsync(_editing);
                }
                Snackbar.Add("Holiday created.", Severity.Success);
            }
            else
            {
                if (IsSelfService)
                {
                    await HolidayService.UpdateOwnAsync(_editing, SelfHrId!.Value);
                }
                else
                {
                    await HolidayService.UpdateAsync(_editing);
                }
                Snackbar.Add("Holiday updated.", Severity.Success);
            }
            _editDialogOpen = false;
            await ReloadRangeAsync();
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
    }

    private async Task DeleteEditingAsync()
    {
        if (_editing is null || _editing.Id == 0 || !_canEdit)
        {
            return;
        }
        if (!await MessageService.Confirm("Delete this holiday ?"))
        {
            return;
        }
        try
        {
            if (IsSelfService)
            {
                await HolidayService.DeleteOwnAsync(_editing.Id, SelfHrId!.Value);
            }
            else
            {
                await HolidayService.DeleteAsync(_editing.Id);
            }
            Snackbar.Add("Holiday deleted.", Severity.Success);
            _editDialogOpen = false;
            await ReloadRangeAsync();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to delete holiday");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DownloadIcsAsync()
    {
        try
        {
            var bytes = await IcsExportService.BuildTeamCalendarAsync(TeamId);
            await DownloadService.DownloadAsync(bytes, $"{_team?.Name ?? "team"}_calendar.ics", "text/calendar;charset=utf-8");
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to export iCal");
            Snackbar.Add($"iCal export failed: {ex.Message}", Severity.Error);
        }
    }

    private string PrefKey(string subkey) => $"hp:{TeamId}:{subkey}";

    private async Task LoadPrefsAsync()
    {
        try
        {
            var view = await JS.InvokeAsync<string?>("localStorage.getItem", PrefKey("view"));
            if (Enum.TryParse<ViewMode>(view, out var v))
            {
                _view = v;
            }
            var sph = await JS.InvokeAsync<string?>("localStorage.getItem", PrefKey("showPublicHolidays"));
            if (bool.TryParse(sph, out var b1))
            {
                _showPublicHolidays = b1;
            }
            var ssp = await JS.InvokeAsync<string?>("localStorage.getItem", PrefKey("showSprints"));
            if (bool.TryParse(ssp, out var b2))
            {
                _showSprints = b2;
            }
            var hiddenCsv = await JS.InvokeAsync<string?>("localStorage.getItem", PrefKey("hiddenMembers"));
            if (!string.IsNullOrEmpty(hiddenCsv))
            {
                foreach (var p in hiddenCsv.Split(',', StringSplitOptions.RemoveEmptyEntries))
                {
                    if (int.TryParse(p, out var hrId))
                    {
                        _memberVisible[hrId] = false;
                    }
                }
            }
            if (_view != ViewMode.Month)
            {
                _loading = true;
                await ReloadRangeAsync();
                _loading = false;
            }
            StateHasChanged();
        }
        catch
        {
        }
    }

    private async Task SavePrefsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", PrefKey("view"), _view.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", PrefKey("showPublicHolidays"), _showPublicHolidays.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", PrefKey("showSprints"), _showSprints.ToString());
        }
        catch { }
    }

    private async Task SetTogglePersist(string _, Action setter)
    {
        setter();
        await SavePrefsAsync();
    }

    private async Task SaveMemberPrefsAsync()
    {
        try
        {
            var hidden = string.Join(",", _memberVisible.Where(kv => !kv.Value).Select(kv => kv.Key));
            await JS.InvokeVoidAsync("localStorage.setItem", PrefKey("hiddenMembers"), hidden);
        }
        catch { }
    }
}
