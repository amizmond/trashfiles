@inject ITeamService TeamService
@inject IHolidayService HolidayService
@inject IHolidayTypeService HolidayTypeService
@inject ISprintService SprintService
@inject IPublicHolidayService PublicHolidayService
@inject IPiService PiService
@inject ICapacityCalendarService CapacityService
@inject IIcsExportService IcsExportService
@inject IBrowserDownloadService DownloadService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IModalDialogService MessageService
@inject ISelfServiceResolver SelfService

@using Estimation.Core.Administration.Models
@using Estimation.Core.Calendar.Models
@using Estimation.Core.Calendar.Services
@using Estimation.Core.PlanningIncrement.Models
@using Estimation.Core.PlanningIncrement.Services
@using Estimation.Core.Resources.Models
@using Estimation.Core.Resources.Services
@using System.Text
@using Microsoft.JSInterop
@using Serilog

<PageTitle>Holiday Planner - @(_team?.Name ?? "Team")</PageTitle>

<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <div class="d-flex align-center gap-2 mb-3 flex-wrap">
            <MudToggleGroup T="ViewMode" Value="_view" ValueChanged="OnViewChangedAsync"
                            SelectionMode="SelectionMode.SingleSelection"
                            Color="Color.Primary" Size="Size.Small" CheckMark="false">
                <MudToggleItem Value="ViewMode.Month">Month</MudToggleItem>
                <MudToggleItem Value="ViewMode.Year">Year</MudToggleItem>
                <MudToggleItem Value="ViewMode.Gantt">Gantt</MudToggleItem>
            </MudToggleGroup>
            <div style="position:relative">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Visibility" Disabled="_loading"
                           OnClick="@(() => _showPopoverOpen = !_showPopoverOpen)">
                    Show
                </MudButton>
                <MudPopover Open="_showPopoverOpen" AnchorOrigin="Origin.BottomRight"
                            TransformOrigin="Origin.TopRight" Class="pa-4"
                            Style="min-width:300px; max-height:65vh; overflow:auto">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Show on calendar</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="@(() => _showPopoverOpen = false)" />
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <MudSwitch T="bool" Value="_showPublicHolidays"
                                   ValueChanged="@((bool v) => SetTogglePersist(nameof(_showPublicHolidays), () => _showPublicHolidays = v))"
                                   Label="Public holidays" Color="Color.Primary" Size="Size.Small" />
                        <MudSwitch T="bool" Value="_showSprints"
                                   ValueChanged="@((bool v) => SetTogglePersist(nameof(_showSprints), () => _showSprints = v))"
                                   Label="Sprints" Color="Color.Primary" Size="Size.Small" />
                    </div>
                    @if (_members.Any())
                    {
                        <MudDivider Class="my-2" />
                        <div class="d-flex align-center justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Team members</MudText>
                            <div class="d-flex gap-1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleAllMembersOn">All</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleAllMembersOff">None</MudButton>
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-1">
                            @foreach (var m in _members)
                            {
                                var hrId = m.HumanResourceId;
                                var usage = _leaveUsage.FirstOrDefault(u => u.HumanResourceId == hrId);
                                var balanceLabel = usage is null ? "" :
                                    (usage.Entitlement.HasValue
                                        ? $" ({usage.UsedDays:0.#}/{usage.Entitlement} d)"
                                        : $" ({usage.UsedDays:0.#} d used)");
                                <MudSwitch T="bool"
                                           Value="GetMemberVisible(hrId)"
                                           ValueChanged="@((bool v) => SetMemberVisible(hrId, v))"
                                           Label="@($"{m.HumanResource.FullName}{balanceLabel}")"
                                           Color="Color.Primary" Size="Size.Small" />
                            }
                        </div>
                    }
                </MudPopover>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.CalendarMonth"
                       OnClick="DownloadIcsAsync" Disabled="_loading">
                iCal
            </MudButton>
            @HeaderActions
            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OpenEditAsync(null, null))" Disabled="_loading">
                    Add holiday
                </MudButton>
            }
            else if (_directoryUnavailable)
            {
                <MudTooltip Text="Active Directory is not responding, so your account could not be matched to a team member and your own holidays cannot be added right now. Please try again in a minute.">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.Info">
                        Active Directory not responding
                    </MudChip>
                </MudTooltip>
            }
            else if (_selfIdentityUnresolved)
            {
                <MudTooltip Text="Your account could not be matched to a single team member record, so your own holidays cannot be added here. Ask an administrator to check your employee number.">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.Info">
                        Account not linked to a member
                    </MudChip>
                </MudTooltip>
            }
        </div>

        <div class="d-flex align-center gap-2 mb-2 flex-wrap">
            <MudTooltip Text="Click to jump to month">
                <MudButton Variant="Variant.Text" Size="Size.Large"
                           OnClick="@(() => _datePickerOpen = !_datePickerOpen)"
                           Class="font-weight-bold pa-1" Style="text-transform:none">
                    @RangeTitle
                </MudButton>
            </MudTooltip>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton OnClick="@(() => Shift(-1))" StartIcon="@Icons.Material.Filled.ChevronLeft">Prev</MudButton>
                <MudButton OnClick="GoToday">Today</MudButton>
                <MudButton OnClick="@(() => Shift(1))" EndIcon="@Icons.Material.Filled.ChevronRight">Next</MudButton>
            </MudButtonGroup>
            <MudSpacer />
            @if (_capacity is not null && _view != ViewMode.Year)
            {
                <MudTooltip Text="@($"Working days: {_capacity.WorkingDays} · Gross person-days: {_capacity.GrossPersonDays:0.#}\nPublic holidays: {_capacity.PublicHolidayDays:0.#} pd · Leave: {_capacity.LeaveDays:0.#} pd")">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        Capacity: @_capacity.CapacityPercent.ToString("0.#")%
                        (@_capacity.AvailablePersonDays.ToString("0.#") / @_capacity.GrossPersonDays.ToString("0.#") d)
                    </MudChip>
                </MudTooltip>
            }
        </div>

        <MudPopover Open="_datePickerOpen" AnchorOrigin="Origin.BottomLeft"
                    TransformOrigin="Origin.TopLeft" Class="pa-2">
            <MudDatePicker PickerVariant="PickerVariant.Static" Date="_anchor"
                           DateChanged="OnAnchorDatePicked"
                           OpenTo="OpenTo.Month" FixDay="1" />
        </MudPopover>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }
        else if (_view == ViewMode.Year)
        {
            @if (_pisInRange.Any())
            {
                <MudPaper Class="pa-2 mb-2 rounded-lg" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">Planning Increments (@_anchor.Year)</MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var pi in _pisInRange)
                        {
                            <MudTooltip Text="@PiCapacityTooltip(pi)">
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled">
                                    @pi.Name (@(pi.StartDate?.ToString("yyyy-MM-dd")) – @(pi.EndDate?.ToString("yyyy-MM-dd")))@PiCapacitySuffix(pi)
                                </MudChip>
                            </MudTooltip>
                        }
                    </div>
                </MudPaper>
            }
            <div class="hp-year-grid">
                @for (var m = 1; m <= 12; m++)
                {
                    var month = m;
                    var firstOfMonth = new DateTime(_anchor.Year, month, 1);
                    <div class="hp-mini-month" @onclick="@(() => JumpToMonth(month))" role="button" title="Open this month">
                        <div class="hp-mini-month-header">@firstOfMonth.ToString("MMMM")</div>
                        <div class="hp-mini-grid">
                            @foreach (var dow in new[] { "M", "T", "W", "T", "F", "S", "S" })
                            {
                                <div class="hp-mini-dow">@dow</div>
                            }
                            @foreach (var day in MiniMonthDays(firstOfMonth))
                            {
                                var inMonth = day.Month == month;
                                var dayHolidays = inMonth
                                    ? _holidays.Where(h => h.StartDate.Date <= day.Date && h.EndDate.Date >= day.Date
                                        && GetMemberVisible(h.HumanResourceId)).ToList()
                                    : new List<Holiday>();
                                var isPh = inMonth && _showPublicHolidays
                                    && _publicHolidayByDate.ContainsKey(day.Date);
                                var bgStyle = "";
                                if (dayHolidays.Count > 0)
                                {
                                    bgStyle = $"background-color: rgba(25,118,210,{Math.Min(0.85, 0.2 + dayHolidays.Count * 0.15).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)});color:#fff;";
                                }
                                else if (isPh)
                                {
                                    bgStyle = "background-color:#FFE082;color:#5D4037;";
                                }
                                var title = $"{day:yyyy-MM-dd}" +
                                    (dayHolidays.Any() ? $"\n{dayHolidays.Count} on leave" : "") +
                                    (isPh ? "\nPublic holiday" : "");
                                <div class="hp-mini-cell @(inMonth ? "" : "hp-mini-other")"
                                     style="@bgStyle"
                                     title="@title">
                                    @(inMonth ? day.Day.ToString() : "")
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (_view == ViewMode.Gantt)
        {
            var (gFrom, gTo) = MonthBounds();
            var daysInMonth = (gTo - gFrom).Days + 1;
            <div class="hp-gantt" style="@($"grid-template-columns: 200px repeat({daysInMonth}, minmax(28px, 1fr))")">
                <div class="hp-gantt-cell hp-gantt-header hp-gantt-sticky">Member</div>
                @for (var d = 0; d < daysInMonth; d++)
                {
                    var day = gFrom.AddDays(d);
                    var isWeekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                    var headerStyle = isWeekend ? "background-color:rgba(0,0,0,0.04);" : "";
                    <div class="hp-gantt-cell hp-gantt-header" style="@headerStyle"
                         title="@($"{day:yyyy-MM-dd} ({day.DayOfWeek})")">
                        <div class="hp-gantt-dow">@day.ToString("ddd")[0]</div>
                        <div class="hp-gantt-dnum">@day.Day</div>
                    </div>
                }
                @foreach (var member in _members.Where(m => GetMemberVisible(m.HumanResourceId)))
                {
                    <div class="hp-gantt-cell hp-gantt-sticky hp-gantt-name">@member.HumanResource.FullName</div>
                    @for (var d = 0; d < daysInMonth; d++)
                    {
                        var day = gFrom.AddDays(d);
                        var isWeekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                        var isPh = _showPublicHolidays && IsMemberPublicHoliday(member.HumanResourceId, day);
                        var hOnDay = _holidays.FirstOrDefault(h =>
                            h.HumanResourceId == member.HumanResourceId
                            && h.StartDate.Date <= day.Date && h.EndDate.Date >= day.Date);
                        var cellStyle = "";
                        var content = "";
                        var tooltip = $"{day:yyyy-MM-dd}";
                        if (hOnDay is not null)
                        {
                            var c = hOnDay.HolidayType?.ColorHex ?? "#9E9E9E";
                            cellStyle = $"background-color:{c}; color:#fff;";
                            content = hOnDay.HalfDay == HalfDayPortion.None ? "" : hOnDay.HalfDay.ToString();
                            tooltip = HolidayTooltip(hOnDay);
                        }
                        else if (isPh)
                        {
                            cellStyle = "background-color:#FFE082;color:#5D4037;";
                            var phName = ResolveMemberPublicHoliday(member.HumanResourceId, day)?.Name;
                            tooltip = string.IsNullOrEmpty(phName)
                                ? $"{day:yyyy-MM-dd}\nPublic holiday"
                                : $"{day:yyyy-MM-dd}\n{phName}";
                        }
                        else if (isWeekend)
                        {
                            cellStyle = "background-color:rgba(0,0,0,0.04);";
                        }
                        if (hOnDay is not null)
                        {
                            <div class="hp-gantt-cell @(CanEditRow(hOnDay) ? "hp-gantt-clickable" : "")" style="@cellStyle"
                                 title="@tooltip" @onclick="@(() => OpenEditAsync(hOnDay, null))">@content</div>
                        }
                        else
                        {
                            <div class="hp-gantt-cell @(CanEditMember(member.HumanResourceId) ? "hp-gantt-clickable" : "")" style="@cellStyle"
                                 title="@tooltip" @onclick="@(() => OpenEditAsync(null, day, member.HumanResourceId))">@content</div>
                        }
                    }
                }
            </div>
        }
        else
        {
            @if (_pisInRange.Any())
            {
                <MudPaper Class="pa-2 mb-2 rounded-lg" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">Planning Increments</MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var pi in _pisInRange)
                        {
                            <MudTooltip Text="@PiCapacityTooltip(pi)">
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled">
                                    @pi.Name (@(pi.StartDate?.ToString("yyyy-MM-dd")) – @(pi.EndDate?.ToString("yyyy-MM-dd")))@PiCapacitySuffix(pi)
                                </MudChip>
                            </MudTooltip>
                        }
                    </div>
                </MudPaper>
            }

            <div class="hp-grid">
                @foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                {
                    <div class="hp-dow">@day</div>
                }
                @foreach (var day in GridDays())
                {
                    var inRange = day.Month == _anchor.Month;
                    var isToday = day.Date == DateTime.Today;
                    var isWeekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                    var phRaw = _publicHolidayByDate.TryGetValue(day.Date, out var phList) ? phList : null;
                    var ph = _showPublicHolidays ? phRaw : null;
                    var sprintsToday = _showSprints
                        ? _sprints.Where(s => s.StartDate.Date <= day.Date && s.EndDate.Date >= day.Date).ToList()
                        : new List<Sprint>();
                    var holidaysToday = _holidays
                        .Where(h => h.StartDate.Date <= day.Date && h.EndDate.Date >= day.Date)
                        .Where(h => GetMemberVisible(h.HumanResourceId))
                        .OrderBy(h => h.HumanResource?.FullName)
                        .ToList();
                    var activeMembers = _members.Count(m => m.HumanResource.IsActive);
                    var conflictRatio = activeMembers > 0
                        ? (double)holidaysToday.Select(h => h.HumanResourceId).Distinct().Count() / activeMembers
                        : 0;
                    var hasConflict = inRange && conflictRatio >= ConflictThreshold;

                    var cellStyle = "";
                    if (ph is not null && ph.Any())
                    {
                        cellStyle = "background-color:#FFF8E1;";
                    }
                    else if (isWeekend)
                    {
                        cellStyle = "background-color:rgba(0,0,0,0.02);";
                    }

                    <div class="hp-cell @(inRange ? "" : "hp-cell-other") @(isToday ? "hp-cell-today" : "")"
                         style="@(cellStyle + (inRange && _canEdit ? "cursor:pointer;" : ""))"
                         @onclick="@(() => OnCellClick(day))">
                        <div class="hp-cell-head">
                            <span class="hp-daynum">
                                @day.Day
                                @if (hasConflict)
                                {
                                    <MudTooltip Text="@($"{Math.Round(conflictRatio * 100)}% of team out")">
                                        <span class="hp-conflict-dot"></span>
                                    </MudTooltip>
                                }
                            </span>
                            @if (ph is not null)
                            {
                                @foreach (var p in ph)
                                {
                                    <MudTooltip Text="@($"{p.Name} ({p.City?.Name ?? p.Country?.Name})")">
                                        <MudChip T="string" Size="Size.Small" Style="background-color:#FFE082;color:#5D4037">PH</MudChip>
                                    </MudTooltip>
                                }
                            }
                        </div>
                        @foreach (var s in sprintsToday)
                        {
                            var c = SprintColor(s);
                            <MudTooltip Text="@($"{s.Name}{(s.Pi is null ? "" : $" · {s.Pi.Name}")}{(string.IsNullOrEmpty(s.Comment) ? "" : $"\n{s.Comment}")}")">
                                <div class="hp-sprint" style="@($"background-color:{c}")">@s.Name</div>
                            </MudTooltip>
                        }
                        @foreach (var h in holidaysToday)
                        {
                            var c = h.HolidayType?.ColorHex ?? "#9E9E9E";
                            var half = h.HalfDay == HalfDayPortion.None ? "" : $" ({h.HalfDay})";
                            var tooltip = HolidayTooltip(h);
                            var notCounted = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday
                                || IsMemberPublicHoliday(h.HumanResourceId, day);
                            <MudTooltip Text="@tooltip">
                                <div class="hp-holiday @(CanEditRow(h) ? "" : "hp-readonly") @(notCounted ? "hp-holiday-faded" : "")" style="@($"background-color:{c}")"
                                     @onclick="@(() => OpenEditAsync(h, null))" @onclick:stopPropagation="true" role="button">
                                    @h.HumanResource?.FullName@half
                                </div>
                            </MudTooltip>
                        }
                    </div>
                }
            </div>
        }
    </MudPaper>
</div>

@if (_editing is not null)
{
    <MudDialog @bind-Visible="_editDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>@(_editing.Id == 0 ? "New holiday" : "Edit holiday")</TitleContent>
        <DialogContent>
            @if (IsSelfService)
            {
                <MudTextField T="string" Value="@SelfMemberName" Label="Team member"
                              Variant="Variant.Outlined" Class="mb-3" ReadOnly="true" Disabled="true" />
            }
            else
            {
                <MudSelect T="int" @bind-Value="_editing.HumanResourceId" Label="Team member *" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var m in _members)
                    {
                        <MudSelectItem T="int" Value="@m.HumanResourceId">@m.HumanResource.FullName</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudSelect T="int" @bind-Value="_editing.HolidayTypeId" Label="Type *" Variant="Variant.Outlined" Class="mb-3">
                @foreach (var t in _holidayTypes)
                {
                    <MudSelectItem T="int" Value="@t.Id">@t.Name</MudSelectItem>
                }
            </MudSelect>
            <div class="d-flex gap-2">
                <MudDatePicker Label="Start *" Date="_editStart" DateChanged="OnEditStartChanged"
                               Variant="Variant.Outlined" Class="mb-3" />
                <MudDatePicker Label="End *" Date="_editEnd" DateChanged="OnEditEndChanged"
                               Variant="Variant.Outlined" Class="mb-3" />
            </div>
            @if (_editStart.HasValue && _editEnd.HasValue && _editStart == _editEnd)
            {
                <MudSelect T="HalfDayPortion" @bind-Value="_editing.HalfDay" Label="Half-day"
                           Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem T="HalfDayPortion" Value="HalfDayPortion.None">Full day</MudSelectItem>
                    <MudSelectItem T="HalfDayPortion" Value="HalfDayPortion.AM">Morning (AM)</MudSelectItem>
                    <MudSelectItem T="HalfDayPortion" Value="HalfDayPortion.PM">Afternoon (PM)</MudSelectItem>
                </MudSelect>
            }
            <MudTextField @bind-Value="_editing.Comment" Label="Comment" Variant="Variant.Outlined" Lines="2" />
            @if (_editStart.HasValue && _editEnd.HasValue && _editEnd >= _editStart)
            {
                var bd = BuildBreakdown(_editing.HumanResourceId, _editStart.Value, _editEnd.Value, _editing.HalfDay);
                <MudAlert Severity="Severity.Info" Dense Class="mt-3">
                    <MudText Typo="Typo.body2">
                        Selected range: @_editStart.Value.ToString("yyyy-MM-dd") → @_editEnd.Value.ToString("yyyy-MM-dd")
                        (@bd.TotalDays day(s))
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Vacation days counted: <strong>@bd.VacationDays.ToString("0.#")</strong>
                    </MudText>
                    @if (bd.WeekendDays > 0)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">Weekends excluded: @bd.WeekendDays</MudText>
                    }
                    @if (bd.PublicHolidayDays > 0)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">Public holidays excluded: @bd.PublicHolidayDays</MudText>
                        @foreach (var n in bd.PublicHolidayNames)
                        {
                            <MudText Typo="Typo.caption" Class="d-block ml-3">• @n</MudText>
                        }
                    }
                </MudAlert>
            }
            @if (!string.IsNullOrEmpty(_editError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_editError</MudAlert>
            }
        </DialogContent>
        <DialogActions>
            @if (_editing.Id != 0)
            {
                <MudButton Color="Color.Error" OnClick="DeleteEditingAsync">Delete</MudButton>
            }
            <MudSpacer />
            <MudButton OnClick="@(() => _editDialogOpen = false)">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEditAsync">Save</MudButton>
        </DialogActions>
    </MudDialog>
}

<style>
    .hp-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 2px;
        background-color: var(--mud-palette-lines-default);
        border: 1px solid var(--mud-palette-lines-default);
    }
    .hp-dow {
        background-color: var(--mud-palette-surface);
        padding: 4px 8px;
        font-weight: 600;
        font-size: 0.8rem;
        text-align: center;
    }
    .hp-cell {
        background-color: var(--mud-palette-surface);
        min-height: 96px;
        padding: 4px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow: hidden;
    }
    .hp-cell-other { opacity: 0.5; }
    .hp-cell-today { outline: 2px solid var(--mud-palette-primary); outline-offset: -2px; }
    .hp-cell-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
        gap: 4px;
    }
    .hp-daynum { font-weight: 600; display:inline-flex; align-items:center; gap:4px; }
    .hp-conflict-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background-color: var(--mud-palette-error);
        display: inline-block;
    }
    .hp-sprint {
        font-size: 0.7rem;
        padding: 1px 4px;
        border-radius: 3px;
        color: #fff;
        opacity: 0.85;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .hp-holiday {
        font-size: 0.72rem;
        padding: 2px 4px;
        border-radius: 3px;
        color: #fff;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .hp-holiday:hover { opacity: 0.85; }
    .hp-holiday.hp-readonly { cursor: default; }
    .hp-holiday-faded { opacity: 0.4; }
    .hp-holiday-faded:hover { opacity: 0.55; }

    .hp-year-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }
    @@media (max-width: 1100px) { .hp-year-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @@media (max-width: 800px)  { .hp-year-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
