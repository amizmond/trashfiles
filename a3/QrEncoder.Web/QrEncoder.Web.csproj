<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Shared with QrEncoder so both produce byte-identical payloads for QrDecoder. -->
  <ItemGroup>
    <Compile Include="..\QrEncoder\FilePacker.cs" Link="Encoding\FilePacker.cs" />
    <Compile Include="..\QrEncoder\QrChunker.cs" Link="Encoding\QrChunker.cs" />
  </ItemGroup>

</Project>
