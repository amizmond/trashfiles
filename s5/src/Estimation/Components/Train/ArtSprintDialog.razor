@using Estimation.Core.PlanningIncrement.Models
@using Estimation.Core.Train.Models

<MudDialog>
    <TitleContent>@(Sprint.Id == 0 ? "New ART Sprint" : "Edit ART Sprint")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="Sprint.Name" Label="Sprint Name *" Variant="Variant.Outlined"
                      MaxLength="20" Class="mb-3" Immediate="true" />
        <div class="d-flex gap-2">
            <MudDatePicker Label="Dev start *" @bind-Date="_start" Variant="Variant.Outlined" Class="mb-3" />
            <MudDatePicker Label="Dev end *" @bind-Date="_end" Variant="Variant.Outlined" Class="mb-3" />
        </div>
        <div class="d-flex gap-2">
            <MudDatePicker Label="UAT start *" @bind-Date="_uatStart" Variant="Variant.Outlined" Class="mb-3" />
            <MudDatePicker Label="UAT end *" @bind-Date="_uatEnd" Variant="Variant.Outlined" Class="mb-3" />
        </div>
        <div class="d-flex gap-2">
            <MudDatePicker Label="Sign-off" @bind-Date="_signOff" Variant="Variant.Outlined" Clearable="true" Class="mb-3" />
            <MudDatePicker Label="Release Date" @bind-Date="_release" Variant="Variant.Outlined" Clearable="true" Class="mb-3" />
        </div>
        <MudTextField @bind-Value="Sprint.FixVersion" Label="Fix version" Variant="Variant.Outlined"
                      MaxLength="50" Class="mb-3" />
        <SearchableDropdown T="int?"
                            Items="_piIds"
                            Value="_piId"
                            ValueChanged="@(v => _piId = v)"
                            ToStringFunc="@PiName"
                            Label="PI *"
                            Class="mb-3" />
        <MudCheckBox T="bool" @bind-Value="Sprint.IsIpSprint">IP sprint</MudCheckBox>

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">
                @foreach (var error in _errors)
                {
                    <div>@error</div>
                }
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public CapitalProjectSprint Sprint { get; set; } = null!;

    [Parameter] public List<Pi> Pis { get; set; } = new();

    [Parameter] public Func<CapitalProjectSprint, Task<List<string>>>? Validate { get; set; }

    private DateTime? _start;
    private DateTime? _end;
    private DateTime? _uatStart;
    private DateTime? _uatEnd;
    private DateTime? _signOff;
    private DateTime? _release;
    private int? _piId;
    private bool _busy;
    private List<string> _errors = new();

    private IEnumerable<int?> _piIds => Pis.Select(p => (int?)p.Id);

    private string PiName(int? id)
    {
        if (id is null)
        {
            return string.Empty;
        }

        return Pis.FirstOrDefault(p => p.Id == id.Value)?.Name ?? string.Empty;
    }

    protected override void OnInitialized()
    {
        _start = Sprint.Id == 0 ? DateTime.UtcNow.Date : Sprint.StartDate;
        _end = Sprint.Id == 0 ? DateTime.UtcNow.Date.AddDays(13) : Sprint.EndDate;
        _uatStart = Sprint.UatStart == default ? null : Sprint.UatStart;
        _uatEnd = Sprint.UatEnd == default ? null : Sprint.UatEnd;
        _signOff = Sprint.SignOffDate;
        _release = Sprint.ReleaseDate;
        _piId = Sprint.PiId == 0 ? null : Sprint.PiId;
    }

    private async Task Submit()
    {
        _errors = new List<string>();

        if (string.IsNullOrWhiteSpace(Sprint.Name))
        {
            _errors.Add("Sprint name is required.");
        }

        if (_start is null || _end is null)
        {
            _errors.Add("Dev start and dev end are required.");
        }

        if (_uatStart is null || _uatEnd is null)
        {
            _errors.Add("UAT start and UAT end are required.");
        }

        if (_piId is null)
        {
            _errors.Add("PI is required.");
        }

        if (_errors.Count > 0)
        {
            return;
        }

        Sprint.StartDate = _start!.Value.Date;
        Sprint.EndDate = _end!.Value.Date;
        Sprint.UatStart = _uatStart!.Value.Date;
        Sprint.UatEnd = _uatEnd!.Value.Date;
        Sprint.SignOffDate = _signOff?.Date;
        Sprint.ReleaseDate = _release?.Date;
        Sprint.PiId = _piId!.Value;

        if (Validate is not null)
        {
            _busy = true;
            try
            {
                _errors = await Validate(Sprint);
            }
            finally
            {
                _busy = false;
            }

            if (_errors.Count > 0)
            {
                return;
            }
        }

        MudDialog.Close(DialogResult.Ok(Sprint));
    }

    private void Cancel() => MudDialog.Cancel();
}
