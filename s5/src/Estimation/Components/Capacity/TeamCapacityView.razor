    private async Task CopyFeatureNameAsync(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", name);
            Snackbar.Add("Feature name copied.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not copy the feature name: {ex.Message}", Severity.Error);
        }
    }

