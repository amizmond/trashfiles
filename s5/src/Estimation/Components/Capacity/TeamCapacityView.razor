                    }
                    @if (_showTargetEnd && f.TargetEnd is not null)
                    {
                        <div class="d-flex align-center gap-2 mt-1">
                            <span style="min-width:55px; display:inline-block">Target end:</span>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@f.TargetEnd.Value.ToString("dd MMM yyyy")</MudText>
                        </div>
                    }
                    @if (_showAcceptanceCriteria && !string.IsNullOrWhiteSpace(f.AcceptanceCriteria))
                    {
                        <div class="d-flex align-start gap-2 mt-1">
