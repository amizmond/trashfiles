                    {
                        @if (alloc.IsValid)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@(alloc.IsFullyReserved ? Color.Success : alloc.Reserved > 0m ? Color.Warning : Color.Error)">
                                Reserved @alloc.Reserved.ToString("0.##")/@alloc.Required.ToString("0.##")
                            </MudChip>
                        }
                        else
                        {
                            <MudTooltip Text="Capacity is calculated only when this team has a technology stack with story points entered on this feature. Add a technology stack and enter its story points in the feature.">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Icon="@Icons.Material.Filled.Warning">
                                    No stack capacity
                                </MudChip>
                            </MudTooltip>
                        }
                    }
                    @if (HygieneFailuresOf(f) is { Count: > 0 } failed)
                    {
                        <MudTooltip Text="@HygieneWarningTooltip(failed)">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                     Icon="@Icons.Material.Filled.Warning">
                                @failed.Count failed hygiene check@(failed.Count == 1 ? "" : "s")
                            </MudChip>
                        </MudTooltip>
                    }
                </div>
                <MudBadge Content="@(_commentCounts.GetValueOrDefault(f.FeatureId))"
                          Color="Color.Info" Overlap="true" Bordered="true"
                          Visible="@(_commentCounts.GetValueOrDefault(f.FeatureId) > 0)">
                    <MudTooltip Text="Status Comment">
                        <MudIconButton Icon="@Icons.Material.Filled.Comment"
                                       Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => ShowCommentsAsync(f))" />
                    </MudTooltip>
                </MudBadge>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                               Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OpenFeatureInNewWindow(f.FeatureId))" />
                @if (included && alloc is not null && alloc.IsValid)
                {
                    <MudTooltip Text="Explain capacity">
                        <MudIconButton Icon="@Icons.Material.Filled.Assessment"
                                       Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                       OnClick="@(() => ShowFeatureCapacityAsync(f, alloc))" />
                    </MudTooltip>
                }
                @if (CanRemoveFeature(f))
                {
                    <MudTooltip Text="Remove from Team Capacity — this feature does not belong to the selected PI">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => RemoveFeatureAsync(f))" />
                    </MudTooltip>
                }
            </div>
        </div>;

    [Parameter] public int TeamId { get; set; }

