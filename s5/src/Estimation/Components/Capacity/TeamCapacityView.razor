                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@f.FeaturePiName</MudText>
                        </div>
                    }
                </div>
                <div class="d-flex flex-column align-end gap-1" style="text-align:right; min-width:160px">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
