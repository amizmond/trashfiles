        "Fails the hygiene rules of its ART: " + string.Join(" · ", failures.Select(f => f.Display));

    private static string HygieneFailureTooltip(HygieneFailure failure)
    {
        var parts = new List<string>();

        if (failure.Message is not null && failure.Label != failure.RuleText)
        {
            parts.Add(failure.Label);
        }

        parts.Add(failure.RuleText);
        parts.Add(failure.ActualValue is null ? "current value: empty" : $"current value: {failure.ActualValue}");

        return string.Join(" — ", parts);
    }

    private async Task LoadAsync(int piId)
    {
        try
        {
            _driftDismissed = false;
            _filter = new FeatureCardFilter();
            _result = await CapacityService.GetAsync(TeamId, piId, _includeIpSprints);
            _ownedStackIds = _result.StackCapacities.Select(s => s.TechnologyStackId).ToHashSet();
            _features = _result.Features.ToList();
            await LoadHygieneAsync();
            _commentCounts = await CommentService.GetCountsAsync(_features.Select(f => f.FeatureId).ToList());
            RecomputeAllocations();
            _applyToAllTeams.Clear();
            _otherTeamLines = await CapacityService.GetFeatureOtherTeamLinesAsync(
                TeamId, piId, _features.Select(f => f.FeatureId).ToList());
            _wasEverSaved = _features.Any(f => f.IsSaved);
            _hasNewFeatures = _features.Any(IsNewUnsavedFeature);
            if (_result.Drifts.Count > 0)
            {
                Snackbar.Add(
                    $"{_result.Drifts.Count} added feature(s) changed their PI since being added. See the notice above the list.",
                    Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to load team capacity");
            Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleIncludedAsync(TeamCapacityFeatureRow row, bool value)
    {
        if (!CanEditCapacity)
        {
            return;
        }

        var otherTeams = _otherTeamLines.GetValueOrDefault(row.FeatureId);
        if (otherTeams is { Count: > 0 })
        {
            var choice = await PromptMoveScopeAsync(row, value, otherTeams);
            if (choice == MoveScopeChoice.Cancel)
            {
                StateHasChanged();
                return;
            }
            if (choice == MoveScopeChoice.AllTeams)
            {
                _applyToAllTeams.Add(row.FeatureId);
            }
            else
            {
                _applyToAllTeams.Remove(row.FeatureId);
            }
        }
        else
        {
            _applyToAllTeams.Remove(row.FeatureId);
        }

        var index = _features.FindIndex(f => f.FeatureId == row.FeatureId);
        if (index < 0)
        {
            return;
        }
        _features[index] = _features[index] with { IsIncluded = value };
        _hasUnsavedChanges = true;
        RecomputeAllocations();
        StateHasChanged();
    }

    private async Task<MoveScopeChoice> PromptMoveScopeAsync(
        TeamCapacityFeatureRow row, bool include, List<FeatureOtherTeamLine> otherTeams)
    {
        var name = string.IsNullOrWhiteSpace(row.Name) ? "(no name)" : row.Name;
        var featureLabel = string.IsNullOrEmpty(row.JiraId) ? name : $"{row.JiraId} — {name}";
        var currentTeam = _team?.Name ?? "this team";
        var direction = include ? "above the line" : "below the line";

        var teamItems = string.Join("", otherTeams.Select(t =>
            $"<li>{System.Net.WebUtility.HtmlEncode(t.TeamName)}{(t.IsIncluded ? "" : " <i>(below the line)</i>")}</li>"));
        var message =
            $"<b>{System.Net.WebUtility.HtmlEncode(featureLabel)}</b> is assigned to other team(s) that also plan it in this PI:"
            + $"<ul style=\"margin:6px 0 6px 18px; padding:0\">{teamItems}</ul>"
            + $"Move it {direction} for all these teams as well, or only for "
            + $"<b>{System.Net.WebUtility.HtmlEncode(currentTeam)}</b>?";

        var choice = await ModalDialogService.ConfirmChoice(
            message,
            include ? "Move above the line" : "Move below the line",
            "All assigned teams",
            "Only this team",
            "Cancel");

        return choice switch
        {
            ModalDialogChoice.Primary => MoveScopeChoice.AllTeams,
            ModalDialogChoice.Secondary => MoveScopeChoice.CurrentTeamOnly,
            _ => MoveScopeChoice.Cancel,
        };
    }

