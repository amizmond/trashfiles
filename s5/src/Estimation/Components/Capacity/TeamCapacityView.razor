@implements IAsyncDisposable

@inject ITeamService TeamService
@inject IPiService PiService
@inject ITeamCapacityService CapacityService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IModalDialogService ModalDialogService
@inject IDialogService DialogService
@inject IConfiguration Configuration
@inject IFeatureCommentService CommentService
@inject IWindowsAuthService WindowsAuth
@inject IUserPermissionService UserPermissions
@inject IFeatureHygieneService HygieneService

@using Estimation.Core.Administration.Models
@using Estimation.Core.Administration.Services
@using Estimation.Core.PlanningIncrement.Models
@using Estimation.Core.PlanningIncrement.Services
@using Estimation.Core.Resources.Models
@using Estimation.Core.Resources.Services
@using Estimation.Core.Capacity.Services
@using Estimation.Core.Features.Models
@using Estimation.Core.Features.Services
@using Estimation.Core.Features.Hygiene.Services
@using Serilog

<PageTitle>@($"{_team?.Name} — Capacity")</PageTitle>

<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <div class="d-flex align-center gap-2 mb-3 flex-wrap">
            <MudText Typo="Typo.h6">@($"{_team?.Name} — Team Capacity")</MudText>
            <MudSpacer />
            <MudSelect T="int?"
                       Value="_selectedPiId"
                       ValueChanged="OnPiChangedAsync"
                       Label="Select PI"
                       Variant="Variant.Outlined"
                       Dense
                       AnchorOrigin="Origin.BottomCenter"
                       Style="width:260px">
                @foreach (var pi in _allPis)
                {
                    <MudSelectItem T="int?" Value="pi.Id">@pi.Name</MudSelectItem>
                }
            </MudSelect>
            @if (SelectedPiLocked)
            {
                <MudTooltip Text="@(_canEditLockedPi ? "This PI is locked, but your profile allows editing locked PIs." : "This PI is locked. Capacity planning is read-only for it.")">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Lock">
                        Locked
                    </MudChip>
                </MudTooltip>
            }
            @if (CanEditCapacity)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           Disabled="@(_selectedPiId is null || _result is null)"
                           OnClick="OpenFindAsync">
                    Find
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Tune"
                       Disabled="@(_selectedPiId is null)"
                       OnClick="@(() => Navigation.NavigateTo(CoefficientsUrl))">
                Coefficients
            </MudButton>
            @if (CanEditCapacity)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@((!_hasUnsavedChanges && !_hasNewFeatures) || _saving)"
                           OnClick="SaveAsync">
                    Save
                </MudButton>
            }
        </div>

        <div class="d-flex align-center gap-2 mb-3 flex-wrap">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.HelpOutline" Color="Color.Primary" OnClick="ShowHelpAsync">How is capacity calculated?</MudButton>
            <MudSwitch T="bool"
                       Value="_includeIpSprints"
                       ValueChanged="OnIncludeIpSprintsChangedAsync"
                       Label="Include IP sprint in the calculation"
                       Color="Color.Primary" />
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }
        else if (_team is null)
        {
            <MudAlert Severity="Severity.Warning">Team not found.</MudAlert>
        }
        else if (_selectedPiId is null)
        {
            <MudText Class="mud-text-secondary">Select a PI to view capacity.</MudText>
        }
        else if (_result is null)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }
        else
        {
            @if (_saving)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-2" />
            }

            @if (SelectedPiLocked && !CanEditCapacity)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    This PI is locked. Capacity planning is read-only — saving, moving features above or below
                    the line, reordering, adding and removing features are all disabled.
                </MudAlert>
            }
            else if (SelectedPiLocked)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    This PI is locked, but your profile ("Edit locked PI") allows capacity changes.
                </MudAlert>
            }

            @if (!_driftDismissed && _result.Drifts.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3"
                          ShowCloseIcon="true" CloseIconClicked="@(() => _driftDismissed = true)">
                    <MudText Typo="Typo.body2" Class="font-weight-bold mb-1">
                        Some added features changed their PI since you added them:
                    </MudText>
                    <ul style="margin:0 0 0 18px; padding:0">
                        @foreach (var d in _result.Drifts)
                        {
                            <li>
                                <MudText Typo="Typo.body2" Component="span">
                                    @(string.IsNullOrEmpty(d.JiraId) ? "" : $"{d.JiraId} — ")@d.Name:
                                    added as <b>@(d.AddedPiName ?? "No PI")</b>,
                                    now <b>@(d.CurrentPiName ?? "No PI")</b>.
                                </MudText>
                            </li>
                        }
                    </ul>
                    @if (CanEditCapacity)
                    {
                        <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@_saving"
                                       OnClick="ResaveDriftAsync">
                                Resave with current PI
                            </MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Records each feature's current PI so this notice won't show again.
                            </MudText>
                        </div>
                    }
                </MudAlert>
            }

            <MudPaper Elevation="0" Class="pa-3 rounded-lg mb-3" Style="border:1px solid var(--mud-palette-lines-default)">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.Groups">
                        @_result.Members.Count members
                    </MudChip>
                    @if (NoStackMemberCount > 0)
                    {
                        <MudTooltip Text="These members count toward team capacity but belong to none of the team's technology stacks, so they can't be reserved against any feature that has a stack split. Assign them a stack on the Team page.">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.PersonOff">
                                @NoStackMemberCount member@(NoStackMemberCount != 1 ? "s" : "") with no stack
                            </MudChip>
                        </MudTooltip>
                    }
                    @if (MultiStackMemberCount > 0)
                    {
                        <MudTooltip Text="These members belong to more than one stack. Their days are a shared pool, so every stack they belong to counts their full capacity — which is why the stack capacities overlap.">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Layers">
                                @MultiStackMemberCount in multiple stacks
                            </MudChip>
                        </MudTooltip>
                    }
                    @if (UnbackedFeatureCount > 0)
                    {
                        <MudTooltip Text="Included features with no team technology-stack story points entered. Their effort can't be reserved against any stack.">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Warning">
                                @UnbackedEffort SP not backed by a stack (@UnbackedFeatureCount feature@(UnbackedFeatureCount != 1 ? "s" : ""))
                            </MudChip>
                        </MudTooltip>
                    }
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Groups"
                               OnClick="ShowMembersAsync">
                        Member capacity
                    </MudButton>
                    <MudChip T="string" Size="Size.Small" Color="@WindowChipColor" Variant="Variant.Outlined">
                        Window: @_result.WindowMode @WindowRangeText
                    </MudChip>
                </div>
            </MudPaper>

            <MudGrid Spacing="2" Class="mb-3">
                @if (BuildStackRows() is { Count: > 0 } resourceRows)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-3 rounded-lg" Style="border:1px solid var(--mud-palette-lines-default); height:100%">
                            <div class="d-flex align-center mb-2">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Resource capacity</MudText>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Assessment"
                                           OnClick="ShowMemberAllocationAsync">
                                    Member allocation
                                </MudButton>
                            </div>
                            <div style="overflow-x:auto">
                                <table class="stack-capacity-table">
                                    <thead>
                                        <tr>
                                            <th>Stack</th>
                                            <th title="Effective member-days of the members in this exact stack combination.">Capacity</th>
                                            <th title="Days of these members already booked (on any feature, across every stack they belong to).">Allocated</th>
                                            <th title="Free days of these members (Capacity − Allocated). 0 when they are all fully booked.">Remaining</th>
                                            <th>Members</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in resourceRows)
                                        {
                                            var remaining = row.Capacity - row.Allocated;
                                            <tr @key="row.Key" class="@(row.IsNoStack ? "no-stack-row" : "")">
                                                <td>
                                                    @if (row.IsNoStack)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small"
                                                                 Color="Color.Warning" Style="vertical-align:-5px" />
                                                    }
                                                    <span class="@(row.IsNoStack ? "" : "font-weight-bold")">@row.Name</span>
                                                </td>
                                                <td>@row.Capacity.ToString("0.##")</td>
                                                <td>@row.Allocated.ToString("0.##")</td>
                                                <td style="@(remaining < 0m ? "color:var(--mud-palette-error)" : "")">@remaining.ToString("0.##")</td>
                                                <td>@row.MemberCount</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="total-row">
                                            <td title="Team's overall capacity — the sum of all rows above (each member counted once).">Total capacity</td>
                                            <td>@_result.TotalCapacity.ToString("0.##")</td>
                                            <td>@TotalAllocatedDays.ToString("0.##")</td>
                                            <td>@(((decimal)_result.TotalCapacity - TotalAllocatedDays).ToString("0.##"))</td>
                                            <td>@_result.Members.Count</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </MudPaper>
                    </MudItem>
                }

                @if (BuildDemandRows() is { Count: > 0 } demandRows)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-3 rounded-lg" Style="border:1px solid var(--mud-palette-lines-default); height:100%">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Demand capacity</MudText>
                            <div style="overflow-x:auto">
                                <table class="stack-capacity-table">
                                    <thead>
                                        <tr>
                                            <th>Stack</th>
                                            <th title="Story points the above-the-line features ask of this stack.">Demand</th>
                                            <th title="Story points reserved against this stack, capped by member availability.">Allocated</th>
                                            <th title="Demand minus Allocated — unmet demand (green = covered, amber = partial, red = none).">Remaining</th>
                                            <th title="Story points demanded by below-the-line (excluded) features.">Below the line</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in demandRows)
                                        {
                                            <tr @key="row.StackId">
                                                <td><span class="font-weight-bold">@row.Name</span></td>
                                                <td>@row.Demand.ToString("0.##")</td>
                                                <td>@row.Allocated.ToString("0.##")</td>
                                                <td style="color:@DemandRemainingColor(row.Demand, row.Allocated)">@row.Remaining.ToString("0.##")</td>
                                                <td>@row.BelowLine.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="total-row">
                                            <td>Total</td>
                                            <td>@(demandRows.Sum(r => r.Demand).ToString("0.##"))</td>
                                            <td>@(demandRows.Sum(r => r.Allocated).ToString("0.##"))</td>
                                            <td style="color:@DemandRemainingColor(demandRows)">@((demandRows.Sum(r => r.Demand) - demandRows.Sum(r => r.Allocated)).ToString("0.##"))</td>
                                            <td>@(demandRows.Sum(r => r.BelowLine).ToString("0.##"))</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            @if (FeaturesByLabelCount > 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @FeaturesByPiCount feature(s) linked by PI, @FeaturesByLabelCount by label.
                </MudAlert>
            }

            @if (_filter.IsActive)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    A filter is hiding some issues, so drag-and-drop reordering is off — clear the filter to reorder.
                    Moving issues above or below the line still works.
                </MudAlert>
            }

            <FeatureCardFilterPanel Title="Above the line" Features="_features"
                                    Filter="_filter" FilterChanged="StateHasChanged"
                                    ShowHygiene="true">
                <Actions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               EndIcon="@(_detailsOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               OnClick="() => _detailsOpen = !_detailsOpen">
                        Details
                    </MudButton>
                </Actions>
            </FeatureCardFilterPanel>

            <MudCollapse Expanded="_detailsOpen">
                <MudPaper Elevation="0" Class="pa-3 rounded-lg mb-2" Style="border:1px solid var(--mud-palette-lines-default)">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Show on each card</MudText>
                    <MudGrid Spacing="1">
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showStatus" ValueChanged="OnShowStatusChanged" Label="Status" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showHygiene" ValueChanged="OnShowHygieneChanged" Label="@PlanningDisplayNames.Hygiene" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showTeams" ValueChanged="OnShowTeamsChanged" Label="Teams" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showLabels" ValueChanged="OnShowLabelsChanged" Label="Labels" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showRequirementStatus" ValueChanged="OnShowRequirementStatusChanged" Label="Requirement Status" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showTechnicalApproval" ValueChanged="OnShowTechnicalApprovalChanged" Label="Design Approval" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showSummary" ValueChanged="OnShowSummaryChanged" Label="Summary" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showTargetStart" ValueChanged="OnShowTargetStartChanged" Label="Target Start" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showTargetEnd" ValueChanged="OnShowTargetEndChanged" Label="Target End" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showAcceptanceCriteria" ValueChanged="OnShowAcceptanceCriteriaChanged" Label="Acceptance Criteria" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showRagExplain" ValueChanged="OnShowRagExplainChanged" Label="RAG Explain" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showDependencies" ValueChanged="OnShowDependenciesChanged" Label="Dependencies" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showExternalDependencies" ValueChanged="OnShowExternalDependenciesChanged" Label="External Dependencies" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showPiObjective" ValueChanged="OnShowPiObjectiveChanged" Label="PI Objective" Color="Color.Primary" Dense /></MudItem>
                        <MudItem xs="6" sm="4" md="3"><MudSwitch T="bool" Value="_showPi" ValueChanged="OnShowPiChanged" Label="PI" Color="Color.Primary" Dense /></MudItem>
                    </MudGrid>
                </MudPaper>
            </MudCollapse>
            <div class="team-capacity-list" data-pi-id="@_selectedPiId">
                @{
                    var allIncluded = _features.Where(f => f.IsIncluded).ToList();
                    var includedRank = RankMap(allIncluded);
                    var includedFeatures = _filter.Apply(allIncluded);
                }
                @if (includedFeatures.Count == 0)
                {
                    <MudText Class="pa-3 mud-text-secondary">
                        @(_features.Count == 0
                            ? "No features assigned to this team for the selected PI."
                            : _filter.IsActive
                                ? "No issues above the line match the current filter."
                                : "All issues are below the line.")
                    </MudText>
                }
                else
                {
                    @foreach (var f in includedFeatures)
                    {
                        var alloc = _allocations.GetValueOrDefault(f.FeatureId);
                        @FeatureCard(f, true, alloc, AllocClass(alloc), includedRank.GetValueOrDefault(f.FeatureId))
                    }
                }
            </div>

            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mt-4 mb-1">Below the line</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1 d-block">
                Issues here do not participate in the capacity calculation.
            </MudText>
            <div class="team-capacity-list below-the-line" data-pi-id="@_selectedPiId">
                @{
                    var allExcluded = _features.Where(f => !f.IsIncluded).ToList();
                    var excludedRank = RankMap(allExcluded);
                    var excludedFeatures = _filter.Apply(allExcluded);
                }
                @if (excludedFeatures.Count == 0)
                {
                    <MudText Class="pa-3 mud-text-secondary">
                        @(_filter.IsActive
                            ? "No issues below the line match the current filter."
                            : "No issues below the line.")
                    </MudText>
                }
                else
                {
                    @foreach (var f in excludedFeatures)
                    {
                        @FeatureCard(f, false, null, "", excludedRank.GetValueOrDefault(f.FeatureId))
                    }
                }
            </div>
        }
    </MudPaper>
</div>

<style>
    .team-capacity-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 8px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-background-grey);
        min-height: 100px;
    }

    .team-capacity-list.stack-drag-over {
        background: var(--mud-palette-action-default-hover);
        outline: 2px dashed var(--mud-palette-primary);
        outline-offset: -4px;
        border-radius: 4px;
    }

    .team-capacity-card {
        position: relative;
        padding: 10px 12px 10px 16px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-surface);
        cursor: grab;
        transition: box-shadow 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
        user-select: none;
    }

    .team-capacity-order {
        position: absolute;
        top: 6px;
        left: 8px;
        min-width: 22px;
        padding: 1px 6px;
        border-radius: 10px;
        background: var(--mud-palette-action-default-hover);
        color: var(--mud-palette-text-secondary);
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.5;
        text-align: center;
        user-select: none;
    }

    .team-capacity-card:hover {
        box-shadow: var(--mud-elevation-2);
    }

    .team-capacity-card.readonly {
        cursor: default;
    }

    .team-capacity-card.dragging {
        opacity: 0.4;
    }

    .team-capacity-card.drag-over {
        border-color: var(--mud-palette-primary);
        box-shadow: 0 0 0 2px var(--mud-palette-primary);
    }

    .team-capacity-card.below-line {
        background: #ffd5d5;
        border-color: #f1a9a9;
    }

    .team-capacity-card.capacity-ok {
        border-bottom: 3px solid var(--mud-palette-success);
        border-left: 4px solid var(--mud-palette-success);
    }

    .team-capacity-card.capacity-partial {
        border-bottom: 3px solid var(--mud-palette-warning);
        border-left: 4px solid var(--mud-palette-warning);
    }

    .team-capacity-card.capacity-fail {
        border-bottom: 3px solid var(--mud-palette-error);
        border-left: 4px solid var(--mud-palette-error);
    }

    .team-capacity-card.capacity-warning {
        border-left: 4px dashed var(--mud-palette-warning);
    }

    .stack-capacity-table {
        width: 100%;
        border-collapse: collapse;
    }

    .stack-capacity-table th,
    .stack-capacity-table td {
        padding: 6px 10px;
        font-size: 0.85rem;
        text-align: right;
        white-space: nowrap;
    }

    .stack-capacity-table th:first-child,
    .stack-capacity-table td:first-child {
        text-align: left;
        white-space: normal;
    }

    .stack-capacity-table thead th {
        color: var(--mud-palette-text-secondary);
        font-weight: 600;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .stack-capacity-table tbody td {
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .stack-capacity-table tbody tr:last-child td {
        border-bottom: none;
    }

    .stack-capacity-table tbody tr.no-stack-row td {
        background: rgba(var(--mud-palette-warning-rgb), 0.12);
        color: var(--mud-palette-warning);
    }

    .stack-capacity-table tfoot td {
        font-weight: 600;
        border-top: 2px solid var(--mud-palette-lines-default);
    }
</style>

@code {
    private RenderFragment FeatureCard(TeamCapacityFeatureRow f, bool included, FeatureAllocVm? alloc, string capacityClass, int orderNumber) =>
        @<div class="team-capacity-card @(included ? capacityClass : "below-line") @(CanReorder ? "" : "readonly")"
              @key="f.FeatureId"
              data-feature-id="@f.FeatureId"
              draggable="@(CanReorder ? "true" : "false")">
            <span class="team-capacity-order">@orderNumber</span>
            <div class="d-flex align-center gap-3" style="width:100%">
                @if (CanReorder)
                {
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                             Size="Size.Small"
                             Class="mud-text-secondary" Style="cursor:grab" />
                }
                <MudCheckBox T="bool"
                             Value="f.IsIncluded"
                             ValueChanged="@((bool v) => ToggleIncludedAsync(f, v))"
                             ReadOnly="@(!CanEditCapacity)"
                             Color="Color.Primary"
                             Dense />
                <div class="flex-grow-1" style="min-width:0">
                    <div class="d-flex align-center gap-2 mb-1">
                        <span style="min-width:55px; display:inline-block">Feature:</span>
                        @if (!string.IsNullOrEmpty(f.JiraId))
                        {
                            <a href="@(_jiraTaskUrl + f.JiraId)" target="_blank" style="text-decoration:none" @onclick:stopPropagation>
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Style="cursor:pointer">
                                    @f.JiraId
                                </MudChip>
                            </a>
                        }
                        <MudText Typo="Typo.body2">@f.Name</MudText>
                        @if (!string.IsNullOrWhiteSpace(f.Name))
