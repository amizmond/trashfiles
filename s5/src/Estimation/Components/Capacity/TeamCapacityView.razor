                            <span style="min-width:55px; display:inline-block">RAG:</span>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@f.RagExplain</MudText>
                        </div>
                    }
                    @if (_showLabels && !string.IsNullOrWhiteSpace(f.Labels))
