        };
        var options = new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.Medium, FullWidth = true };
        await ModalDialogService.Component<TeamCapacityMembersDialog>(
            $"{_team?.Name} — Member capacity", parameters, options);
    }

    private async Task ShowMemberAllocationAsync()
    {
        if (_result is null)
        {
            return;
        }
        var parameters = new Dictionary<string, object?>
        {
            { nameof(TeamMemberAllocationDialog.Members), BuildMemberAllocations() },
        };
        var options = new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.Large, FullWidth = true };
        await ModalDialogService.Component<TeamMemberAllocationDialog>(
            $"{_team?.Name} — Member allocation", parameters, options);
    }

    private List<MemberCapacityDetailVm> BuildMemberAllocations()
    {
        var result = new List<MemberCapacityDetailVm>();
        if (_result is null)
        {
            return result;
        }

        var featureById = _features.ToDictionary(f => f.FeatureId);
        var allocatedByMember = new Dictionary<int, decimal>();
        var linesByMember = new Dictionary<int, List<MemberAllocationLine>>();

        foreach (var (featureId, alloc) in _allocations)
        {
            foreach (var skill in alloc.Skills)
            {
                foreach (var mem in skill.Members)
                {
                    if (mem.AllocatedDays <= 0m)
                    {
                        continue;
                    }
                    allocatedByMember[mem.HumanResourceId] =
                        allocatedByMember.GetValueOrDefault(mem.HumanResourceId) + mem.AllocatedDays;
                    if (!linesByMember.TryGetValue(mem.HumanResourceId, out var lines))
                    {
                        lines = new List<MemberAllocationLine>();
                        linesByMember[mem.HumanResourceId] = lines;
                    }
                    var f = featureById.GetValueOrDefault(featureId);
                    lines.Add(new MemberAllocationLine
                    {
                        StackName = skill.Label,
                        FeatureName = f?.Name ?? string.Empty,
                        JiraId = f?.JiraId,
                        Days = mem.AllocatedDays,
                    });
                }
            }
        }

        foreach (var m in _result.Members)
        {
            var lines = linesByMember.GetValueOrDefault(m.HumanResourceId) ?? new List<MemberAllocationLine>();
            result.Add(new MemberCapacityDetailVm
            {
                HumanResourceId = m.HumanResourceId,
                Name = m.FullName,
                Role = m.RoleName,
                Capacity = (decimal)m.EffectiveDays,
                Allocated = allocatedByMember.GetValueOrDefault(m.HumanResourceId),
                Lines = lines.OrderBy(l => l.StackName).ThenBy(l => l.FeatureName).ToList(),
            });
        }
        return result;
    }
}
