    private async Task RemoveFeatureAsync(TeamCapacityFeatureRow f)
    {
        if (!CanRemoveFeature(f))
        {
            return;
        }

        var name = string.IsNullOrWhiteSpace(f.Name) ? "(no name)" : f.Name;
        var label = string.IsNullOrEmpty(f.JiraId) ? name : $"{f.JiraId} — {name}";
        var confirmed = await ModalDialogService.Confirm(
            $"Remove \"{label}\" from Team Capacity? It does not belong to the selected PI. The change applies after you Save.",
            "Remove feature",
            "Remove");
        if (!confirmed)
        {
            return;
        }

        var index = _features.FindIndex(x => x.FeatureId == f.FeatureId);
        if (index < 0)
        {
            return;
        }
        _features.RemoveAt(index);
        _hasUnsavedChanges = true;
        RecomputeAllocations();
        Snackbar.Add("Feature removed. Remember to Save.", Severity.Success);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnJsDragStart(int featureId, int sourcePiId)
    {
        if (!CanReorder)
        {
            return;
        }
        _dragSourceId = featureId;
    }

    [JSInvokable]
    public Task OnJsDrop(int targetFeatureId, int targetPiId)
    {
        if (!CanReorder || !_dragSourceId.HasValue || _moveInProgress)
        {
            return Task.CompletedTask;
        }
        _moveInProgress = true;
        try
        {
            var sourceId = _dragSourceId.Value;
            _dragSourceId = null;

            var sourceIndex = _features.FindIndex(f => f.FeatureId == sourceId);
            if (sourceIndex < 0)
            {
                return Task.CompletedTask;
            }

            int targetIndex;
            if (targetFeatureId == -1)
            {
                targetIndex = _features.Count - 1;
            }
            else if (targetFeatureId == sourceId)
            {
                return Task.CompletedTask;
            }
            else
            {
                targetIndex = _features.FindIndex(f => f.FeatureId == targetFeatureId);
                if (targetIndex < 0)
                {
                    return Task.CompletedTask;
                }
            }

            var item = _features[sourceIndex];
            _features.RemoveAt(sourceIndex);
            if (targetIndex > _features.Count)
            {
                targetIndex = _features.Count;
            }
            _features.Insert(targetIndex, item);
            _hasUnsavedChanges = true;
            RecomputeAllocations();
            StateHasChanged();
        }
        finally
        {
            _moveInProgress = false;
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public void OnJsDragEnd()
    {
        _dragSourceId = null;
    }

    private async Task SaveAsync()
    {
        if (!CanEditCapacity || _selectedPiId is null)
        {
            return;
        }
        _saving = true;
        try
        {
            var rows = _features
                .Select((f, i) => new TeamCapacityOrderRow(f.FeatureId, i + 1, f.IsIncluded, f.IsManuallyAdded))
                .ToList();
            await CapacityService.SaveOrderAsync(TeamId, _selectedPiId.Value, rows);

            if (_applyToAllTeams.Count > 0)
            {
                var inclusion = _features
                    .Where(f => _applyToAllTeams.Contains(f.FeatureId))
                    .ToDictionary(f => f.FeatureId, f => f.IsIncluded);
                await CapacityService.PropagateInclusionToOtherTeamsAsync(TeamId, _selectedPiId.Value, inclusion);
                _otherTeamLines = await CapacityService.GetFeatureOtherTeamLinesAsync(
                    TeamId, _selectedPiId.Value, _features.Select(f => f.FeatureId).ToList());
                _applyToAllTeams.Clear();
            }

            _features = _features
                .Select((f, i) => f with { SortOrder = i + 1, IsSaved = true })
                .ToList();
            _hasUnsavedChanges = false;
            _wasEverSaved = true;
            _hasNewFeatures = false;
            Snackbar.Add("Saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to save team capacity order");
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResaveDriftAsync()
    {
        if (!CanEditCapacity || _selectedPiId is null || _result is null || _result.Drifts.Count == 0)
        {
            return;
        }
        _saving = true;
        try
        {
            var driftFeatureIds = _result.Drifts.Select(d => d.FeatureId).ToList();
            var rows = _features
                .Select((f, i) => new TeamCapacityOrderRow(f.FeatureId, i + 1, f.IsIncluded, f.IsManuallyAdded))
                .ToList();
            await CapacityService.SaveOrderAsync(TeamId, _selectedPiId.Value, rows, driftFeatureIds);
            _hasUnsavedChanges = false;
            Snackbar.Add("Saved. The added features now reflect their current PI.", Severity.Success);
            await LoadAsync(_selectedPiId.Value);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to resave team capacity drift");
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

