    private static string DemandRemainingColor(decimal demand, decimal allocated)
    {
        if (demand - allocated <= 0m)
        {
            return "var(--mud-palette-success)";
        }
        if (allocated > 0m)
        {
            return "var(--mud-palette-warning)";
        }
        return "var(--mud-palette-error)";
    }

    private static string DemandRemainingColor(IEnumerable<DemandRowVm> rows) =>
        DemandRemainingColor(rows.Sum(r => r.Demand), rows.Sum(r => r.Allocated));

    private Dictionary<int, decimal> AllocatedDaysByMember()
    {
        var map = new Dictionary<int, decimal>();
        foreach (var mem in _allocations.Values.SelectMany(a => a.Skills).SelectMany(s => s.Members))
        {
            if (mem.AllocatedDays <= 0m)
            {
                continue;
            }
            map[mem.HumanResourceId] = map.GetValueOrDefault(mem.HumanResourceId) + mem.AllocatedDays;
        }
        return map;
    }

    private decimal TotalAllocatedDays => _allocations.Values.Sum(a => a.Reserved);

    private record StackRowVm(
        string Key, string Name, decimal Capacity, decimal Allocated, int MemberCount, bool IsNoStack);

    private List<StackRowVm> BuildStackRows()
    {
        var list = new List<StackRowVm>();
        if (_result is null)
        {
            return list;
        }

        var owned = _ownedStackIds;
        var nameById = _result.StackCapacities.ToDictionary(s => s.TechnologyStackId, s => s.StackName);
        var allocByMember = AllocatedDaysByMember();
        string ComboName(List<int> ids) => string.Join(" / ", ids.Select(id => nameById.GetValueOrDefault(id, "?")));

        var acc = new Dictionary<string, (List<int> Ids, decimal Capacity, decimal Allocated, int Count)>();
        foreach (var m in _result.MemberMeta)
        {
            var ids = m.StackIds.Where(owned.Contains)
                .OrderBy(id => nameById.GetValueOrDefault(id, string.Empty)).ThenBy(id => id).ToList();
            var key = ids.Count == 0 ? string.Empty : string.Join("|", ids);
            var cur = acc.GetValueOrDefault(key, (Ids: ids, Capacity: 0m, Allocated: 0m, Count: 0));
            cur.Capacity += (decimal)m.EffectiveDays;
            cur.Allocated += allocByMember.GetValueOrDefault(m.HumanResourceId);
            cur.Count += 1;
            acc[key] = cur;
        }

        foreach (var kv in acc.Where(k => k.Key.Length > 0)
            .OrderBy(k => k.Value.Ids.Count).ThenBy(k => ComboName(k.Value.Ids)))
        {
            list.Add(new StackRowVm(kv.Key, ComboName(kv.Value.Ids), kv.Value.Capacity, kv.Value.Allocated, kv.Value.Count, false));
        }
        if (acc.TryGetValue(string.Empty, out var ns) && ns.Count > 0)
        {
            list.Add(new StackRowVm("__nostack__", "No stack", ns.Capacity, ns.Allocated, ns.Count, true));
        }
        return list;
    }

    private record DemandRowVm(
        int StackId, string Name, decimal Demand, decimal Allocated, decimal Remaining, decimal BelowLine);

    private List<DemandRowVm> BuildDemandRows()
    {
        var rows = new List<DemandRowVm>();
        if (_result is null)
        {
            return rows;
        }

        var names = new Dictionary<int, string>();
        foreach (var s in _allocations.Values.SelectMany(a => a.Skills))
        {
            names[s.StackId] = s.Label;
        }

        var belowByStack = new Dictionary<int, decimal>();
        foreach (var f in _features.Where(x => !x.IsIncluded))
        {
            var demand = _result.Demands.GetValueOrDefault(f.FeatureId);
            if (demand is null)
            {
                continue;
            }
            foreach (var s in demand.Stacks)
            {
                var sp = (decimal)(s.StoryPoints ?? 0);
                if (sp <= 0m)
                {
                    continue;
                }
                names.TryAdd(s.TechnologyStackId, s.StackName);
                belowByStack[s.TechnologyStackId] = belowByStack.GetValueOrDefault(s.TechnologyStackId) + sp;
            }
        }

        foreach (var (stackId, name) in names.OrderBy(kv => kv.Value))
        {
            var demand = StackDemand(stackId);
            var allocated = StackUsed(stackId);
            rows.Add(new DemandRowVm(
                stackId, name, demand, allocated, demand - allocated,
                belowByStack.GetValueOrDefault(stackId)));
        }
        return rows;
    }

    private void RecomputeAllocations()
    {
        _allocations = new Dictionary<int, FeatureAllocVm>();
        if (_result is null)
        {
            return;
        }

        var included = _features.Where(x => x.IsIncluded).Select(f => f.FeatureId).ToList();
        var allocations = TeamBoardAllocator.Allocate(included, _result.Demands, _result.MemberMeta);
        foreach (var featureId in included)
        {
            _allocations[featureId] = ToAllocationVm(allocations[featureId]);
        }
    }

    private static FeatureAllocVm ToAllocationVm(TeamBoardFeatureAllocation a) => new()
    {
        FeatureId = a.FeatureId,
        IsValid = a.IsValid,
        Required = a.Required,
        Reserved = a.Reserved,
        IsFullyReserved = a.IsFullyReserved,
        Skills = a.Stacks
            .Select(s => new SkillAllocVm
            {
                StackId = s.TechnologyStackId,
                Label = s.StackName,
                Required = s.Required,
                Reserved = s.Reserved,
                Members = s.Members
                    .Select(m => new MemberAllocVm
                    {
                        HumanResourceId = m.HumanResourceId,
                        Name = m.FullName,
                        AllocatedDays = m.Days,
                    })
                    .ToList(),
            })
            .ToList(),
    };

