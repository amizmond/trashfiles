    private void AddFoundFeatures(List<FeatureFindRow> selected)
    {
        var existingIds = _features.Select(f => f.FeatureId).ToHashSet();
        var nextSort = _features.Count == 0 ? 1 : _features.Max(f => f.SortOrder) + 1;
        var added = 0;
        foreach (var row in selected)
        {
            if (existingIds.Contains(row.FeatureId))
            {
                continue;
            }
            _features.Add(new TeamCapacityFeatureRow(
                row.FeatureId,
                row.JiraId,
                row.Name,
                null,
                null,
                row.Effort,
                true,
                nextSort++,
                true,
                row.PiId,
                row.PiName,
                Status: row.Status));
            existingIds.Add(row.FeatureId);
            added++;
        }

        if (added > 0)
        {
            _hasUnsavedChanges = true;
            RecomputeAllocations();
            Snackbar.Add($"Added {added} feature(s). Remember to Save.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Selected feature(s) are already in the list.", Severity.Info);
        }
    }

    private static string AllocClass(FeatureAllocVm? a)
    {
        if (a is null)
        {
            return "";
        }
        if (!a.IsValid)
        {
            return "capacity-warning";
        }
        if (a.Required <= 0m)
        {
            return "";
        }
        if (a.IsFullyReserved)
        {
            return "capacity-ok";
        }
        return a.Reserved > 0m ? "capacity-partial" : "capacity-fail";
    }

    private decimal StackUsed(int stackId) =>
        _allocations.Values.SelectMany(a => a.Skills).Where(s => s.StackId == stackId).Sum(s => s.Reserved);

    private decimal StackDemand(int stackId) =>
        _allocations.Values.SelectMany(a => a.Skills).Where(s => s.StackId == stackId).Sum(s => s.Required);

    private int OwnedStackCount(TeamMemberMeta m) => m.StackIds.Count(_ownedStackIds.Contains);

    private List<TeamMemberMeta> NoStackMembers =>
        _result?.MemberMeta.Where(m => OwnedStackCount(m) == 0).ToList() ?? new();
    private int NoStackMemberCount => NoStackMembers.Count;
    private double NoStackCapacity => NoStackMembers.Sum(m => m.EffectiveDays);

