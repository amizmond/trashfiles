    private Dictionary<string, AccessLevel> UserPageAccess { get; set; } = new();

    [CascadingParameter(Name = "IsAdmin")]
    private bool IsAdmin { get; set; }

    private bool _canEdit;

    private bool _canEditLockedPi;

    private bool SelectedPiLocked => _allPis.FirstOrDefault(p => p.Id == _selectedPiId)?.IsLocked == true;
    private bool CanEditCapacity => _canEdit && (!SelectedPiLocked || _canEditLockedPi);

    private bool CanReorder => CanEditCapacity && !_filter.IsActive;

    private static Dictionary<int, int> RankMap(List<TeamCapacityFeatureRow> rows) =>
        rows.Select((f, index) => (f.FeatureId, Rank: index + 1))
            .ToDictionary(x => x.FeatureId, x => x.Rank);

