    private string WindowRangeText
    {
        get
        {
            if (_result?.WindowStart is null || _result?.WindowEnd is null)
            {
                return "";
            }
            return $"({_result.WindowStart:dd MMM yyyy} – {_result.WindowEnd:dd MMM yyyy})";
        }
    }

    private MudBlazor.Color WindowChipColor => _result?.WindowMode switch
    {
        "Sprints" => MudBlazor.Color.Success,
        "PI" => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Error,
    };

    private MudBlazor.Color UsedChipColor
    {
        get
        {
            if (_result is null)
            {
                return MudBlazor.Color.Default;
            }
            var used = ConsumedEffort;
            if (_result.TotalCapacity <= 0)
            {
                return MudBlazor.Color.Default;
            }
            return used > _result.TotalCapacity ? MudBlazor.Color.Error : MudBlazor.Color.Success;
        }
    }

    private int ConsumedEffort => _features.Where(f => f.IsIncluded).Sum(f => f.Effort);

    private int FeaturesByPiCount => _features.Count(f => f.FeaturePiId == _selectedPiId);
    private int FeaturesByLabelCount => _features.Count(f => f.MatchedByLabel);

    private string _consumedDisplay => ConsumedEffort.ToString();
    private string _remainingDisplay
    {
        get
        {
            if (_result is null)
            {
                return "—";
            }
            var remaining = _result.TotalCapacity - ConsumedEffort;
            return FormatDays(remaining);
        }
    }

    private static string FormatDays(double v) => v.ToString("F1");

    protected override void OnInitialized()
    {
        _canEdit = CanEditOverride ?? (UserPageAccess.TryGetValue(PageKey, out var access) && access == AccessLevel.Edit);

        _canEditLockedPi = IsAdmin;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var teamTask = TeamService.GetByIdAsync(TeamId);
        var pisTask = PiService.GetAllLightAsync();
        await Task.WhenAll(teamTask, pisTask);
        _team = teamTask.Result;
        _allPis = pisTask.Result;
        _jiraTaskUrl = Configuration["JiraTaskUrl"];

        if (_team is null || _piRestored)
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/piDragDrop.js");
            await _jsModule.InvokeVoidAsync("init", _dotNetRef);
            _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);

            _currentUserName = await WindowsAuth.GetUserName();
            if (!_canEditLockedPi && _currentUserName is not null)
            {
                var permissions = await UserPermissions.GetPermissionSetAsync(_currentUserName);
                _canEditLockedPi = permissions.IsActionAvailable(AppActionKeys.EditLockedPi);
            }

            await RestoreDetailTogglesAsync();

            await RestoreSelectedPiAsync();
        }
    }

    private async Task RestoreSelectedPiAsync()
    {
        if (_piRestored)
        {
            return;
        }
        _piRestored = true;
        if (_team is null)
        {
            return;
        }

        int? storedPiId = null;
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", SelectedPiStorageKey);
            if (int.TryParse(raw, out var id))
            {
                storedPiId = id;
            }
        }
        catch
        {
        }

        var resolved = storedPiId is not null && _allPis.Any(p => p.Id == storedPiId)
            ? storedPiId
            : _allPis.FirstOrDefault()?.Id;

        _selectedPiId = resolved;
        _loading = false;
        if (resolved is not null)
        {
            await LoadAsync(resolved.Value);
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _locationChangingRegistration?.Dispose();
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("dispose");
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!_hasUnsavedChanges)
        {
            return;
        }
        var confirmed = await ModalDialogService.Confirm(
            "You have unsaved changes. Do you want to leave without saving?",
            "Unsaved Changes",
            "Leave");
        if (!confirmed)
        {
            context.PreventNavigation();
        }
    }

    private async Task OnPiChangedAsync(int? piId)
    {
        if (piId == _selectedPiId)
        {
            return;
        }
        if (_hasUnsavedChanges)
        {
            var confirmed = await ModalDialogService.Confirm(
                "Changing the PI will discard unsaved changes. Continue?",
                "Unsaved Changes",
                "Discard");
            if (!confirmed)
            {
                return;
            }
        }
        _selectedPiId = piId;
        _hasUnsavedChanges = false;
        await PersistSelectedPiAsync();
        if (piId is null)
        {
            _result = null;
            _features = new();
            _otherTeamLines = new();
            _applyToAllTeams.Clear();
            _commentCounts = new();
            return;
        }
        await LoadAsync(piId.Value);
    }

    private async Task OnIncludeIpSprintsChangedAsync(bool value)
    {
        if (value == _includeIpSprints)
        {
            return;
        }
        if (_hasUnsavedChanges)
        {
            var confirmed = await ModalDialogService.Confirm(
                "Changing this option reloads the data and will discard unsaved changes. Continue?",
                "Unsaved Changes",
                "Discard");
            if (!confirmed)
            {
                return;
            }
        }
        _includeIpSprints = value;
        _hasUnsavedChanges = false;
        if (_selectedPiId is not null)
        {
            await LoadAsync(_selectedPiId.Value);
        }
    }

    private async Task PersistSelectedPiAsync()
    {
        try
        {
            if (_selectedPiId is null)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", SelectedPiStorageKey);
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.setItem", SelectedPiStorageKey, _selectedPiId.Value.ToString());
            }
        }
        catch
        {
        }
    }

