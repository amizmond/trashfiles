@inject IJiraMetadataService JiraMetadata
@inject IJiraIssueService JiraIssueService
@inject IModalDialogService MessageService
@inject IArtService ArtService
@inject Microsoft.Extensions.Options.IOptions<JiraSettings> JiraConfig

@using Estimation.Core.JiraIntegration.Client
@using Estimation.Core.Resources.Models
@using Estimation.Core.Train.Services

<MudDialog Style="@_dialogStyle" Class="@_dialogClass">
    <TitleContent>
        <div class="d-flex align-center" style="width:100%; gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.Sync" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Find new @(IssueType)s in Jira</MudText>
            <MudSpacer />
            <MudTooltip Text="@(_fullscreen ? "Exit fullscreen" : "Fullscreen")">
                <MudIconButton
                    Icon="@(_fullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                    Size="Size.Small"
                    OnClick="ToggleFullscreen" />
            </MudTooltip>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense>
                    This dialog searches Jira for @(IssueType) issues that are not yet in the database
                    and imports the ones you select as new records. Issues that already exist in the
                    database are hidden from the results and are never updated here.
                </MudAlert>
            </MudItem>

            <MudItem xs="6">
                <MudSelect T="ProjectOption" Value="_selectedProject" ValueChanged="OnProjectChanged"
                           Label="Jira Project"
                           Variant="Variant.Outlined" Required Dense
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var p in Projects)
                    {
                        <MudSelectItem T="ProjectOption" Value="p">@p.KeysText — @p.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="6">
                <MudTextField T="string" Value="@IssueType" Label="Issue Type"
                              Variant="Variant.Outlined" ReadOnly Dense />
            </MudItem>

            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_jiraIdsText"
                              Label="Jira IDs (optional)"
                              Placeholder="e.g. PROJ-123, PROJ-456"
                              HelperText="Comma- or space-separated. When provided, the filters below are ignored."
                              Variant="Variant.Outlined" Dense Clearable />
            </MudItem>

            <MudItem xs="9">
                @if (_labelsLoading)
                {
                    <MudField Label="Labels" Variant="Variant.Outlined">
                        <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Primary" Class="mr-2" />
                        Loading labels...
                    </MudField>
                }
                else
                {
                    <SearchableDropdown T="string"
                                        Items="_availableLabelNames"
                                        Values="_selectedLabels"
                                        ValuesChanged="@(v => _selectedLabels = v)"
                                        MultiSelect="true"
                                        Label="Labels"
                                        Disabled="_selectedProject is null"
                                        Style="width:100%" />
                }
            </MudItem>
            <MudItem xs="3">
                <MudSelect T="LabelMatchMode" @bind-Value="_labelMatchMode" Label="Match"
                           Variant="Variant.Outlined" Dense>
                    <MudSelectItem T="LabelMatchMode" Value="LabelMatchMode.Any">Any</MudSelectItem>
                    <MudSelectItem T="LabelMatchMode" Value="LabelMatchMode.All">All</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="9">
                @if (_statusesLoading)
                {
                    <MudField Label="Status" Variant="Variant.Outlined">
                        <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Primary" Class="mr-2" />
                        Loading statuses...
                    </MudField>
                }
                else
                {
                    <MudSelect T="string" Label="Status" MultiSelection @bind-SelectedValues="_selectedStatuses"
                               Variant="Variant.Outlined" Dense Clearable Disabled="_selectedProject is null"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var status in _availableStatuses)
                        {
                            <MudSelectItem T="string" Value="@status.Name">@status.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            </MudItem>
            <MudItem xs="3" Class="d-flex align-end">
                <MudCheckBox T="bool" @bind-Value="_excludeStatuses" Label="NOT"
                             Dense Color="Color.Warning" />
            </MudItem>

            @if (IssueType == JiraIssueTypes.Feature)
            {
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="_selectedPi" Label="Planning Increment"
                               Variant="Variant.Outlined" Dense Clearable
                               Disabled="_selectedProject is null"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var pi in AvailablePiNames)
                        {
                            <MudSelectItem T="string" Value="@pi">@pi</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <MudItem xs="6">
                <MudDatePicker @bind-Date="_updatedFrom" Label="Updated From"
                               Variant="Variant.Outlined" Dense Clearable
                               Disabled="_selectedProject is null"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           Disabled="_selectedProject is null || _searching"
                           OnClick="SearchAsync">
                    @if (_searching)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Default" Class="mr-2" />
                        @:Searching...
                    }
                    else
                    {
                        @:Search
                    }
                </MudButton>
            </MudItem>

            @if (_searchExecuted)
            {
                <MudItem xs="12">
                    <div class="d-flex align-center mb-2" style="gap:12px; flex-wrap:wrap;">
                        <MudText Typo="Typo.subtitle2">
                            Found @_searchResults.Count new issue(s)
                        </MudText>
                        @if (_selectedIssues.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                @_selectedIssues.Count selected
                            </MudChip>
                        }
                    </div>

                    @if (_alreadyInDbCount > 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-2" Dense>
                            @_alreadyInDbCount issue(s) returned by the search already exist in the database and are hidden.
                        </MudAlert>
                    }

                    @if (OtherArtCount > 0 || NoArtCount > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2" Dense>
                            @if (OtherArtCount > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    @OtherArtCount issue(s) belong to another ART by their components and labels; once
                                    imported they are shown under that ART.
                                </MudText>
                            }
                            @if (NoArtCount > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    @NoArtCount issue(s) belong to no ART by their components and labels; once imported
                                    only admins and users with General access can see them.
                                </MudText>
                            }
                        </MudAlert>
                    }

                    @if (_teamsNotFound.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2" Dense>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                Teams from Jira with no match in DB (will be ignored):
                            </MudText>
                            <MudText Typo="Typo.body2">@string.Join(", ", _teamsNotFound)</MudText>
                        </MudAlert>
                    }

                    @if (_pisToCreate.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2" Dense>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                PIs that don't exist in DB and will be created:
                            </MudText>
                            <MudText Typo="Typo.body2">@string.Join(", ", _pisToCreate)</MudText>
                        </MudAlert>
                    }

                    @if (_showPreview && _searchResults.Count > 0)
                    {
                        <MudDataGrid T="JiraIssueResponse" Items="_searchResults"
                                     MultiSelection="true"
                                     SelectOnRowClick="false"
                                     @bind-SelectedItems="_selectedIssues"
                                     Dense Hover Striped
                                     Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterRow"
                                     Style="@_gridStyle"
                                     Class="jira-sync-grid"
                                     Bordered="true">
                            <Columns>
                                <SelectColumn T="JiraIssueResponse" />
                                <PropertyColumn Property="x => x.Key" Title="Key" />
                                <PropertyColumn Property="x => x.Summary" Title="Summary" />
                                <PropertyColumn Property="x => x.Status" Title="Status" />
                                @if (IsFeature)
                                {
                                    <TemplateColumn Title="ART" Sortable="false">
                                        <CellTemplate>
                                            @{
                                                var match = MatchOf(context.Item);
                                                var name = ArtHelper.DisplayName(match, _artLookup);
                                            }
                                            <MudTooltip Text="@(ArtHelper.Explain(match, _artLookup) ?? string.Empty)">
                                                <MudText Typo="Typo.body2"
                                                         Color="@(IsOtherArt(match) || IsNoArt(match) ? Color.Warning : Color.Default)">
                                                    @(name ?? "—")
                                                </MudText>
                                            </MudTooltip>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Components">
                                        <CellTemplate>
                                            @if (context.Item.Components is { Count: > 0 })
                                            {
                                                @string.Join(", ", context.Item.Components)
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Labels">
                                    <CellTemplate>
                                        @if (context.Item.Labels is { Count: > 0 })
                                        {
                                            @string.Join(", ", context.Item.Labels)
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.PlanningIncrement" Title="PI" />
                                <PropertyColumn Property="x => x.GfedTeam" Title="Teams" />
                                <TemplateColumn Title="Updated">
                                    <CellTemplate>
                                        @(context.Item.Updated?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Target Start">
                                    <CellTemplate>
                                        @(context.Item.TargetStart?.ToString("yyyy-MM-dd") ?? "—")
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Target End">
                                    <CellTemplate>
                                        @(context.Item.TargetEnd?.ToString("yyyy-MM-dd") ?? "—")
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.StoryPoints" Title="Story Points" />
                            </Columns>
                        </MudDataGrid>
                    }
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                   Disabled="@(_selectedIssues.Count == 0)"
                   OnClick="ImportSelected">
            Import selected@(_selectedIssues.Count > 0 ? $" ({_selectedIssues.Count})" : "")
        </MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="!_searchExecuted || _searchResults.Count == 0"
                   OnClick="ImportAll">
            Import all
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .mud-dialog-container:has(.jira-sync-dialog) {
        max-width: calc(100vw - 25px) !important;
        width: calc(100vw - 25px) !important;
    }
    .jira-sync-dialog {
        margin: 15px;
        max-width: calc(100vw - 25px) !important;
        width: calc(100vw - 25px) !important;
    }

    .mud-dialog-container:has(.jira-sync-dialog-fullscreen) {
        max-width: 100vw !important;
        width: 100vw !important;
        max-height: 100vh !important;
        height: 100vh !important;
        margin: 0 !important;
    }
    .jira-sync-dialog-fullscreen {
        max-width: 100vw !important;
        width: 100vw !important;
        max-height: 100vh !important;
        height: 100vh !important;
        margin: 0 !important;
        border-radius: 0 !important;
    }

    .jira-sync-grid .mud-table-cell.filter-header-cell {
        padding: 2px 6px !important;
    }
    .jira-sync-grid .mud-table-cell.filter-header-cell .mud-input-control {
        margin-top: 0 !important;
    }
    .jira-sync-grid .mud-table-cell.filter-header-cell .mud-input-control .mud-input-slot {
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        font-size: 0.8rem !important;
    }
    .jira-sync-grid .mud-table-cell.filter-header-cell .mud-input-control .mud-input-label {
        font-size: 0.8rem !important;
    }
    .jira-sync-grid .mud-table-head .mud-table-cell {
        padding: 6px 10px !important;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public List<ProjectOption> Projects { get; set; } = new();
    [Parameter] public string IssueType { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public List<string> AvailablePiNames { get; set; } = new();
    [Parameter] public List<Team> AvailableTeams { get; set; } = new();
    [Parameter] public HashSet<string> ExistingJiraIds { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private ProjectOption? _selectedProject;
    private IReadOnlyCollection<string> _selectedLabels = Array.Empty<string>();
    private LabelMatchMode _labelMatchMode = LabelMatchMode.Any;
    private IReadOnlyCollection<string> _selectedStatuses = Array.Empty<string>();
    private bool _excludeStatuses;
    private string? _selectedPi;
    private DateTime? _updatedFrom;
    private string _jiraIdsText = string.Empty;

    private List<JiraLabel> _availableLabels = [];
    private IEnumerable<string> _availableLabelNames => _availableLabels.Select(l => l.Name);
    private List<JiraStatus> _availableStatuses = [];
    private bool _labelsLoading;
    private bool _statusesLoading;

    private List<JiraIssueResponse> _searchResults = [];
    private HashSet<JiraIssueResponse> _selectedIssues = new();
    private ArtLookup _artLookup = ArtLookup.Empty;
    private bool _artLookupLoaded;
    private Dictionary<string, ArtMatch> _matchByKey = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _teamsNotFound = new();
    private List<string> _pisToCreate = new();
    private int _alreadyInDbCount;
    private bool _searching;
    private bool _searchExecuted;
    private bool _showPreview;
    private bool _fullscreen;

    private string _dialogClass => _fullscreen ? "jira-sync-dialog jira-sync-dialog-fullscreen" : "jira-sync-dialog";

    private string _dialogStyle => _fullscreen ? "" : "max-width: calc(100vw - 25px); width: calc(100vw - 25px);";

    private string _gridStyle => _fullscreen
        ? "height: calc(100vh - 420px); overflow-y:auto;"
        : "max-height: 60vh; min-height: 360px; overflow-y:auto;";

    private bool IsFeature => IssueType == JiraIssueTypes.Feature;

    private int OtherArtCount => IsFeature ? _searchResults.Count(i => IsOtherArt(MatchOf(i))) : 0;

    private int NoArtCount => IsFeature ? _searchResults.Count(i => IsNoArt(MatchOf(i))) : 0;

    private void ToggleFullscreen()
    {
        _fullscreen = !_fullscreen;
    }

    private ArtMatch MatchOf(JiraIssueResponse issue) =>
        _matchByKey.TryGetValue(issue.Key, out var match) ? match : ArtMatch.NoKey;

    private bool IsOtherArt(ArtMatch match) =>
        match.IsMatched && _selectedProject is not null && match.ArtId != _selectedProject.Id;

    private static bool IsNoArt(ArtMatch match) =>
        match.Kind is ArtMatchKind.Unmatched or ArtMatchKind.Ambiguous;

    private async Task MatchFeaturesToArtsAsync()
    {
        _matchByKey = new(StringComparer.OrdinalIgnoreCase);
        if (!IsFeature)
        {
            return;
        }

        if (!_artLookupLoaded)
        {
            try
            {
                _artLookup = ArtHelper.BuildLookup(await ArtService.GetAllLightAsync());
                _artLookupLoaded = true;
            }
            catch (Exception ex)
            {
                Serilog.Log.Warning(ex, "Could not load the ARTs to match the found features");
                return;
            }
        }

        foreach (var issue in _searchResults)
        {
            _matchByKey[issue.Key] = _artLookup.Matcher.Match(issue.ToMatchFacts());
        }
    }

    protected override void OnInitialized()
    {
        _showPreview = !JiraConfig.Value.SkipSyncPreview;
    }

    private void OnProjectChanged(ProjectOption? value)
    {
        if (_selectedProject == value)
        {
            return;
        }
        _selectedProject = value;
        _searchExecuted = false;
        _searchResults.Clear();
        _selectedIssues.Clear();
        _matchByKey.Clear();
        _teamsNotFound.Clear();
        _pisToCreate.Clear();
        _alreadyInDbCount = 0;
        _selectedLabels = Array.Empty<string>();
        _selectedStatuses = Array.Empty<string>();
        _selectedPi = null;
        _jiraIdsText = string.Empty;
        if (value is not null)
        {
            _ = LoadMetadataAsync(value.JiraKeys);
        }
    }

    private async Task LoadMetadataAsync(IReadOnlyList<string> projectKeys)
    {
        _labelsLoading = true;
        _statusesLoading = true;
        StateHasChanged();

        var labelsTasks = projectKeys.Select(k => JiraMetadata.GetLabelsAsync(UserName, k)).ToList();
        var statusesTasks = projectKeys.Select(k => JiraMetadata.GetStatusesAsync(UserName, k)).ToList();

        try
        {
            var perKey = await AwaitEachAsync(labelsTasks);
            _availableLabels = perKey.Count == 1
                ? perKey[0]
                : perKey.SelectMany(l => l).DistinctBy(l => l.Name, StringComparer.Ordinal).OrderBy(l => l.Name).ToList();
        }
        finally
        {
            _labelsLoading = false;
            StateHasChanged();
        }

        try
        {
            var perKey = await AwaitEachAsync(statusesTasks);
            _availableStatuses = perKey.Count == 1
                ? perKey[0]
                : perKey.SelectMany(s => s).DistinctBy(s => s.Name, StringComparer.OrdinalIgnoreCase).OrderBy(s => s.Name).ToList();
        }
        finally
        {
            _statusesLoading = false;
            StateHasChanged();
        }
    }

    private static async Task<List<List<T>>> AwaitEachAsync<T>(IEnumerable<Task<List<T>>> tasks)
    {
        var results = new List<List<T>>();
        foreach (var task in tasks)
        {
            try
            {
                results.Add(await task);
            }
            catch
            {
                results.Add([]);
            }
        }
        return results;
    }

    private List<string> ParseJiraIds()
    {
        if (string.IsNullOrWhiteSpace(_jiraIdsText))
        {
            return new List<string>();
        }
        var separators = new[] { ',', ';', ' ', '\t', '\n', '\r' };
        return _jiraIdsText
            .Split(separators, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string ProjectClause()
    {
        var keys = _selectedProject!.JiraKeys;
        if (keys.Count == 1)
        {
            return $"project = \"{keys[0]}\"";
        }
        var projectList = string.Join(", ", keys.Select(k => $"\"{k}\""));
        return $"project in ({projectList})";
    }

    private string BuildJql()
    {
        var ids = ParseJiraIds();
        if (ids.Count > 0)
        {
            var keyList = string.Join(", ", ids.Select(k => $"\"{k}\""));
            return $"{ProjectClause()} AND issuetype = \"{IssueType}\" AND key in ({keyList})";
        }

        var jql = $"{ProjectClause()} AND issuetype = \"{IssueType}\"";

        var labels = _selectedLabels.ToList();
        if (labels.Count > 0)
        {
            if (_labelMatchMode == LabelMatchMode.All)
            {
                foreach (var label in labels)
                {
                    jql += $" AND labels = \"{label}\"";
                }
            }
            else
            {
                var labelList = string.Join(", ", labels.Select(l => $"\"{l}\""));
                jql += $" AND labels in ({labelList})";
            }
        }

        var statuses = _selectedStatuses.ToList();
        if (statuses.Count > 0)
        {
            var statusList = string.Join(", ", statuses.Select(s => $"\"{s}\""));
            var op = _excludeStatuses ? "not in" : "in";
            jql += $" AND status {op} ({statusList})";
        }

        if (!string.IsNullOrWhiteSpace(_selectedPi))
        {
            var piFieldId = JiraConfig.Value.PlanningIncrementCustomFieldId;
            if (!string.IsNullOrWhiteSpace(piFieldId))
            {
                var fieldRef = piFieldId.StartsWith("customfield_", StringComparison.OrdinalIgnoreCase)
                    ? $"cf[{piFieldId.Substring("customfield_".Length)}]"
                    : piFieldId;
                jql += $" AND {fieldRef} = \"{_selectedPi}\"";
            }
        }

        if (_updatedFrom.HasValue)
        {
            jql += $" AND updated >= \"{_updatedFrom.Value:yyyy-MM-dd}\"";
        }

        return jql;
    }

    private async Task SearchAsync()
    {
        if (_selectedProject is null)
        {
            return;
        }

        _searching = true;
        _searchExecuted = false;
        StateHasChanged();

        try
        {
            var jql = BuildJql();
            var found = await JiraIssueService.SearchIssuesAsync(UserName, jql);
            _alreadyInDbCount = found.Count(i => ExistingJiraIds.Contains(i.Key));
            _searchResults = found.Where(i => !ExistingJiraIds.Contains(i.Key)).ToList();
            await MatchFeaturesToArtsAsync();
            _selectedIssues.Clear();
            ComputeWarnings();
            _searchExecuted = true;
        }
        catch (Exception ex)
        {
            _searchResults = [];
            _selectedIssues.Clear();
            _matchByKey.Clear();
            _teamsNotFound.Clear();
            _pisToCreate.Clear();
            _alreadyInDbCount = 0;
            _searchExecuted = true;
            Serilog.Log.Error(ex, "Jira search failed");
        }
        finally
        {
            _searching = false;
            StateHasChanged();
        }
    }

    private void ComputeWarnings()
    {
        var piSet = new HashSet<string>(AvailablePiNames, StringComparer.OrdinalIgnoreCase);

        var unmatchedTeams = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var missingPis = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var issue in _searchResults)
        {
            foreach (var jt in JiraTeamMatcher.SplitJiraValue(issue.GfedTeam))
            {
                if (JiraTeamMatcher.Match(jt, AvailableTeams) is null)
                {
                    unmatchedTeams.Add(jt);
                }
            }

            if (!string.IsNullOrWhiteSpace(issue.PlanningIncrement)
                && !piSet.Contains(issue.PlanningIncrement.Trim()))
            {
                missingPis.Add(issue.PlanningIncrement.Trim());
            }
        }

        _teamsNotFound = unmatchedTeams.OrderBy(s => s).ToList();
        _pisToCreate = missingPis.OrderBy(s => s).ToList();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task ImportAll()
    {
        if (!await ConfirmImportAsync(_searchResults))
        {
            return;
        }
        var result = new JiraSyncDialogResult(_selectedProject!.Id, _selectedProject.PrimaryKey, _searchResults);
        MudDialog.Close(DialogResult.Ok(result));
    }

    private async Task ImportSelected()
    {
        if (_selectedIssues.Count == 0)
        {
            return;
        }
        var issues = _searchResults.Where(_selectedIssues.Contains).ToList();
        if (!await ConfirmImportAsync(issues))
        {
            return;
        }
        var result = new JiraSyncDialogResult(_selectedProject!.Id, _selectedProject.PrimaryKey, issues);
        MudDialog.Close(DialogResult.Ok(result));
    }

    private Task<bool> ConfirmImportAsync(IReadOnlyCollection<JiraIssueResponse> issues)
    {
        var projects = _selectedProject!.JiraKeys.Count == 1 ? "project" : "projects";
        var message = $"Import {issues.Count} new {IssueType} issue(s) from Jira {projects} " +
                      $"{_selectedProject.KeysText} into the database as new records? " +
                      "Existing records will not be changed.";
        var otherArtCount = IsFeature ? issues.Count(i => IsOtherArt(MatchOf(i))) : 0;
        if (otherArtCount > 0)
        {
            message += $" {otherArtCount} of them belong to another ART than {_selectedProject.Name} " +
                       "by their components and labels and will be shown under that ART.";
        }
        var noArtCount = IsFeature ? issues.Count(i => IsNoArt(MatchOf(i))) : 0;
        if (noArtCount > 0)
        {
            message += $" {noArtCount} of them belong to no ART by their components and labels, " +
                       "so only admins and users with General access will see them.";
        }
        return MessageService.Confirm(message, "Confirm import", "Import");
    }

    public enum LabelMatchMode { Any, All }

    public record ProjectOption(int Id, IReadOnlyList<string> JiraKeys, string Name)
    {
        public string KeysText => string.Join(", ", JiraKeys);

        public string PrimaryKey => JiraKeys.Count > 0 ? JiraKeys[0] : string.Empty;

        public virtual bool Equals(ProjectOption? other) =>
            other is not null && Id == other.Id && Name == other.Name && JiraKeys.SequenceEqual(other.JiraKeys);

        public override int GetHashCode() => HashCode.Combine(Id, Name);
    }
    public record JiraSyncDialogResult(int ProjectId, string ProjectKey, List<JiraIssueResponse> Issues);
}
