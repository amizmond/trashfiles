@attribute [Route(RoutingPath.BusinessOutcomesEdit)]

@inject IBusinessOutcomeService BoService
@inject IPortfolioEpicService EpicService
@inject ISolutionTrainResolver TrainResolver
@inject IPermissionGuard PermissionGuard
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IConfiguration Configuration

@using Estimation.Core.Train.Models
@using Estimation.Core.Train.Services
@using Estimation.Core.Features.Models
@using Estimation.Core.Shared.Services

<AccessGuard PageKey="BusinessOutcomes">
<PageTitle>@_model.Summary</PageTitle>

<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">

        <div class="d-flex align-center gap-2 mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo(ListUrl))" />
            <MudText Typo="Typo.h6">@_model.Summary</MudText>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }
        else
        {
            <MudGrid Spacing="4">
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="2" Class="pa-6 rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-4">@PlanningDisplayNames.Details</MudText>
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudTextField T="string" Value="_model.JiraId" Label="@PlanningDisplayNames.JiraId"
                                          Variant="Variant.Outlined" ReadOnly="true" />
                            @if (!string.IsNullOrWhiteSpace(_model.JiraId))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Color="Color.Primary"
                                               Href="@(Configuration["JiraTaskUrl"] + _model.JiraId)"
                                               Target="_blank" />
                            }
                        </div>
                        <MudTextField T="string" Value="_model.Summary" Label="@PlanningDisplayNames.Summary"
                                      Variant="Variant.Outlined" ReadOnly="true" Class="mb-3" />
                        <MudTextField T="string" Value="@EpicDisplayName" Label="@PlanningDisplayNames.PortfolioEpic"
                                      Variant="Variant.Outlined" ReadOnly="true" Class="mb-3" />
                        <MudTextField T="string" Value="_model.Description" Label="@PlanningDisplayNames.Description"
                                      Variant="Variant.Outlined" Lines="3" ReadOnly="true" Class="mb-3" />
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Elevation="2" Class="rounded-lg">
                        <MudToolBar Dense Class="gap-2 flex-wrap" Style="min-height:64px">
                            <MudText Typo="Typo.h6" Style="white-space:nowrap">@PlanningDisplayNames.Features</MudText>
                        </MudToolBar>
                        <MudDataGrid T="Feature" Items="_model.Features"
                                     Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                            <Columns>
                                <TemplateColumn Title="@PlanningDisplayNames.JiraId" Sortable="true" SortBy="@(x => x.JiraId ?? string.Empty)" CellStyle="width:150px;">
                                    <CellTemplate>
                                        @if (!string.IsNullOrEmpty(context.Item.JiraId))
                                        {
                                            <a href="@(Configuration["JiraTaskUrl"] + context.Item.JiraId)" target="_blank" style="text-decoration:none">
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="Color.Warning" Variant="Variant.Outlined" Style="cursor:pointer">
                                                    @context.Item.JiraId
                                                </MudChip>
                                            </a>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Name" Title="@PlanningDisplayNames.Name" Sortable="true" />

                                <PropertyColumn Property="x => x.Description" Title="@PlanningDisplayNames.Description" Sortable="false" />
                                <TemplateColumn Title="" CellStyle="width:100px; text-align:right" Sortable="false" Filterable="false">
                                    <CellTemplate>
                                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                       Size="Size.Small" Color="Color.Primary"
                                                       Href="@($"{RoutingPath.Features}/{context.Item.Id}")"
                                                       Target="_blank" />
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">No features linked yet.</MudText>
                            </NoRecordsContent>
                            <PagerContent>
                                <MudDataGridPager T="Feature" PageSizeOptions="new[] { 5, 10, 25, 50 }" />
                            </PagerContent>
                        </MudDataGrid>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudPaper>
</div>

</AccessGuard>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string ListUrl => ReturnUrl ?? RoutingPath.BusinessOutcomes;

    private BusinessOutcome _model = new();
    private List<PortfolioEpic> _allEpics = new();
    private bool _loading = true;

    private string EpicDisplayName
    {
        get
        {
            var epic = _allEpics.FirstOrDefault(e => e.Id == _model.PortfolioEpicId);
            if (epic is null)
            {
                return string.Empty;
            }

            return string.IsNullOrEmpty(epic.JiraId) ? epic.Summary ?? string.Empty : $"[{epic.JiraId}] {epic.Summary}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _allEpics = await EpicService.GetAllLightAsync();

        var e = await BoService.GetByIdAsync(Id);
        if (e is null)
        {
            Nav.NavigateTo(ListUrl); return;
        }

        var matcher = await TrainResolver.GetArtMatcherAsync();
        var trainScope = TrainResolver.ResolveForChildren(e.Features, matcher);
        if (!await PermissionGuard.CanViewAsync("BusinessOutcomes", trainScope))
        {
            Snackbar.Add("You don't have access to this business outcome's Solution Trains.", Severity.Warning);
            Nav.NavigateTo(ListUrl);
            return;
        }

        _model = e;
        _loading = false;
    }
}
