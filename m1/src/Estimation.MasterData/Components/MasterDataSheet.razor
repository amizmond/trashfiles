    private async Task ExportFilteredAsync() => await ExportAsync("MasterSheet.xlsx");

    private async Task ExportEmptyTemplateAsync() => await ExportAsync("MasterSheet_Template.xlsx");

    private async Task ExportAsync(string fileName)
    {
        try
        {
            _exporting = true;
            StateHasChanged();

            var bytes = await MasterSheetService.ExportFilteredAsync(fileName);
            await DownloadService.DownloadAsync(bytes, fileName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private async Task OnUploadFileSelected(IBrowserFile file)
    {
        if (file is null)
        {
            return;
        }

        MemoryStream? stream = null;
        try
        {
            stream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            var present = await MasterSheetService.DetectColumnsAsync(stream);
            if (present.Count == 0)
            {
                Snackbar.Add("No recognized feature columns were found in the file.", Severity.Error);
                return;
            }

            _exporting = true;
            StateHasChanged();

            stream.Position = 0;
            var result = await MasterSheetService.ParseFileAsync(stream);
            if (result.Rows.Count == 0)
            {
                Snackbar.Add("No data rows found in the uploaded file.", Severity.Warning);
                return;
            }

            MasterSheetUploadPreviewState.PendingUpload = result.Rows;
            MasterSheetUploadPreviewState.ImportedColumns = result.AppliedColumns;
            MasterSheetUploadPreviewState.TechStackNames = result.TechStackNames;
            Nav.NavigateTo(RoutingPath.MasterSheetUploadPreview);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            if (stream is not null)
            {
                await stream.DisposeAsync();
            }
            StateHasChanged();
        }
    }

