    private IReadOnlyList<string?> GetFeatureLabels(MasterRow row)
    {
        if (string.IsNullOrWhiteSpace(row.FeatureLabel))
            return [];

        return row.FeatureLabel
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim()).ToList();
    }

    private void UpdateFeatureLabel(MasterRow item, IReadOnlyCollection<string?> fl)
    {
        var before = MatchRow(item);
        item.FeatureLabel = string.Join(',', fl);
        WarnIfLabelsMoveFeature(item, before, MatchRow(item));
        CommittedItemChanges(item);
    }

    private IEnumerable<string> GetSortedLabels(MasterRow row)
    {
        var selectedLabels = GetFeatureLabels(row).ToHashSet();

        return _availableLabels
            .OrderByDescending(label => selectedLabels.Contains(label))
            .ThenBy(label => label);
    }

    private async Task UpdateBo(MasterRow item, int? boTableId)
    {
        var bo = _allBusinessOutcome.FirstOrDefault(bo => bo.Id == boTableId);
        item.BoId = boTableId;
        item.BoName = bo.Summary;
        item.BoJiraId = bo.JiraId;
        item.EpicTableId = bo.PortfolioEpicId;
        item.EpicName = bo.PortfolioEpic?.Summary;
        item.EpicJiraId = bo.PortfolioEpic?.JiraId;

        if (bo.PortfolioEpic.StrategicObjectivePortfolioEpics.Any())
        {
            item.StrategicObjective.Clear();
            var soRow = new MasterRowJiraRef();
            soRow.Summary = bo.PortfolioEpic.StrategicObjectivePortfolioEpics.First().StrategicObjective.Summary;
            soRow.SoTableId = bo.PortfolioEpic.StrategicObjectivePortfolioEpics.First().StrategicObjective.Id;
            soRow.JiraId = bo.PortfolioEpic.StrategicObjectivePortfolioEpics.First().StrategicObjective.JiraId;
            item.StrategicObjective.Add(soRow);
        };

        await CommittedItemChanges(item);
    }

