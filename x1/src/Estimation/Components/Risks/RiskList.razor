    private bool MatchesFilter(RiskVm risk)
    {
        if (_filterCategoriesSet.Count > 0 && !_filterCategoriesSet.Contains(risk.Category))
        {
            return false;
        }

        if (_filterSeveritiesSet.Count > 0 && !_filterSeveritiesSet.Contains(risk.Severity))
        {
            return false;
        }

        if (_filterStatusesSet.Count > 0 && !_filterStatusesSet.Contains(risk.Status))
        {
            return false;
        }

        if (!MatchesAnySet(_filterArtNamesSet, _filterArtNotBacking, risk.Arts.Select(a => a.Name)))
        {
            return false;
        }

        if (!MatchesSet(_filterOwnersSet, _filterOwnerNotBacking, risk.Owner))
        {
            return false;
        }

        if (!MatchesAnySet(_filterJiraIdsSet, _filterJiraIdNotBacking, risk.Features.Select(f => f.JiraId)))
        {
            return false;
        }

        if (!MatchesAnySet(_filterBoIdsSet, _filterBoNotBacking, risk.Features.Select(f => f.BoJiraId)))
        {
            return false;
        }

        if (!MatchesAnySet(_filterEpicIdsSet, _filterEpicNotBacking, risk.Features.Select(f => f.EpicJiraId)))
        {
            return false;
        }

        if (!MatchesAnySet(_filterSoIdsSet, _filterSoNotBacking,
            risk.Features.SelectMany(f => f.StrategicObjectives).Select(so => so.JiraId)))
        {
            return false;
        }

        if (_filterDueFromBacking is { } dueFrom && (risk.DueBy is null || risk.DueBy < dueFrom))
        {
            return false;
        }

        if (_filterDueToBacking is { } dueTo && (risk.DueBy is null || risk.DueBy > dueTo))
        {
            return false;
        }

        if (_filterRaisedFromBacking is { } raisedFrom && risk.DateRaised < raisedFrom)
        {
            return false;
        }

        if (_filterRaisedToBacking is { } raisedTo && risk.DateRaised > raisedTo)
        {
            return false;
        }

        var search = _filterSearchBacking?.Trim();
        if (string.IsNullOrEmpty(search))
        {
            return true;
        }

        if (Matches(risk.Summary, search)
            || Matches(risk.Owner, search)
            || Matches(risk.ArtNamesText, search)
            || Matches(_unitedComments.GetValueOrDefault(risk.Id), search))
        {
            return true;
        }

        return risk.Features.Any(f => Matches(f.JiraId, search) || Matches(f.Summary, search));
    }

    private static bool Matches(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false;

    private static bool MatchesSet(HashSet<string> selected, bool negate, string? value)
    {
        if (selected.Count == 0)
        {
            return !negate || string.IsNullOrWhiteSpace(value);
        }

        var hit = !string.IsNullOrWhiteSpace(value) && selected.Contains(value);
        return negate ? !hit : hit;
    }

    private static bool MatchesAnySet(HashSet<string> selected, bool negate, IEnumerable<string?> values)
    {
        var present = values.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v!).ToList();

        if (selected.Count == 0)
        {
            return !negate || present.Count == 0;
        }

        var hit = present.Any(selected.Contains);
        return negate ? !hit : hit;
    }

    private static IOrderedEnumerable<RiskVm> OrderRows<TKey>(
        IEnumerable<RiskVm> source, Func<RiskVm, TKey> keySelector, bool descending) =>
        descending ? source.OrderByDescending(keySelector) : source.OrderBy(keySelector);

    private void RecomputeFilteredRows()
    {
        IEnumerable<RiskVm> filtered = _rows.Where(MatchesFilter);

        filtered = _sortColumn switch
        {
            SortableDateRaised => OrderRows(filtered, r => r.DateRaised, _sortDescending),
            SortableArt => OrderRows(filtered, r => r.ArtNamesText, _sortDescending),
            SortableJiraIds => OrderRows(filtered, JiraIdsSortKey, _sortDescending),
            SortableCategory => OrderRows(filtered, r => r.Category, _sortDescending),
            SortableSeverity => OrderRows(filtered, r => r.Severity, _sortDescending),
            SortableSummary => OrderRows(filtered, r => r.Summary, _sortDescending),
            SortableOwner => OrderRows(filtered, r => r.Owner, _sortDescending),
            SortableStatus => OrderRows(filtered, r => r.Status, _sortDescending),
            SortableDueBy => OrderRows(filtered, r => r.DueBy, _sortDescending),
            SortableComments => OrderRows(filtered, r => _unitedComments.GetValueOrDefault(r.Id), _sortDescending),
            SortableDateUpdated => OrderRows(filtered, r => r.DateUpdated, _sortDescending),
            SortableCreatedBy => OrderRows(filtered, r => r.DisplayCreatedBy, _sortDescending),
            SortableUpdatedBy => OrderRows(filtered, r => r.DisplayUpdatedBy, _sortDescending),
            _ => filtered
        };

        _filteredRows = filtered.ToList();

        _orderNumbers = _filteredRows
            .Select((r, index) => (r.Id, Number: index + 1))
            .ToDictionary(x => x.Id, x => x.Number);
    }

