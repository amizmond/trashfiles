@attribute [Route(RoutingPath.Risks)]
@inherits LocalTimeComponentBase

@inject IRiskService RiskService
@inject IRiskCommentService RiskCommentService
@inject IPiService PiService
@inject IBrowserDownloadService DownloadService
@inject ISnackbar Snackbar
@inject IWindowsAuthService WindowsAuth
@inject NavigationManager Nav
@inject IModalDialogService MessageService
@inject IConfiguration Configuration
@inject IJSRuntime JS

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using MudBlazor.Utilities
@using Serilog
@using Estimation.Core.Administration.Models
@using Estimation.Core.PlanningIncrement.Models
@using Estimation.Core.PlanningIncrement.Services
@using Estimation.Core.Risks.Models
@using Estimation.Core.Risks.Services

<PageTitle>@PlanningDisplayNames.Risks</PageTitle>

<AccessGuard PageKey="Risks">
<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <div class="d-flex flex-wrap align-center gap-2 pa-2">
            <MudText Typo="Typo.h6" Class="mr-2">@PlanningDisplayNames.Risks</MudText>

            <MudSelect T="int?"
                       Value="_selectedPiId"
                       ValueChanged="OnPiChangedAsync"
                       Label="@PlanningDisplayNames.PI"
                       Variant="Variant.Outlined"
                       Dense
                       Disabled="_loading"
                       AnchorOrigin="Origin.BottomCenter"
                       Style="width:240px">
                @foreach (var pi in _allPis)
                {
                    <MudSelectItem T="int?" Value="@pi.Id">@pi.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />

            <div style="position:relative;">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ViewColumn"
                           Disabled="_loading"
                           OnClick="() => _columnsPopoverOpen = !_columnsPopoverOpen">
                    Columns
                </MudButton>
                <MudPopover Open="_columnsPopoverOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                            Class="pa-4" Style="min-width:340px; max-height:75vh; overflow-y:auto">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@PlanningDisplayNames.ToggleColumns</MudText>
                        <div>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetColumnsAsync">Reset</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _columnsPopoverOpen = false" />
                        </div>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">Drag a row to reorder. Toggle to show or hide.</MudText>
                    <MudDropContainer T="ColumnItem" @ref="_columnDropContainer" Items="_columnItems"
                                      ItemsSelector="@((item, zone) => item.Selector == zone)"
                                      ItemDropped="OnColumnDroppedAsync" Class="d-block">
                        <ChildContent>
                            <MudDropZone T="ColumnItem" Identifier="@ColumnZoneId" AllowReorder="true"
                                         Class="d-flex flex-column gap-1" />
                        </ChildContent>
                        <ItemRenderer>
                            <div class="d-flex align-center gap-2 px-2 py-1 rounded-lg mud-paper-outlined" style="cursor:grab; user-select:none">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Class="mud-text-secondary" />
                                <MudSwitch T="bool" Value="context.Visible"
                                           ValueChanged="@(v => OnColumnVisibilityChangedAsync(context, v))"
                                           Label="@context.Label" Color="Color.Primary" Dense Class="flex-grow-1 ma-0" />
                            </div>
                        </ItemRenderer>
                    </MudDropContainer>

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Feature columns</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">Shown inside the expanded feature rows.</MudText>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var item in _featureColumnItems)
                        {
                            var current = item;
                            <div class="d-flex align-center gap-2 px-2 py-1 rounded-lg mud-paper-outlined">
                                <MudSwitch T="bool" Value="current.Visible"
                                           ValueChanged="@(v => OnFeatureColumnVisibilityChangedAsync(current, v))"
                                           Label="@current.Label" Color="Color.Primary" Dense Class="flex-grow-1 ma-0" />
                            </div>
                        }
                    </div>
                </MudPopover>
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       Disabled="_loading"
                       OnClick="() => _drawerOpen = !_drawerOpen">
                Filter
            </MudButton>

            <MudTooltip Text="Exports every risk of the selected PI, ignoring the filters.">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@(_loading || _exporting || _selectedPiId is null)"
                           OnClick="ExportToExcelAsync">
                    Export to excel
                </MudButton>
            </MudTooltip>

            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_loading || _selectedPiId is null)"
                           OnClick="OpenNewDialogAsync">
                    New
                </MudButton>
            }
        </div>

        <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Elevation="2"
                   Variant="DrawerVariant.Temporary" Width="360px"
                   Style="background: var(--mud-palette-surface)">
            <MudDrawerHeader>
                <div class="d-flex align-center justify-space-between" style="width:100%">
                    <MudText Typo="Typo.h6">@PlanningDisplayNames.Filters</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _drawerOpen = false" />
                </div>
            </MudDrawerHeader>
            <div class="d-flex flex-column gap-3 pa-4 risk-filter-panel">
                <MudTextField @bind-Value="FilterSearch" Label="@PlanningDisplayNames.Search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              HelperText="Matches summary, owner, ART, comments and the linked features."
                              Clearable Immediate DebounceInterval="300" Dense Variant="Variant.Outlined" />

                <MudSelect T="RiskCategory?" Label="@PlanningDisplayNames.Category" MultiSelection
                           @bind-SelectedValues="FilterCategories"
                           Dense Variant="Variant.Outlined" Clearable
                           ToStringFunc="@(c => c?.ToDisplayString() ?? string.Empty)"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var category in Enum.GetValues<RiskCategory>())
                    {
                        <MudSelectItem T="RiskCategory?" Value="@((RiskCategory?)category)">@category.ToDisplayString()</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="RiskSeverity?" Label="@PlanningDisplayNames.Severity" MultiSelection
                           @bind-SelectedValues="FilterSeverities"
                           Dense Variant="Variant.Outlined" Clearable
                           ToStringFunc="@(s => s?.ToDisplayString() ?? string.Empty)"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var severity in Enum.GetValues<RiskSeverity>())
                    {
                        <MudSelectItem T="RiskSeverity?" Value="@((RiskSeverity?)severity)">@severity.ToDisplayString()</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="RiskStatus?" Label="@PlanningDisplayNames.Status" MultiSelection
                           @bind-SelectedValues="FilterStatuses"
                           Dense Variant="Variant.Outlined" Clearable
                           ToStringFunc="@(s => s?.ToDisplayString() ?? string.Empty)"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var status in Enum.GetValues<RiskStatus>())
                    {
                        <MudSelectItem T="RiskStatus?" Value="@((RiskStatus?)status)">@status.ToDisplayString()</MudSelectItem>
                    }
                </MudSelect>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableArts"
                                        Values="FilterArtNames"
                                        ValuesChanged="OnFilterArtNamesChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.Art"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find risks without an ART or exclude the selected ones">
                        <MudCheckBox T="bool" @bind-Value="FilterArtNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableOwners"
                                        Values="FilterOwners"
                                        ValuesChanged="OnFilterOwnersChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.Owner"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find risks without an owner or exclude the selected ones">
                        <MudCheckBox T="bool" @bind-Value="FilterOwnerNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableJiraIds"
                                        Values="FilterJiraIds"
                                        ValuesChanged="OnFilterJiraIdsChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.Feature"
                                        ToStringFunc="@LookupFeatureText"
                                        ItemTemplate="@FeatureItemTemplate"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find risks without features or exclude the selected ones">
                        <MudCheckBox T="bool" @bind-Value="FilterJiraIdNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableSoIds"
                                        Values="FilterSoIds"
                                        ValuesChanged="OnFilterSoIdsChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.StrategicObjective"
                                        ToStringFunc="@LookupSoText"
                                        ItemTemplate="@SoItemTemplate"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find risks without Strategic Objective or exclude the selected ones">
                        <MudCheckBox T="bool" @bind-Value="FilterSoNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableEpicIds"
                                        Values="FilterEpicIds"
                                        ValuesChanged="OnFilterEpicIdsChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.PortfolioEpic"
                                        ToStringFunc="@LookupEpicText"
                                        ItemTemplate="@EpicItemTemplate"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find risks without Portfolio Epic or exclude the selected ones">
                        <MudCheckBox T="bool" @bind-Value="FilterEpicNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableBoIds"
                                        Values="FilterBoIds"
                                        ValuesChanged="OnFilterBoIdsChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.BusinessOutcome"
                                        ToStringFunc="@LookupBoText"
                                        ItemTemplate="@BoItemTemplate"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find risks without Business Outcome or exclude the selected ones">
                        <MudCheckBox T="bool" @bind-Value="FilterBoNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <MudDivider Class="my-1" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@PlanningDisplayNames.DueBy</MudText>
                <div class="d-flex gap-2">
                    <MudDatePicker Date="FilterDueFrom" DateChanged="@(d => FilterDueFrom = d)"
                                   Label="From" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Clearable DateFormat="yyyy-MM-dd" Style="flex:1" />
                    <MudDatePicker Date="FilterDueTo" DateChanged="@(d => FilterDueTo = d)"
                                   Label="To" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Clearable DateFormat="yyyy-MM-dd" Style="flex:1" />
                </div>

                <MudDivider Class="my-1" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@PlanningDisplayNames.DateRaised</MudText>
                <div class="d-flex gap-2">
                    <MudDatePicker Date="FilterRaisedFrom" DateChanged="@(d => FilterRaisedFrom = d)"
                                   Label="From" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Clearable DateFormat="yyyy-MM-dd" Style="flex:1" />
                    <MudDatePicker Date="FilterRaisedTo" DateChanged="@(d => FilterRaisedTo = d)"
                                   Label="To" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Clearable DateFormat="yyyy-MM-dd" Style="flex:1" />
                </div>

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           FullWidth OnClick="ClearFilters" Class="mt-2">
                    @PlanningDisplayNames.ClearFilters
                </MudButton>
            </div>
        </MudDrawer>

        <MudDivider />

        @if (!_loading && _allPis.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">No PIs are defined yet. Create a PI before raising risks.</MudAlert>
        }
        else
        {
            <MudDataGrid @ref="_grid"
                         T="RiskVm"
                         Items="@_filteredRows"
                         Hover="true"
                         Striped="true"
                         Dense="true"
                         Elevation="0"
                         Loading="_loading"
                         LoadingProgressColor="Color.Primary"
                         ColumnResizeMode="ResizeMode.Container"
                         @bind-CurrentPage="_currentPage"
                         @bind-RowsPerPage="_pageSize">
                <Columns>
                    <HierarchyColumn T="RiskVm" />

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showOrder" CellStyle="width:60px">
                        <HeaderTemplate>#</HeaderTemplate>
                        <CellTemplate>@OrderNumber(context.Item)</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showDateRaised">
                        <HeaderTemplate>@SortableHeader(SortableDateRaised, PlanningDisplayNames.DateRaised)</HeaderTemplate>
                        <CellTemplate>@FormatDay(context.Item.DateRaised)</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:80px; max-width:260px;" Hidden="!_showArt">
                        <HeaderTemplate>@SortableHeader(SortableArt, PlanningDisplayNames.Art)</HeaderTemplate>
                        <CellTemplate>
                            @foreach (var art in context.Item.Arts)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Class="mr-1">
                                    @art.Name
                                </MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:100px; max-width:260px;" Hidden="!_showJiraIds">
                        <HeaderTemplate>@SortableHeader(SortableJiraIds, PlanningDisplayNames.RiskJiraIds)</HeaderTemplate>
                        <CellTemplate>
                            @foreach (var feature in context.Item.Features.Where(f => !string.IsNullOrEmpty(f.JiraId)))
                            {
                                <MudTooltip Text="@feature.Summary">
                                    <a href="@(Configuration["JiraTaskUrl"] + feature.JiraId)" target="_blank" style="text-decoration:none">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="cursor:pointer">
                                            @feature.JiraId
                                        </MudChip>
                                    </a>
                                </MudTooltip>
                            }
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showCategory">
                        <HeaderTemplate>@SortableHeader(SortableCategory, PlanningDisplayNames.Category)</HeaderTemplate>
                        <CellTemplate>
                            <MudTooltip Text="@(context.Item.Category == RiskCategory.Risk ? "Potential future problem" : "Problem that has already materialised")">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@CategoryColor(context.Item.Category)">
                                    @context.Item.Category.ToDisplayString()
                                </MudChip>
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showSeverity">
                        <HeaderTemplate>@SortableHeader(SortableSeverity, PlanningDisplayNames.Severity)</HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@SeverityColor(context.Item.Severity)">
                                @context.Item.Severity.ToDisplayString()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:150px; max-width:500px;" Hidden="!_showSummary">
                        <HeaderTemplate>@SortableHeader(SortableSummary, PlanningDisplayNames.Summary)</HeaderTemplate>
                        <CellTemplate>
                            <div style="white-space:pre-wrap; word-break:break-word">@context.Item.Summary</div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:80px; max-width:220px;" Hidden="!_showOwner">
                        <HeaderTemplate>@SortableHeader(SortableOwner, PlanningDisplayNames.Owner)</HeaderTemplate>
                        <CellTemplate>@context.Item.Owner</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showStatus">
                        <HeaderTemplate>@SortableHeader(SortableStatus, PlanningDisplayNames.Status)</HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@StatusColor(context.Item.Status)">
                                @context.Item.Status.ToDisplayString()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showDueBy">
                        <HeaderTemplate>@SortableHeader(SortableDueBy, PlanningDisplayNames.DueBy)</HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.DueBy.HasValue)
                            {
                                @FormatDay(context.Item.DueBy.Value)
                            }
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:150px; max-width:500px;" Hidden="!_showComments">
                        <HeaderTemplate>@SortableHeader(SortableComments, PlanningDisplayNames.RiskComments)</HeaderTemplate>
                        <CellTemplate>
                            <div style="white-space:pre-wrap; word-break:break-word">@_unitedComments.GetValueOrDefault(context.Item.Id)</div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showDateUpdated">
                        <HeaderTemplate>@SortableHeader(SortableDateUpdated, PlanningDisplayNames.DateUpdated)</HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.DateUpdated.HasValue)
                            {
                                @FormatTimestamp(context.Item.DateUpdated.Value)
                            }
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showCreatedBy">
                        <HeaderTemplate>@SortableHeader(SortableCreatedBy, PlanningDisplayNames.CreatedBy)</HeaderTemplate>
                        <CellTemplate>@context.Item.DisplayCreatedBy</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showUpdatedBy">
                        <HeaderTemplate>@SortableHeader(SortableUpdatedBy, PlanningDisplayNames.UpdatedBy)</HeaderTemplate>
                        <CellTemplate>@context.Item.DisplayUpdatedBy</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="@PlanningDisplayNames.Actions" Sortable="false" Filterable="false"
                                    Hidden="!_showActions" StickyRight="true">
                        <CellTemplate>
                            <MudBadge Content="@(_commentCounts.GetValueOrDefault(context.Item.Id))"
                                      Color="Color.Info" Overlap="true" Bordered="true"
                                      Visible="@(_commentCounts.GetValueOrDefault(context.Item.Id) > 0)">
                                <MudTooltip Text="@PlanningDisplayNames.RiskComments">
                                    <MudFab Class="m-2" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Comment"
                                            Size="Size.Small" OnClick="@(() => ShowCommentsAsync(context.Item))" />
                                </MudTooltip>
                            </MudBadge>
                            @if (_canEdit)
                            {
                                <MudTooltip Text="Edit risk">
                                    <MudFab Class="m-2" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit"
                                            Size="Size.Small" OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                                </MudTooltip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <ChildRowContent>
                    <MudPaper Class="pa-3 ma-2" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                        @if (context.Item.Features.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">No features are linked to this risk.</MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Bordered="true" Striped="true" Elevation="0">
                                <thead>
                                    <tr>
                                        @if (_showFeatureJiraId)
                                        {
                                            <th>@PlanningDisplayNames.JiraId</th>
                                        }
                                        @if (_showFeatureSummary)
                                        {
                                            <th>@PlanningDisplayNames.Summary</th>
                                        }
                                        @if (_showFeatureBo)
                                        {
                                            <th>@PlanningDisplayNames.BusinessOutcome</th>
                                        }
                                        @if (_showFeatureBoName)
                                        {
                                            <th>@PlanningDisplayNames.BusinessOutcomeName</th>
                                        }
                                        @if (_showFeatureEpic)
                                        {
                                            <th>@PlanningDisplayNames.PortfolioEpic</th>
                                        }
                                        @if (_showFeatureEpicName)
                                        {
                                            <th>@PlanningDisplayNames.PortfolioEpicName</th>
                                        }
                                        @if (_showFeatureSo)
                                        {
                                            <th>@PlanningDisplayNames.StrategicObjective</th>
                                        }
                                        @if (_showFeatureSoName)
                                        {
                                            <th>@PlanningDisplayNames.StrategicObjectiveName</th>
                                        }
                                        @if (_showFeatureLabels)
                                        {
                                            <th>@PlanningDisplayNames.Labels</th>
                                        }
                                        @if (_showFeatureStoryPoints)
                                        {
                                            <th>@PlanningDisplayNames.StoryPoints</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var feature in context.Item.Features)
                                    {
                                        <tr @key="feature.FeatureId">
                                            @if (_showFeatureJiraId)
                                            {
                                                <td>
                                                    @if (!string.IsNullOrEmpty(feature.JiraId))
                                                    {
                                                        <a href="@(Configuration["JiraTaskUrl"] + feature.JiraId)" target="_blank" style="text-decoration:none">
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="cursor:pointer">
                                                                @feature.JiraId
                                                            </MudChip>
                                                        </a>
                                                    }
                                                </td>
                                            }
                                            @if (_showFeatureSummary)
                                            {
                                                <td><span class="font-weight-bold">@feature.Summary</span></td>
                                            }
                                            @if (_showFeatureBo)
                                            {
                                                <td>
                                                    @if (!string.IsNullOrEmpty(feature.BoJiraId))
                                                    {
                                                        <MudTooltip Text="@feature.BoName">
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                                @feature.BoJiraId
                                                            </MudChip>
                                                        </MudTooltip>
                                                    }
                                                </td>
                                            }
                                            @if (_showFeatureBoName)
                                            {
                                                <td>@feature.BoName</td>
                                            }
                                            @if (_showFeatureEpic)
                                            {
                                                <td>
                                                    @if (!string.IsNullOrEmpty(feature.EpicJiraId))
                                                    {
                                                        <MudTooltip Text="@feature.EpicName">
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                                @feature.EpicJiraId
                                                            </MudChip>
                                                        </MudTooltip>
                                                    }
                                                </td>
                                            }
                                            @if (_showFeatureEpicName)
                                            {
                                                <td>@feature.EpicName</td>
                                            }
                                            @if (_showFeatureSo)
                                            {
                                                <td>
                                                    @foreach (var so in feature.StrategicObjectives.Where(s => !string.IsNullOrEmpty(s.JiraId)))
                                                    {
                                                        <MudTooltip Text="@so.Name">
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                                @so.JiraId
                                                            </MudChip>
                                                        </MudTooltip>
                                                    }
                                                </td>
                                            }
                                            @if (_showFeatureSoName)
                                            {
                                                <td>@feature.SoNamesText</td>
                                            }
                                            @if (_showFeatureLabels)
                                            {
                                                <td>
                                                    @if (!string.IsNullOrEmpty(feature.Labels))
                                                    {
                                                        @foreach (var label in feature.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="mr-1">@label</MudChip>
                                                        }
                                                    }
                                                </td>
                                            }
                                            @if (_showFeatureStoryPoints)
                                            {
                                                <td>@feature.StoryPoints</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudPaper>
                </ChildRowContent>
