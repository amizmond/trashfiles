        if (keys.Remove(ColKey.Actions))
        {
            keys.Add(ColKey.Actions);
        }
        keys.Insert(0, ColKey.Hierarchy);
        return keys;
    }

    private const string ColumnPrefsKey = "riskList.columns.v2";
    private bool _columnPrefsLoaded;
    private bool _columnLayoutInitialized;

    private sealed class ColumnPrefs
    {
        public List<string>? Order { get; set; }
        public Dictionary<string, bool>? Visible { get; set; }
        public Dictionary<string, bool>? FeatureVisible { get; set; }
    }

    private void AssignColumnIdentifiers()
    {
        if (_grid is null)
        {
            return;
        }

        var rendered = _grid.RenderedColumns;
        if (rendered.Count != _markupOrderKeys.Length)
        {
            return;
        }

        for (var i = 0; i < _markupOrderKeys.Length; i++)
        {
            rendered[i].Identifier = _markupOrderKeys[i];
        }
    }

    private void ApplyColumnOrder()
    {
        if (_grid is null)
        {
            return;
        }

        var order = OrderedKeys();
        var rendered = _grid.RenderedColumns;
        var ordered = rendered
            .OrderBy(c =>
            {
                var idx = order.IndexOf(c.Identifier ?? string.Empty);
                return idx < 0 ? int.MaxValue : idx;
            })
            .ToList();

        rendered.Clear();
        rendered.AddRange(ordered);

        _filteredRows = new List<RiskVm>(_filteredRows);
    }

    private async Task OnColumnDroppedAsync(MudItemDropInfo<ColumnItem> dropInfo)
    {
        if (dropInfo.Item is null)
        {
            return;
        }

        dropInfo.Item.Selector = dropInfo.DropzoneIdentifier;
        _columnItems.UpdateOrder(dropInfo, item => item.Order, 0);
        _columnItems = _columnItems.OrderBy(c => c.Order).ToList();

        ApplyColumnOrder();
        await SaveColumnPrefsAsync();
    }

    private async Task OnColumnVisibilityChangedAsync(ColumnItem item, bool value)
    {
        item.Visible = value;
        await SaveColumnPrefsAsync();
    }

    private async Task OnFeatureColumnVisibilityChangedAsync(ColumnItem item, bool value)
    {
        item.Visible = value;
        await SaveColumnPrefsAsync();
    }

    private async Task ResetColumnsAsync()
    {
        InitColumnDefaults();
        ApplyColumnOrder();
        _columnDropContainer?.Refresh();
        await SaveColumnPrefsAsync();
    }

    private async Task LoadColumnPrefsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ColumnPrefsKey);
            if (string.IsNullOrEmpty(json))
            {
                return;
            }

            var prefs = System.Text.Json.JsonSerializer.Deserialize<ColumnPrefs>(json);
            if (prefs is null)
            {
                return;
            }

            if (prefs.Visible is not null)
            {
                foreach (var item in _columnItems)
                {
                    if (prefs.Visible.TryGetValue(item.Key, out var vis))
                    {
                        item.Visible = vis;
                    }
                }
            }

            if (prefs.FeatureVisible is not null)
            {
                foreach (var item in _featureColumnItems)
                {
                    if (prefs.FeatureVisible.TryGetValue(item.Key, out var vis))
                    {
                        item.Visible = vis;
                    }
                }
            }

            if (prefs.Order is not null && prefs.Order.Count > 0)
            {
                var known = _columnItems.Select(c => c.Key).ToHashSet(StringComparer.Ordinal);
                var newOrder = prefs.Order.Where(k => known.Contains(k)).Distinct().ToList();
                foreach (var item in _columnItems)
                {
                    if (!newOrder.Contains(item.Key))
                    {
                        newOrder.Add(item.Key);
                    }
                }

                foreach (var item in _columnItems)
                {
                    item.Order = newOrder.IndexOf(item.Key);
                }
                _columnItems = _columnItems.OrderBy(c => c.Order).ToList();
            }
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Failed to load RiskList column preferences");
        }
        finally
        {
            _columnPrefsLoaded = true;
        }
    }

    private async Task SaveColumnPrefsAsync()
    {
        if (!_columnPrefsLoaded)
        {
            return;
        }

        try
        {
            var prefs = new ColumnPrefs
            {
                Order = ColumnOrderForPrefs(),
                Visible = _columnItems.ToDictionary(c => c.Key, c => c.Visible, StringComparer.Ordinal),
                FeatureVisible = _featureColumnItems.ToDictionary(c => c.Key, c => c.Visible, StringComparer.Ordinal)
            };
            var json = System.Text.Json.JsonSerializer.Serialize(prefs);
            await JS.InvokeVoidAsync("localStorage.setItem", ColumnPrefsKey, json);
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Failed to save RiskList column preferences");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _canEdit = UserPageAccess.TryGetValue(PageKey, out var access) && access == AccessLevel.Edit;
        InitColumnDefaults();

        try
        {
            _userName = await WindowsAuth.GetUserName();
            _allPis = await PiService.GetAllLightAsync();
            _selectedPiId = PiIdFromQuery();

            if (_selectedPiId is not null)
            {
                await LoadRisksAsync();
            }

            _piRestorePending = _selectedPiId is null && _allPis.Count > 0;
            _loading = _piRestorePending;
        }
        catch (Exception ex)
        {
            _piRestorePending = false;
            _loading = false;
            Log.Error(ex, "Failed to initialise the Risks view");
            await MessageService.Exception(ex);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadColumnPrefsAsync();

            if (_piRestorePending)
            {
                _piRestorePending = false;
                await RestoreSelectedPiAsync();
            }
            else
            {
                await SaveSelectedPiAsync(_selectedPiId);
            }

            StateHasChanged();
        }

        if (!_columnLayoutInitialized && _columnPrefsLoaded
            && _grid is not null
            && _grid.RenderedColumns.Count == _markupOrderKeys.Length)
        {
            AssignColumnIdentifiers();
            ApplyColumnOrder();
            _columnLayoutInitialized = true;
            _columnDropContainer?.Refresh();
            StateHasChanged();
        }
    }

    private int? PiIdFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);

        if (q.TryGetValue("pi", out var raw)
            && int.TryParse(raw.ToString(), out var piId)
            && _allPis.Any(p => p.Id == piId))
        {
            return piId;
        }

        return null;
    }

    private const string SelectedPiKey = "riskList.selectedPi";
    private bool _piRestorePending;

    private async Task RestoreSelectedPiAsync()
    {
        _selectedPiId = await LoadStoredPiIdAsync() ?? _allPis.FirstOrDefault()?.Id;
        await SaveSelectedPiAsync(_selectedPiId);

        try
        {
            if (_selectedPiId is not null)
            {
                Nav.NavigateTo(Nav.GetUriWithQueryParameter("pi", _selectedPiId), replace: true);
                await LoadRisksAsync();
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to restore the selected PI");
            await MessageService.Exception(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<int?> LoadStoredPiIdAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", SelectedPiKey);

            if (int.TryParse(raw, out var piId) && _allPis.Any(p => p.Id == piId))
            {
                return piId;
            }
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Failed to load the stored Risks PI selection");
        }

        return null;
    }

    private async Task SaveSelectedPiAsync(int? piId)
    {
        try
        {
            if (piId is { } id)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", SelectedPiKey, id.ToString());
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", SelectedPiKey);
            }
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Failed to save the Risks PI selection");
        }
    }

    private async Task OnPiChangedAsync(int? piId)
    {
        _selectedPiId = piId;
        _currentPage = 0;

        Nav.NavigateTo(Nav.GetUriWithQueryParameter("pi", piId), replace: true);
        await SaveSelectedPiAsync(piId);

        if (piId is null)
        {
            _rows = new List<RiskVm>();
            _commentCounts = new Dictionary<int, int>();
            _unitedComments = new Dictionary<int, string>();
            RecomputeFilteredRows();
            return;
        }

        _loading = true;
        try
        {
            await LoadRisksAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRisksAsync()
    {
        if (_selectedPiId is not { } piId)
        {
            return;
        }

        _rows = await RiskService.GetForPiAsync(piId);

        var ids = _rows.Select(r => r.Id).ToList();
        _commentCounts = await RiskCommentService.GetCountsAsync(ids);
        _unitedComments = await RiskCommentService.GetUnitedAsync(ids, UserTime.TimeZone);

        RebuildFilterOptions();
        RecomputeFilteredRows();
    }

    private void RebuildFilterOptions()
    {
        _availableArts = _rows
            .SelectMany(r => r.Arts.Select(a => a.Name))
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _availableOwners = _rows
            .Select(r => r.Owner)
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .Select(o => o!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(o => o, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _availableFeatures = CollectJiraRefs(_rows.SelectMany(r => r.Features)
            .Select(f => (f.JiraId, f.Summary)));

        _availableBos = CollectJiraRefs(_rows.SelectMany(r => r.Features)
            .Select(f => (f.BoJiraId, f.BoName)));

        _availableEpics = CollectJiraRefs(_rows.SelectMany(r => r.Features)
            .Select(f => (f.EpicJiraId, f.EpicName)));

        _availableSos = CollectJiraRefs(_rows.SelectMany(r => r.Features)
            .SelectMany(f => f.StrategicObjectives)
            .Select(so => (so.JiraId, so.Name)));

        _filterArtNamesBacking = Retain(_filterArtNamesBacking, _availableArts);
        _filterArtNamesSet = new HashSet<string>(_filterArtNamesBacking, StringComparer.OrdinalIgnoreCase);
        _filterOwnersBacking = Retain(_filterOwnersBacking, _availableOwners);
        _filterOwnersSet = new HashSet<string>(_filterOwnersBacking, StringComparer.OrdinalIgnoreCase);
        _filterJiraIdsBacking = Retain(_filterJiraIdsBacking, _availableJiraIds);
        _filterJiraIdsSet = new HashSet<string>(_filterJiraIdsBacking, StringComparer.OrdinalIgnoreCase);
        _filterBoIdsBacking = Retain(_filterBoIdsBacking, _availableBoIds);
        _filterBoIdsSet = new HashSet<string>(_filterBoIdsBacking, StringComparer.OrdinalIgnoreCase);
        _filterEpicIdsBacking = Retain(_filterEpicIdsBacking, _availableEpicIds);
        _filterEpicIdsSet = new HashSet<string>(_filterEpicIdsBacking, StringComparer.OrdinalIgnoreCase);
        _filterSoIdsBacking = Retain(_filterSoIdsBacking, _availableSoIds);
        _filterSoIdsSet = new HashSet<string>(_filterSoIdsBacking, StringComparer.OrdinalIgnoreCase);
    }

    private static List<(string JiraId, string? Summary)> CollectJiraRefs(
        IEnumerable<(string? JiraId, string? Summary)> source) =>
        source
            .Where(x => !string.IsNullOrWhiteSpace(x.JiraId))
            .Select(x => (JiraId: x.JiraId!, x.Summary))
            .DistinctBy(x => x.JiraId, StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x.JiraId, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static IReadOnlyCollection<string> Retain(IReadOnlyCollection<string> selected, List<string> available)
    {
        if (selected.Count == 0)
        {
            return selected;
        }

        var lookup = available.ToHashSet(StringComparer.OrdinalIgnoreCase);
        return selected.Where(lookup.Contains).ToList();
    }

    private async Task ExportToExcelAsync()
    {
        if (_selectedPiId is null || _exporting)
        {
            return;
        }

        try
        {
            _exporting = true;
            StateHasChanged();

            var bytes = RiskExcelExportService.Generate(_rows, SelectedPiName, _unitedComments);
            await DownloadService.DownloadAsync(bytes, RiskExcelExportService.BuildFileName(SelectedPiName));
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to export risks");
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private string RiskLabel(RiskVm risk) => $"{risk.Category.ToDisplayString()} #{OrderNumber(risk)}";

    private Task OpenNewDialogAsync() => OpenRiskDialogAsync(null);

    private Task OpenEditDialogAsync(RiskVm risk) => OpenRiskDialogAsync(risk.Id);

    private async Task OpenRiskDialogAsync(int? riskId)
    {
        if (_selectedPiId is not { } piId)
        {
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            { nameof(RiskEditDialog.PiId), piId },
            { nameof(RiskEditDialog.PiName), SelectedPiName },
            { nameof(RiskEditDialog.RiskId), riskId },
            { nameof(RiskEditDialog.CurrentUser), _userName },
            { nameof(RiskEditDialog.CanDelete), _canEdit && IsAdmin },
        };

        var title = riskId is null ? "New Risk" : "Edit Risk";

        var options = new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.False, FullWidth = false };
        var dialogRef = await MessageService.Component<RiskEditDialog>(title, parameters, options);
        var result = await dialogRef.Result;

        if (result is { Canceled: false })
        {
            await LoadRisksAsync();
        }
    }

    private async Task ShowCommentsAsync(RiskVm risk)
    {
        var title = RiskLabel(risk)
            + (string.IsNullOrWhiteSpace(risk.Summary) ? string.Empty : $" — {risk.Summary}");

        var parameters = new Dictionary<string, object?>
        {
            { nameof(RiskCommentsDialog.RiskId), risk.Id },
            { nameof(RiskCommentsDialog.RiskTitle), title },
            { nameof(RiskCommentsDialog.CurrentUser), _userName },
            { nameof(RiskCommentsDialog.ReadOnly), !_canEdit },
        };

        var options = new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.False, FullWidth = false };
        var dialogRef = await MessageService.Component<RiskCommentsDialog>(PlanningDisplayNames.RiskComments, parameters, options);
        await dialogRef.Result;

        try
        {
            var counts = await RiskCommentService.GetCountsAsync(new[] { risk.Id });
            _commentCounts[risk.Id] = counts.GetValueOrDefault(risk.Id);

            var united = await RiskCommentService.GetUnitedAsync(new[] { risk.Id }, UserTime.TimeZone);
            if (united.TryGetValue(risk.Id, out var text))
            {
                _unitedComments[risk.Id] = text;
            }
            else
            {
                _unitedComments.Remove(risk.Id);
            }

            RecomputeFilteredRows();
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Failed to refresh risk comments for risk {RiskId}", risk.Id);
        }
    }

