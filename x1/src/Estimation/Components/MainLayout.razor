@inherits LayoutComponentBase

@inject IWindowsAuthService WindowsAuthService
@inject IAppAuthorizationService AppAuthService
@inject IActiveDirectoryService AdService
@inject ISelfServiceResolver SelfServiceResolver
@inject IJiraAuthService JiraAuth
@inject IDialogService DialogService
@inject IModalDialogService MessageService
@inject IUserTimeZoneService UserTime
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS

@using Estimation.Core.JiraIntegration.Client
@using Estimation.Core.Administration.Models
@using Estimation.Core.Administration.Services

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_authChecked)
{
    <MudLayout>
        <MudMainContent Class="d-flex align-center justify-center" Style="min-height:100vh;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </MudMainContent>
    </MudLayout>
}
else if (!_isAuthorized)
{
    <MudLayout>
        <MudMainContent Class="d-flex align-center justify-center" Style="min-height:100vh;">
            @if (_selfService is { Teams.Count: > 0 })
            {
                <MudCard Style="max-width:560px; width:100%;">
                    <MudCardHeader>
                        <MudText Typo="Typo.h5">Hello, @_selfService.DisplayName</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body1" Class="mb-4">
                            You can fill in your own vacation for your team(s) below. To use the rest
                            of the application you need to request access.
                        </MudText>
                        <div class="d-flex flex-column gap-2 mb-4">
                            @foreach (var team in _selfService.Teams)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.BeachAccess"
                                           FullWidth="true"
                                           OnClick="@(() => Navigation.NavigateTo($"{RoutingPath.MyVacations}/{team.TeamId}"))">
                                    @team.TeamName — Vacations
                                </MudButton>
                            }
                        </div>
                        <MudDivider Class="my-3" />
                        @if (_accessRequested)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                Your access request has been submitted. Please wait for administrator approval.
                            </MudAlert>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="RequestAccessWithConfirmAsync"
                                       Disabled="_requestingAccess">
                                @if (_requestingAccess)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Request full access
                            </MudButton>
                        }
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <MudCard Style="max-width:500px; width:100%;">
                    <MudCardHeader>
                        <MudText Typo="Typo.h5" Color="Color.Error">Access Denied</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_accessRequested)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                                Your access request has been submitted. Please wait for administrator approval.
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                                You are not authorized to access this application.
                            </MudAlert>
                        }
                        <MudText Typo="Typo.body1">
                            User: <strong>@_userName</strong>
                        </MudText>
                        @if (!_accessRequested)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="mt-4"
                                       FullWidth="true"
                                       OnClick="RequestAccessAsync"
                                       Disabled="_requestingAccess">
                                @if (_requestingAccess)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Request Access
                            </MudButton>
                        }
                    </MudCardContent>
                </MudCard>
            }
        </MudMainContent>
    </MudLayout>
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            <MudSpacer />
            @if (JiraAuth.IsConfigured)
            {
                @if (_jiraConnected)
                {
                    <MudTooltip Text="Jira: Connected">
                        <MudIconButton Icon="@Icons.Material.Filled.CloudDone"
                                       Color="Color.Success"
                                       OnClick="OpenJiraDialogAsync" />
                    </MudTooltip>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CloudOff"
                               Class="mr-2"
                               OnClick="OpenJiraDialogAsync">
                        Login to Jira
                    </MudButton>
                }
            }
            <MudText Typo="Typo.body2" Class="mx-4">@_displayName</MudText>
            <GlobalFilterButton />
            <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="ToggleTheme" />
            </MudTooltip>
            @if (!string.IsNullOrWhiteSpace(TeamsGroupLink))
            {
                <MudTooltip Text="Open the support Teams group">
                    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline"
                                   Color="Color.Inherit"
                                   OnClick="OpenTeamsGroupAsync" />
                </MudTooltip>
            }
        </MudAppBar>
        <MudDrawer @bind-Open="@_open" Elevation="1">
            <MudNavMenu Class="mud-width-full">
                <MudText Typo="Typo.h6" Class="p-3">Capital PI Tool</MudText>
                <MudDivider Class="my-2" />

                @foreach (var navItem in _navPages.Where(p => p.Group is null))
                {
                    <MudNavLink Href="@GetPageHref(navItem.Key)" Match="@GetPageMatch(navItem.Key)" Icon="@GetPageIcon(navItem.Key)">@navItem.DisplayName</MudNavLink>

                }

                @foreach (var group in _navPages.Where(p => p.Group is not null).GroupBy(p => p.Group!).OrderBy(g => g.Min(p => p.SortOrder)))
                {
                    <MudNavGroup Title="@group.Key" Icon="@GetGroupIcon(group.Key)" Expanded="true">
                        @foreach (var navItem in group.OrderBy(p => p.SortOrder))
                        {
                            @if (navItem.Key == "Authorization" && _hasPendingRequests)
                            {
                                <MudNavLink Href="@GetPageHref(navItem.Key)" Match="@GetPageMatch(navItem.Key)" Icon="@GetPageIcon(navItem.Key)">
                                    @navItem.DisplayName
                                    <MudBadge Color="Color.Error" Dot="true" Overlap="true" Class="ml-2" />
                                </MudNavLink>
                            }
                            else
                            {
                                <MudNavLink Href="@GetPageHref(navItem.Key)" Match="@GetPageMatch(navItem.Key)" Icon="@GetPageIcon(navItem.Key)">@navItem.DisplayName</MudNavLink>
                            }
                        }
                    </MudNavGroup>
                }

            </MudNavMenu>
        </MudDrawer>
        <MudMainContent>
            <CascadingValue Value="_isAdmin" Name="IsAdmin">
                <CascadingValue Value="_userPageAccess" Name="UserPageAccess">
                    @Body
                </CascadingValue>
            </CascadingValue>
        </MudMainContent>
    </MudLayout>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _isDarkMode;
    bool _open = true;
    private bool _authChecked;
    private bool _isAuthorized;
    private bool _isAdmin;
    private string? _userName;
    private string? _displayName;
    private bool _jiraConnected;
    private bool _accessRequested;
    private bool _requestingAccess;
    private bool _hasPendingRequests;
    private SelfServiceContext? _selfService;
    private List<NavPageInfo> _navPages = [];
    private Dictionary<string, AccessLevel> _userPageAccess = new(StringComparer.OrdinalIgnoreCase);

    private string? TeamsGroupLink => Configuration["TeamsGroupLink"];

    protected override async Task OnInitializedAsync()
    {
        _userName = await WindowsAuthService.GetUserName();

        if (_userName is null)
        {
            _authChecked = true;
            return;
        }

        var currentUser = await AppAuthService.GetCurrentUserAsync(_userName);
        _isAuthorized = currentUser is not null && currentUser.IsApproved;
        _accessRequested = currentUser is not null && currentUser.IsAccessRequested && !currentUser.IsApproved;
        _displayName = string.IsNullOrWhiteSpace(currentUser?.DisplayName) ? _userName : currentUser.DisplayName;

        if (_isAuthorized)
        {
            _isAdmin = currentUser!.IsAdmin;
            _navPages = await AppAuthService.GetNavigationPagesAsync(_userName);
            _userPageAccess = _navPages.ToDictionary(p => p.Key, p => p.AccessLevel, StringComparer.OrdinalIgnoreCase);

            if (_isAdmin)
            {
                _hasPendingRequests = await AppAuthService.HasPendingRequestsAsync();
            }

            if (JiraAuth.IsConfigured)
            {
                _jiraConnected = await JiraAuth.IsAuthenticatedAsync(_userName);
            }
        }
        else
        {
            // Unapproved user: offer self-service vacation entry when they match an HR record
            // (via the AD EmployeeId) and belong to at least one team.
            _selfService = await SelfServiceResolver.ResolveAsync();
        }

        _authChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserTime.EnsureResolvedAsync();
        }
    }

    private async Task RequestAccessAsync()
    {
        if (_userName is null)
        {
            return;
        }

        _requestingAccess = true;
        var adInfo = AdService.GetUser(_userName);
        await AppAuthService.RequestAccessAsync(_userName, adInfo?.DisplayName, adInfo?.SamAccountName, adInfo?.EmployeeId, adInfo?.EmailAddress);
        if (!string.IsNullOrWhiteSpace(adInfo?.DisplayName))
        {
            _displayName = adInfo.DisplayName;
        }
        _accessRequested = true;
        _requestingAccess = false;
    }

    private async Task RequestAccessWithConfirmAsync()
    {
        if (await MessageService.Confirm("Request access to the full application?"))
        {
            await RequestAccessAsync();
        }
    }

    private string GetPageHref(string key) => key switch
    {
        "Dashboard" => RoutingPath.Base,
        "Pis" => RoutingPath.Pis,
        "Departments" => RoutingPath.Departments,
        "CapitalProjects" => RoutingPath.CapitalProjects,
        "StrategicObjectives" => RoutingPath.StrategicObjectives,
        "PortfolioEpics" => RoutingPath.PortfolioEpics,
        "BusinessOutcomes" => RoutingPath.BusinessOutcomes,
        "Features" => RoutingPath.Features,
        "FeatureSnapshots" => RoutingPath.FeatureSnapshots,
        "Teams" => RoutingPath.Teams,
        "HumanResources" => RoutingPath.HumanResources,
        "Skills" => RoutingPath.Skills,
        "TechnologyStacks" => RoutingPath.TechnologyStacks,
        "AuditLog" => RoutingPath.AuditLog,
        "StaticSettings" => RoutingPath.StaticSettings,
        "Authorization" => RoutingPath.Authorization,
        "Profiles" => RoutingPath.Profiles,
        "DatabaseBackup" => RoutingPath.DatabaseBackup,
        "JiraSync" => RoutingPath.JiraSync,
        "HolidaysSetup" => RoutingPath.HolidaysSetup,
        "TeamPlanningCapacity" => RoutingPath.TeamPlanningCapacity,
        "TeamPlanningHolidays" => RoutingPath.TeamPlanningHolidays,
        "TeamPlanningCoefficients" => RoutingPath.TeamPlanningCoefficients,
        "TeamPlanningSprints" => RoutingPath.TeamPlanningSprints,
        "MasterSheet"=>RoutingPath.MasterSheet,
        "Risks" => RoutingPath.Risks,
        _ => RoutingPath.Base
    };

    private NavLinkMatch GetPageMatch(string key)
    {
        var href = GetPageHref(key);

        if (string.IsNullOrEmpty(href))
        {
            return NavLinkMatch.All;
        }

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var currentPath = "/" + relative.TrimEnd('/');

        var underMoreSpecificPage = _navPages
            .Select(p => GetPageHref(p.Key))
            .Any(other => other.StartsWith($"{href}/", StringComparison.OrdinalIgnoreCase)
                && (currentPath.Equals(other, StringComparison.OrdinalIgnoreCase)
                    || currentPath.StartsWith($"{other}/", StringComparison.OrdinalIgnoreCase)));

        return underMoreSpecificPage ? NavLinkMatch.All : NavLinkMatch.Prefix;
    }

    private string GetPageIcon(string key) => key switch
    {
        "Dashboard" => Icons.Material.Filled.Dashboard,
        "Pis" => Icons.Material.Filled.DateRange,
        "Departments" => Icons.Material.Filled.CorporateFare,
        "CapitalProjects" => Icons.Material.Filled.Business,
        "StrategicObjectives" => Icons.Material.Filled.Schema,
        "PortfolioEpics" => Icons.Material.Filled.Layers,
        "BusinessOutcomes" => Icons.Material.Filled.TrackChanges,
        "Features" => Icons.Material.Filled.Extension,
        "FeatureSnapshots" => Icons.Material.Filled.PhotoCamera,
        "Teams" => Icons.Material.Filled.Group,
        "HumanResources" => Icons.Material.Filled.Person,
        "Skills" => Icons.Material.Filled.Psychology,
        "TechnologyStacks" => Icons.Material.Filled.Layers,
        "AuditLog" => Icons.Material.Filled.History,
        "StaticSettings" => Icons.Material.Filled.Settings,
        "Authorization" => Icons.Material.Filled.AdminPanelSettings,
        "Profiles" => Icons.Material.Filled.Badge,
        "DatabaseBackup" => Icons.Material.Filled.Backup,
        "JiraSync" => Icons.Material.Filled.Sync,
        "HolidaysSetup" => Icons.Material.Filled.BeachAccess,
        "TeamPlanningCapacity" => Icons.Material.Filled.Insights,
        "TeamPlanningHolidays" => Icons.Material.Filled.BeachAccess,
        "TeamPlanningCoefficients" => Icons.Material.Filled.Tune,
        "TeamPlanningSprints" => Icons.Material.Filled.Speed,
        "MasterSheet" => Icons.Material.Filled.Dataset,
        "Risks" => Icons.Material.Filled.ReportProblem,
        _ => Icons.Material.Filled.Circle
    };

    private string GetGroupIcon(string group) => group switch
    {
        "Planning" => Icons.Material.Filled.AccountTree,
        "Resources" => Icons.Material.Filled.People,
        "Team planning" => Icons.Material.Filled.CalendarMonth,
        "Admin" => Icons.Material.Filled.AdminPanelSettings,
        _ => Icons.Material.Filled.Folder
    };

    private async Task OpenJiraDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialogRef = await DialogService.ShowAsync<JiraLoginDialog>("Jira Authentication", options);
        var result = await dialogRef.Result;

        if (result?.Data is bool connected)
        {
            _jiraConnected = connected;
        }
        else if (_userName is not null)
        {
            _jiraConnected = await JiraAuth.IsAuthenticatedAsync(_userName);
        }
    }

    private async Task OpenTeamsGroupAsync()
    {
        var link = TeamsGroupLink;

        if (string.IsNullOrWhiteSpace(link))
        {
            return;
        }

        await JS.InvokeVoidAsync("open", link, "_blank");
    }

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    void ToggleDrawer()
    {
        _open = !_open;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Indigo.Lighten1,
            Secondary = Colors.Pink.Accent2,
            AppbarBackground = Colors.Indigo.Lighten5,
            AppbarText = Colors.Shades.Black,
            DrawerBackground = Colors.Indigo.Lighten5,
            Background = Colors.Gray.Lighten4,
        },
    };
}
