        if (!string.Equals(_model.Status?.Trim(), jiraIssue.Status?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            var jiraVal = jiraIssue.Status;
            var dbVal = _model.Status;
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.Status),
                DisplayName = "Status",
                JiraDisplay = jiraVal,
                DbDisplay = dbVal,
                ApplyJira = Sync(() => _model.Status = jiraVal),
                ApplyDb = Sync(() => _model.Status = dbVal),
            });
        }

        var jiraLabels = jiraIssue.Labels is { Count: > 0 }
            ? string.Join(",", jiraIssue.Labels.OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
            : null;
        var dbLabelsSorted = string.IsNullOrEmpty(_model.Labels)
            ? null
            : string.Join(",", _model.Labels
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .OrderBy(x => x, StringComparer.OrdinalIgnoreCase));
        if (!string.Equals(jiraLabels, dbLabelsSorted, StringComparison.Ordinal))
        {
            var jiraDisplay = jiraIssue.Labels is { Count: > 0 } ? string.Join(", ", jiraIssue.Labels) : null;
            var dbDisplay = string.IsNullOrEmpty(_model.Labels)
                ? null
                : string.Join(", ", _model.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
            var dbLabelsRaw = _model.Labels;
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.Labels),
                DisplayName = PlanningDisplayNames.Labels,
                JiraDisplay = jiraDisplay,
                DbDisplay = dbDisplay,
                ApplyJira = Sync(() =>
                {
                    _model.Labels = jiraIssue.Labels is { Count: > 0 } ? string.Join(",", jiraIssue.Labels) : null;
