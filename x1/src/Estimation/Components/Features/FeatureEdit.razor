    private async Task OpenGetJiraDialogAsync()
    {
        if (!_jiraConnected)
        {
            return;
        }

        var parameters = new DialogParameters<JiraFetchDialog>
        {
            { x => x.InitialJiraId, _model.JiraId }
        };
