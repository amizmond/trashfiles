                ApplyDb = Sync(() => _model.StoryPoints = dbVal),
            });
        }

        BuildTeamsDiff(jiraIssue);
    }

    private void BuildTeamsDiff(JiraIssueResponse jiraIssue)
    {
        var dbTeamIds = _model.FeatureTeams.Select(ft => ft.TeamId).ToList();
        var dbTeams = dbTeamIds
            .Select(id => _allTeams.FirstOrDefault(t => t.Id == id))
            .Where(t => t is not null)
            .Cast<Team>()
            .ToList();

        var jiraTeams = new List<Team>();
        foreach (var jt in JiraTeamMatcher.SplitJiraValue(jiraIssue.GfedTeam))
        {
            var match = JiraTeamMatcher.Match(jt, _allTeams);
            if (match is not null && jiraTeams.All(t => t.Id != match.Id))
            {
                jiraTeams.Add(match);
            }
        }

        var dbCanonical = dbTeams
            .Select(JiraTeamMatcher.CanonicalName)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var jiraCanonical = jiraTeams
            .Select(JiraTeamMatcher.CanonicalName)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (dbCanonical.SequenceEqual(jiraCanonical, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        var jiraTeamIds = jiraTeams.Select(t => t.Id).ToList();

        AddDiff(new FieldDiff
        {
            Key = "FeatureTeams",
            DisplayName = PlanningDisplayNames.Teams,
            JiraDisplay = jiraCanonical.Count > 0 ? string.Join(", ", jiraCanonical) : null,
            DbDisplay = dbCanonical.Count > 0 ? string.Join(", ", dbCanonical) : null,
            ApplyJira = () => SetFeatureTeamsAsync(jiraTeamIds),
            ApplyDb = () => SetFeatureTeamsAsync(dbTeamIds),
        });
    }

    private async Task SetFeatureTeamsAsync(IReadOnlyList<int> targetTeamIds)
    {
        var current = _model.FeatureTeams.Select(ft => ft.TeamId).ToHashSet();
        var target = targetTeamIds.ToHashSet();

        foreach (var removeId in current.Except(target).ToList())
        {
            await FeatureService.RemoveTeamAsync(_model.Id, removeId);
            _model.FeatureTeams = _model.FeatureTeams.Where(ft => ft.TeamId != removeId).ToList();
            _persistedTeamIds.Remove(removeId);
        }

        foreach (var addId in target.Except(current).ToList())
        {
            await FeatureService.AddTeamAsync(_model.Id, addId);
            var team = _allTeams.FirstOrDefault(t => t.Id == addId);
            if (team is null)
            {
                continue;
            }
            _model.FeatureTeams.Add(new FeatureTeam
            {
                FeatureId = _model.Id,
                TeamId = addId,
                Team = team,
            });
            _persistedTeamIds.Add(addId);
        }
        RecomputeSkillRows();
    }

    private void AddDiff(FieldDiff diff)
    {
        _fieldDiffs[diff.Key] = diff;
    }

    private async Task OnDiffChoiceChanged(FieldDiff diff, DiffSource source)
    {
        diff.Choice = source;
        if (source == DiffSource.Jira)
        {
            await diff.ApplyJira();
        }
        else if (source == DiffSource.Db)
        {
            await diff.ApplyDb();
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        foreach (var cts in _debounceCts.Values)
        {
            try
            {
                cts.Cancel();
            }
            catch (ObjectDisposedException)
            {
            }
            cts.Dispose();
        }
        _debounceCts.Clear();
    }
