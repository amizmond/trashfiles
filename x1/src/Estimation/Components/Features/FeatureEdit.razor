    private static bool HasStacks(FeatureTeam ft) => ft.TechnologyStacks.Any();
    private static int TeamStackSum(FeatureTeam ft) => ft.TechnologyStacks.Sum(s => s.StoryPoints ?? 0);

    private static string StackKey(int teamId, int stackId) => $"{teamId}-{stackId}";
    private bool IsExpanded(int teamId, int stackId) => _expandedStacks.Contains(StackKey(teamId, stackId));
    private void ToggleExpand(int teamId, int stackId)
    {
        var key = StackKey(teamId, stackId);
        if (!_expandedStacks.Add(key))
        {
            _expandedStacks.Remove(key);
        }
    }

    private int? GetSelectedStackForTeam(FeatureTeam ft)
    {
        if (_selectedStackByTeam.TryGetValue(ft.TeamId, out var v))
        {
            return v;
        }
        var available = AvailableStackIdsForTeam(ft).ToList();
        return available.Count == 1 ? available[0] : null;
    }
    private void SetSelectedStackForTeam(int teamId, int? value) => _selectedStackByTeam[teamId] = value;

    private IEnumerable<int?> AvailableStackIdsForTeam(FeatureTeam ft)
    {
        var owned = _teamStackIds.TryGetValue(ft.TeamId, out var ids) ? ids : Array.Empty<int>();
        return _allStacks
            .Where(s => owned.Contains(s.Id) && ft.TechnologyStacks.All(x => x.TechnologyStackId != s.Id))
            .Select(s => (int?)s.Id);
    }

    private bool TeamOwnsNoStacks(FeatureTeam ft) =>
        !_teamStackIds.TryGetValue(ft.TeamId, out var ids) || ids.Count == 0;

    private static decimal SkillValueOf(FeatureTeamTechnologyStack ftts, int skillId) =>
        ftts.SkillValues.FirstOrDefault(x => x.SkillId == skillId)?.Value ?? 0m;

    private async Task AddTeamStackAsync(FeatureTeam ft)
    {
        if (!IsTeamPersisted(ft))
        {
            return;
        }
        var stackId = GetSelectedStackForTeam(ft);
        if (stackId is null)
        {
            return;
        }
        await FeatureSkillService.AddTeamStackAsync(ft.FeatureId, ft.TeamId, stackId.Value);
        var stack = _allStacks.FirstOrDefault(s => s.Id == stackId.Value);
        if (stack is null)
        {
            return;
        }
        ft.TechnologyStacks.Add(new FeatureTeamTechnologyStack
        {
            FeatureId = ft.FeatureId,
            TeamId = ft.TeamId,
            TechnologyStackId = stackId.Value,
            TechnologyStack = stack,
            StoryPoints = null,
            SkillValues = new List<FeatureTeamStackSkill>()
        });
        SetSelectedStackForTeam(ft.TeamId, null);
        await RecomputeAndPersistTeamSumAsync(ft);
        RecomputeSkillRows();
    }

    private async Task RemoveTeamStackAsync(FeatureTeam ft, FeatureTeamTechnologyStack ftts)
    {
        await FeatureSkillService.RemoveTeamStackAsync(ft.FeatureId, ft.TeamId, ftts.TechnologyStackId);
        ft.TechnologyStacks = ft.TechnologyStacks.Where(x => x.TechnologyStackId != ftts.TechnologyStackId).ToList();
        _expandedStacks.Remove(StackKey(ft.TeamId, ftts.TechnologyStackId));
        await RecomputeAndPersistTeamSumAsync(ft);
        RecomputeSkillRows();
    }

    private async Task OnTeamStackStoryPointsChanged(FeatureTeam ft, FeatureTeamTechnologyStack ftts, int? value)
    {
        ftts.StoryPoints = value;
        ApplySplitInMemory(ftts);
        await RecomputeAndPersistTeamSumAsync(ft);
        RecomputeSkillRows();
        Debounce($"teamstack-{ft.TeamId}-{ftts.TechnologyStackId}", () =>
            FeatureSkillService.SetTeamStackStoryPointsAsync(ft.FeatureId, ft.TeamId, ftts.TechnologyStackId, value));
    }

    private async Task OnTeamStackSkillValueChanged(FeatureTeam ft, FeatureTeamTechnologyStack ftts, int skillId, decimal value)
    {
        var v = value < 0m ? 0m : value;
        var sv = ftts.SkillValues.FirstOrDefault(x => x.SkillId == skillId);
        if (sv is null)
        {
            sv = new FeatureTeamStackSkill
            {
                FeatureId = ft.FeatureId,
                TeamId = ft.TeamId,
                TechnologyStackId = ftts.TechnologyStackId,
                SkillId = skillId,
                Skill = _allSkills.FirstOrDefault(s => s.Id == skillId)!
            };
            ftts.SkillValues.Add(sv);
        }
        sv.Value = v;

        ftts.StoryPoints = (int)Math.Round(ftts.SkillValues.Sum(x => x.Value));

        await RecomputeAndPersistTeamSumAsync(ft);
        RecomputeSkillRows();

        Debounce($"teamstackskill-{ft.TeamId}-{ftts.TechnologyStackId}-{skillId}", () =>
            FeatureSkillService.SetTeamStackSkillValueAsync(ft.FeatureId, ft.TeamId, ftts.TechnologyStackId, skillId, v));
        Debounce($"teamstackpts-{ft.TeamId}-{ftts.TechnologyStackId}", () =>
            FeatureSkillService.SetTeamStackStoryPointsValueOnlyAsync(ft.FeatureId, ft.TeamId, ftts.TechnologyStackId, ftts.StoryPoints));
    }

    private void ApplySplitInMemory(FeatureTeamTechnologyStack ftts)
    {
        var skills = ftts.TechnologyStack.TechnologyStackSkills
            .Select(tss => (tss.SkillId, tss.Percentage))
            .ToList();
        var split = StoryPointSplitter.Split(ftts.StoryPoints ?? 0, skills);

        var rebuilt = new List<FeatureTeamStackSkill>();
        foreach (var tss in ftts.TechnologyStack.TechnologyStackSkills)
        {
            rebuilt.Add(new FeatureTeamStackSkill
            {
                FeatureId = ftts.FeatureId,
                TeamId = ftts.TeamId,
                TechnologyStackId = ftts.TechnologyStackId,
                SkillId = tss.SkillId,
                Skill = tss.Skill,
                Value = split.TryGetValue(tss.SkillId, out var v) ? v : 0
            });
        }
        ftts.SkillValues = rebuilt;
    }

    private async Task RecomputeAndPersistTeamSumAsync(FeatureTeam ft)
    {
        if (ft.TechnologyStacks.Any())
        {
            var sum = TeamStackSum(ft);
            ft.StoryPoints = sum;
            await FeatureService.SetFeatureTeamStoryPointsAsync(ft.FeatureId, ft.TeamId, sum);
        }
    }

    private void RecomputeSkillRows()
    {
        var map = new Dictionary<int, FeatureSkillRow>();

        foreach (var ft in _model.FeatureTeams)
        {
            foreach (var ftts in ft.TechnologyStacks)
            {
                foreach (var sv in ftts.SkillValues)
                {
                    if (!map.TryGetValue(sv.SkillId, out var r))
                    {
                        r = new FeatureSkillRow { SkillId = sv.SkillId, SkillName = sv.Skill?.Name ?? SkillName(sv.SkillId) };
                        map[sv.SkillId] = r;
                    }
                    r.TeamsEstimation += sv.Value;
                }
            }
        }

        foreach (var fs in _model.FeatureSkills)
        {
            if (!map.TryGetValue(fs.SkillId, out var r))
            {
                r = new FeatureSkillRow { SkillId = fs.SkillId, SkillName = fs.Skill?.Name ?? SkillName(fs.SkillId) };
                map[fs.SkillId] = r;
            }
            r.GeneralEstimation = fs.Value;
            r.HasGeneralRow = true;
        }

        _skillRows = map.Values.OrderBy(r => r.SkillName).ToList();
    }

    private static string FormatNum(decimal d) =>
        d == Math.Truncate(d) ? ((long)d).ToString() : d.ToString("0.##");

    private void Debounce(string key, Func<Task> action)
    {
        if (_debounceCts.TryGetValue(key, out var existing))
        {
            existing.Cancel();
            existing.Dispose();
        }
        var cts = new CancellationTokenSource();
        _debounceCts[key] = cts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, cts.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            if (_disposed)
            {
                return;
            }

            try
            {
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await action();
                    }
                    catch (Exception ex)
                    {
                        Log.Error(ex, "Debounced save failed for {Key}", key);
                        Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
                    }
                });
            }
            catch (Exception ex) when (!_disposed)
            {
                Log.Error(ex, "Debounced InvokeAsync failed for {Key}", key);
            }
        });
    }

    private async Task LoadJiraDataAsync()
    {
        if (_isNew || string.IsNullOrWhiteSpace(_model.JiraId) || !_jiraConnected)
        {
            return;
        }

        _loadingJira = true;
        _jiraWarning = null;
        _fieldDiffs.Clear();
        StateHasChanged();

        try
        {
            var jiraIssue = await JiraIssueService.GetIssueAsync(_userName!, _model.JiraId);
            if (_disposed)
            {
                return;
            }
            if (jiraIssue is null)
            {
                _jiraWarning = $"Jira issue '{_model.JiraId}' was not found.";
            }
            else
            {
                BuildJiraDiffs(jiraIssue);
                if (_fieldDiffs.Count == 0)
                {
                    Snackbar.Add("Feature matches Jira — no differences.", Severity.Success);
                }
            }
        }
        catch (Exception ex) when (!_disposed)
        {
            Log.Error(ex, "Failed to load Jira data for issue {JiraId}", _model.JiraId);
            _jiraWarning = $"Failed to read from Jira: {ex.Message}";
        }
        finally
        {
            if (!_disposed)
            {
                _loadingJira = false;
                StateHasChanged();
            }
        }
    }

