                JiraDisplay = jiraVal,
                DbDisplay = dbVal,
                ApplyJira = Sync(() => _model.AcceptanceCriteria = jiraVal),
                ApplyDb = Sync(() => _model.AcceptanceCriteria = dbVal),
            });
        }

        if (!string.Equals(_model.NavigatorId?.Trim(), jiraIssue.NavigatorId?.Trim(), StringComparison.Ordinal))
        {
            var jiraVal = jiraIssue.NavigatorId;
            var dbVal = _model.NavigatorId;
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.NavigatorId),
                DisplayName = PlanningDisplayNames.NavigatorId,
                JiraDisplay = jiraVal,
                DbDisplay = dbVal,
                ApplyJira = Sync(() => _model.NavigatorId = jiraVal),
                ApplyDb = Sync(() => _model.NavigatorId = dbVal),
            });
        }

        if (!string.IsNullOrEmpty(jiraIssue.IssueType)
            && !string.Equals(_model.IssueType?.Trim(), jiraIssue.IssueType?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            var jiraVal = jiraIssue.IssueType;
            var dbVal = _model.IssueType;
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.IssueType),
                DisplayName = PlanningDisplayNames.IssueType,
                JiraDisplay = jiraVal,
                DbDisplay = dbVal,
                ApplyJira = Sync(() => _model.IssueType = jiraVal),
                ApplyDb = Sync(() => _model.IssueType = dbVal),
            });
        }

        if ((string.Equals(_model.IssueType, JiraIssueTypes.Feature, StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(_model.IssueType))
            && !string.Equals(_model.Name?.Trim(), jiraIssue.FeatureName?.Trim(), StringComparison.Ordinal))
        {
            var jiraVal = jiraIssue.FeatureName;
            var dbVal = _model.Name;
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.Name),
                DisplayName = PlanningDisplayNames.FeatureName,
