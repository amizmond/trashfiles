        await FetchJiraForNewAsync();
    }

    private async Task FetchJiraForNewAsync()
    {
        NormalizeJiraId();
        if (string.IsNullOrWhiteSpace(_model.JiraId) || !_jiraConnected)
        {
            return;
        }

        _loadingJira = true;
        _error = null;
        _jiraWarning = null;
        StateHasChanged();

        try
        {
            var jiraIssue = await JiraIssueService.GetIssueAsync(_userName!, _model.JiraId);
            if (jiraIssue is null)
            {
                _error = $"Jira issue '{_model.JiraId}' was not found.";
                return;
            }

            _model.Summary = jiraIssue.Summary ?? _model.Summary;
            _model.Description = jiraIssue.Description ?? _model.Description;
            _model.AcceptanceCriteria = jiraIssue.AcceptanceCriteria ?? _model.AcceptanceCriteria;
            _model.NavigatorId = jiraIssue.NavigatorId ?? _model.NavigatorId;
            _model.Status = jiraIssue.Status ?? _model.Status;

            if (!string.IsNullOrWhiteSpace(jiraIssue.FeatureName))
            {
                _model.Name = jiraIssue.FeatureName;
            }

            if (!string.IsNullOrWhiteSpace(jiraIssue.RagExplain))
            {
                _model.RagExplain = jiraIssue.RagExplain;
            }

            if (!string.IsNullOrWhiteSpace(jiraIssue.IssueType))
            {
                _model.IssueType = jiraIssue.IssueType;
            }

            if (jiraIssue.Labels is { Count: > 0 })
            {
                _model.Labels = string.Join(",", jiraIssue.Labels);
                SyncLabelsFromModel();
            }

            _model.TargetStart = jiraIssue.TargetStart;
            _model.TargetEnd = jiraIssue.TargetEnd;
            _model.StoryPoints = jiraIssue.StoryPoints;

            var dashIndex = _model.JiraId.IndexOf('-');
            if (dashIndex > 0)
            {
                var projectKey = _model.JiraId[..dashIndex];
                if (_allCapitalProjects.Any(c => string.Equals(c.JiraKey, projectKey, StringComparison.OrdinalIgnoreCase)))
                {
                    _model.ProjectKey = projectKey;
                    await LoadLabelsAsync(projectKey);
                    await LoadStatusesAsync(projectKey);
                }
            }

            Snackbar.Add("Jira data loaded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to fetch Jira data for issue {JiraId}", _model.JiraId);
            _error = $"Failed to fetch from Jira: {ex.Message}";
        }
        finally
        {
            _loadingJira = false;
        }
    }

    private void BuildJiraDiffs(JiraIssueResponse jiraIssue)
    {
        var jiraProject = JiraSyncItemMapping.ProjectKeyFromJiraKey(jiraIssue.Key);
        var dbProject = string.IsNullOrWhiteSpace(_model.ProjectKey) ? null : _model.ProjectKey.Trim();
        if (!string.Equals(dbProject, jiraProject, StringComparison.OrdinalIgnoreCase))
        {
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.ProjectKey),
                DisplayName = PlanningDisplayNames.Project,
                JiraDisplay = jiraProject,
                DbDisplay = dbProject,
                ApplyJira = async () =>
                {
                    _model.ProjectKey = jiraProject;
                    if (_jiraConnected && !string.IsNullOrWhiteSpace(jiraProject))
                    {
                        await LoadLabelsAsync(jiraProject);
                        await LoadStatusesAsync(jiraProject);
                    }
                },
                ApplyDb = async () =>
                {
                    _model.ProjectKey = dbProject;
                    if (_jiraConnected && !string.IsNullOrWhiteSpace(dbProject))
                    {
                        await LoadLabelsAsync(dbProject);
                        await LoadStatusesAsync(dbProject);
                    }
                },
            });
        }

        if (!string.Equals(_model.Summary?.Trim(), jiraIssue.Summary?.Trim(), StringComparison.Ordinal))
        {
            var jiraVal = jiraIssue.Summary;
            var dbVal = _model.Summary;
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.Summary),
                DisplayName = PlanningDisplayNames.Summary,
                JiraDisplay = jiraVal,
                DbDisplay = dbVal,
                ApplyJira = Sync(() => _model.Summary = jiraVal ?? string.Empty),
                ApplyDb = Sync(() => _model.Summary = dbVal ?? string.Empty),
            });
        }

        if (!string.Equals(_model.Description?.Trim(), jiraIssue.Description?.Trim(), StringComparison.Ordinal))
        {
            var jiraVal = jiraIssue.Description;
            var dbVal = _model.Description;
            AddDiff(new FieldDiff
            {
                Key = nameof(_model.Description),
                DisplayName = PlanningDisplayNames.Description,
                JiraDisplay = jiraVal,
                DbDisplay = dbVal,
                ApplyJira = Sync(() => _model.Description = jiraVal),
