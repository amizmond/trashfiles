    private bool CanRemoveSkill(FeatureSkillRow row) =>
        row.GeneralEstimation == 0m && !IsSkillInSelectedTeamStack(row.SkillId);

    private bool IsSkillInSelectedTeamStack(int skillId) =>
        _model.FeatureTeams
            .SelectMany(ft => ft.TechnologyStacks)
            .SelectMany(s => s.TechnologyStack.TechnologyStackSkills)
            .Any(tss => tss.SkillId == skillId);

    private async Task RemoveSkillAsync(FeatureSkillRow row)
    {
        if (!CanRemoveSkill(row))
        {
