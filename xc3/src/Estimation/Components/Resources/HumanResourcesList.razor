    private async Task ApplyFiltersAsync()
    {
        RebuildChoices();
        if (ActiveFilterCount == 0 && !GlobalFilter.Values.IsEmpty)
        {
            _globalFilterCleared = true;
        }

        await ReloadFirstPageAsync();
    }

    private async Task ReloadFirstPageAsync()
    {
        if (_table is null)
        {
            return;
        }

        if (_table.CurrentPage != 0)
        {
            _table.NavigateTo(0);
            return;
        }

        await _table.ReloadServerData();
    }

    private void ResetFilters()
    {
        _searchTerm = null;
        _filterActiveStatus = null;
        _filterSkillNames = [];
        _filterSkillAll = false;
        _filterTeamNames = [];
        _filterTeamNot = false;
        _filterTeamRoleNames = [];
        _filterArtNames = [];
        _filterDepartmentNames = [];

        foreach (var filter in ValueFilters)
        {
            filter.Reset();
        }
    }

    private async Task ClearFilters()
    {
        ResetFilters();
        _globalFilterCleared = true;
        RebuildChoices();
        await ReloadFirstPageAsync();
    }

    private async Task ConfirmDeleteAsync(HumanResourceListItem hr)
    {
        try
        {
            if (await MessageService.Confirm($"Permanently delete {hr.FullName}? This cannot be undone."))
            {
                await DeleteAsync(hr);
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, ex.Message);
            await MessageService.Exception(ex);
        }
    }

    private async Task DeleteAsync(HumanResourceListItem hr)
    {
        try
        {
            await HrService.DeleteAsync(hr.Id);
            if (_table is not null)
            {
                await _table.ReloadServerData();
            }
            Snackbar.Add($"{hr.FullName} deleted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

