    private HumanResourceFilter BuildCurrentFilter() => new()
    {
        Search = _searchTerm,
        SkillNames = ListOrNull(_filterSkillNames),
        AllSkills = _filterSkillAll,
        IsActive = _filterActiveStatus switch
        {
            ActiveStatus => true,
            InactiveStatus => false,
            _ => null
        },
        TeamNames = ListOrNull(_filterTeamNames),
        TeamNot = _filterTeamNot,
        TeamRoleNames = ListOrNull(_filterTeamRoleNames),
        ArtNames = ListOrNull(_filterArtNames),
        DepartmentNames = ListOrNull(_filterDepartmentNames),
        EmployeeCategoryNames = _employeeCategory.SelectedOrNull,
        EmployeeCategoryNot = _employeeCategory.Not,
        EmployeeTypeNames = _employeeType.SelectedOrNull,
        EmployeeTypeNot = _employeeType.Not,
        EmployeeRoleNames = _employeeRole.SelectedOrNull,
        EmployeeRoleNot = _employeeRole.Not,
        EmployeeVendorNames = _employeeVendor.SelectedOrNull,
        EmployeeVendorNot = _employeeVendor.Not,
        CorporateGradeNames = _corporateGrade.SelectedOrNull,
        CorporateGradeNot = _corporateGrade.Not,
        CountryNames = _country.SelectedOrNull,
        CountryNot = _country.Not,
        CityNames = _city.SelectedOrNull,
        CityNot = _city.Not,
        AllowedArtIds = _allowedTrainIds,
    };

    private static List<string>? ListOrNull(IReadOnlyCollection<string> values) =>
        values.Count > 0 ? values.ToList() : null;

    private async Task ExportFilteredAsync()
    {
        if (_matchCount == 0)
        {
            Snackbar.Add("No filtered resources to export.", Severity.Warning);
            return;
        }

        var states = PickerColumns.Select(c => new HrColumnState
        {
            Column = c.Column,
            Label = c.Label,
            Selected = !ExportOffByDefault.Contains(c.Column),
            Editable = true,
            IsMain = MainColumns.Contains(c.Column)
        }).ToList();

        var selection = await ShowColumnPickerAsync(
            "Choose columns to export",
            "Exports the resources matching the current filters. Select the columns to include.",
            "Export",
            states);
        if (selection is null)
        {
            return;
        }

        try
        {
            _exporting = true;
            StateHasChanged();

            var bytes = await HrUploadService.ExportFilteredAsync(selection, BuildCurrentFilter());
            await DownloadService.DownloadAsync(bytes, "Resources.xlsx");
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to export resources");
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private async Task OnUploadFileSelected(IBrowserFile file)
    {
        if (file == null)
        {
            return;
        }

        MemoryStream? stream = null;
        try
        {
            stream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            var present = await HrUploadService.DetectColumnsAsync(stream);

            if (!present.Contains(HrUploadColumn.FullName))
            {
                Snackbar.Add("The file must contain a 'Full Name' column to import.", Severity.Error);
                return;
            }

            var states = PickerColumns.Select(c =>
            {
                var isPresent = present.Contains(c.Column);
                var isMain = MainColumns.Contains(c.Column);
                return new HrColumnState
                {
                    Column = c.Column,
                    Label = c.Label,
                    Selected = isPresent,
                    Editable = isPresent && !isMain,
                    IsMain = isMain && isPresent
                };
            }).ToList();

            var selection = await ShowColumnPickerAsync(
                "Choose columns to import",
                "Columns not found in the uploaded file are disabled. Unchecked columns keep their existing values.",
                "Continue",
                states);
            if (selection is null)
            {
                return;
            }

            _exporting = true;
            StateHasChanged();

            stream.Position = 0;
            var rows = await HrUploadService.ParseFileAsync(stream, selection);
            UploadPreview.PendingUpload = rows;
            UploadPreview.ImportedColumns = selection;
            Navigation.NavigateTo(RoutingPath.HumanResourcesUploadPreview);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to parse uploaded file");
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            if (stream is not null)
            {
                await stream.DisposeAsync();
            }
            StateHasChanged();
        }
    }

    private async Task<HrUploadColumnSelection?> ShowColumnPickerAsync(
        string title, string description, string confirmLabel, List<HrColumnState> states)
    {
        var parameters = new DialogParameters<ResourceColumnPickerDialog>
        {
            { x => x.Columns, states },
            { x => x.Description, description },
            { x => x.ConfirmLabel, confirmLabel },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ResourceColumnPickerDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not HrUploadColumnSelection selection)
        {
            return null;
        }
        return selection;
    }
