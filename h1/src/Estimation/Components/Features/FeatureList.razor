                <PropertyColumn Property="r => r.RagExplain" Sortable="false" CellStyle="min-width:100px; max-width:400px;" Hidden="!_showRagExplain">
                    <HeaderTemplate>@SortableHeader(SortableRagExplain, PlanningDisplayNames.RagExplain)</HeaderTemplate>
                </PropertyColumn>

                <PropertyColumn Property="r => r.Dependencies" Sortable="false" CellStyle="min-width:100px; max-width:400px;" Hidden="!_showDependencies">
                    <HeaderTemplate>@SortableHeader(SortableDependencies, PlanningDisplayNames.Dependencies)</HeaderTemplate>
                </PropertyColumn>

                <TemplateColumn Sortable="false" Hidden="!_showExternalDependencies">
