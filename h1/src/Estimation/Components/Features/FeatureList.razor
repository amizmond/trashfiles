    private record FeatureRow(
        int Id,
        string? JiraId,
        string? FeatureName,
        string? Summary,
        int? PiId,
        string? PiName,
        string? BoJiraId,
        string? BoName,
        string? BoDescription,
        string? EpicJiraId,
        string? EpicName,
        string? EpicDescription,
        List<JiraRef> ProgramJiraIds,
        string? CapitalProjectName,
        string? Labels,
        string? PiObjective,
        List<TeamRef> Teams,
        List<TechStackRef> TechStacks,
        string? RagExplain,
        string? Dependencies,
        bool ExternalDependencies,
        string? AcceptanceCriteria,
        DateTime? TargetStart,
        DateTime? TargetEnd,
        int? StoryPoints,
        string? Status,
        int? Ranking,
        string? RequirementStatus,
        string? TechnicalApproval,
        string? UnfundedOption,
        IReadOnlyList<HygieneFailure>? HygieneFailures
    )
    {
        public int? TechStackEstimation => TechStacks.Count > 0
            ? TechStacks.Sum(ts => ts.EstimatedEffort ?? 0)
            : null;

        public bool StoryPointsMatchTechStack => (StoryPoints ?? 0) == (TechStackEstimation ?? 0);
    }

