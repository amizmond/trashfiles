    private async Task LoadHygieneRulesAsync()
    {
        try
        {
            _hygieneRulesByArtKey = await HygieneService.GetRulesByArtJiraKeyAsync();
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Hygiene rules could not be loaded; the hygiene column stays empty");
            _hygieneRulesByArtKey = new Dictionary<string, IReadOnlyList<FeatureHygieneRule>>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private IReadOnlyList<HygieneFailure>? EvaluateHygiene(Feature feature)
    {
        var key = FeatureScope.ProjectKeyOf(feature);

        return key is not null && _hygieneRulesByArtKey.TryGetValue(key, out var rules)
            ? FeatureHygieneEvaluator.Evaluate(feature, rules)
            : null;
    }

