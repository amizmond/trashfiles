@attribute [Route(RoutingPath.Features)]
@inherits LocalTimeComponentBase

@implements IDisposable

@inject IFeatureService FeatureService
@inject IFeatureHygieneService HygieneService
@inject IFeatureCommentService FeatureCommentService
@inject IFeatureUploadService FeatureUploadService
@inject IBrowserDownloadService DownloadService
@inject IPiService PiService
@inject ICapitalProjectService CapitalProjectService
@inject IDepartmentService DepartmentService
@inject ITeamService TeamService
@inject ITechnologyStackService TechnologyStackService
@inject IBusinessOutcomeService BusinessOutcomeService
@inject IJiraAuthService JiraAuth
@inject IWindowsAuthService WindowsAuth
@inject IUserPermissionService UserPermissions
@inject ISolutionTrainResolver TrainResolver
@inject GlobalFilterState GlobalFilter
@inject NavigationManager Nav
@inject IModalDialogService MessageService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJiraIssueService JiraIssueService
@inject IJiraDiffService JiraDiffService
@inject IConfiguration Configuration
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using MudBlazor.Utilities
@using Serilog
@using Estimation.Core.JiraIntegration.Client
@using Estimation.Core.Administration.Models
@using Estimation.Core.Administration.Services
@using Estimation.Core.Train.Models
@using Estimation.Core.Train.Services
@using Estimation.Core.PlanningIncrement.Models
@using Estimation.Core.PlanningIncrement.Services
@using Estimation.Core.Resources.Services
@using Estimation.Core.Features.Models
@using Estimation.Core.Features.Services
@using Estimation.Core.Features.Hygiene.Models
@using Estimation.Core.Features.Hygiene.Services
@using Estimation.Core.Shared.Services

<AccessGuard PageKey="Features">
<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <MudText Typo="Typo.h6">@PlanningDisplayNames.Features</MudText>

        <div class="d-flex flex-wrap align-center justify-end gap-2 pa-2">
            <div style="position:relative;">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ViewColumn"
                           Disabled="_loading"
                           OnClick="() => _columnsPopoverOpen = !_columnsPopoverOpen">
                    Columns
                </MudButton>
                <MudPopover Open="_columnsPopoverOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="pa-4" Style="min-width:340px; max-height:75vh; overflow-y:auto">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@PlanningDisplayNames.ToggleColumns</MudText>
                        <div>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetColumnsAsync">Reset</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _columnsPopoverOpen = false" />
                        </div>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">Drag a row to reorder. Toggle to show or hide.</MudText>
                    <MudDropContainer T="ColumnItem" @ref="_columnDropContainer" Items="_columnItems"
                                      ItemsSelector="@((item, zone) => item.Selector == zone)"
                                      ItemDropped="OnColumnDroppedAsync" Class="d-block">
                        <ChildContent>
                            <MudDropZone T="ColumnItem" Identifier="@ColumnZoneId" AllowReorder="true"
                                         Class="d-flex flex-column gap-1" />
                        </ChildContent>
                        <ItemRenderer>
                            <div class="d-flex align-center gap-2 px-2 py-1 rounded-lg mud-paper-outlined" style="cursor:grab; user-select:none">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Class="mud-text-secondary" />
                                <MudSwitch T="bool" Value="context.Visible"
                                           ValueChanged="@(v => OnColumnVisibilityChangedAsync(context, v))"
                                           Label="@context.Label" Color="Color.Primary" Dense Class="flex-grow-1 ma-0" />
                            </div>
                        </ItemRenderer>
                    </MudDropContainer>
                </MudPopover>
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       Disabled="_loading"
                       OnClick="() => _drawerOpen = !_drawerOpen">
                Filter
            </MudButton>

            @if (_canEdit)
            {
                @if (_jiraConnected)
                {
                    @if (_canSyncJira)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   Disabled="_syncing"
                                   OnClick="OpenSyncDialogAsync">
                            Find new Features in Jira
                        </MudButton>
                    }
                    @if (_canSyncFiltered)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.SyncAlt"
                                   Disabled="_syncing"
                                   OnClick="SyncFilteredAsync">
                            Update filtered from Jira
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AccountTree"
                               Disabled="_syncing"
                               OnClick="OpenHierarchyCheckDialogAsync">
                        Hierarchy check
                    </MudButton>
                }

                @if (_canMapToPi)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Map"
                               Disabled="_loading"
                               OnClick="OpenMapToPiDialogAsync">
                        Map to PI
                    </MudButton>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => Nav.NavigateTo(RoutingPath.FeaturesNew))">
                    New
                </MudButton>

                @ExportExcelButton

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Description"
                           Disabled="_loading || _exporting"
                           OnClick="ExportEmptyTemplateAsync">
                    Empty template
                </MudButton>

                <MudFileUpload T="IBrowserFile"
                               Accept=".xlsx"
                               MaximumFileCount="1"
                               FilesChanged="OnUploadFileSelected">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.UploadFile"
                                   Disabled="_loading || _exporting">
                            Upload
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            }
            else
            {
                @ExportExcelButton
            }
        </div>

        <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Elevation="2"
                    Variant="DrawerVariant.Temporary" Width="400px"
                    Style="background: var(--mud-palette-surface)">
            <MudDrawerHeader>
                <div class="d-flex align-center justify-space-between" style="width:100%">
                    <MudText Typo="Typo.h6">@PlanningDisplayNames.Filters</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _drawerOpen = false" />
                </div>
            </MudDrawerHeader>
            <div class="d-flex flex-column gap-3 pa-4">
                @if (!_loading)
                {
                <MudTextField @bind-Value="FilterSearch" Label="@PlanningDisplayNames.Search" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable Immediate
                              DebounceInterval="300" Dense Variant="Variant.Outlined" />

                <MudSelect T="string" Label="@PlanningDisplayNames.Department" MultiSelection
                           @bind-SelectedValues="FilterDepartmentNames"
                           Dense Variant="Variant.Outlined" Clearable
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var dept in _availableDepartments)
                    {
                        <MudSelectItem T="string" Value="@dept">@dept</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" Label="@PlanningDisplayNames.CapitalProjec" MultiSelection
                           @bind-SelectedValues="FilterCapitalProjectNames"
                           Dense Variant="Variant.Outlined" Clearable
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var cp in _availableCapitalProjects)
                    {
                        <MudSelectItem T="string" Value="@cp">@cp</MudSelectItem>
                    }
                </MudSelect>

                <div class="d-flex align-end gap-2">
                    <MudSelect T="string" Label="@PlanningDisplayNames.PI" MultiSelection
                               @bind-SelectedValues="FilterPiNames"
                               Dense Variant="Variant.Outlined" Clearable
                               AnchorOrigin="Origin.BottomCenter" Style="flex:1">
                        @foreach (var pi in _availablePis)
                        {
                            <MudSelectItem T="string" Value="@pi">@pi</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="d-flex flex-column">
                        <MudTooltip Text="Also include features whose labels match the selected PI's label rules">
                            <MudCheckBox T="bool" @bind-Value="FilterPiLabels" Label="@PlanningDisplayNames.Labels" Dense Color="Color.Primary" />
                        </MudTooltip>
                        <MudTooltip Text="Negate: find features without PI or exclude selected">
                            <MudCheckBox T="bool" @bind-Value="FilterPiNot" Label="Not" Dense Color="Color.Secondary" />
                        </MudTooltip>
                    </div>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="@_availableProgramIds"
                                        Values="FilterProgramNames"
                                        ValuesChanged="OnFilterProgramNamesChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.StrategicObjective"
                                        ToStringFunc="@LookupProgramText"
                                        ItemTemplate="@ProgramItemTemplate"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Strategic Objective or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterProgramNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="@_availableEpicIds"
                                        Values="FilterEpicNames"
                                        ValuesChanged="OnFilterEpicNamesChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.PortfolioEpic"
                                        ToStringFunc="@LookupEpicText"
                                        ItemTemplate="@EpicItemTemplate"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Portfolio Epic or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterEpicNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="@_availableBoIds"
                                        Values="FilterBoNames"
                                        ValuesChanged="OnFilterBoNamesChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.BusinessOutcome"
                                        ToStringFunc="@LookupBoText"
                                        ItemTemplate="@BoItemTemplate"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Business Outcome or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterBoNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableTeams"
                                        Values="FilterTeamNames"
                                        ValuesChanged="OnFilterTeamNamesChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.Teams"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Teams or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterTeamNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <MudSelect T="string" Label="@PlanningDisplayNames.Status" MultiSelection
                               @bind-SelectedValues="FilterStatuses"
                               Dense Variant="Variant.Outlined" Clearable
                               AnchorOrigin="Origin.BottomCenter" Style="flex:1">
                        @foreach (var s in _availableStatuses)
                        {
                            <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTooltip Text="Negate: find features without Status or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterStatusNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableLabels"
                                        Values="FilterLabels"
                                        ValuesChanged="OnFilterLabelsChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.Labels"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Labels or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterLabelsNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <SearchableDropdown T="string"
                                    Items="_availableTechStacks"
                                    Values="FilterTechStackNames"
                                    ValuesChanged="OnFilterTechStackNamesChanged"
                                    MultiSelect="true"
                                    Label="@PlanningDisplayNames.TechnologyStacks" />

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableRequirementStatuses"
                                        Values="FilterRequirementStatuses"
                                        ValuesChanged="OnFilterRequirementStatusesChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.RequirementStatus"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Requirement Status or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterRequirementStatusNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableTechnicalApprovals"
                                        Values="FilterTechnicalApprovals"
                                        ValuesChanged="OnFilterTechnicalApprovalsChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.TechnicalApproval"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Technical Approval or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterTechnicalApprovalNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <div class="d-flex align-end gap-2">
                    <SearchableDropdown T="string"
                                        Items="_availableFundingStatuses"
                                        Values="FilterFundingStatuses"
                                        ValuesChanged="OnFilterFundingStatusesChanged"
                                        MultiSelect="true"
                                        Label="@PlanningDisplayNames.FundingStatus"
                                        Style="flex:1" />
                    <MudTooltip Text="Negate: find features without Funding Status or exclude selected">
                        <MudCheckBox T="bool" @bind-Value="FilterFundingStatusNot" Label="Not" Dense Color="Color.Secondary" />
                    </MudTooltip>
                </div>

                <MudTooltip Text="Show only features whose Story Points differ from the total of their tech stack estimation. A missing value counts as 0, so a feature with Story Points but no estimation (or the reverse) is included.">
                    <MudCheckBox T="bool" @bind-Value="FilterStoryPointsMismatch"
                                 Label="@($"{PlanningDisplayNames.StoryPoints} ≠ {PlanningDisplayNames.TechStackEstimation}")"
                                 Dense Color="Color.Primary" />
                </MudTooltip>

                <MudSelect T="string" Label="@PlanningDisplayNames.Hygiene"
                           Value="_filterHygieneBacking" ValueChanged="OnFilterHygieneChanged"
                           Dense Variant="Variant.Outlined" Clearable
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="string" Value="@HygieneFilterHealthy">Healthy</MudSelectItem>
                    <MudSelectItem T="string" Value="@HygieneFilterUnhealthy">Not healthy</MudSelectItem>
                    <MudSelectItem T="string" Value="@HygieneFilterUnchecked">Not checked (ART has no rules)</MudSelectItem>
                </MudSelect>

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           FullWidth OnClick="ClearFilters" Class="mt-2">
                    @PlanningDisplayNames.ClearFilters
                </MudButton>
                }
            </div>
        </MudDrawer>

        @if (_syncing)
        {
            <MudProgressLinear Indeterminate Color="Color.Warning" Class="mb-2" />
            <MudAlert Severity="Severity.Info" Class="mb-2">Synchronizing Features from Jira...</MudAlert>
        }

        <MudDivider />

        @if (_showPiMatchSummary)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2 mt-2">
                @_piByPiCount feature(s) linked by PI, @_piByLabelCount by label.
            </MudAlert>
            @if (_piLabelMismatchRows.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    @_piLabelMismatchRows.Count feature(s) matched by label but are assigned to a different PI: @_piLabelMismatchText
                </MudAlert>
            }
        }

        <MudDataGrid 
                @ref="_grid" 
                T="FeatureRow"
                Items="@_filteredRows"
                Hover="true"
                Striped="true"
                Dense="true"
                Elevation="0"
                Loading="_loading"
                LoadingProgressColor="Color.Primary"
                ColumnResizeMode="ResizeMode.Container"
                @bind-CurrentPage="CurrentPage"
                @bind-RowsPerPage="PageSize">
            <Columns>
                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showJiraId">
                    <HeaderTemplate>@SortableHeader(SortableJiraId, PlanningDisplayNames.JiraId)</HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.JiraId))
                        {
                            <a href="@(Configuration["JiraTaskUrl"] + context.Item.JiraId)" target="_blank" style="text-decoration:none">
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="cursor:pointer">
                                    @context.Item.JiraId
                                </MudChip>
                            </a>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="r => r.FeatureName" Sortable="false" CellStyle="min-width:100px; max-width:300px;" Hidden="!_showFeatureName">
                    <HeaderTemplate>@SortableHeader(SortableFeatureName, PlanningDisplayNames.FeatureName)</HeaderTemplate>
                </PropertyColumn>

                <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:100px; max-width:300px;" Hidden="!_showName">
                    <HeaderTemplate>@SortableHeader(SortableSummary, PlanningDisplayNames.Summary)</HeaderTemplate>
                    <CellTemplate>
                        <MudText Class="font-weight-bold">@context.Item.Summary</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showStatus">
                    <HeaderTemplate>@SortableHeader(SortableStatus, PlanningDisplayNames.Status)</HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.Status))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@JiraStatusHelper.StatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showHygiene">
                    <HeaderTemplate>
                        <MudTooltip Text="Hygiene rules of the feature's ART. Empty when the ART has no rules.">
                            <span>@PlanningDisplayNames.Hygiene</span>
                        </MudTooltip>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.HygieneFailures is { } failures)
                        {
                            @if (failures.Count == 0)
                            {
                                <MudTooltip Text="Passes every hygiene rule of its ART">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">OK</MudChip>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@string.Join(" · ", failures.Select(f => f.Label))">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" Style="cursor:pointer"
                                             OnClick="@(() => Nav.NavigateTo(RoutingPath.FeatureHygiene))">
                                        @failures.Count failed
                                    </MudChip>
                                </MudTooltip>
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="r => r.CapitalProjectName" Sortable="false" Resizable="true" CellStyle="min-width:50px; max-width:300px;" Hidden="!_showCapitalProject">
                    <HeaderTemplate>@SortableHeader(SortableCapitalProject, PlanningDisplayNames.CapitalProjec)</HeaderTemplate>
                </PropertyColumn>
                
                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showBoJiraId">
                    <HeaderTemplate>@SortableHeader(SortableBusinessOutcome, PlanningDisplayNames.BusinessOutcome)</HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.BoJiraId))
                        {
                            <MudTooltip Text="@context.Item.BoName">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="cursor:pointer"
                                         OnClick="@(() => OpenJiraDetailsDialogAsync(PlanningDisplayNames.BusinessOutcome, context.Item.BoJiraId, context.Item.BoName, context.Item.BoDescription))">
                                    @context.Item.BoJiraId
                                </MudChip>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:50px; max-width:300px;" Hidden="!_showBoName">
                    <HeaderTemplate>@SortableHeader(SortableBusinessOutcomeName, PlanningDisplayNames.BusinessOutcomeName)</HeaderTemplate>
                    <CellTemplate>
                        @context.Item.BoName
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showEpicJiraId">
                    <HeaderTemplate>@SortableHeader(SortablePortfolioEpic, PlanningDisplayNames.PortfolioEpic)</HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.EpicJiraId))
                        {
                            <MudTooltip Text="@context.Item.EpicName">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="cursor:pointer"
                                         OnClick="@(() => OpenJiraDetailsDialogAsync(PlanningDisplayNames.PortfolioEpic, context.Item.EpicJiraId, context.Item.EpicName, context.Item.EpicDescription))">
                                    @context.Item.EpicJiraId
                                </MudChip>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:50px; max-width:300px;" Hidden="!_showEpicName">
                    <HeaderTemplate>@SortableHeader(SortablePortfolioEpicName, PlanningDisplayNames.PortfolioEpicName)</HeaderTemplate>
                    <CellTemplate>
                        @context.Item.EpicName
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showProgramJiraId">
                    <HeaderTemplate>@SortableHeader(SortableStrategicObjective, PlanningDisplayNames.StrategicObjective)</HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.ProgramJiraIds.Count > 0)
                        {
                            @foreach (var prog in context.Item.ProgramJiraIds)
                            {
                                <MudTooltip Text="@prog.Summary">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="cursor:pointer"
                                             OnClick="@(() => OpenJiraDetailsDialogAsync(PlanningDisplayNames.StrategicObjective, prog.JiraId, prog.Summary, prog.Description))">
                                        @prog.JiraId
                                    </MudChip>
                                </MudTooltip>
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" CellStyle="min-width:50px; max-width:300px;" Hidden="!_showProgramName">
                    <HeaderTemplate>@SortableHeader(SortableStrategicObjectiveName, PlanningDisplayNames.StrategicObjectiveName)</HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.ProgramJiraIds.Count > 0)
                        {
                            @string.Join(", ", context.Item.ProgramJiraIds.Select(p => p.Summary).Where(s => !string.IsNullOrEmpty(s)))
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" CellStyle="max-width:200px;" Hidden="!_showLabels">
                    <HeaderTemplate>@SortableHeader(SortableLabels, PlanningDisplayNames.Labels)</HeaderTemplate>

                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.Labels))
                        {
                            @foreach (var label in context.Item.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="mr-1">@label</MudChip>
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="r => r.PiName" Sortable="false" Hidden="!_showPi">
                    <HeaderTemplate>@SortableHeader(SortablePi, PlanningDisplayNames.FeaturePi)</HeaderTemplate>
                </PropertyColumn>

                <PropertyColumn Property="r => r.PiObjective" Sortable="false" CellStyle="min-width:100px; max-width:400px;" Hidden="!_showPiObjective">
                    <HeaderTemplate>@SortableHeader(SortablePiObjective, PlanningDisplayNames.PiObjective)</HeaderTemplate>
                </PropertyColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showTeams">
                    <HeaderTemplate>@SortableHeader(SortableTeams, PlanningDisplayNames.Teams)</HeaderTemplate>
                    <CellTemplate>
                        @foreach (var t in context.Item.Teams.Take(3))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                     Class="mr-1" OnClick="@(() => Nav.NavigateTo($"{RoutingPath.Teams}/{t.Id}"))">@(t.StoryPoints.HasValue ? $"{t.Name}: {t.StoryPoints}" : t.Name)</MudChip>
                        }
                        @if (context.Item.Teams.Count > 3)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
