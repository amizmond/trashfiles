                            <MudText Color="@(context.Item.StoryPointsMatchTechStack ? Color.Default : Color.Warning)">
                                @context.Item.TechStackEstimation
                            </MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="r => r.Ranking" Sortable="false" Hidden="!_showRanking">
                    <HeaderTemplate>@SortableHeader(SortableRanking, PlanningDisplayNames.Ranking)</HeaderTemplate>
                </PropertyColumn>

                <PropertyColumn Property="r => r.RequirementStatus" Sortable="false" CellStyle="min-width:100px; max-width:400px;" Hidden="!_showRequirementStatus">
                    <HeaderTemplate>@SortableHeader(SortableRequirementStatus, PlanningDisplayNames.RequirementStatus)</HeaderTemplate>
                </PropertyColumn>

                <PropertyColumn Property="r => r.TechnicalApproval" Sortable="false" CellStyle="min-width:100px; max-width:400px;" Hidden="!_showTechnicalApproval">
                    <HeaderTemplate>@SortableHeader(SortableTechnicalApproval, PlanningDisplayNames.TechnicalApproval)</HeaderTemplate>
                </PropertyColumn>

                <PropertyColumn Property="r => r.UnfundedOption" Sortable="false" Hidden="!_showFundingStatus">
                    <HeaderTemplate>@SortableHeader(SortableFundingStatus, PlanningDisplayNames.FundingStatus)</HeaderTemplate>
                </PropertyColumn>
                
                @if (_canEdit)
                {
                    <TemplateColumn Title="@PlanningDisplayNames.Actions" Sortable="false" Filterable="false" Hidden="!_showActions" StickyRight="true">
                        <CellTemplate>
                            <MudBadge Content="@(_commentCounts.GetValueOrDefault(context.Item.Id))"
                                      Color="Color.Info" Overlap="true" Bordered="true"
                                      Visible="@(_commentCounts.GetValueOrDefault(context.Item.Id) > 0)">
                                    <MudTooltip Text="Status Comments">
                                    <MudFab Class="m-2" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Comment" Size="Size.Small" OnClick="@(() => ShowCommentsAsync(context.Item))" />
                                </MudTooltip>
                            </MudBadge>
                            <MudFab Class="m-2" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => NavigateToEdit(context.Item.Id))" />
                            @if (IsAdmin)
                            {
                                <MudTooltip Text="Delete Feature">
                                    <MudFab Class="m-2" StartIcon="@Icons.Material.Filled.DeleteForever" IconColor="Color.Secondary" Size="Size.Small" OnClick="@(() => ConfirmDeleteAsync(context.Item))" />
                                </MudTooltip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
            <NoRecordsContent><MudText Class="pa-6 mud-text-secondary">No features found.</MudText></NoRecordsContent>
            <PagerContent><MudDataGridPager T="FeatureRow" PageSizeOptions="new[] { 10, 25, 50, 100 }" /></PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

