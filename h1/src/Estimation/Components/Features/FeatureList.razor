    private RenderFragment SortableHeader(string sortKey, string title) => @<div style="cursor:pointer; display:flex; align-items:center; user-select:none" @onclick="@(() => ToggleSort(sortKey))">
        <span>@title</span>
        @if (_sortColumn == sortKey)
        {
            <MudIcon Icon="@(_sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small" Class="ml-1" />
        }
    </div>;

    private void ToggleSort(string sortKey)
    {
        if (_sortColumn == sortKey)
        {
            if (_sortDescending)
            {
                _sortColumn = null;
                _sortDescending = false;
            }
            else
            {
                _sortDescending = true;
            }
        }
        else
        {
            _sortColumn = sortKey;
            _sortDescending = false;
        }
        RecomputeFilteredRows();
        UpdateUrl();
    }

    private static string? FirstProgramJiraId(FeatureRow r)
    {
        return r.ProgramJiraIds.Count > 0 ? r.ProgramJiraIds[0].JiraId : null;
    }

    private static string? FirstProgramSummary(FeatureRow r)
    {
        return r.ProgramJiraIds.Count > 0 ? r.ProgramJiraIds[0].Summary : null;
    }

    private static string TeamsSortKey(FeatureRow r) =>
        string.Join(", ", r.Teams.Select(t => t.Name).OrderBy(n => n, StringComparer.OrdinalIgnoreCase));

    private static string TechStacksSortKey(FeatureRow r) =>
        string.Join(", ", r.TechStacks.Select(t => t.Name).OrderBy(n => n, StringComparer.OrdinalIgnoreCase));

    private static IOrderedEnumerable<FeatureRow> OrderRows<TKey>(
        IEnumerable<FeatureRow> source, Func<FeatureRow, TKey> keySelector, bool descending)
    {
        return descending
            ? source.OrderByDescending(keySelector)
            : source.OrderBy(keySelector);
    }

    private void RecomputeFilteredRows()
    {
        IEnumerable<FeatureRow> filtered = _rows.Where(MatchesFilter);

        filtered = _sortColumn switch
        {
            SortableJiraId => OrderRows(filtered, r => r.JiraId, _sortDescending),
            SortableFeatureName => OrderRows(filtered, r => r.FeatureName, _sortDescending),
            SortableSummary => OrderRows(filtered, r => r.Summary, _sortDescending),
            SortableStatus => OrderRows(filtered, r => r.Status, _sortDescending),
            SortableCapitalProject => OrderRows(filtered, r => r.CapitalProjectName, _sortDescending),
            SortableBusinessOutcome => OrderRows(filtered, r => r.BoJiraId, _sortDescending),
            SortableBusinessOutcomeName => OrderRows(filtered, r => r.BoName, _sortDescending),
            SortablePortfolioEpic => OrderRows(filtered, r => r.EpicJiraId, _sortDescending),
            SortablePortfolioEpicName => OrderRows(filtered, r => r.EpicName, _sortDescending),
            SortableStrategicObjective => OrderRows(filtered, FirstProgramJiraId, _sortDescending),
            SortableStrategicObjectiveName => OrderRows(filtered, FirstProgramSummary, _sortDescending),
            SortableLabels => OrderRows(filtered, r => r.Labels, _sortDescending),
            SortablePi => OrderRows(filtered, r => r.PiName, _sortDescending),
            SortablePiObjective => OrderRows(filtered, r => r.PiObjective, _sortDescending),
            SortableTeams => OrderRows(filtered, TeamsSortKey, _sortDescending),
            SortableTechStacks => OrderRows(filtered, TechStacksSortKey, _sortDescending),
            SortableComments => OrderRows(filtered, r => _unitedComments?.GetValueOrDefault(r.Id), _sortDescending),
            SortableRagExplain => OrderRows(filtered, r => r.RagExplain, _sortDescending),
            SortableDependencies => OrderRows(filtered, r => r.Dependencies, _sortDescending),
            SortableExternalDependencies => OrderRows(filtered, r => r.ExternalDependencies, _sortDescending),
            SortableAcceptanceCriteria => OrderRows(filtered, r => r.AcceptanceCriteria, _sortDescending),
            SortableTargetStart => OrderRows(filtered, r => r.TargetStart, _sortDescending),
            SortableTargetEnd => OrderRows(filtered, r => r.TargetEnd, _sortDescending),
            SortableStoryPoints => OrderRows(filtered, r => r.StoryPoints, _sortDescending),
            SortableTechStackEstimation => OrderRows(filtered, r => r.TechStackEstimation, _sortDescending),
            SortableRanking => OrderRows(filtered, r => r.Ranking, _sortDescending),
            SortableRequirementStatus => OrderRows(filtered, r => r.RequirementStatus, _sortDescending),
            SortableTechnicalApproval => OrderRows(filtered, r => r.TechnicalApproval, _sortDescending),
            SortableFundingStatus => OrderRows(filtered, r => r.UnfundedOption, _sortDescending),
            _ => filtered
        };

        _filteredRows = filtered.ToList();
        RecomputePiMatchSummary();
    }

    private void RecomputePiMatchSummary()
    {
        _piByPiCount = 0;
        _piByLabelCount = 0;
        _piLabelMismatchRows = new List<FeatureRow>();
        _piLabelMismatchText = null;

        _showPiMatchSummary = _filterPiNamesSet.Count > 0 && !_filterPiNotBacking && _filteredRows.Count > 0;
        if (!_showPiMatchSummary)
        {
            return;
        }

        foreach (var r in _filteredRows)
        {
            if (r.PiName is not null && _filterPiNamesSet.Contains(r.PiName))
            {
                _piByPiCount++;
                continue;
            }

            _piByLabelCount++;
            if (r.PiName is not null)
            {
                _piLabelMismatchRows.Add(r);
            }
        }

        if (_piLabelMismatchRows.Count > 0)
        {
            const int maxShown = 10;
            var shown = _piLabelMismatchRows
                .Take(maxShown)
                .Select(r => $"{r.JiraId ?? r.Summary ?? "(no id)"} (PI: {r.PiName})");
            _piLabelMismatchText = string.Join(", ", shown);
            if (_piLabelMismatchRows.Count > maxShown)
            {
                _piLabelMismatchText += $", +{_piLabelMismatchRows.Count - maxShown} more";
            }
        }
    }

    private bool MatchesSelectedPi(FeatureRow r)
    {
        if (r.PiName is not null && _filterPiNamesSet.Contains(r.PiName))
        {
            return true;
        }

        if (!_filterPiLabelsBacking || string.IsNullOrEmpty(r.Labels))
        {
            return false;
        }

        var featureLabels = new HashSet<string>(
            r.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            StringComparer.OrdinalIgnoreCase);
        if (featureLabels.Count == 0)
        {
            return false;
        }

        foreach (var piName in _filterPiNamesSet)
        {
            if (!_piLabelConfigByName.TryGetValue(piName, out var rules))
            {
                continue;
            }

            foreach (var rule in rules)
            {
                var matches = rule.Mode == PiLabelMatchMode.All
                    ? rule.Labels.All(featureLabels.Contains)
                    : rule.Labels.Any(featureLabels.Contains);
                if (matches)
                {
                    return true;
                }
            }
        }

        return false;
    }

    private bool MatchesFilter(FeatureRow r)
    {
        if (!string.IsNullOrWhiteSpace(_filterSearchBacking))
        {
            var s = _filterSearchBacking.Trim();
            if (!((r.Summary?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.JiraId?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.PiName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.BoName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.BoJiraId?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.FeatureName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.EpicName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)))
            {
                return false;
            }
        }

        if (_filterLabelsNotBacking)
        {
            if (_filterLabelsSet.Count > 0)
            {
                if (!string.IsNullOrEmpty(r.Labels)
                    && r.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .Any(l => _filterLabelsSet.Contains(l)))
                {
                    return false;
                }
            }
            else
            {
                if (!string.IsNullOrEmpty(r.Labels)
                    && r.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length > 0)
                {
                    return false;
                }
            }
        }
        else if (_filterLabelsSet.Count > 0)
        {
            if (string.IsNullOrEmpty(r.Labels)
                || !r.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Any(l => _filterLabelsSet.Contains(l)))
            {
                return false;
            }
        }

        if (_filterPiNotBacking)
        {
            if (_filterPiNamesSet.Count > 0)
            {
                if (MatchesSelectedPi(r))
                {
                    return false;
                }
            }
            else
            {
                if (r.PiName is not null)
                {
                    return false;
                }
            }
        }
        else if (_filterPiNamesSet.Count > 0 && !MatchesSelectedPi(r))
        {
            return false;
        }

        if (_filterBoNotBacking)
        {
            if (_filterBoNamesSet.Count > 0)
            {
                if (r.BoJiraId is not null && _filterBoNamesSet.Contains(r.BoJiraId))
                {
                    return false;
                }
            }
            else
            {
                if (r.BoJiraId is not null)
                {
                    return false;
                }
            }
        }
        else if (_filterBoNamesSet.Count > 0
            && (r.BoJiraId is null || !_filterBoNamesSet.Contains(r.BoJiraId)))
        {
            return false;
        }

        if (_filterEpicNotBacking)
        {
            if (_filterEpicNamesSet.Count > 0)
            {
                if (r.EpicJiraId is not null && _filterEpicNamesSet.Contains(r.EpicJiraId))
                {
                    return false;
                }
            }
            else
            {
                if (r.EpicJiraId is not null)
                {
                    return false;
                }
            }
        }
        else if (_filterEpicNamesSet.Count > 0
            && (r.EpicJiraId is null || !_filterEpicNamesSet.Contains(r.EpicJiraId)))
        {
            return false;
        }

        if (_filterProgramNotBacking)
        {
            if (_filterProgramNamesSet.Count > 0)
            {
                if (r.ProgramJiraIds.Any(p => _filterProgramNamesSet.Contains(p.JiraId)))
                {
                    return false;
                }
            }
            else
            {
                if (r.ProgramJiraIds.Count > 0)
                {
                    return false;
                }
            }
        }
        else if (_filterProgramNamesSet.Count > 0
            && !r.ProgramJiraIds.Any(p => _filterProgramNamesSet.Contains(p.JiraId)))
        {
            return false;
        }

        if (_filterDepartmentNamesSet.Count > 0
            && !(r.CapitalProjectName is not null
                && _cpNameToDept.TryGetValue(r.CapitalProjectName, out var dn)
                && _filterDepartmentNamesSet.Contains(dn)))
        {
            return false;
        }

        if (_filterCapitalProjectNamesSet.Count > 0
            && (r.CapitalProjectName is null || !_filterCapitalProjectNamesSet.Contains(r.CapitalProjectName)))
        {
            return false;
        }

        if (_filterTechStackNamesSet.Count > 0
            && !r.TechStacks.Any(ts => _filterTechStackNamesSet.Contains(ts.Name)))
        {
            return false;
        }

        if (_filterTeamNotBacking)
        {
            if (_filterTeamNamesSet.Count > 0)
            {
                if (r.Teams.Any(t => _filterTeamNamesSet.Contains(t.Name)))
                {
                    return false;
                }
            }
            else
            {
                if (r.Teams.Count > 0)
                {
                    return false;
                }
            }
        }
        else if (_filterTeamNamesSet.Count > 0
            && !r.Teams.Any(t => _filterTeamNamesSet.Contains(t.Name)))
        {
            return false;
        }

        if (_filterStatusNotBacking)
        {
            if (_filterStatusesSet.Count > 0)
            {
                if (r.Status is not null && _filterStatusesSet.Contains(r.Status))
                {
                    return false;
                }
            }
            else
            {
                if (r.Status is not null)
                {
                    return false;
                }
            }
        }
        else if (_filterStatusesSet.Count > 0
            && (r.Status is null || !_filterStatusesSet.Contains(r.Status)))
        {
            return false;
        }

        if (_filterRequirementStatusNotBacking)
        {
            if (_filterRequirementStatusesSet.Count > 0)
            {
                if (r.RequirementStatus is not null && _filterRequirementStatusesSet.Contains(r.RequirementStatus))
                {
                    return false;
                }
            }
            else
            {
                if (r.RequirementStatus is not null)
                {
                    return false;
                }
            }
        }
        else if (_filterRequirementStatusesSet.Count > 0
            && (r.RequirementStatus is null || !_filterRequirementStatusesSet.Contains(r.RequirementStatus)))
        {
            return false;
        }

        if (_filterTechnicalApprovalNotBacking)
        {
            if (_filterTechnicalApprovalsSet.Count > 0)
            {
                if (r.TechnicalApproval is not null && _filterTechnicalApprovalsSet.Contains(r.TechnicalApproval))
                {
                    return false;
                }
            }
            else
            {
                if (r.TechnicalApproval is not null)
                {
                    return false;
                }
            }
        }
        else if (_filterTechnicalApprovalsSet.Count > 0
            && (r.TechnicalApproval is null || !_filterTechnicalApprovalsSet.Contains(r.TechnicalApproval)))
        {
            return false;
        }

        if (_filterFundingStatusNotBacking)
        {
            if (_filterFundingStatusesSet.Count > 0)
            {
                if (r.UnfundedOption is not null && _filterFundingStatusesSet.Contains(r.UnfundedOption))
                {
                    return false;
                }
            }
            else
            {
                if (r.UnfundedOption is not null)
                {
                    return false;
                }
            }
        }
        else if (_filterFundingStatusesSet.Count > 0
            && (r.UnfundedOption is null || !_filterFundingStatusesSet.Contains(r.UnfundedOption)))
        {
            return false;
        }

        if (_filterStoryPointsMismatchBacking && r.StoryPointsMatchTechStack)
        {
            return false;
        }

        if (_filterHygieneBacking is not null)
        {
            var hygieneMatches = _filterHygieneBacking switch
            {
                HygieneFilterHealthy => r.HygieneFailures is { Count: 0 },
                HygieneFilterUnhealthy => r.HygieneFailures is { Count: > 0 },
                HygieneFilterUnchecked => r.HygieneFailures is null,
                _ => true
            };

            if (!hygieneMatches)
            {
                return false;
            }
        }

        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        _canEdit = UserPageAccess.TryGetValue("Features", out var access) && access == AccessLevel.Edit;
        InitColumnDefaults();

        try
        {
            _userName = await WindowsAuth.GetUserName();
            if (_userName is not null)
            {
                _permissions = await UserPermissions.GetPermissionSetAsync(_userName);
                _canSyncJira = _permissions.IsActionAvailable(AppActionKeys.JiraSync);
                _canSyncFiltered = _permissions.IsActionAvailable(AppActionKeys.JiraSyncFiltered);
                _canMapToPi = _permissions.IsActionAvailable(AppActionKeys.MapToPi);
            }
            if (_userName is not null && JiraAuth.IsConfigured)
            {
                _jiraConnected = await JiraAuth.IsAuthenticatedAsync(_userName);
            }

            var departments = await DepartmentService.GetAllAsync();
            _cpNameToDept = departments
                .SelectMany(d => d.CapitalProjects.Select(cp => (cp.Name, d.Name)))
                .GroupBy(x => x.Item1, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First().Item2, StringComparer.OrdinalIgnoreCase);

            _allCapitalProjectsForSync = await CapitalProjectService.GetAllAsync();
            _capitalProjectByJiraKey = _allCapitalProjectsForSync
                .Where(cp => !string.IsNullOrWhiteSpace(cp.JiraKey))
                .GroupBy(cp => cp.JiraKey!, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g => new CapitalProjectRef(g.First().Id, g.First().Name, g.First().Description),
                    StringComparer.OrdinalIgnoreCase);

            var allPis = await PiService.GetAllLightAsync();
            _piLabelConfigByName = allPis
                .GroupBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g => g
                        .Where(p => !string.IsNullOrWhiteSpace(p.FeatureLabels))
                        .Select(p => new PiLabelRule(
                            new HashSet<string>(
                                p.FeatureLabels!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                                StringComparer.OrdinalIgnoreCase),
                            p.LabelMatchMode))
                        .Where(rule => rule.Labels.Count > 0)
                        .ToList(),
                    StringComparer.OrdinalIgnoreCase);

            await LoadHygieneRulesAsync();
            var items = FilterVisibleFeatures(await FeatureService.GetAllWithHierarchyAsync());
            _rows = items.Select(f =>
            {
                var bo = f.BusinessOutcome;
                var epic = bo?.PortfolioEpic;
                var programs = epic?.StrategicObjectivePortfolioEpics
                    .Select(ppe => ppe.StrategicObjective).ToList() ?? new();

                var resolvedCapitalProjectName = ArtHelper.ResolveArtByJiraId(f.ProjectKey, f.JiraId, _capitalProjectByJiraKey)?.Name;

                return new FeatureRow(
                    Id: f.Id,
                    JiraId: f.JiraId,
                    FeatureName: f.Name,
                    Summary: f.Summary,
                    PiId: f.PiId,
                    PiName: f.Pi?.Name,
                    BoJiraId: bo?.JiraId,
                    BoName: bo?.Summary,
                    BoDescription: bo?.Description,
                    EpicJiraId: epic?.JiraId,
                    EpicName: epic?.Summary,
                    EpicDescription: epic?.Description,
                    ProgramJiraIds: programs
                        .Where(p => !string.IsNullOrEmpty(p.JiraId))
                        .Select(p => new JiraRef(p.JiraId!, p.Summary, p.Description))
                        .DistinctBy(p => p.JiraId).ToList(),
                    CapitalProjectName: resolvedCapitalProjectName,
                    Labels: f.Labels,
                    PiObjective: f.PiObjective?.Name,
                    Teams: f.FeatureTeams.Select(ft => new TeamRef(ft.TeamId, ft.Team.Name, ft.StoryPoints)).ToList(),
                    TechStacks: f.FeatureTeams
                        .SelectMany(ft => ft.TechnologyStacks)
                        .SelectMany(ftts => ftts.SkillValues)
                        .Where(sv => sv.Skill != null)
                        .GroupBy(sv => sv.Skill.Name, StringComparer.OrdinalIgnoreCase)
                        .Select(g => new TechStackRef(g.Key, (int?)Math.Round(g.Sum(sv => sv.Value))))
                        .OrderBy(ts => ts.Name, StringComparer.OrdinalIgnoreCase)
                        .ToList(),
                    RagExplain: f.RagExplain,
                    Dependencies: f.Dependencies,
                    ExternalDependencies: f.ExternalDependencies,
                    AcceptanceCriteria: f.AcceptanceCriteria,
                    TargetStart: f.TargetStart,
                    TargetEnd: f.TargetEnd,
                    StoryPoints: f.StoryPoints,
                    Status: f.Status,
                    Ranking: f.Ranking,
                    RequirementStatus: f.RequirementStatus?.Name,
                    TechnicalApproval: f.TechnicalApproval?.Name,
                    UnfundedOption: f.UnfundedOption?.Name,
                    HygieneFailures: EvaluateHygiene(f)
                );
            }).ToList();

            _availablePis = allPis
                .Where(p => !string.IsNullOrEmpty(p.Name))
                .GroupBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .Select(g => new { Name = g.Key, StartDate = g.Max(p => p.StartDate) })
                .OrderByDescending(p => p.StartDate ?? DateTime.MinValue)
                .ThenByDescending(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .Select(p => p.Name).ToList();
            _availableBos = _rows
                .Where(r => !string.IsNullOrEmpty(r.BoJiraId))
                .Select(r => (r.BoJiraId!, r.BoName))
                .DistinctBy(b => b.Item1, StringComparer.OrdinalIgnoreCase)
                .OrderBy(b => b.Item1).ToList();
            _availableEpics = _rows
                .Where(r => !string.IsNullOrEmpty(r.EpicJiraId))
                .Select(r => (r.EpicJiraId!, r.EpicName))
                .DistinctBy(e => e.Item1, StringComparer.OrdinalIgnoreCase)
                .OrderBy(e => e.Item1).ToList();
            _availablePrograms = _rows
                .SelectMany(r => r.ProgramJiraIds.Select(p => (p.JiraId, p.Summary)))
                .Where(p => !string.IsNullOrEmpty(p.JiraId))
                .DistinctBy(p => p.JiraId, StringComparer.OrdinalIgnoreCase)
                .OrderBy(p => p.JiraId).ToList();
            _availableDepartments = _rows
                .Where(r => r.CapitalProjectName is not null && _cpNameToDept.ContainsKey(r.CapitalProjectName))
                .Select(r => _cpNameToDept[r.CapitalProjectName!])
                .Distinct().OrderBy(n => n).ToList();
            _availableCapitalProjects = _rows
                .Where(r => !string.IsNullOrEmpty(r.CapitalProjectName))
                .Select(r => r.CapitalProjectName!)
                .Distinct().OrderBy(n => n).ToList();
            _availableTechStacks = _rows
                .SelectMany(r => r.TechStacks.Select(ts => ts.Name))
                .Where(n => !string.IsNullOrEmpty(n))
                .Distinct().OrderBy(n => n).ToList();
            _availableTeams = _rows
                .SelectMany(r => r.Teams.Select(t => t.Name))
                .Where(n => !string.IsNullOrEmpty(n))
                .Distinct().OrderBy(n => n).ToList();
            _availableStatuses = _rows
                .Where(r => !string.IsNullOrEmpty(r.Status))
                .Select(r => r.Status!)
                .Distinct().OrderBy(n => n).ToList();
            _availableLabels = _rows
                .Where(r => !string.IsNullOrEmpty(r.Labels))
                .SelectMany(r => r.Labels!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
            _availableRequirementStatuses = _rows
                .Where(r => !string.IsNullOrEmpty(r.RequirementStatus))
                .Select(r => r.RequirementStatus!)
                .Distinct().OrderBy(n => n).ToList();
            _availableTechnicalApprovals = _rows
                .Where(r => !string.IsNullOrEmpty(r.TechnicalApproval))
                .Select(r => r.TechnicalApproval!)
                .Distinct().OrderBy(n => n).ToList();
            _availableFundingStatuses = _rows
                .Where(r => !string.IsNullOrEmpty(r.UnfundedOption))
                .Select(r => r.UnfundedOption!)
                .Distinct().OrderBy(n => n).ToList();

            if (!ReadUrlParams())
            {
                await GlobalFilter.EnsureLoadedAsync();
                ApplyGlobalFilter();
            }

            RecomputeFilteredRows();

            await LoadCommentCountsAsync();
        }
        finally
        {
            _loading = false;
            _suppressUrlUpdate = false;
        }
    }

    private async Task ConfirmDeleteAsync(FeatureRow row)
    {
        try
        {
            if (await MessageService.Confirm($"Delete {row.Summary} ?"))
            {
                await FeatureService.DeleteAsync(row.Id);
                _rows.RemoveAll(r => r.Id == row.Id);
                RecomputeFilteredRows();
                UpdateUrl();
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, ex.Message);
            await MessageService.Exception(ex);
        }
    }

