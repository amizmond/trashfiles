    private void InitColumnDefaults()
    {
        var visible = AllColumns
            .Where(c => c.Key != ColKey.Actions || _canEdit)
            .ToList();
        _markupOrderKeys = visible.Select(c => c.Key).ToArray();
        _columnItems = visible
            .Select((c, idx) => new ColumnItem
            {
                Key = c.Key,
                Label = c.Label,
                Visible = c.DefaultVisible,
                Order = idx,
                Selector = ColumnZoneId,
            })
            .ToList();
    }

    private List<string> OrderedKeys()
    {
        var keys = _columnItems.OrderBy(c => c.Order).Select(c => c.Key).ToList();
        if (keys.Remove(ColKey.Actions))
        {
            keys.Add(ColKey.Actions);
        }
        return keys;
    }

