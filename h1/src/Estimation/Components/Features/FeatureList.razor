    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadColumnPrefsAsync();

            if (_showComments && _unitedComments is null)
            {
                await EnsureUnitedCommentsLoadedAsync();
                StateHasChanged();
            }
        }

        if (!_columnLayoutInitialized && _columnPrefsLoaded
            && _grid is not null
            && _grid.RenderedColumns.Count == _markupOrderKeys.Length)
        {
            AssignColumnIdentifiers();
            ApplyColumnOrder();
            _columnLayoutInitialized = true;
            _columnDropContainer?.Refresh();
            StateHasChanged();
        }

        if (_initialPageSizeFromUrl.HasValue && _grid is not null)
        {
            var size = _initialPageSizeFromUrl.Value;
            _initialPageSizeFromUrl = null;
            await _grid.SetRowsPerPageAsync(size, false);
        }
    }

    private const string ColumnPrefsKey = "featureList.columns.v2";
    private bool _columnPrefsLoaded;
    private bool _columnLayoutInitialized;

    private sealed class ColumnPrefs
    {
        public List<string>? Order { get; set; }
        public Dictionary<string, bool>? Visible { get; set; }
    }

    private void AssignColumnIdentifiers()
    {
        if (_grid is null)
        {
            return;
        }

        var rendered = _grid.RenderedColumns;
        if (rendered.Count != _markupOrderKeys.Length)
        {
            return;
        }

        for (var i = 0; i < _markupOrderKeys.Length; i++)
        {
            rendered[i].Identifier = _markupOrderKeys[i];
        }
    }

    private void ApplyColumnOrder()
    {
        if (_grid is null)
        {
            return;
        }

        var order = OrderedKeys();
        var rendered = _grid.RenderedColumns;
        var ordered = rendered
            .OrderBy(c =>
            {
                var idx = order.IndexOf(c.Identifier ?? string.Empty);
                return idx < 0 ? int.MaxValue : idx;
            })
            .ToList();

        rendered.Clear();
        rendered.AddRange(ordered);

        _filteredRows = new List<FeatureRow>(_filteredRows);
    }

    private async Task OnColumnDroppedAsync(MudItemDropInfo<ColumnItem> dropInfo)
    {
        if (dropInfo.Item is null)
        {
            return;
        }

        dropInfo.Item.Selector = dropInfo.DropzoneIdentifier;
        _columnItems.UpdateOrder(dropInfo, item => item.Order, 0);
        _columnItems = _columnItems.OrderBy(c => c.Order).ToList();

        ApplyColumnOrder();
        await SaveColumnPrefsAsync();
    }

    private async Task OnColumnVisibilityChangedAsync(ColumnItem item, bool value)
    {
        item.Visible = value;
        if (item.Key == ColKey.Comments && value)
        {
            await EnsureUnitedCommentsLoadedAsync();
        }
        await SaveColumnPrefsAsync();
    }

    private async Task ResetColumnsAsync()
    {
        InitColumnDefaults();
        ApplyColumnOrder();
        _columnDropContainer?.Refresh();
        await SaveColumnPrefsAsync();
    }

    private async Task LoadColumnPrefsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ColumnPrefsKey);
            if (string.IsNullOrEmpty(json))
            {
                return;
            }

            var prefs = System.Text.Json.JsonSerializer.Deserialize<ColumnPrefs>(json);
            if (prefs is null)
            {
                return;
            }

            if (prefs.Visible is not null)
            {
                foreach (var item in _columnItems)
                {
                    if (prefs.Visible.TryGetValue(item.Key, out var vis))
                    {
                        item.Visible = vis;
                    }
                }
            }

            if (prefs.Order is not null && prefs.Order.Count > 0)
            {
                var known = new HashSet<string>(_markupOrderKeys, StringComparer.Ordinal);
                var newOrder = prefs.Order.Where(k => known.Contains(k)).Distinct().ToList();
                foreach (var k in _markupOrderKeys)
                {
                    if (!newOrder.Contains(k))
                    {
                        newOrder.Add(k);
                    }
                }

                foreach (var item in _columnItems)
                {
                    var idx = newOrder.IndexOf(item.Key);
                    item.Order = idx < 0 ? int.MaxValue : idx;
                }
                _columnItems = _columnItems.OrderBy(c => c.Order).ToList();
            }
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Failed to load FeatureList column preferences");
        }
        finally
        {
            _columnPrefsLoaded = true;
        }
    }

    private async Task SaveColumnPrefsAsync()
    {
        if (!_columnPrefsLoaded)
        {
            return;
        }

        try
        {
            var prefs = new ColumnPrefs
            {
                Order = OrderedKeys(),
                Visible = _columnItems.ToDictionary(c => c.Key, c => c.Visible, StringComparer.Ordinal)
            };
            var json = System.Text.Json.JsonSerializer.Serialize(prefs);
            await JS.InvokeVoidAsync("localStorage.setItem", ColumnPrefsKey, json);
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Failed to save FeatureList column preferences");
        }
    }

    private void UpdateUrl()
    {
        if (_suppressUrlUpdate)
        {
            return;
        }

        var query = new Dictionary<string, object?>();
        query["search"] = string.IsNullOrWhiteSpace(_filterSearchBacking) ? null : _filterSearchBacking;
        query["labelsNot"] = _filterLabelsNotBacking ? (object?)true : null;
        query["labels"] = _filterLabelsSet.Count > 0 ? string.Join(",", _filterLabelsBacking) : null;
        query["piNot"] = _filterPiNotBacking ? (object?)true : null;
        query["piLabels"] = !_filterPiLabelsBacking ? (object?)false : null;
        query["pi"] = _filterPiNamesSet.Count > 0 ? string.Join(",", _filterPiNamesBacking) : null;
        query["boNot"] = _filterBoNotBacking ? (object?)true : null;
        query["bo"] = _filterBoNamesSet.Count > 0 ? string.Join(",", _filterBoNamesBacking) : null;
        query["epicNot"] = _filterEpicNotBacking ? (object?)true : null;
        query["epic"] = _filterEpicNamesSet.Count > 0 ? string.Join(",", _filterEpicNamesBacking) : null;
        query["programNot"] = _filterProgramNotBacking ? (object?)true : null;
        query["program"] = _filterProgramNamesSet.Count > 0 ? string.Join(",", _filterProgramNamesBacking) : null;
        query["dept"] = _filterDepartmentNamesSet.Count > 0 ? string.Join(",", _filterDepartmentNamesBacking) : null;
        query["cp"] = _filterCapitalProjectNamesSet.Count > 0 ? string.Join(",", _filterCapitalProjectNamesBacking) : null;
        query["ts"] = _filterTechStackNamesSet.Count > 0 ? string.Join(",", _filterTechStackNamesBacking) : null;
        query["teamNot"] = _filterTeamNotBacking ? (object?)true : null;
        query["team"] = _filterTeamNamesSet.Count > 0 ? string.Join(",", _filterTeamNamesBacking) : null;
        query["statusNot"] = _filterStatusNotBacking ? (object?)true : null;
        query["status"] = _filterStatusesSet.Count > 0 ? string.Join(",", _filterStatusesBacking) : null;
        query["reqStatusNot"] = _filterRequirementStatusNotBacking ? (object?)true : null;
        query["reqStatus"] = _filterRequirementStatusesSet.Count > 0 ? string.Join(",", _filterRequirementStatusesBacking) : null;
        query["techApprovalNot"] = _filterTechnicalApprovalNotBacking ? (object?)true : null;
        query["techApproval"] = _filterTechnicalApprovalsSet.Count > 0 ? string.Join(",", _filterTechnicalApprovalsBacking) : null;
        query["fundingNot"] = _filterFundingStatusNotBacking ? (object?)true : null;
        query["funding"] = _filterFundingStatusesSet.Count > 0 ? string.Join(",", _filterFundingStatusesBacking) : null;
        query["spMismatch"] = _filterStoryPointsMismatchBacking ? (object?)true : null;
        query["hygiene"] = _filterHygieneBacking;
        query["gf"] = _globalFilterCleared ? (object?)0 : null;
        query["sortBy"] = _sortColumn;
        query["sortDesc"] = _sortDescending && _sortColumn is not null ? (object?)true : null;
        query["page"] = _currentPageBacking > 0 ? (object?)_currentPageBacking : null;
        query["pageSize"] = _pageSizeBacking != 10 ? (object?)_pageSizeBacking : null;

        var uri = Nav.GetUriWithQueryParameters(query);
        Nav.NavigateTo(uri, replace: true);
    }

    private void NavigateToEdit(int id)
    {
        var currentUri = new Uri(Nav.Uri);
        var returnUrl = currentUri.PathAndQuery;
        var editUri = Nav.GetUriWithQueryParameters(
            $"{RoutingPath.Features}/{id}",
            new Dictionary<string, object?> { ["returnUrl"] = returnUrl });
        Nav.NavigateTo(editUri);
    }

    private Dictionary<int, int> _commentCounts = new();

    private Dictionary<int, string>? _unitedComments;

    private async Task LoadCommentCountsAsync()
    {
        try
        {
            _commentCounts = await FeatureCommentService.GetCountsAsync(_rows.Select(r => r.Id).ToList());
        }
        catch
        {
        }

        if (_showComments)
        {
            _unitedComments = null;
            await EnsureUnitedCommentsLoadedAsync();
        }
    }

    private async Task EnsureUnitedCommentsLoadedAsync()
    {
        if (_unitedComments is not null || _rows.Count == 0)
        {
            return;
        }

        try
        {
            _unitedComments = await FeatureCommentService.GetUnitedAsync(_rows.Select(r => r.Id).ToList(), UserTime.TimeZone);
        }
        catch
        {
            // Non-fatal: the column stays empty until the next reload.
        }
    }

    private async Task ShowCommentsAsync(FeatureRow row)
    {
        var title = string.IsNullOrEmpty(row.JiraId) ? (row.FeatureName ?? "Feature") : $"{row.JiraId} — {row.FeatureName}";
        var parameters = new Dictionary<string, object?>
        {
            { nameof(FeatureCommentsDialog.FeatureId), row.Id },
            { nameof(FeatureCommentsDialog.FeatureTitle), title },
            { nameof(FeatureCommentsDialog.CurrentUser), _userName },
        };
        var options = new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.False, FullWidth = false };
        var dialogRef = await MessageService.Component<FeatureCommentsDialog>("Status Comments", parameters, options);
        await dialogRef.Result;

        try
        {
            var counts = await FeatureCommentService.GetCountsAsync(new[] { row.Id });
            _commentCounts[row.Id] = counts.GetValueOrDefault(row.Id);

            if (_unitedComments is not null)
            {
                var united = await FeatureCommentService.GetUnitedAsync(new[] { row.Id }, UserTime.TimeZone);
                if (united.TryGetValue(row.Id, out var text))
                {
                    _unitedComments[row.Id] = text;
                }
                else
                {
                    _unitedComments.Remove(row.Id);
                }
            }
        }
        catch
        {
        }
        StateHasChanged();
    }

