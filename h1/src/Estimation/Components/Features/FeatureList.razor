                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="r => r.AcceptanceCriteria" Sortable="false" CellStyle="min-width:100px; max-width:400px;" Hidden="!_showAcceptanceCriteria">
                    <HeaderTemplate>@SortableHeader(SortableAcceptanceCriteria, PlanningDisplayNames.AcceptanceCriteria)</HeaderTemplate>
                </PropertyColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showTargetStart">
                    <HeaderTemplate>@SortableHeader(SortableTargetStart, PlanningDisplayNames.TargetStart)</HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.TargetStart.HasValue)
                        {
                            @context.Item.TargetStart.Value.ToString("yyyy-MM-dd")
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showTargetEnd">
                    <HeaderTemplate>@SortableHeader(SortableTargetEnd, PlanningDisplayNames.TargetEnd)</HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.TargetEnd.HasValue)
                        {
                            @context.Item.TargetEnd.Value.ToString("yyyy-MM-dd")
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="r => r.StoryPoints" Sortable="false" Hidden="!_showStoryPoints">
                    <HeaderTemplate>@SortableHeader(SortableStoryPoints, PlanningDisplayNames.StoryPoints)</HeaderTemplate>
                </PropertyColumn>

                <TemplateColumn Sortable="false" Resizable="true" Hidden="!_showTechStackEstimation">
                    <HeaderTemplate>@SortableHeader(SortableTechStackEstimation, PlanningDisplayNames.TechStackEstimation)</HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.TechStackEstimation.HasValue)
