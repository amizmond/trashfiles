    private List<Feature> FilterVisibleFeatures(List<Feature> items) =>
        items.Where(f => _permissions.CanView("Features", GetFeatureScope(f.ProjectKey, f.JiraId))).ToList();

    private TrainScope GetFeatureScope(string? projectKey, string? jiraId)
    {
        var key = TrainResolver.GetProjectKey(projectKey, jiraId);
        if (key is null)
        {
            return TrainScope.Unrestricted;
        }

        return _capitalProjectByJiraKey.TryGetValue(key, out var cp)
            ? TrainScope.ForTrains([cp.Id])
            : TrainScope.AdminOrGeneralOnly;
    }

