@attribute [Route(RoutingPath.TeamsUploadBulkPreview)]

@inject ITeamUploadService UploadService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@using Serilog
@using Estimation.Core.Resources.Models
@using Estimation.Core.Resources.Services

<AccessGuard PageKey="Teams" RequireEdit="true">
<PageTitle>Teams Upload Preview</PageTitle>

<div class="container-fluid mt-3 mb-5">
    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <div class="d-flex align-center gap-2 mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Navigation.NavigateTo(RoutingPath.Teams))" />
            <MudText Typo="Typo.h6">Teams Upload Preview</MudText>
        </div>

        @if (_saving)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-2" />
        }

        @if (_rows is null || !_rows.Any())
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                No data to preview. Please go back and upload a file.
            </MudAlert>
        }
        else
        {
            <div style="@(_saving ? "pointer-events:none;opacity:0.6" : "")">
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    @_rows.Count row(s) parsed.
                    @_rows.Count(r => r.IsNew) new team(s) will be created.
                    @_rows.Count(r => !r.IsNew && r.HasChanges) existing team(s) will be updated.
                    @_rows.Count(r => !r.HasChanges) unchanged.
                </MudAlert>

                @if (_blockedRows.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        <div class="mb-1">
                            @_blockedCount ART link(s) in @_blockedRows.Count row(s) will be skipped. Everything else in those rows is applied.
                        </div>
                        @foreach (var row in _blockedRows)
                        {
                            <div>
                                <strong>@row.TeamName</strong>:
                                @string.Join(", ", row.BlockedProjects.Select(b => b.Name))
                                — @row.BlockedProjects[0].Reason
                            </div>
                        }
                        <div class="mt-1">
                            Mark a team as shared between ARTs on its team page if it really belongs to more than one.
                        </div>
                    </MudAlert>
                }

                <div class="mb-3 d-flex flex-wrap gap-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                        New / Added
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                        Will be removed
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                        Skipped
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                        Not changed
                    </MudChip>
                </div>

                <MudTable T="TeamUploadRow"
                          Items="_rows"
                          Hover
                          Striped
                          Dense
                          Bordered="true"
                          HorizontalScrollbar
                          Elevation="0">

                    <HeaderContent>
                        <MudTh Style="min-width:60px">#</MudTh>
                        <MudTh Style="min-width:80px">Status</MudTh>
                        <MudTh Style="min-width:200px">Team Name</MudTh>
                        <MudTh Style="min-width:300px">Project</MudTh>
                        <MudTh Style="min-width:300px">Technology Stacks</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd>@(_rows.IndexOf(context) + 1)</MudTd>
                        <MudTd>
                            @if (context.IsNew)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">New</MudChip>
                            }
                            else if (context.HasChanges)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Update</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">No change</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.TeamName</MudText>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var p in context.UnchangedProjects)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@p</MudChip>
                                }
                                @foreach (var p in context.NewProjects)
                                {
                                    <MudTooltip Text="Will be added" Placement="Placement.Top">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@p</MudChip>
                                    </MudTooltip>
                                }
                                @foreach (var p in context.RemovedProjects)
                                {
                                    <MudTooltip Text="Will be removed" Placement="Placement.Top">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">@p</MudChip>
                                    </MudTooltip>
                                }
                                @foreach (var p in context.BlockedProjects)
                                {
                                    <MudTooltip Text="@p.Reason" Placement="Placement.Top">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                                                 Icon="@Icons.Material.Filled.Block">@p.Name</MudChip>
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var ts in context.UnchangedTechStacks)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@ts</MudChip>
                                }
                                @foreach (var ts in context.NewTechStacks)
                                {
                                    <MudTooltip Text="Will be added" Placement="Placement.Top">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@ts</MudChip>
                                    </MudTooltip>
                                }
                                @foreach (var ts in context.RemovedTechStacks)
                                {
                                    <MudTooltip Text="Will be removed" Placement="Placement.Top">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">@ts</MudChip>
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="ConfirmAsync" Disabled="_saving">
                        Confirm & Save
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Cancel"
                               OnClick="Cancel" Disabled="_saving">
                        Cancel
                    </MudButton>
                </div>
            </div>
        }
    </MudPaper>
</div>

</AccessGuard>

@code {
    private List<TeamUploadRow>? _rows;
    private bool _saving;

    private List<TeamUploadRow> _blockedRows =>
        _rows?.Where(r => r.BlockedProjects.Count > 0).ToList() ?? new List<TeamUploadRow>();

    private int _blockedCount => _blockedRows.Sum(r => r.BlockedProjects.Count);

    protected override void OnInitialized()
    {
        if (TeamUploadPreviewState.PendingUpload is null)
        {
            Navigation.NavigateTo(RoutingPath.Teams);
            return;
        }

        _rows = TeamUploadPreviewState.PendingUpload;
    }

    private async Task ConfirmAsync()
    {
        if (_rows is null)
        {
            return;
        }

        _saving = true;
        try
        {
            await UploadService.SaveAsync(_rows);
            TeamUploadPreviewState.Clear();
            Snackbar.Add("Teams uploaded successfully.", Severity.Success);
            Navigation.NavigateTo(RoutingPath.Teams, true);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to save uploaded teams");
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        TeamUploadPreviewState.Clear();
        Navigation.NavigateTo(RoutingPath.Teams);
    }
}
