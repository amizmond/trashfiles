    private void RecomputeFilteredRows()
    {
        IEnumerable<ProgramRow> filtered = _rows.Where(MatchesFilter);
        filtered = _sortColumn switch
        {
            SortableSummary => _sortDescending
                ? filtered.OrderByDescending(r => r.Summary)
                : filtered.OrderBy(r => r.Summary),
            SortableStatus => _sortDescending
                ? filtered.OrderByDescending(r => r.Status)
                : filtered.OrderBy(r => r.Status),
            _ => filtered
        };
        _filteredRows = filtered.ToList();
    }

    private bool MatchesFilter(ProgramRow r)
    {
        if (!string.IsNullOrWhiteSpace(_filterSearchBacking))
        {
            var s = _filterSearchBacking.Trim();
            if (!((r.Summary?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.JiraId?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)))
            {
                return false;
            }
        }

        if (_filterLabelsNotBacking || _filterLabelsSet.Count > 0)
        {
            var labels = SplitLabels(r.Labels);
            var matches = _filterLabelsSet.Count > 0
                ? labels.Any(_filterLabelsSet.Contains)
                : labels.Length > 0;
            if (matches == _filterLabelsNotBacking)
            {
                return false;
            }
        }

        if (_filterDepartmentNamesSet.Count > 0
            && !r.CapitalProjects.Any(cp => _cpToDept.TryGetValue(cp.Id, out var dn) && _filterDepartmentNamesSet.Contains(dn)))
        {
            return false;
        }

        var hasFeatureFilter = HasFeatureLabelFilter || HasFeaturePiFilter;

        bool InFeatureArts(FeatureRef f) => f.ArtName is not null && _filterCapitalProjectNamesSet.Contains(f.ArtName);

        bool FeaturesPass(Func<FeatureRef, bool> inScope) =>
            (!hasFeatureFilter || r.Features.Any(f => inScope(f) && FeatureMatches(f)))
            && !r.Features.Any(f => inScope(f) && FeatureExcluded(f));

        var hasBoArtFilter = _filterBoArtNamesSet.Count > 0;
        var hasFeatureArtFilter = _filterCapitalProjectNamesSet.Count > 0;

        var boArtMatch = hasBoArtFilter
            && r.BoArts.Any(b => b.ArtNames.Any(_filterBoArtNamesSet.Contains));
        var featureMatch = hasFeatureArtFilter
            && (hasFeatureFilter
                || r.Features.Any(InFeatureArts)
                || (r.Features.Count == 0 && r.CapitalProjects.Any(cp => _filterCapitalProjectNamesSet.Contains(cp.Name))))
            && FeaturesPass(InFeatureArts);

        bool pass;
        if (hasBoArtFilter && hasFeatureArtFilter)
        {
            pass = _filterArtLogicBacking == ArtFilterLogic.Or
                ? boArtMatch ? FeaturesPass(_ => true) : featureMatch
                : boArtMatch && featureMatch;
        }
        else if (hasBoArtFilter)
        {
            pass = boArtMatch && FeaturesPass(_ => true);
        }
        else if (hasFeatureArtFilter)
        {
            pass = featureMatch;
        }
        else
        {
            pass = FeaturesPass(_ => true);
        }

        if (!pass)
        {
            return false;
        }

        if (_filterEpicNamesSet.Count > 0
            && !r.Epics.Any(e => e.JiraId is not null && _filterEpicNamesSet.Contains(e.JiraId)))
        {
            return false;
        }

        if (_filterStatusNotBacking)
        {
            if (_filterStatusesSet.Count > 0
                ? r.Status is not null && _filterStatusesSet.Contains(r.Status)
                : r.Status is not null)
            {
                return false;
            }
        }
        else if (_filterStatusesSet.Count > 0
            && (r.Status is null || !_filterStatusesSet.Contains(r.Status)))
        {
            return false;
        }

        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        _canEdit = UserPageAccess.TryGetValue("StrategicObjectives", out var access) && access == AccessLevel.Edit;

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        Nav.LocationChanged += OnLocationChanged;

        try
        {
            _userName = await WindowsAuth.GetUserName();
            if (_userName is not null && JiraAuth.IsConfigured)
            {
                _jiraConnected = await JiraAuth.IsAuthenticatedAsync(_userName);
            }

            var departments = await DepartmentService.GetAllAsync();
            _cpToDept = departments
                .SelectMany(d => d.CapitalProjects.Select(cp => (cp.Id, d.Name)))
                .ToDictionary(x => x.Id, x => x.Name);
            _artNameToDept = DepartmentArts.ByArtName(departments);

            _allCapitalProjects = await ArtService.GetAllAsync();
            _artLookup = ArtHelper.BuildLookup(_allCapitalProjects);

            _permissions = await PermissionGuard.GetPermissionsAsync();
            ResolveAllowedScope();

            _piLabelRules = (await PiService.GetAllLightAsync())
                .Select(p => new PiLabelRule(p.Name, p.StartDate, PiLabelMatching.ParseLabels(p.FeatureLabels), p.LabelMatchMode))
                .Where(rule => rule.Labels.Count > 0)
                .ToList();

            var items = FilterVisibleObjectives(await ProgramService.GetAllWithHierarchyAsync());
            _rows = items.Select(ToRow).ToList();

            PopulateAvailableFilterValues();

            if (!ReadUrlParams())
            {
                await GlobalFilter.EnsureLoadedAsync();
                ApplyGlobalFilter();
            }

            KeepSelectedOptions();
            RecomputeFilteredRows();
        }
        finally { _loading = false; _suppressUrlUpdate = false; }

        var current = Nav.ToAbsoluteUri(Nav.Uri);
        if (current.AbsoluteUri != _readUri && IsListUri(current))
        {
            _reloadTask = ReloadFromUrlAsync();
            await _reloadTask;
        }
    }

    private List<StrategicObjective> FilterVisibleObjectives(List<StrategicObjective> items) =>
        _permissions.IsAdmin
            ? items
            : items.Where(pp => _permissions.CanView("StrategicObjectives", GetObjectiveScope(pp))).ToList();

    private TrainScope GetObjectiveScope(StrategicObjective pp) =>
        TrainResolver.ResolveForChildren(
            pp.StrategicObjectivePortfolioEpics
                .SelectMany(ppe => ppe.PortfolioEpic.BusinessOutcomes)
                .SelectMany(bo => bo.Features),
            _artLookup.Matcher);

    private ProgramRow ToRow(StrategicObjective pp)
    {
        var outcomes = pp.StrategicObjectivePortfolioEpics
            .SelectMany(ppe => ppe.PortfolioEpic.BusinessOutcomes).ToList();
        var features = outcomes.SelectMany(bo => bo.Features).ToList();

        return new ProgramRow(
            Id: pp.Id,
            JiraId: pp.JiraId,
            Summary: pp.Summary,
            CapitalProjects: ArtHelper.ResolveParentArts(pp, features, _artLookup).ToList(),
            Epics: pp.StrategicObjectivePortfolioEpics
                .Select(ppe => new EpicRef(ppe.PortfolioEpicId, ppe.PortfolioEpic.JiraId, ppe.PortfolioEpic.Summary))
                .ToList(),
            FeaturePis: features
                .Where(f => f.Pi is not null)
                .Select(f => new FeaturePiRef(f.Pi!.Name, f.Pi.StartDate))
                .DistinctBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList(),
            BoArts: outcomes
                .Select(bo => new ArtItemRef(bo.Id, bo.JiraId, bo.Summary,
                    ArtHelper.ResolveParentArts(bo, bo.Features, _artLookup).Select(a => a.Name).ToList(),
                    bo.Labels))
                .Where(b => b.ArtNames.Count > 0)
                .ToList(),
            Features: features
                .Select(f => new FeatureRef(f.Id, f.JiraId, f.Summary,
                    ArtHelper.ResolveArt(f, _artLookup)?.Name,
                    f.Labels, f.Pi?.Name))
                .ToList(),
            Labels: pp.Labels,
            FeatureLabels: features
                .Where(f => !string.IsNullOrEmpty(f.Labels))
                .SelectMany(f => f.Labels!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                .Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
            Status: pp.Status
        );
    }

    private async Task ConfirmDeleteAsync(ProgramRow row)
    {
        try
        {
            if (await MessageService.Confirm($"Delete {row.Summary} ?"))
            {
                await ProgramService.DeleteAsync(row.Id);
                _rows.RemoveAll(r => r.Id == row.Id);
                PopulateAvailableFilterValues();
                RecomputeFilteredRows();
                UpdateUrl();
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, ex.Message);
            await MessageService.Exception(ex);
        }
    }

    private async Task OpenSyncDialogAsync()
    {
        if (_allCapitalProjects.Count == 0)
        {
            _allCapitalProjects = await ArtService.GetAllAsync();
            _artLookup = ArtHelper.BuildLookup(_allCapitalProjects);
        }

        var projectsWithKey = _allCapitalProjects
            .Where(cp => cp.HasKeys)
            .ToList();

        if (projectsWithKey.Count == 0)
        {
            Snackbar.Add("No ART Level records have a Jira Key configured.", Severity.Warning);
            return;
        }

        var existingJiraIds = await ProgramService.GetExistingJiraIdsAsync();

        var parameters = new DialogParameters<JiraSyncDialog>
        {
            { x => x.Projects, projectsWithKey.Select(cp => new JiraSyncDialog.ProjectOption(cp.Id, cp.Keys, cp.Name)).ToList() },
            { x => x.IssueType, JiraIssueTypes.StrategicObjective },
            { x => x.UserName, _userName! },
            { x => x.ExistingJiraIds, existingJiraIds }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<JiraSyncDialog>("Find new Strategic Objectives in Jira", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        var syncResult = (JiraSyncDialog.JiraSyncDialogResult)result.Data!;
        await RunSyncAsync(syncResult.ProjectId, syncResult.ProjectKey, syncResult.Issues);
    }

    private async Task RunSyncAsync(int capitalProjectId, string projectKey, List<JiraIssueResponse> jiraIssues, Dictionary<string, HashSet<string>>? propertyMaskByJiraKey = null, bool createMissing = true)
    {
        _syncing = true;
        StateHasChanged();

        try
        {
            if (jiraIssues.Count == 0)
            {
                Snackbar.Add($"No Strategic Objectives found in Jira project {projectKey}.", Severity.Info);
                return;
            }

            var syncItems = jiraIssues
                .Select(ji => ji.ToStrategicObjectiveSyncItem(propertyMaskByJiraKey?.GetValueOrDefault(ji.Key)))
                .ToList();

            var syncResult = await ProgramService.SyncFromJiraAsync(capitalProjectId, projectKey, syncItems, createMissing);

            Snackbar.Add(
                $"Sync complete: {syncResult.Created} created, {syncResult.Updated} updated, {syncResult.Linked} linked.",
                Severity.Success);

            var items = FilterVisibleObjectives(await ProgramService.GetAllWithHierarchyAsync());
            _rows = items.Select(ToRow).ToList();
            PopulateAvailableFilterValues();
            RecomputeFilteredRows();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Jira sync failed");
            Snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncing = false;
        }
    }

    private void ToggleSort(string sortKey)
    {
        if (_sortColumn == sortKey)
        {
            if (_sortDescending)
            {
                _sortColumn = null;
                _sortDescending = false;
            }
            else
            {
                _sortDescending = true;
            }
        }
        else
        {
            _sortColumn = sortKey;
            _sortDescending = false;
        }
        RecomputeFilteredRows();
        UpdateUrl();
    }

    private static readonly string[] FilterQueryKeys =
        ["gf", "search", "labelNot", "label", "fLabelNot", "fLabel", "dept", "cp", "boArt", "epic", "piNot", "pi", "statusNot", "status"];

    private bool _globalFilterCleared;

    private void ApplyGlobalFilter()
    {
        var values = GlobalFilter.Values;

        GlobalFilterApply.Names(values.DepartmentNames,
            ref _filterDepartmentNamesBacking, ref _filterDepartmentNamesSet, _availableDepartments);
        GlobalFilterApply.Names(values.ArtNames,
            ref _filterCapitalProjectNamesBacking, ref _filterCapitalProjectNamesSet, _availableCapitalProjects);
        GlobalFilterApply.Names(values.PiNames,
            ref _filterPiNamesBacking, ref _filterPiNamesSet, _availablePis);
    }

    private bool ReadUrlParams()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _readUri = uri.AbsoluteUri;
        var q = QueryHelpers.ParseQuery(uri.Query);
        var hasFilterParams = FilterQueryKeys.Any(k => q.TryGetValue(k, out var v) && !string.IsNullOrWhiteSpace(v));
        if (q.TryGetValue("gf", out var gf) && gf == "0")
        {
            _globalFilterCleared = true;
        }
        if (q.TryGetValue("search", out var search) && !string.IsNullOrWhiteSpace(search))
        {
            _filterSearchBacking = search.ToString();
        }
        if (q.TryGetValue("labelNot", out var labelNot)
            && string.Equals(labelNot, "true", StringComparison.OrdinalIgnoreCase))
        {
            _filterLabelsNotBacking = true;
        }
        if (q.TryGetValue("label", out var label) && !string.IsNullOrWhiteSpace(label))
        {
            var vals = MatchOptions(label.ToString(), _availableLabels);
            _filterLabelsBacking = vals;
            _filterLabelsSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("fLabelNot", out var fLabelNot)
            && string.Equals(fLabelNot, "true", StringComparison.OrdinalIgnoreCase))
        {
            _filterFeatureLabelsNotBacking = true;
        }
        if (q.TryGetValue("fLabel", out var fLabel) && !string.IsNullOrWhiteSpace(fLabel))
        {
            var vals = MatchOptions(fLabel.ToString(), _availableFeatureLabels);
            _filterFeatureLabelsBacking = vals;
            _filterFeatureLabelsSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("dept", out var dept) && !string.IsNullOrWhiteSpace(dept))
        {
            var vals = MatchOptions(dept.ToString(), _availableDepartments);
            _filterDepartmentNamesBacking = vals;
            _filterDepartmentNamesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("cp", out var cp) && !string.IsNullOrWhiteSpace(cp))
        {
            var vals = MatchOptions(cp.ToString(), _availableCapitalProjects);
            _filterCapitalProjectNamesBacking = vals;
            _filterCapitalProjectNamesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("boArt", out var boArt) && !string.IsNullOrWhiteSpace(boArt))
        {
            var vals = MatchOptions(boArt.ToString(), _availableBoArts);
            _filterBoArtNamesBacking = vals;
            _filterBoArtNamesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("artLogic", out var artLogic) && !string.IsNullOrWhiteSpace(artLogic))
        {
            if (string.Equals(artLogic, "and", StringComparison.OrdinalIgnoreCase))
            {
                _filterArtLogicBacking = ArtFilterLogic.And;
            }
            else if (string.Equals(artLogic, "or", StringComparison.OrdinalIgnoreCase))
            {
                _filterArtLogicBacking = ArtFilterLogic.Or;
            }
        }
        if (q.TryGetValue("epic", out var epic) && !string.IsNullOrWhiteSpace(epic))
        {
            var vals = MatchOptions(epic.ToString(), _availableEpicIds);
            _filterEpicNamesBacking = vals;
            _filterEpicNamesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("piNot", out var piNot)
            && string.Equals(piNot, "true", StringComparison.OrdinalIgnoreCase))
        {
            _filterPiNotBacking = true;
        }
        if (q.TryGetValue("piLabels", out var piLabels)
            && string.Equals(piLabels, "false", StringComparison.OrdinalIgnoreCase))
        {
            _filterPiLabelsBacking = false;
        }
        if (q.TryGetValue("pi", out var pi) && !string.IsNullOrWhiteSpace(pi))
        {
            var vals = MatchOptions(pi.ToString(), _availablePis);
            _filterPiNamesBacking = vals;
            _filterPiNamesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("statusNot", out var statusNot)
            && string.Equals(statusNot, "true", StringComparison.OrdinalIgnoreCase))
        {
            _filterStatusNotBacking = true;
        }
        if (q.TryGetValue("status", out var status) && !string.IsNullOrWhiteSpace(status))
        {
            var vals = MatchOptions(status.ToString(), _availableStatuses);
            _filterStatusesBacking = vals;
            _filterStatusesSet = new HashSet<string>(vals, StringComparer.OrdinalIgnoreCase);
        }
        if (q.TryGetValue("sortBy", out var sortBy) && !string.IsNullOrWhiteSpace(sortBy))
        {
            _sortColumn = sortBy.ToString();
            _sortDescending = q.TryGetValue("sortDesc", out var sortDesc)
                && string.Equals(sortDesc, "true", StringComparison.OrdinalIgnoreCase);
        }

        if (q.TryGetValue("page", out var pageStr)
            && int.TryParse(pageStr, out var pageVal) && pageVal >= 0)
        {
            _currentPageBacking = pageVal;
        }

        if (q.TryGetValue("pageSize", out var pageSizeStr)
            && int.TryParse(pageSizeStr, out var pageSizeVal) && PageSizeOptions.Contains(pageSizeVal))
        {
            _pageSizeBacking = pageSizeVal;
            _initialPageSizeFromUrl = pageSizeVal;
        }

        return hasFilterParams;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initialPageSizeFromUrl.HasValue && _grid is not null)
        {
            var size = _initialPageSizeFromUrl.Value;
            _initialPageSizeFromUrl = null;
            await _grid.SetRowsPerPageAsync(size, false);
        }
    }

    private void UpdateUrl()
    {
        if (_suppressUrlUpdate || _disposed || !IsListUri(Nav.ToAbsoluteUri(Nav.Uri)))
        {
            return;
        }
        var query = new Dictionary<string, object?>();
        query["search"] = string.IsNullOrWhiteSpace(_filterSearchBacking) ? null : _filterSearchBacking;
        query["labelNot"] = _filterLabelsNotBacking ? (object?)true : null;
        query["label"] = _filterLabelsSet.Count > 0 ? string.Join(",", _filterLabelsBacking) : null;
        query["fLabelNot"] = _filterFeatureLabelsNotBacking ? (object?)true : null;
        query["fLabel"] = _filterFeatureLabelsSet.Count > 0 ? string.Join(",", _filterFeatureLabelsBacking) : null;
        query["dept"] = _filterDepartmentNamesSet.Count > 0 ? string.Join(",", _filterDepartmentNamesBacking) : null;
        query["cp"] = _filterCapitalProjectNamesSet.Count > 0 ? string.Join(",", _filterCapitalProjectNamesBacking) : null;
        query["boArt"] = _filterBoArtNamesSet.Count > 0 ? string.Join(",", _filterBoArtNamesBacking) : null;
        query["artLogic"] = _filterArtLogicBacking == ArtFilterLogic.Or ? "or" : null;
        query["epic"] = _filterEpicNamesSet.Count > 0 ? string.Join(",", _filterEpicNamesBacking) : null;
        query["piNot"] = _filterPiNotBacking ? (object?)true : null;
        query["piLabels"] = !_filterPiLabelsBacking ? (object?)false : null;
        query["pi"] = _filterPiNamesSet.Count > 0 ? string.Join(",", _filterPiNamesBacking) : null;
        query["statusNot"] = _filterStatusNotBacking ? (object?)true : null;
        query["status"] = _filterStatusesSet.Count > 0 ? string.Join(",", _filterStatusesBacking) : null;
        query["gf"] = _globalFilterCleared ? (object?)0 : null;
        query["sortBy"] = _sortColumn;
        query["sortDesc"] = _sortDescending && _sortColumn is not null ? (object?)true : null;
        query["page"] = _currentPageBacking > 0 ? (object?)_currentPageBacking : null;
        query["pageSize"] = _pageSizeBacking != 10 ? (object?)_pageSizeBacking : null;
        var uri = Nav.GetUriWithQueryParameters(query);
        _urlWrites.Add(Nav.ToAbsoluteUri(uri).AbsoluteUri);
        Nav.NavigateTo(uri, replace: true);
    }

    private readonly List<string> _urlWrites = new();
    private string? _readUri;
    private Task? _reloadTask;
    private bool _disposed;

    private static bool IsListUri(Uri uri) =>
        string.Equals(uri.AbsolutePath.TrimEnd('/'), RoutingPath.StrategicObjectives, StringComparison.OrdinalIgnoreCase);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_loading)
        {
            return;
        }

        var uri = Nav.ToAbsoluteUri(e.Location);
        var written = _urlWrites.IndexOf(uri.AbsoluteUri);
        if (written >= 0)
        {
            _urlWrites.RemoveRange(0, written + 1);
            return;
        }

        _urlWrites.Clear();
        if (IsListUri(uri))
        {
            InvokeAsync(() => _reloadTask = ReloadFromUrlAsync());
        }
    }

    private async Task ReloadFromUrlAsync()
    {
        _filterVersion++;
        _filterPending = false;
        _filterDebounceTimer?.Dispose();
        ResetFilters();
        _globalFilterCleared = false;
        _sortColumn = null;
        _sortDescending = false;
        _currentPageBacking = 0;
        _pageSizeBacking = 10;

        var hasFilterParams = ReadUrlParams();
        var page = _currentPageBacking;
        _currentPageBacking = 0;

        if (!hasFilterParams)
        {
            await GlobalFilter.EnsureLoadedAsync();
            ApplyGlobalFilter();
        }

        KeepSelectedOptions();

        if (_grid is not null)
        {
            _initialPageSizeFromUrl = null;
            await _grid.SetRowsPerPageAsync(_pageSizeBacking, true);
        }

        _currentPageBacking = page;
        RecomputeFilteredRows();
        StateHasChanged();
    }

    private void NavigateToEdit(int id)
    {
        var currentUri = new Uri(Nav.Uri);
        var returnUrl = currentUri.PathAndQuery;
        var editUri = Nav.GetUriWithQueryParameters(
            $"{RoutingPath.StrategicObjectives}/{id}",
            new Dictionary<string, object?> { ["returnUrl"] = returnUrl });
        Nav.NavigateTo(editUri);
    }

    private async Task SyncFilteredAsync()
    {
        await ApplyPendingFilterAsync();
        var jiraKeys = JiraIssueIds.Keys(_filteredRows.Select(r => r.JiraId));

        if (jiraKeys.Count == 0)
        {
            Snackbar.Add("No filtered records have a Jira ID.", Severity.Warning);
            return;
        }

        var confirmed = await MessageService.Confirm(
            $"This will search Jira for the {jiraKeys.Count} filtered Strategic Objective(s) that have a Jira ID " +
            "and compare them with the database. You will then see the differences and choose which " +
            "records to update from Jira. No new records are created. Continue?",
            "Update filtered from Jira", "Continue");
        if (!confirmed)
        {
            return;
        }

        _syncing = true;
        StateHasChanged();

        try
        {
            var jiraIssues = await JiraIssueService.GetIssuesByKeysAsync(_userName!, jiraKeys);

            var dbItems = JiraIssueIds.NewestMatching(await ProgramService.GetAllAsync(), jiraKeys, so => so.Id);

            var diffs = JiraDiffService.DiffJiraIssues(jiraIssues, dbItems)
                .Select(d => new JiraFilteredSyncDiffDialog.DiffItem(d.JiraKey, d.PropertyName, d.DbValue, d.JiraValue))
                .ToList();

            var parameters = new DialogParameters<JiraFilteredSyncDiffDialog>
            {
                { x => x.Diffs, diffs },
                { x => x.JiraIssues, jiraIssues }
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
            var dialog = await DialogService.ShowAsync<JiraFilteredSyncDiffDialog>(
                "Jira Differences — Strategic Objectives", parameters, options);
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
            {
                var selection = (JiraFilteredSyncDiffDialog.SyncSelection)result.Data!;
                await RunSyncAsync(0, string.Empty, selection.Issues, selection.PropertyMaskByJiraKey, createMissing: false);
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Sync filtered strategic objectives failed");
            Snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncing = false;
        }
    }

    private async Task ExportFilteredAsync()
    {
        if (_exporting)
        {
            return;
        }

        _exporting = true;
        StateHasChanged();

        try
        {
            await ApplyPendingFilterAsync();
            if (_filteredRows.Count == 0)
            {
                Snackbar.Add("No filtered strategic objectives to export.", Severity.Warning);
                return;
            }

            var exportRows = _filteredRows.Select(r => new StrategicObjectiveExportRow
            {
                JiraId = r.JiraId,
                Summary = r.Summary,
                Status = r.Status,
                Epics = string.Join(", ", r.Epics.Select(e => e.Summary).Where(s => !string.IsNullOrEmpty(s))),
                Labels = r.Labels
            }).ToList();

            var bytes = StrategicObjectiveExportService.Generate(exportRows);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("eval",
                $"var a=document.createElement('a');a.href='data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}';a.download='StrategicObjectives.xlsx';document.body.appendChild(a);a.click();a.remove();");
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to export strategic objectives");
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private HashSet<string>? _allowedArtNames;
    private HashSet<string>? _allowedDepartmentNames;

    private void ResolveAllowedScope()
    {
        var allowedTrainIds = _permissions.GetAllowedTrains("StrategicObjectives", AccessLevel.ReadOnly);
        if (allowedTrainIds is null)
        {
            _allowedArtNames = null;
            _allowedDepartmentNames = null;
            return;
        }

        var ids = allowedTrainIds.ToHashSet();
        _allowedArtNames = _allCapitalProjects
            .Where(cp => ids.Contains(cp.Id))
            .Select(cp => cp.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _allowedDepartmentNames = ids
            .Where(_cpToDept.ContainsKey)
            .Select(id => _cpToDept[id])
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private bool IsArtAllowed(string name) => _allowedArtNames is null || _allowedArtNames.Contains(name);

    private bool IsDepartmentAllowed(string name) => _allowedDepartmentNames is null || _allowedDepartmentNames.Contains(name);

    private void PopulateAvailableFilterValues()
    {
        _availableDepartments = _rows
            .SelectMany(r => r.CapitalProjects)
            .Where(cp => _cpToDept.ContainsKey(cp.Id))
            .Select(cp => _cpToDept[cp.Id])
            .Where(IsDepartmentAllowed)
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
        _capitalProjectChoices = _rows
            .SelectMany(r => r.Features.Select(f => f.ArtName)
                .Concat(r.Features.Count == 0 ? r.CapitalProjects.Select(cp => cp.Name) : Enumerable.Empty<string>()))
            .Where(n => !string.IsNullOrEmpty(n))
            .Select(n => n!)
            .Where(IsArtAllowed)
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
        _boArtChoices = _rows
            .SelectMany(r => r.BoArts.SelectMany(b => b.ArtNames))
            .Where(n => !string.IsNullOrEmpty(n))
            .Where(IsArtAllowed)
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
        _availableEpics = _rows
            .SelectMany(r => r.Epics)
            .Where(e => !string.IsNullOrEmpty(e.JiraId))
            .Select(e => (e.JiraId!, e.Summary))
            .DistinctBy(e => e.Item1, StringComparer.OrdinalIgnoreCase)
            .OrderBy(e => e.Item1).ToList();
        _availablePis = _rows
            .SelectMany(r => r.FeaturePis)
            .Concat(_piLabelRules
                .Where(rule => _rows.Any(r => r.Features.Any(f => rule.Matches(f.Labels))))
                .Select(rule => new FeaturePiRef(rule.PiName, rule.StartDate)))
            .GroupBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .Select(g => new { Name = g.Key, StartDate = g.Max(p => p.StartDate) })
            .OrderByDescending(p => p.StartDate ?? DateTime.MinValue)
            .ThenBy(p => p.Name)
            .Select(p => p.Name).ToList();
        _availableStatuses = _rows
            .Where(r => !string.IsNullOrEmpty(r.Status))
            .Select(r => r.Status!)
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
        _availableLabels = _rows
            .SelectMany(r => SplitLabels(r.Labels))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
        _availableFeatureLabels = _rows
            .SelectMany(r => r.FeatureLabels)
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
        KeepSelectedOptions();
    }

    private void KeepSelectedOptions()
    {
        _filterDepartmentNamesBacking = KeepSelected(_filterDepartmentNamesBacking, _availableDepartments);
        ShowArtChoices();
        _filterPiNamesBacking = KeepSelected(_filterPiNamesBacking, _availablePis);
        _filterStatusesBacking = KeepSelected(_filterStatusesBacking, _availableStatuses);
        _filterLabelsBacking = KeepSelected(_filterLabelsBacking, _availableLabels);
        _filterFeatureLabelsBacking = KeepSelected(_filterFeatureLabelsBacking, _availableFeatureLabels);

        _filterEpicNamesBacking = MatchOptions(_filterEpicNamesBacking, _availableEpicIds);
        _availableEpics.AddRange(_filterEpicNamesBacking
            .Where(id => !_availableEpics.Any(e => string.Equals(e.JiraId, id, StringComparison.OrdinalIgnoreCase)))
            .Select(id => (id, (string?)null))
            .ToList());
    }

    private static string[] KeepSelected(IReadOnlyCollection<string> selected, List<string> options)
    {
        var kept = MatchOptions(selected, options);
        options.AddRange(kept.Where(v => !options.Contains(v, StringComparer.OrdinalIgnoreCase)).ToList());
        return kept;
    }

    private List<ArtItemRef> GetMatchedBos(ProgramRow r) =>
        r.BoArts
            .Where(b => b.ArtNames.Any(_filterBoArtNamesSet.Contains))
            .DistinctBy(b => b.Id)
            .OrderBy(b => b.JiraId, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<FeatureRef> GetMatchedFeatures(ProgramRow r) =>
        r.Features
            .Where(f => f.ArtName is not null && _filterCapitalProjectNamesSet.Contains(f.ArtName) && FeatureMatches(f) && !FeatureExcluded(f))
            .DistinctBy(f => f.Id)
            .OrderBy(f => f.JiraId, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool HasFeatureLabelFilter => !_filterFeatureLabelsNotBacking && _filterFeatureLabelsSet.Count > 0;

    private bool HasFeaturePiFilter => !_filterPiNotBacking && _filterPiNamesSet.Count > 0;

    private bool HasSelectedLabel(FeatureRef f) => SplitLabels(f.Labels).Any(_filterFeatureLabelsSet.Contains);

    private bool InSelectedPi(FeatureRef f) =>
        (f.PiName is not null && _filterPiNamesSet.Contains(f.PiName))
        || (_filterPiLabelsBacking
            && _piLabelRules.Any(rule => _filterPiNamesSet.Contains(rule.PiName) && rule.Matches(f.Labels)));

    private bool FeatureMatches(FeatureRef f) =>
        (!HasFeatureLabelFilter || HasSelectedLabel(f))
        && (!HasFeaturePiFilter || InSelectedPi(f));

    private bool FeatureExcluded(FeatureRef f) =>
        (_filterPiNotBacking
            && (_filterPiNamesSet.Count > 0 ? InSelectedPi(f) : f.PiName is not null)
            && (!HasFeatureLabelFilter || HasSelectedLabel(f)))
        || (_filterFeatureLabelsNotBacking
            && (_filterFeatureLabelsSet.Count > 0 ? HasSelectedLabel(f) : SplitLabels(f.Labels).Length > 0)
            && (!HasFeaturePiFilter || InSelectedPi(f)));

    private static string[] SplitLabels(string? labels) =>
        string.IsNullOrEmpty(labels)
            ? Array.Empty<string>()
            : labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string[] MatchOptions(string values, IEnumerable<string> options) =>
        MatchOptions(SplitLabels(values), options);

    private static string[] MatchOptions(IEnumerable<string> values, IEnumerable<string> options) =>
        values
            .Select(v => options.FirstOrDefault(o => string.Equals(o, v, StringComparison.OrdinalIgnoreCase)) ?? v)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private Task ShowMatchedBosAsync(ProgramRow r) =>
        ShowMatchedItemsAsync(
            GetMatchedBos(r).Select(b => new MatchedItemsDialog.ItemRow(b.Id, b.JiraId, b.Summary)).ToList(),
            RoutingPath.BusinessOutcomes,
            $"Business Outcomes matching selected ARTs — {r.JiraId}");

    private Task ShowMatchedFeaturesAsync(ProgramRow r) =>
        ShowMatchedItemsAsync(
            GetMatchedFeatures(r).Select(f => new MatchedItemsDialog.ItemRow(f.Id, f.JiraId, f.Summary)).ToList(),
            RoutingPath.Features,
            $"Features matching selected ARTs — {r.JiraId}");

    private async Task ShowMatchedItemsAsync(List<MatchedItemsDialog.ItemRow> rows, string itemRoute, string title)
    {
        var parameters = new DialogParameters<MatchedItemsDialog>
        {
            { x => x.Items, rows },
            { x => x.ItemRoute, itemRoute },
            { x => x.JiraTaskUrl, Configuration["JiraTaskUrl"] }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<MatchedItemsDialog>(title, parameters, options);
    }

    public void Dispose()
    {
        _disposed = true;
        _filterPending = false;
        _filterVersion++;
        Nav.LocationChanged -= OnLocationChanged;
        _filterDebounceTimer?.Dispose();
    }

    private record EpicRef(int Id, string? JiraId, string? Summary);
    private record FeaturePiRef(string Name, DateTime? StartDate);
    private record ArtItemRef(int Id, string? JiraId, string? Summary, List<string> ArtNames, string? Labels);
    private record FeatureRef(int Id, string? JiraId, string? Summary, string? ArtName, string? Labels, string? PiName);

    private record PiLabelRule(string PiName, DateTime? StartDate, HashSet<string> Labels, PiLabelMatchMode Mode)
    {
        public bool Matches(string? featureLabels) => PiLabelMatching.Matches(Labels, Mode, featureLabels);
    }

    private record ProgramRow(
        int Id,
        string? JiraId,
        string Summary,
        List<ArtRef> CapitalProjects,
        List<EpicRef> Epics,
        List<FeaturePiRef> FeaturePis,
        List<ArtItemRef> BoArts,
        List<FeatureRef> Features,
        string? Labels,
        List<string> FeatureLabels,
        string? Status
    );
}
