        {
            _ = WriteStoredAsync(LinkTypesStorageKey, current);
        }
    }

    private void ZoomBy(int delta)
    {
        var zoom = Math.Clamp(Zoom + delta, MinZoom, MaxZoom);
        var value = zoom == DefaultZoom ? null : zoom.ToString(CultureInfo.InvariantCulture);

        if (_tableView)
        {
            _tableZoom = zoom;
            _ = WriteStoredAsync(TableZoomStorageKey, value);
        }
        else
        {
            _boardZoom = zoom;
            _ = WriteStoredAsync(BoardZoomStorageKey, value);
        }
    }

