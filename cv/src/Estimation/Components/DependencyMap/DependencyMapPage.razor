    private async Task ClearSelectionLineAsync()
    {
        if (!_selection.IsEmpty)
        {
            SetSelection(DependencySelection.None);
            return;
        }

        await SetMyTeamAsync(null);
    }

    private void ToggleRisk(DependencyRisk risk)
    {
        var selected = _filter.Risks.ToHashSet();

        if (selected.Count == 0)
        {
            selected.Add(risk);
        }
        else if (!selected.Remove(risk))
        {
            selected.Add(risk);
        }

        if (selected.Count == DependencyRiskDisplay.All.Count)
        {
            selected.Clear();
        }

        _filter.Risks = DependencyRiskDisplay.All.Where(selected.Contains).ToList();
        Rebuild();
        UpdateUrl();
    }

    private void SetChain(ChainMode mode)
    {
        _chain = mode;

        if (_focus is not null)
        {
            _focus = _focus with { Chain = mode };
        }

        Rebuild();
        UpdateUrl();
    }

