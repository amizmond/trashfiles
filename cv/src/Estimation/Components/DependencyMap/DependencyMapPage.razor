    private async Task OnFindSelectedAsync(FindOption? option)
    {
        if (option is null)
        {
            return;
        }

        FocusNode(option.NodeId, null);

        if (_find is not null)
        {
            await _find.ClearAsync();
        }
    }

    private Task<IEnumerable<FindOption>> SearchAsync(string? value, CancellationToken token)
    {
        var needle = value?.Trim();
        IEnumerable<FindOption> matches = string.IsNullOrEmpty(needle)
            ? _findOptions
            : _findOptions.Where(o => o.Text.Contains(needle, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult<IEnumerable<FindOption>>(matches.Take(MaxFindResults).ToList());
    }

    private async Task OpenFeatureAsync()
    {
        if (_view?.Panel is not { } panel || !_openable.Contains(panel.Feature.FeatureId))
        {
            return;
        }

        await JS.InvokeVoidAsync("open", $"{RoutingPath.Features}/{panel.Feature.FeatureId}", "_blank");
    }

    private async Task ExportAsync()
    {
        if (_loading || _data is null || _view is null || _exporting)
        {
            return;
        }

        _exporting = true;

        try
        {
            var bytes = DependencyExcelExportService.Build(_data, _view.Rows, _jiraTaskUrl, FilterText());
            var fileName = $"dependencies-{SafeFileName(_data.ArtName)}-{SafeFileName(_data.PiName)}-{DateTime.UtcNow:yyyyMMdd}.xlsx";
            await DownloadService.DownloadAsync(bytes, fileName);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to export the dependency map to Excel");
            Snackbar.Add("The export failed.", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private string FilterText()
    {
        var parts = new List<string>();

        if (MyTeamLane is { } team)
        {
            parts.Add($"{PlanningDisplayNames.MyTeam}: {team.Name}");
        }

        if (!_selection.IsEmpty)
        {
            parts.Add($"Showing: {SelectionText}");
        }

        parts.Add($"Link types: {LinkTypesText()}");
        parts.Add($"Risks: {(_filter.Risks.Count == 0 ? "all" : string.Join(", ", DependencyRiskDisplay.All.Where(_filter.Risks.Contains).Select(DependencyRiskRule.Label)))}");
        parts.Add($"Same ART, other PI: {OnOff(_filter.ShowOtherPi)}");
        parts.Add($"Other ART or no ART: {OnOff(_filter.ShowOtherArt)}");
        parts.Add($"Issues that are not features: {OnOff(_filter.ShowNotInTool)}");
        parts.Add($"Links inside one team: {OnOff(_filter.ShowWithinTeam)}");
        parts.Add($"Feature filters: {_featureFilter.ActiveCount}");
        parts.Add($"Label matches: {OnOff(_includeLabelMatches)}");

        return string.Join("; ", parts);
    }

    private string LinkTypesText()
    {
        if (!_filter.FiltersLinkTypes)
        {
            return "all";
        }

        var names = string.Join(", ", _filter.LinkTypes);
        return _filter.LinkTypesNot ? $"all except {names}" : names;
    }

    private async Task RestorePreferencesAsync()
    {
        _stored = await ReadPreferencesAsync();

        if (DependencyMapQuery.UsesStoredView(_query))
        {
            _tableView = string.Equals(Stored(ViewStorageKey), TableValue, StringComparison.OrdinalIgnoreCase);
        }

        _lines = string.Equals(Stored(LinesStorageKey), RisksValue, StringComparison.OrdinalIgnoreCase)
            ? DependencyLineMode.Risks
            : DependencyLineMode.All;
        _overviewOpen = Stored(OverviewStorageKey) != "0";
        _boardZoom = StoredZoom(BoardZoomStorageKey);
        _tableZoom = StoredZoom(TableZoomStorageKey);

        if (!DependencyMapQuery.HasLinkTypeKeys(_query))
        {
            DependencyMapQuery.ReadLinkTypePreference(Stored(LinkTypesStorageKey), _filter);
        }
    }

    private string? Stored(string key) => _stored.GetValueOrDefault(key);

    private int StoredZoom(string key) =>
        int.TryParse(Stored(key), NumberStyles.Integer, CultureInfo.InvariantCulture, out var zoom)
            ? Math.Clamp(zoom, MinZoom, MaxZoom)
            : DefaultZoom;

    private string? StoredTeamLane() =>
        int.TryParse(Stored(TeamStorageKey), out var teamId) ? TeamLaneIdOf(teamId) : null;

    private string? GlobalTeamLane() => GlobalTeamIds.Count == 1 ? TeamLaneIdOf(GlobalTeamIds[0]) : null;

    private string? TeamLaneIdOf(int teamId)
    {
        var laneId = DependencyClassifier.TeamLaneId(teamId);
        return LaneOf(laneId) is { } lane && IsTeamLane(lane) ? laneId : null;
    }

    private string? LaneIdByName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name) || _index is null)
        {
            return null;
        }

        var trimmed = name.Trim();
        return _index.Lanes.FirstOrDefault(l => string.Equals(l.Name, trimmed, StringComparison.OrdinalIgnoreCase))?.LaneId;
    }

    private string? FeatureNodeByKey(string? key)
    {
        if (string.IsNullOrWhiteSpace(key) || _index is null)
        {
            return null;
        }

        var trimmed = key.Trim();
        return _index.Nodes.Values
            .Where(n => n.Feature is not null && string.Equals(n.Key, trimmed, StringComparison.OrdinalIgnoreCase))
            .OrderBy(n => n.Feature!.Kind)
            .ThenBy(n => n.Feature!.FeatureId)
            .Select(n => n.NodeId)
            .FirstOrDefault();
    }

    private string? FocusKey()
    {
        if (_focus is null || _index is null || !_index.Nodes.TryGetValue(_focus.NodeId, out var node))
        {
            return null;
        }

        return string.IsNullOrEmpty(node.Key) ? null : node.Key;
    }

    private DependencyLane? LaneOf(string? laneId) =>
        laneId is null ? null : _index?.Lanes.FirstOrDefault(l => l.LaneId == laneId);

    private bool IsCardNode(string nodeId) =>
        _index is not null && _index.Nodes.TryGetValue(nodeId, out var node) && node.IsCard;

    private string KeyOfNode(string nodeId)
    {
        if (_index is null || !_index.Nodes.TryGetValue(nodeId, out var node))
        {
            return nodeId;
        }

        return string.IsNullOrEmpty(node.Key) ? node.Feature?.Title ?? nodeId : node.Key;
    }

    private void RequestScroll(string nodeId)
    {
        _scrollTo = nodeId;
        _scrollRequest++;
    }

    private Dictionary<string, string?> ReadQuery()
    {
        var result = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);

        foreach (var (key, value) in QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query))
        {
            result.TryAdd(key, value.ToString());
        }

        return result;
    }

    private async Task<Dictionary<string, string?>> ReadPreferencesAsync()
    {
        try
        {
            var module = await ModuleAsync();
            var values = await module.InvokeAsync<Dictionary<string, string?>?>("readStorage", StoragePrefix);
            return values is null
                ? new Dictionary<string, string?>(StringComparer.Ordinal)
                : new Dictionary<string, string?>(values, StringComparer.Ordinal);
        }
        catch
        {
            return new Dictionary<string, string?>(StringComparer.Ordinal);
        }
    }

    private async Task WriteStoredAsync(string key, string? value)
    {
        try
        {
            if (value is null)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", key);
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.setItem", key, value);
            }
        }
        catch
        {
        }
    }

    private RenderFragment ViewToggle => @<MudToggleGroup T="bool" Value="_tableView" ValueChanged="SetTableViewAsync"
                                                         SelectionMode="SelectionMode.SingleSelection"
                                                         Color="Color.Primary" Size="Size.Small" CheckMark="false">
        <MudToggleItem Value="false">Board</MudToggleItem>
        <MudToggleItem Value="true">Table</MudToggleItem>
    </MudToggleGroup>;

    private RenderFragment LinesControl => @<div class="d-flex align-center gap-1">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Lines</MudText>
        <MudToggleGroup T="DependencyLineMode" Value="_lines" ValueChanged="SetLinesAsync"
                        SelectionMode="SelectionMode.SingleSelection"
                        Color="Color.Primary" Size="Size.Small" CheckMark="false">
            <MudToggleItem Value="DependencyLineMode.All">All</MudToggleItem>
            <MudToggleItem Value="DependencyLineMode.Risks">Risks</MudToggleItem>
        </MudToggleGroup>
    </div>;

    private RenderFragment ZoomControl => @<div class="dm-zoom">
        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" title="Zoom out" aria-label="Zoom out" Disabled="@(Zoom <= MinZoom)" OnClick="@(() => ZoomBy(-ZoomStep))" />
        <span class="dm-zoom-value" title="@(_tableView ? "Table zoom" : "Board zoom")">@Zoom%</span>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" title="Zoom in" aria-label="Zoom in" Disabled="@(Zoom >= MaxZoom)" OnClick="@(() => ZoomBy(ZoomStep))" />
    </div>;

    private RenderFragment FullScreenBar => @<div class="dm-fullscreen-bar">
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mr-2">@PlanningDisplayNames.DependencyMap · @_data?.ArtName · @_data?.PiName</MudText>
        @ViewToggle
        @if (!_tableView)
        {
            @LinesControl
        }
        @ZoomControl
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.FullscreenExit"
                   title="Back to the page (Esc)"
                   OnClick="ExitFullScreen">
            Exit full screen
        </MudButton>
    </div>;

    private string LinkTypeText(DependencyLinkTypeInfo type)
    {
        var phrases = LinkTypePhrases(type);
        var shared = LinkTypes.Count(t => string.Equals(LinkTypePhrases(t), phrases, StringComparison.OrdinalIgnoreCase)) > 1;

        if (!shared)
        {
            return phrases;
        }

        var name = type.TypeName == DependencyClassifier.UnnamedLinkType ? "no type name" : type.TypeName;
        return $"{phrases} ({name})";
    }

    private static string LinkTypePhrases(DependencyLinkTypeInfo type) =>
        string.Equals(type.Outward, type.Inward, StringComparison.OrdinalIgnoreCase)
            ? type.Outward
            : $"{type.Outward} / {type.Inward}";

    private static string LinkTypeTitle(DependencyLinkTypeInfo type, bool shown) =>
        $"Jira link type \"{type.TypeName}\" · {LinkOrderRule.Describe(type.Order, type.Outward)} · {Plural(type.LinkCount, "link", "links")} here. Click to {(shown ? "hide" : "show")} these links.";

    private static bool IsTeamLane(DependencyLane lane) =>
        lane.Kind is DependencyLaneKind.ArtTeam or DependencyLaneKind.OtherTeam;

    private static string KeyOrTitle(DependencyFeature feature) =>
        string.IsNullOrEmpty(feature.JiraId) ? feature.Title : feature.JiraId;

    private static int CountOf(RiskSummary summary, DependencyRisk risk) => risk switch
    {
        DependencyRisk.OutOfOrder => summary.OutOfOrder,
        DependencyRisk.AtRisk => summary.AtRisk,
        DependencyRisk.InOrder => summary.InOrder,
        _ => summary.NotChecked
    };

    private static string Plural(int count, string one, string many) => count == 1 ? $"1 {one}" : $"{count} {many}";

    private static string OnOff(bool value) => value ? "on" : "off";

    private static string SafeFileName(string value)
    {
        var chars = value.Trim().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray();
        var name = new string(chars).Trim('-');
        return name.Length == 0 ? "export" : name;
    }
}
