@attribute [Route(RoutingPath.JiraSync)]
@inherits LocalTimeComponentBase

@inject IJiraSyncService SyncService
@inject IJiraMetadataService Metadata
@inject IWindowsAuthService WindowsAuth
@inject IAppAuthorizationService AppAuthService
@inject ISnackbar Snackbar
@inject IModalDialogService MessageService
@inject IDialogService DialogService

@using System.Net
@using Estimation.Core.Administration.Services
@using Estimation.Core.JiraIntegration.Client
@using Estimation.Core.JiraIntegration.Models
@using Estimation.Core.JiraIntegration.Services
@using Estimation.Core.Train.Services

<PageTitle>Jira Sync</PageTitle>

<AdminOnly>
<div class="container-fluid mt-3 mb-5">

    <MudPaper Class="p-3 rounded-lg mb-3" Elevation="2">
        <MudText Typo="Typo.h5" Class="mb-4">Jira Background Sync</MudText>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }
        else if (_settings is not null)
        {
            @if (!_serviceConnected)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    The Jira service account is not connected. Connect it below; the background sync
                    cannot run without it.
                </MudAlert>
            }

            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(_serviceConnected ? Icons.Material.Filled.CloudDone : Icons.Material.Filled.CloudOff)"
                                 Color="@(_serviceConnected ? Color.Success : Color.Warning)" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">
                                Service account: <strong>@_settings.ServiceAccountUserName</strong>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @(_serviceConnected ? "Connected" : "Not connected")
                            </MudText>
                        </MudStack>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Link"
                                   OnClick="ConnectServiceAccountAsync">
                            @(_serviceConnected ? "Reconnect" : "Connect")
                        </MudButton>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_settings.CycleCooldownMinutes"
                                     Label="Cooldown after each cycle (minutes)"
                                     Variant="Variant.Outlined"
                                     Min="1" Max="1440"
                                     Disabled="_settings.Enabled"
                                     HelperText="@(_settings.Enabled ? "Stop the sync to edit." : "Minimum 1; saved when you press Start.")" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <SearchableDropdown T="string"
                                        Label="Jira server timezone"
                                        Items="@_timeZoneIds"
                                        Value="@(_settings.JiraTimeZoneId ?? _serverTimeZoneId)"
                                        ValueChanged="OnJiraTimeZoneChanged"
                                        ToStringFunc="TimeZoneDisplay"
                                        Clearable="false"
                                        HelperText="Timezone Jira interprets query dates in. Defaults to the app server timezone; saved immediately." />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Class="mt-4" Spacing="2" AlignItems="AlignItems.Center">
                @if (_settings.Enabled)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="StopSyncAsync"
                               Disabled="_busy">
                        Stop
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="StartSyncAsync"
                               Disabled="_busy || !_serviceConnected">
                        Start
                    </MudButton>
                }
                <MudTooltip Text="@(_settings.Enabled ? "Stop the scheduled sync to run manually." : "Run one sync cycle now")">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Sync"
                               OnClick="RunSyncNowAsync"
                               Disabled="_running || !_serviceConnected || _settings.Enabled">
                        @if (_running)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Running…</span>
                        }
                        else
                        {
                            <span>Run sync now</span>
                        }
                    </MudButton>
                </MudTooltip>
                <MudSpacer />
                <MudStack Spacing="0" Class="align-end">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Status: <strong>@(_settings.Enabled ? "Running" : "Stopped")</strong>
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Last run: @UserTime.Format(_settings.LastRunAt, "yyyy-MM-dd HH:mm")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Next cycle: @(_settings.Enabled ? UserTime.Format(_settings.NextRunAt, "yyyy-MM-dd HH:mm", "pending") : "—")
                    </MudText>
                </MudStack>
            </MudStack>
        }
    </MudPaper>

    <MudPaper Class="p-3 rounded-lg mb-3" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
            <MudText Typo="Typo.h6">Jira keys</MudText>
            <MudSpacer />
            <MudTextField T="string" @bind-Value="_search" Immediate="true" Clearable="true"
                          Placeholder="Search keys or ARTs" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:280px" />
            <MudTooltip Text="@(_serviceConnected ? "Add a Jira project that no ART uses" : "Connect the service account first; a new key is checked in Jira with it.")">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddKeyDialogAsync"
                           Disabled="_loading || !_serviceConnected">
                    Add key
                </MudButton>
            </MudTooltip>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
            One row per Jira project key: every key an ART uses, plus keys added here. A key is synced only when
            "Create not existed" and/or "Update existed" is on, and each sync fetches it once. Jira data overwrites
            the synced fields in the database. The components and labels set on each ART then decide which ART a
            Feature belongs to; Features that no ART accepts are still synced, and only admins and General users see them.
            Strategic Objectives, Portfolio Epics and Business Outcomes follow the ARTs of their Features.
            "Fetch only issues with labels" narrows what is fetched for every ART on the key.
        </MudText>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }
        else if (_rows.Count == 0)
        {
            <MudText Class="pa-2 mud-text-secondary">No Jira keys yet. Add a key to an ART, or add one here.</MudText>
        }
        else if (!FilteredRows.Any())
        {
            <MudText Class="pa-2 mud-text-secondary">No key matches "@_search".</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var row in FilteredRows)
                {
                    <MudExpansionPanel @key="row.JiraKey" ExpandedChanged="@((bool expanded) => OnPanelExpandedAsync(row, expanded))">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                                <MudText><strong>@row.JiraKey</strong></MudText>
                                @if (_projects.TryGetValue(row.JiraKey, out var project))
                                {
                                    @if (project is null)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning">not found in Jira</MudText>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(project.Name))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@project.Name</MudText>
                                    }
                                }
                                @if (!row.IsConfigured)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">not configured</MudChip>
                                }
                                else if (row.CreateNotExisted || row.UpdateExisted)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">active</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">off</MudChip>
                                }
                                @if (row.Overview.IsUsedByArt)
                                {
                                    @foreach (var art in row.Overview.Arts)
                                    {
                                        <MudTooltip Text="@(art.IsFiltered ? art.FilterDescription : "Takes every issue of the key that no filtered ART takes")">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                                     Href="@($"{RoutingPath.CapitalProjects}/{art.ArtId}")" Target="_blank">
                                                @(art.IsFiltered ? $"{art.ArtName} (filtered)" : art.ArtName)
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">No ART</MudChip>
                                }
                                @if (row.Overview.Conflicts.Count > 0)
                                {
                                    <MudTooltip Text="@ConflictText(row)">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                    </MudTooltip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @if (!row.IsConfigured)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                    @NotConfiguredText(row)
                                </MudAlert>
                            }
                            @if (!row.Overview.IsUsedByArt)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                    No ART uses this key. Features on it get no ART, so only admins and General users see them;
                                    Strategic Objectives, Portfolio Epics and Business Outcomes follow the ARTs of their Features.
                                </MudAlert>
                            }
                            else if (row.Overview.Arts.All(a => a.IsFiltered))
                            {
                                <MudText Typo="Typo.caption" Class="d-block mb-3 mud-text-secondary">
                                    Every ART on this key filters it by components or labels. Features that none of them accept
                                    get no ART, so only admins and General users see them.
                                </MudText>
                            }

                            <MudGrid>
                                <MudItem xs="6" md="3">
                                    <MudSwitch @bind-Value="row.CreateNotExisted" Color="Color.Primary" T="bool" Label="Create not existed" />
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudSwitch @bind-Value="row.UpdateExisted" Color="Color.Primary" T="bool" Label="Update existed" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudSelect T="string" Label="Issue types" MultiSelection="true"
                                               @bind-SelectedValues="row.IssueTypes" Variant="Variant.Outlined"
                                               MultiSelectionTextFunc="@(v => string.Join(", ", v))">
                                        @foreach (var t in IssueTypeOptions)
                                        {
                                            <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudSelect T="JiraSyncDateFilterMode" @bind-Value="row.DateFilterMode"
                                               Label="Date filter / watermark" Variant="Variant.Outlined">
                                        <MudSelectItem Value="JiraSyncDateFilterMode.Updated">Last updated date</MudSelectItem>
                                        <MudSelectItem Value="JiraSyncDateFilterMode.Created">Created date</MudSelectItem>
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <SearchableDropdown T="string" MultiSelect="true" Label="Fetch only issues with labels"
                                                        Items="@row.AvailableLabels"
                                                        @bind-Values="row.Labels"
                                                        SelectAll="true"
                                                        Disabled="row.Loading"
                                                        SearchPlaceholder="Search labels…"
                                                        Placeholder="@(row.Loading ? "Loading…" : "Any label")"
                                                        NoItemsText="@(row.Loading ? "Loading…" : "No labels in this project")" />
                                    @if (LabelCoverageWarning(row) is { } labelWarning)
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@labelWarning</MudAlert>
                                    }
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <SearchableDropdown T="string" MultiSelect="true" Label="Statuses"
                                                        Items="@row.AvailableStatuses"
                                                        @bind-Values="row.Statuses"
                                                        SelectAll="true"
                                                        Disabled="row.Loading"
                                                        SearchPlaceholder="Search statuses…"
                                                        Placeholder="@(row.Loading ? "Loading…" : "Select statuses")"
                                                        NoItemsText="@(row.Loading ? "Loading…" : "No statuses in this project")" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <SearchableDropdown T="string" MultiSelect="true" Label="Don't create with status"
                                                        Items="@row.AvailableStatuses"
                                                        @bind-Values="row.ExcludeCreateStatuses"
                                                        SelectAll="true"
                                                        Disabled="row.Loading"
                                                        SearchPlaceholder="Search statuses…"
                                                        Placeholder="@(row.Loading ? "Loading…" : "Select statuses")"
                                                        HelperText="New issues with these statuses are skipped; existing ones are still updated."
                                                        NoItemsText="@(row.Loading ? "Loading…" : "No statuses in this project")" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudDatePicker @bind-Date="row.SinceFloorUtc"
                                                   Label="Only issues since (optional floor)"
                                                   Variant="Variant.Outlined" Clearable="true" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudTextField T="string" Label="Last synced (watermark)" ReadOnly="true"
                                                      Variant="Variant.Outlined"
                                                      Value="@UserTime.Format(row.Watermark, "yyyy-MM-dd HH:mm", "never")"
                                                      HelperText="@($"Shown in your timezone ({UserTime.TimeZone.Id}).")" />
                                        <MudTooltip Text="Clear the watermark so the next sync re-fetches from the floor (or everything if no floor).">
                                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Restore"
                                                       OnClick="@(() => ResetWatermarkAsync(row))"
                                                       Disabled="row.Watermark is null || row.ResettingWatermark">
                                                Reset
                                            </MudButton>
                                        </MudTooltip>
                                    </MudStack>
                                </MudItem>
                            </MudGrid>

                            <MudStack Row="true" Class="mt-2" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           OnClick="@(() => SaveKeyAsync(row))"
                                           Disabled="row.Saving">
                                    Save key
                                </MudButton>
                                @if (!row.Overview.IsUsedByArt && row.IsConfigured)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="@(() => RemoveKeyAsync(row))"
                                               Disabled="row.Saving || row.Removing">
                                        Remove key
                                    </MudButton>
                                }
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudPaper>

    <MudPaper Class="p-3 rounded-lg" Elevation="2">
        <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">History</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="ReloadHistoryAsync" />
        </MudStack>

        <MudDataGrid T="JiraSyncHistory" Items="_history" Dense Hover Striped Bordered="true" RowsPerPage="25">
            <Columns>
                <PropertyColumn Property="x => x.StartedAt" Title="Started" InitialDirection="SortDirection.Descending">
                    <CellTemplate>
                        @FormatUserTime(context.Item.StartedAt)
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Status" Title="Status">
                    <CellTemplate>
                        @switch (context.Item.Status)
                        {
                            case "Success":
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Success</MudChip>
                                break;
                            case "Failed":
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Failed</MudChip>
                                break;
                            case "Running":
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Running</MudChip>
                                break;
                            default:
                                <MudText>@context.Item.Status</MudText>
                                break;
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.FinishedAt" Title="Ended">
                    <CellTemplate>
                        @FormatUserTime(context.Item.FinishedAt)
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TriggeredBy" Title="Triggered by" />
                <PropertyColumn Property="x => x.Created" Title="Created" />
                <PropertyColumn Property="x => x.Updated" Title="Updated" />
                <PropertyColumn Property="x => x.IssuesFetched" Title="Fetched" />
                <PropertyColumn Property="x => x.Failed" Title="Failed" />
                <PropertyColumn Property="x => x.Message" Title="Message" Sortable="false">
                    <CellTemplate>
                        <div class="d-flex align-center" style="gap:4px;">
                            <MudText Style="max-width:340px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                @(context.Item.Message ?? "—")
                            </MudText>
                            @if (!string.IsNullOrEmpty(context.Item.Message))
                            {
                                <MudTooltip Text="View full message">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small"
                                                   OnClick="@(() => ShowMessageAsync(context.Item.Message))" />
                                </MudTooltip>
                            }
                        </div>
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No sync runs yet.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="JiraSyncHistory" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>
</AdminOnly>

@code {
    [CascadingParameter(Name = "IsAdmin")]
    private bool IsAdmin { get; set; }

    private static readonly string[] IssueTypeOptions =
        { "Feature", "Business Outcome", "Portfolio Epic", "Strategic Objective" };

    private JiraSyncSettings? _settings;
    private bool _serviceConnected;
    private List<KeyRow> _rows = new();
    private List<JiraSyncHistory> _history = new();
    private readonly Dictionary<string, JiraProject?> _projects = new(StringComparer.OrdinalIgnoreCase);
    private string? _search;
    private bool _loading = true;
    private bool _busy;
    private bool _running;

    private List<string> _timeZoneIds = new();
    private Dictionary<string, string> _timeZoneDisplay = new();
    private readonly string _serverTimeZoneId = TimeZoneInfo.Local.Id;

    private IEnumerable<KeyRow> FilteredRows => string.IsNullOrWhiteSpace(_search)
        ? _rows
        : _rows.Where(r => Matches(r, _search.Trim()));

    protected override async Task OnInitializedAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        var zones = TimeZoneInfo.GetSystemTimeZones();
        _timeZoneIds = zones.Select(z => z.Id).ToList();
        _timeZoneDisplay = zones.ToDictionary(z => z.Id, z => z.DisplayName);

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _settings = await SyncService.GetSettingsAsync();
            _serviceConnected = await SyncService.IsServiceAccountConnectedAsync();
            await ReloadKeysAsync();
            _history = await SyncService.GetHistoryAsync();
        }
        finally
        {
            _loading = false;
        }

        _ = LoadProjectsAsync();
    }

    private async Task ReloadKeysAsync()
    {
        var previous = _rows.ToDictionary(r => r.JiraKey, StringComparer.OrdinalIgnoreCase);
        _rows = (await SyncService.GetKeysAsync())
            .Select(overview =>
            {
                if (!previous.TryGetValue(overview.JiraKey, out var row))
                {
                    return ToRow(overview);
                }

                row.Overview = overview;
                row.IsConfigured = overview.IsConfigured;
                row.Watermark = overview.Settings?.LastSyncedWatermarkUtc;
                return row;
            })
            .ToList();
    }

    private static KeyRow ToRow(JiraSyncKeyOverview overview)
    {
        var s = overview.Settings;
        var labels = SplitCsv(s?.LabelsCsv);
        var statuses = SplitCsv(s?.StatusesCsv);
        var excludeCreateStatuses = SplitCsv(s?.ExcludeCreateStatusesCsv);
        return new KeyRow
        {
            Overview = overview,
            IsConfigured = overview.IsConfigured,
            CreateNotExisted = s?.CreateNotExisted ?? false,
            UpdateExisted = s?.UpdateExisted ?? false,
            IssueTypes = SplitCsv(s?.IssueTypesCsv),
            Labels = labels,
            Statuses = statuses,
            ExcludeCreateStatuses = excludeCreateStatuses,
            DateFilterMode = s?.DateFilterMode ?? JiraSyncDateFilterMode.Updated,
            SinceFloorUtc = s?.SinceFloorUtc,
            Watermark = s?.LastSyncedWatermarkUtc,
            AvailableLabels = new List<string>(labels),
            AvailableStatuses = statuses.Union(excludeCreateStatuses, StringComparer.OrdinalIgnoreCase).ToList(),
        };
    }

    private async Task LoadProjectsAsync()
    {
        if (_settings is null || !_serviceConnected)
        {
            return;
        }

        var serviceUser = _settings.ServiceAccountUserName;
        var keys = _rows.Select(r => r.JiraKey).Where(k => !_projects.ContainsKey(k)).ToList();
        if (keys.Count == 0)
        {
            return;
        }

        using var gate = new SemaphoreSlim(4);
        await Task.WhenAll(keys.Select(async key =>
        {
            await gate.WaitAsync();
            try
            {
                _projects[key] = await Metadata.GetProjectAsync(serviceUser, key);
            }
            catch (Exception)
            {
            }
            finally
            {
                gate.Release();
            }
        }));

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private bool Matches(KeyRow row, string search) =>
        row.JiraKey.Contains(search, StringComparison.OrdinalIgnoreCase)
        || row.Overview.Arts.Any(a => a.ArtName.Contains(search, StringComparison.OrdinalIgnoreCase))
        || (_projects.TryGetValue(row.JiraKey, out var project)
            && project?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) == true);

    private static string NotConfiguredText(KeyRow row) =>
        $"{string.Join(", ", row.Overview.Arts.Select(a => a.ArtName))} {(row.Overview.Arts.Count == 1 ? "uses" : "use")} this key, "
        + "but it has no sync settings yet. Choose what to sync and press Save key to start syncing it.";

    private static string ConflictText(KeyRow row) =>
        string.Join(" ", row.Overview.Conflicts.Select(c =>
        {
            var names = string.Join(", ", row.Overview.Arts.Where(a => c.ArtIds.Contains(a.ArtId)).Select(a => a.ArtName).Distinct());
            return c.Unfiltered
                ? $"{names} all take {row.JiraKey} without components or labels, so its issues match several ARTs and get no ART."
                : $"{names} use {row.JiraKey} with the same components and labels, so the issues they accept match several ARTs and get no ART.";
        })) + " Change the components or labels on the ART page.";

    private static string? LabelCoverageWarning(KeyRow row)
    {
        if (row.Labels.Count == 0 || !row.Overview.IsUsedByArt)
        {
            return null;
        }

        var fetched = row.Labels.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var missing = row.Overview.Arts
            .Where(a =>
            {
                var labels = JiraListValues.Parse(a.Labels);
                return labels.Count == 0 || !labels.IsSubsetOf(fetched);
            })
            .Select(a => a.ArtName)
            .Distinct()
            .ToList();

        return missing.Count == 0
            ? null
            : $"Only issues with the labels above are fetched. {string.Join(", ", missing)} also accept{(missing.Count == 1 ? "s" : string.Empty)} issues without them, so those issues are not synced.";
    }

    private async Task ReloadHistoryAsync()
    {
        _history = await SyncService.GetHistoryAsync();
    }

    private async Task OnJiraTimeZoneChanged(string? timeZoneId)
    {
        if (_settings is null || string.IsNullOrWhiteSpace(timeZoneId))
        {
            return;
        }

        _settings.JiraTimeZoneId = timeZoneId;
        try
        {
            await SyncService.UpdateJiraTimeZoneAsync(timeZoneId);
            Snackbar.Add("Jira timezone updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private string TimeZoneDisplay(string? id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return string.Empty;
        }
        return _timeZoneDisplay.TryGetValue(id, out var display) ? display : id;
    }

    private string FormatUserTime(DateTime? utc) => UserTime.Format(utc, "yyyy-MM-dd HH:mm:ss");

    private async Task ShowMessageAsync(string? message)
    {
        var parameters = new DialogParameters<JiraSyncMessageDialog>
        {
            { x => x.Message, message }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<JiraSyncMessageDialog>("Sync run details", parameters, options);
    }

    private async Task StartSyncAsync()
    {
        if (_settings is null)
        {
            return;
        }

        _busy = true;
        try
        {
            _settings = await SyncService.StartAsync(_settings.CycleCooldownMinutes);
            Snackbar.Add("Sync started.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StopSyncAsync()
    {
        if (_settings is null)
        {
            return;
        }

        _busy = true;
        try
        {
            _settings = await SyncService.StopAsync();
            Snackbar.Add("Sync stopped.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunSyncNowAsync()
    {
        if (!await MessageService.Confirm("Run a Jira sync now?"))
        {
            return;
        }

        _running = true;
        try
        {
            var userName = await WindowsAuth.GetUserName() ?? "Manual";
            var result = await SyncService.RunSyncAsync(userName);

            if (result.Status == "Success")
            {
                Snackbar.Add($"Sync complete: {result.Created} created, {result.Updated} updated.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Sync failed: {result.Message}", Severity.Error);
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task ConnectServiceAccountAsync()
    {
        if (_settings is null)
        {
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<JiraLoginDialog>
        {
            { x => x.ConnectAsUserName, _settings.ServiceAccountUserName }
        };
        var dialogRef = await DialogService.ShowAsync<JiraLoginDialog>(
            "Connect Jira service account", parameters, options);
        await dialogRef.Result;

        _serviceConnected = await SyncService.IsServiceAccountConnectedAsync();
        foreach (var missing in _projects.Where(p => p.Value is null).Select(p => p.Key).ToList())
        {
            _projects.Remove(missing);
        }
        StateHasChanged();
        _ = LoadProjectsAsync();
    }

    private async Task OnPanelExpandedAsync(KeyRow row, bool expanded)
    {
        if (!expanded || row.OptionsLoaded || row.Loading || !_serviceConnected)
        {
            return;
        }
        await LoadOptionsAsync(row);
    }

    private async Task ResetWatermarkAsync(KeyRow row)
    {
        if (row.Watermark is null)
        {
            return;
        }

        row.ResettingWatermark = true;
        try
        {
            await SyncService.ResetWatermarkAsync(row.JiraKey);
            row.Watermark = null;
            Snackbar.Add($"Watermark reset for {row.JiraKey}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            row.ResettingWatermark = false;
        }
    }

    private async Task LoadOptionsAsync(KeyRow row)
    {
        if (_settings is null)
        {
            return;
        }

        row.Loading = true;
        StateHasChanged();
        try
        {
            var serviceUser = _settings.ServiceAccountUserName;
            var labelNames = (await Metadata.GetLabelsAsync(serviceUser, row.JiraKey)).Select(l => l.Name);
            var statusNames = (await Metadata.GetStatusesAsync(serviceUser, row.JiraKey)).Select(s => s.Name);

            row.AvailableLabels = labelNames
                .Union(row.Labels, StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x).ToList();
            row.AvailableStatuses = statusNames
                .Union(row.Statuses, StringComparer.OrdinalIgnoreCase)
                .Union(row.ExcludeCreateStatuses, StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x).ToList();
            row.OptionsLoaded = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load Jira options: {ex.Message}", Severity.Error);
        }
        finally
        {
            row.Loading = false;
        }
    }

    private async Task SaveKeyAsync(KeyRow row)
    {
        row.Saving = true;
        try
        {
            var settings = new JiraSyncKey
            {
                JiraKey = row.JiraKey,
                CreateNotExisted = row.CreateNotExisted,
                UpdateExisted = row.UpdateExisted,
                IssueTypesCsv = JoinCsv(row.IssueTypes),
                LabelsCsv = JoinCsv(row.Labels),
                StatusesCsv = JoinCsv(row.Statuses),
                ExcludeCreateStatusesCsv = JoinCsv(row.ExcludeCreateStatuses),
                DateFilterMode = row.DateFilterMode,
                SinceFloorUtc = row.SinceFloorUtc,
            };

            var result = await SyncService.SaveKeyAsync(settings);
            row.IsConfigured = true;
            row.Watermark = result.Settings.LastSyncedWatermarkUtc;
            Snackbar.Add(result.WatermarkReset
                    ? $"Saved sync settings for {row.JiraKey}. They change what is fetched, so its next sync starts over."
                    : $"Saved sync settings for {row.JiraKey}.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            row.Saving = false;
        }
    }

    private async Task OpenAddKeyDialogAsync()
    {
        var parameters = new DialogParameters<JiraSyncAddKeyDialog>
        {
            { x => x.Save, AddKeyAsync }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialogRef = await DialogService.ShowAsync<JiraSyncAddKeyDialog>("Add Jira key", parameters, options);
        var result = await dialogRef.Result;
        if (result is null || result.Canceled || result.Data is not string key)
        {
            return;
        }

        await ReloadAsync();
        var name = _projects.TryGetValue(key, out var project) && !string.IsNullOrWhiteSpace(project?.Name)
            ? $" ({project.Name})"
            : string.Empty;
        Snackbar.Add($"Added {key}{name}. Choose what to sync and press Save.", Severity.Success);
    }

    private async Task<string?> AddKeyAsync(string key)
    {
        if (!await IsAdminNowAsync())
        {
            return "Only administrators can add Jira keys.";
        }
        if (_settings is null || !await SyncService.IsServiceAccountConnectedAsync())
        {
            return "Connect the Jira service account first; a new key is checked in Jira with it.";
        }

        JiraProject? project;
        try
        {
            project = await Metadata.GetProjectAsync(_settings.ServiceAccountUserName, key);
        }
        catch (Exception ex)
        {
            return $"Could not check {key} in Jira: {ex.Message}";
        }

        if (project is null)
        {
            return $"Jira has no project {key}, or the service account '{_settings.ServiceAccountUserName}' cannot see it.";
        }
        if (!string.Equals(project.Key, key, StringComparison.OrdinalIgnoreCase))
        {
            return $"{key} is an old key of Jira project {project.Key}. Add {project.Key} instead.";
        }

        try
        {
            await SyncService.AddKeyAsync(key);
        }
        catch (Exception ex)
        {
            return ex.Message;
        }

        _projects[key] = project;
        return null;
    }

    private async Task RemoveKeyAsync(KeyRow row)
    {
        if (!await IsAdminNowAsync())
        {
            Snackbar.Add("Only administrators can remove Jira keys.", Severity.Error);
            return;
        }

        row.Removing = true;
        try
        {
            var counts = await SyncService.CountSyncedItemsAsync(row.JiraKey);
            var question = $"Remove Jira key {row.JiraKey} from the sync?";
            if (counts.Total > 0)
            {
                question += $" {DescribeCounts(counts)} synced from it stay in the tool but are no longer updated from Jira.";
            }
            if (!await MessageService.Confirm(WebUtility.HtmlEncode(question), okBtnText: "Remove"))
            {
                return;
            }

            await SyncService.RemoveKeyAsync(row.JiraKey);
            Snackbar.Add($"Jira key {row.JiraKey} removed.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            row.Removing = false;
        }
    }

    private async Task<bool> IsAdminNowAsync()
    {
        var userName = await WindowsAuth.GetUserName();
        return userName is not null && await AppAuthService.IsAdminAsync(userName);
    }

    private static string DescribeCounts(JiraSyncKeyItemCounts counts)
    {
        var parts = new List<string>();
        AddCount(parts, counts.Features, "Feature", "Features");
        AddCount(parts, counts.BusinessOutcomes, "Business Outcome", "Business Outcomes");
        AddCount(parts, counts.PortfolioEpics, "Portfolio Epic", "Portfolio Epics");
        AddCount(parts, counts.StrategicObjectives, "Strategic Objective", "Strategic Objectives");
        return string.Join(", ", parts);
    }

    private static void AddCount(List<string> parts, int count, string singular, string plural)
    {
        if (count > 0)
        {
            parts.Add($"{count} {(count == 1 ? singular : plural)}");
        }
    }

    private static List<string> SplitCsv(string? csv)
    {
        if (string.IsNullOrWhiteSpace(csv))
        {
            return new List<string>();
        }
        return csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    }

    private static string? JoinCsv(IEnumerable<string> values)
    {
        var list = values?.Where(v => !string.IsNullOrWhiteSpace(v)).ToList() ?? new List<string>();
        return list.Count == 0 ? null : string.Join(",", list);
    }

    public class KeyRow
    {
        public JiraSyncKeyOverview Overview { get; set; } = null!;
        public string JiraKey => Overview.JiraKey;
        public bool IsConfigured { get; set; }
        public bool CreateNotExisted { get; set; }
        public bool UpdateExisted { get; set; }
        public IReadOnlyCollection<string> IssueTypes { get; set; } = Array.Empty<string>();
        public IReadOnlyCollection<string> Labels { get; set; } = Array.Empty<string>();
        public IReadOnlyCollection<string> Statuses { get; set; } = Array.Empty<string>();
        public IReadOnlyCollection<string> ExcludeCreateStatuses { get; set; } = Array.Empty<string>();
        public JiraSyncDateFilterMode DateFilterMode { get; set; } = JiraSyncDateFilterMode.Updated;
        public DateTime? SinceFloorUtc { get; set; }
        public DateTime? Watermark { get; set; }
        public List<string> AvailableLabels { get; set; } = new();
        public List<string> AvailableStatuses { get; set; } = new();
        public bool OptionsLoaded { get; set; }
        public bool Loading { get; set; }
        public bool Saving { get; set; }
        public bool Removing { get; set; }
        public bool ResettingWatermark { get; set; }
    }
}
