@inject IUserTimeZoneService UserTime

@if (Uploads.Count > 0)
{
    <div style="width:280px">
        <MudSelect T="int" Value="@(SelectedId ?? 0)" ValueChanged="OnSelected"
                   Label="As of"
                   Dense Variant="Variant.Outlined"
                   Disabled="Disabled"
                   AnchorOrigin="Origin.BottomCenter">
            @foreach (var upload in Uploads)
            {
                <MudSelectItem T="int" Value="@upload.Id">@UploadLabels.Label(upload, Uploads, UserTime)</MudSelectItem>
            }
        </MudSelect>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public List<HeadcountUpload> Uploads { get; set; } = [];

    [Parameter]
    public int? SelectedId { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<int> OnSelected { get; set; }
}
