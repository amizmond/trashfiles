<MudDrawer Open="Open" OpenChanged="OpenChanged" Anchor="Anchor.End" Elevation="2"
           Variant="DrawerVariant.Temporary" Width="420px"
           Style="background: var(--mud-palette-surface)">
    <MudDrawerHeader>
        <div class="d-flex align-center justify-space-between" style="width:100%">
            <div class="d-flex align-baseline gap-2">
                <MudText Typo="Typo.h6">Filters</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@MatchCount.ToString("N0") of @TotalCount.ToString("N0")</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => OpenChanged.InvokeAsync(false)" />
        </div>
    </MudDrawerHeader>
    @if (Open)
    {
        <HeadcountFilterPanel Filter="Filter" Facets="Facets" OnChanged="OnChanged" />
    }
</MudDrawer>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired]
    public HeadcountFilter Filter { get; set; } = null!;

    [Parameter]
    public IReadOnlyDictionary<HeadcountColumn, Dictionary<string, int>>? Facets { get; set; }

    [Parameter]
    public int MatchCount { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }
}
