<div class="pa-4" style="min-width:420px">
    <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">@Message</MudText>
    <MudText Typo="Typo.caption" Class="mb-4 mud-text-secondary d-block">
        An approval covers the current state of a feature. It stays valid in every comparison that shows
        this state and stops matching as soon as the feature changes again.
    </MudText>

    <MudTextField T="string" @bind-Value="_comment"
                  Label="Comment"
                  HelperText="Optional."
                  Lines="3" MaxLength="1000"
                  Immediate Clearable
                  Dense Variant="Variant.Outlined" />

    <div class="d-flex justify-end gap-2 mt-6">
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Confirm">Approve</MudButton>
    </div>
</div>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    private string? _comment;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(new ApproveResult(_comment)));

    public record ApproveResult(string? Comment);
}
