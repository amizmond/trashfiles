@namespace Estimation.Components.DepartmentPlanning.Views
@inherits PlanningViewBase

@using System.Globalization
@using System.Text
@using Estimation.Core.DepartmentPlanning.Services
@using Estimation.Core.DepartmentPlanning.Views
@using Estimation.Core.JiraIntegration.Models
@inject IJSRuntime JS

<div class="wl-root">
    <div class="wl-toolbar">
        <div class="wl-control">
            <span class="wl-label">Scale</span>
            <MudToggleGroup T="WaterlineScale" Value="_scale" ValueChanged="SetScale"
                            SelectionMode="SelectionMode.SingleSelection"
                            Color="Color.Primary" Size="Size.Small" CheckMark="false">
                <MudToggleItem Value="WaterlineScale.StoryPoints">Story points</MudToggleItem>
                <MudToggleItem Value="WaterlineScale.PercentOfCapacity">% of capacity</MudToggleItem>
            </MudToggleGroup>
        </div>
        <div class="wl-control">
            <span class="wl-label">Colour</span>
            <MudToggleGroup T="WaterlineColour" Value="_colour" ValueChanged="SetColour"
                            SelectionMode="SelectionMode.SingleSelection"
                            Color="Color.Primary" Size="Size.Small" CheckMark="false">
                <MudToggleItem Value="WaterlineColour.Rank">Rank</MudToggleItem>
                <MudToggleItem Value="WaterlineColour.Objective">Strategic objective</MudToggleItem>
            </MudToggleGroup>
        </div>
        <MudTooltip Text="Split each ART column into one thin column per team, each with its own capacity tick, to see which team runs out first.">
            <MudSwitch T="bool" Value="_teams" ValueChanged="SetTeams" Label="Split by team" Color="Color.Primary" Size="Size.Small" />
        </MudTooltip>
        <MudSpacer />
        <div class="wl-key">
            <span class="wl-key-item"><i class="wl-swatch planned"></i>planned</span>
            <span class="wl-key-item"><i class="wl-swatch over"></i>over capacity</span>
            <span class="wl-key-item"><i class="wl-swatch below"></i>below the ART line</span>
            <span class="wl-key-item"><i class="wl-swatch ghost"></i>not planned (cut by team lines)</span>
        </div>
    </div>

    @if (_colour == WaterlineColour.Objective && _chart.Objectives.Count > 0)
    {
        <div class="wl-legend">
            @foreach (var objective in _chart.Objectives)
            {
                <span class="wl-legend-item" title="@($"{objective.Items} ranked items")">
                    <i class="wl-swatch @ObjectiveClass(objective)"></i>@(objective.JiraId is null ? objective.Title : $"{objective.JiraId} {objective.Title}")
                </span>
            }
        </div>
    }

    @if (_chart.IsEmpty)
    {
        <div class="wl-empty">@EmptyText</div>
    }
    else
    {
        <div class="wl-scroll" tabindex="0" @onkeydown="OnKeyDownAsync">
            <svg class="wl-svg @(_colour == WaterlineColour.Objective ? "colour-objective" : "colour-rank")"
                 width="@F(_chart.Width)" height="@F(_chart.Height)"
                 style="--wl-w:@(F(_chart.Width))px; --wl-h:@(F(_chart.Height))px"
                 viewBox="0 0 @F(_chart.Width) @F(_chart.Height)"
                 role="img" aria-label="@AriaLabel">
                <defs>
                    <pattern id="wl-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <line class="wl-hatch-line" x1="0" y1="0" x2="0" y2="6" />
                    </pattern>
                    <pattern id="wl-overhatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
                        <line class="wl-overhatch-line" x1="0" y1="0" x2="0" y2="6" />
                    </pattern>
                </defs>
                <g class="wl-axis">
                    <text class="wl-axis-title" x="@F(WaterlineLayout.AxisWidth - 6)" y="@F(WaterlineLayout.PlotTop - 10)" text-anchor="end">@Axis.Title</text>
                    @foreach (var tick in Axis.Ticks)
                    {
                        <g class="wl-tick-row">
                            <line class="wl-grid" x1="@F(WaterlineLayout.AxisWidth)" x2="@F(_chart.Width - WaterlineLayout.RightPad)" y1="@F(tick.Y)" y2="@F(tick.Y)" />
                            <text class="wl-tick" x="@F(WaterlineLayout.AxisWidth - 6)" y="@F(tick.Y + 3.5)" text-anchor="end">@tick.Label</text>
                        </g>
                    }
                    <text class="wl-hint" x="@F(WaterlineLayout.AxisWidth - 6)" y="@F(WaterlineLayout.PlotBottom + 14)" text-anchor="end">rank 1 at the bottom</text>
                </g>
                @foreach (var column in _chart.Columns)
                {
                    <g class="wl-col @(column.IsRanked ? "" : "unranked") @(IsSelected(column.Row) ? "selected" : "")" @key="column.Row.Id">
                        @Header(column)
                        @if (_teams && column.Teams.Count > 0)
                        {
                            @foreach (var team in column.Teams)
                            {
                                @TeamBars(column, team)
                            }
                        }
                        else
                        {
                            @Bars(column)
                        }
                        @Annotation(column)
                    </g>
                }
            </svg>
        </div>
        <div class="wl-foot">
            Columns stack each ART's ranked items from the bottom; the bold tick is the ART's capacity, the dashed line is its ART line.
            @Tree.FeaturesShown of @Tree.FeaturesInScope features shown; an item shared by several ARTs appears in each column and is counted once in the totals.
        </div>
    }
</div>

@code {
    private const double MinHeight = 1.5d;
    private const double LabelHeight = 12d;
    private const double TitleHeight = 26d;
    private const double CharWidth = 6.2d;

    private PlanningTree? _tree;
    private DepartmentPlanningData? _data;
    private WaterlineChart _chart = WaterlineChart.Empty;
    private Dictionary<WaterlineSegment, string> _tips = new(ReferenceEqualityComparer.Instance);
    private WaterlineScale _scale = WaterlineScale.StoryPoints;
    private WaterlineColour _colour = WaterlineColour.Rank;
    private bool _teams;
    private string? _hoverKey;
    private bool _scrollToSelected;
    private readonly PlanningHandlerCache<WaterlineSegment, Action> _segmentEnter;

    public WaterlineView()
    {
        _segmentEnter = new(segment => () => Hover(segment), ReferenceEqualityComparer.Instance);
    }

    private WaterlineAxis Axis => _chart.Axis(_scale);

    private string AriaLabel => $"Capacity waterline: {_chart.Columns.Count} ARTs for {PiName}";

    private string EmptyText => Tree.FeaturesInScope == 0
        ? $"No features are planned on the teams in scope for {PiName ?? "this planning increment"}."
        : Tree.Roots.Count == 0
            ? "No rows match the search and filters."
            : "The Waterline needs the capacity drawdown lens: one column per ART.";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_tree, Tree) && ReferenceEquals(_data, Data) && _builtTeams == _teams)
        {
            return;
        }

        _tree = Tree;
        _data = Data;
        _builtTeams = _teams;
        _chart = WaterlineLayout.Build(Tree, Data, _teams);
        _hoverKey = null;
        _segmentEnter.Clear();

        var tips = new Dictionary<WaterlineSegment, string>(ReferenceEqualityComparer.Instance);
        foreach (var column in _chart.Columns)
        {
            foreach (var segment in column.Segments.Concat(column.BelowLine))
            {
                tips[segment] = Tip(column, segment, null);
            }

            foreach (var team in column.Teams)
            {
                foreach (var segment in team.Segments.Concat(team.BelowLine))
                {
                    tips[segment] = Tip(column, segment, team);
                }
            }
        }

        _tips = tips;
    }

    private void SetScale(WaterlineScale scale) => _scale = scale;

    private void SetColour(WaterlineColour colour) => _colour = colour;

    private bool _builtTeams;

    private void SetTeams(bool value)
    {
        _teams = value;
        OnParametersSet();
    }

    private void Hover(WaterlineSegment segment) => _hoverKey = segment.TwinKey;

    private void ClearHover() => _hoverKey = null;

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Fit(string text, double width, double charWidth = CharWidth)
    {
        var max = (int)(width / charWidth);
        if (text.Length <= max)
        {
            return text;
        }

        return max <= 1 ? "…" : text[..(max - 1)] + "…";
    }

    private static string ObjectiveClass(WaterlineObjective objective) => objective.Id is null ? "so-none" : $"so-{objective.Index % 10}";

    private string ObjectiveClass(WaterlineSegment segment) =>
        segment.Objective < _chart.Objectives.Count ? ObjectiveClass(_chart.Objectives[segment.Objective]) : "so-none";

    private string SegmentClass(WaterlineSegment segment) =>
        "wl-item "
        + ObjectiveClass(segment)
        + (segment.IsBelowLine ? " below" : "")
        + (segment.Row.OverCapacity ? " over" : "")
        + (segment.Row.CapacityRunsOutHere ? " runs-out" : "")
        + (segment.IsSaved ? "" : " unsaved")
        + (segment.Row.IsBucket ? " bucket" : "")
        + (IsSelected(segment.Row) ? " selected" : "")
        + (_hoverKey is not null && segment.TwinKey == _hoverKey ? " twin" : "");

    private string? SegmentStyle(WaterlineSegment segment) =>
        _colour == WaterlineColour.Rank && !segment.IsBelowLine ? $"--wl-dark:{F(8d + 30d * segment.Shade)}%" : null;

    private static string Label(WaterlineSegment segment)
    {
        var rank = segment.Rank is { } r ? $"#{r.Rank} " : "";
        return rank + (string.IsNullOrEmpty(segment.Row.JiraId) ? segment.Row.Title : segment.Row.JiraId);
    }

    private static string OverOrFree(decimal over) => over > 0m ? $"+{PlanningFormat.Sp(over)} SP over" : $"{PlanningFormat.Sp(-over)} SP free";

    private static string Tip(WaterlineColumn column, WaterlineSegment segment, WaterlineTeamColumn? team)
    {
        var row = segment.Row;
        var sb = new StringBuilder();
        if (segment.Rank is { } rank)
        {
            sb.Append('#').Append(rank.Rank).Append(' ');
        }

        if (!string.IsNullOrEmpty(row.JiraId))
        {
            sb.Append(row.JiraId).Append(' ');
        }

        sb.Append(row.Title).Append('\n').Append(PlanningFormat.LevelName(row.Level)).Append(" on ").Append(column.Name);

        if (team is not null)
        {
            var cell = row.TeamCells.GetValueOrDefault(team.Team.Id);
            sb.Append('\n').Append(team.Team.Name).Append(": ");
            if (segment.IsBelowLine)
            {
                sb.Append(PlanningFormat.Sp(segment.Sp)).Append(" SP demand below the ART line, no capacity reserved");
            }
            else
            {
                sb.Append(PlanningFormat.Sp(segment.Sp)).Append(" SP planned, cumulative ").Append(PlanningFormat.Sp(segment.To))
                    .Append(" of ").Append(PlanningFormat.Sp(team.CapacitySp)).Append(" SP capacity (").Append(OverOrFree(segment.To - team.CapacitySp)).Append(')');
            }

            if (cell is not null && cell.DemandSp > cell.PlannedSp)
            {
                sb.Append('\n').Append(PlanningFormat.Sp(cell.DemandSp - cell.PlannedSp)).Append(" SP of this team's demand not planned");
            }
        }
        else if (segment.IsBelowLine)
        {
            sb.Append('\n').Append("Below the ART line: ").Append(PlanningFormat.Sp(row.Metrics.DemandSp)).Append(" SP demand, no capacity reserved in this PI");
        }
        else
        {
            sb.Append('\n').Append("Planned ").Append(PlanningFormat.Sp(segment.Sp)).Append(" SP, cumulative ").Append(PlanningFormat.Sp(segment.To))
                .Append(" of ").Append(PlanningFormat.Sp(column.CapacitySp)).Append(" SP capacity (").Append(OverOrFree(segment.To - column.CapacitySp)).Append(')');
            if (row.CapacityRunsOutHere)
            {
                sb.Append('\n').Append("Capacity runs out here");
            }

            if (row.Metrics.UnplannedSp > 0m)
            {
                sb.Append('\n').Append("Not planned ").Append(PlanningFormat.Sp(row.Metrics.UnplannedSp)).Append(" SP (cut by team lines)");
            }
        }

        sb.Append('\n').Append(row.Metrics.Features).Append(" features, ").Append(row.Metrics.Done).Append(" done");
        sb.Append('\n').Append("RAG ").Append(segment.Rag ?? "not set");
        if (row.Metrics.DependenciesAtRisk > 0)
        {
            sb.Append('\n').Append(row.Metrics.DependenciesAtRisk).Append(" dependencies at risk");
        }

        if (!segment.IsSaved)
        {
            sb.Append('\n').Append("Order not saved in the ART ranking yet");
        }

        return sb.ToString();
    }

    private static string HeaderTip(WaterlineColumn column)
    {
        var sb = new StringBuilder();
        sb.Append(column.Name).Append(" (").Append(column.Subtitle).Append(')');
        sb.Append('\n').Append(PlanningFormat.Sp(column.PlannedSp)).Append(" SP planned of ").Append(PlanningFormat.Sp(column.CapacitySp)).Append(" SP capacity");
        if (column.HasCapacity)
        {
            sb.Append(" (").Append(OverOrFree(column.OverSp)).Append(')');
        }

        sb.Append('\n').Append(column.Segments.Count).Append(" items above the ART line, ").Append(column.BelowLine.Count).Append(" below it");
        if (column.ZeroPlannedItems > 0)
        {
            sb.Append('\n').Append(column.ZeroPlannedItems).Append(" items with 0 SP planned are drawn as hairlines");
        }

        sb.Append('\n').Append(column.Row.Metrics.Features).Append(" features, ").Append(PlanningFormat.Sp(column.Row.Metrics.UnplannedSp)).Append(" SP not planned");
        return sb.ToString();
    }

    private static string EmptyNote(WaterlineColumn column) =>
        column.PlannedSp > 0m ? "items hidden by the filters"
        : column.HasCapacity ? "nothing planned"
        : "nothing planned, no capacity";

    private static string HeaderLine(WaterlineColumn column)
    {
        var text = $"{PlanningFormat.Sp(column.PlannedSp)} of {PlanningFormat.Sp(column.CapacitySp)} SP · {column.Items} items";
        return column.BelowLine.Count > 0 ? $"{text} · {column.BelowLine.Count} below line" : text;
    }

    private static string TeamTip(WaterlineTeamColumn team)
    {
        var text = $"{team.Team.Name}: {PlanningFormat.Sp(team.PlannedSp)} SP planned of {PlanningFormat.Sp(team.CapacitySp)} SP capacity";
        return team.HasCapacity ? $"{text} ({OverOrFree(team.OverSp)})\n{team.Team.MemberCount} members" : $"{text}\nNo capacity in this PI";
    }

    private RenderFragment Header(WaterlineColumn column) => __builder =>
    {
        var nameWidth = column.Width - 2 * WaterlineLayout.ColumnPad;
        <g class="wl-head" @onclick="DetailsHandler(column.Row.Id)">
            <title>@HeaderTip(column)</title>
            <rect class="wl-head-bg" x="@F(column.X + 4)" y="6" width="@F(column.Width - 8)" height="@F(WaterlineLayout.PlotTop - 18)" rx="6" />
            <text class="wl-name" x="@F(column.BarX)" y="28">@Fit(column.Name, nameWidth, 7.4)</text>
            <rect class="wl-tag lvl-@((int)column.ItemLevel)" x="@F(column.BarX)" y="38" width="24" height="14" rx="3" />
            <text class="wl-tag-text" x="@F(column.BarX + 12)" y="48.5" text-anchor="middle">@PlanningFormat.LevelTag(column.ItemLevel)</text>
            <text class="wl-sub @(column.IsRanked ? "" : "warn")" x="@F(column.BarX + 30)" y="49">@Fit(column.Subtitle, nameWidth - 30, 5.6)</text>
            <text class="wl-sub" x="@F(column.BarX)" y="68">@Fit(HeaderLine(column), nameWidth, 5.6)</text>
        </g>
    };

    private RenderFragment Bars(WaterlineColumn column) => __builder =>
    {
        <g class="wl-bars">
            @if (column.Items == 0)
            {
                <g class="wl-notes">
                    <text class="wl-note" x="@F(column.BarX)" y="@F(WaterlineLayout.PlotBottom - 8)">@EmptyNote(column)</text>
                </g>
            }
            @foreach (var segment in column.Segments)
            {
                @if (segment.Ghost is { } ghost)
                {
                    var band = ghost.For(_scale);
                    <rect class="wl-ghost" x="@F(column.GhostX)" y="@F(band.Top)" width="@F(WaterlineLayout.GhostWidth)" height="@F(Math.Max(MinHeight, band.Height))">
                        <title>@($"{Label(segment)}: {PlanningFormat.Sp(segment.Row.Metrics.UnplannedSp)} SP of its demand is not planned (cut by team lines)")</title>
                    </rect>
                }
            }
            @foreach (var segment in column.Segments)
            {
                @Segment(segment, column.BarX, column.BarWidth)
            }
            @if (column.HasLine)
            {
                var y = column.LineY.For(_scale);
                <g class="wl-line">
                    <line class="wl-artline" x1="@F(column.BarX - 4)" x2="@F(column.GhostX + WaterlineLayout.GhostWidth)" y1="@F(y)" y2="@F(y)" />
                    <text class="wl-artline-text" x="@F(column.GhostX + WaterlineLayout.GhostWidth)" y="@F(y - 3)" text-anchor="end">ART LINE</text>
                </g>
            }
            @foreach (var segment in column.BelowLine)
            {
                @Segment(segment, column.BarX, column.BarWidth)
            }
            @CapacityTick(column.BarX - 4, column.GhostX + WaterlineLayout.GhostWidth + 4, column.CapacityY)
        </g>
    };

    private RenderFragment TeamBars(WaterlineColumn column, WaterlineTeamColumn team) => __builder =>
    {
        var y = team.LineY.For(_scale);
        <g class="wl-team @(team.OverSp > 0m ? "over" : "")">
            <rect class="wl-team-bg" x="@F(team.X)" y="@F(WaterlineLayout.PlotTop)" width="@F(team.Width)" height="@F(WaterlineLayout.PlotBottom - WaterlineLayout.PlotTop)">
                <title>@TeamTip(team)</title>
            </rect>
            @foreach (var segment in team.Segments)
            {
                @Segment(segment, team.X, team.Width)
            }
            @if (column.HasLine)
            {
                <line class="wl-artline" x1="@F(team.X - 1)" x2="@F(team.X + team.Width + 1)" y1="@F(y)" y2="@F(y)" />
            }
            @foreach (var segment in team.BelowLine)
            {
                @Segment(segment, team.X, team.Width)
            }
            @CapacityTick(team.X - 2, team.X + team.Width + 2, team.CapacityY)
            <text class="wl-team-name @(team.HasCapacity ? "" : "warn")"
                  x="@F(team.X + team.Width / 2)" y="@F(WaterlineLayout.PlotBottom + 12)"
                  text-anchor="end"
                  transform="rotate(-35 @F(team.X + team.Width / 2) @F(WaterlineLayout.PlotBottom + 12))">
                @Fit(team.Team.Name, 58, 5.4)
                <title>@TeamTip(team)</title>
            </text>
        </g>
    };

    private RenderFragment Segment(WaterlineSegment segment, double x, double width) => __builder =>
    {
        var band = segment.Block.For(_scale);
        var height = Math.Max(MinHeight, band.Height);
        var top = band.Bottom - height;
        var tip = _tips.GetValueOrDefault(segment) ?? Label(segment);
        <g class="@SegmentClass(segment)"
           @onclick="DetailsHandler(segment.Row.Id)"
           @onpointerenter="_segmentEnter.For(segment)"
           @onpointerleave="ClearHover">
            <title>@tip</title>
            <rect class="wl-seg" x="@F(x)" y="@F(top)" width="@F(width)" height="@F(height)" style="@SegmentStyle(segment)" />
            @if (segment.Over is { } over)
            {
                var red = over.For(_scale);
                <rect class="wl-over" x="@F(x)" y="@F(red.Top)" width="@F(width)" height="@F(Math.Max(MinHeight, red.Height))" />
            }
            @if (height >= LabelHeight && width >= 40)
            {
                var textX = x + 6;
                @if (width >= 60)
                {
                    <circle class="wl-dot @PlanningFormat.RagClass(segment.Rag)" cx="@F(x + 8)" cy="@F(top + height / 2)" r="3.5" />
                    textX = x + 16;
                }
                var labelWidth = width - (textX - x) - 6 - (segment.Row.Metrics.DependenciesAtRisk > 0 ? 12 : 0);
                var twoLines = height >= TitleHeight;
                <g class="wl-labels">
                    <text class="wl-seg-text" x="@F(textX)" y="@F(top + height / 2 + (twoLines ? -2 : 4))">@Fit(Label(segment), labelWidth)</text>
                    @if (twoLines)
                    {
                        <g>
                            <text class="wl-seg-text light" x="@F(textX)" y="@F(top + height / 2 + 10)">@Fit(segment.Row.Title, labelWidth, 5.6)</text>
                        </g>
                    }
                    @if (segment.Row.Metrics.DependenciesAtRisk > 0)
                    {
                        <g>
                            <text class="wl-glyph" x="@F(x + width - 4)" y="@F(top + height / 2 + 4)" text-anchor="end">⚠</text>
                        </g>
                    }
                </g>
            }
        </g>
    };

    private RenderFragment CapacityTick(double x1, double x2, WaterlineLevel? level) => __builder =>
    {
        if (level is null)
        {
            return;
        }

        var y = level.For(_scale);
        <line class="wl-cap" x1="@F(x1)" x2="@F(x2)" y1="@F(y)" y2="@F(y)" />
    };

    private RenderFragment Annotation(WaterlineColumn column) => __builder =>
    {
        if (!column.HasCapacity)
        {
            <g class="wl-annotation">
                <text class="wl-note warn" x="@F(column.TextX)" y="@F(WaterlineLayout.PlotBottom - 8)">no capacity</text>
            </g>
            return;
        }

        var y = column.CapacityY!.For(_scale);
        var over = column.OverSp > 0m;
        <g class="wl-annotation">
            <text class="wl-anno @(over ? "over" : "free")" x="@F(column.TextX)" y="@F(y + 4)">@OverOrFree(column.OverSp)</text>
            <text class="wl-anno-sub" x="@F(column.TextX)" y="@F(y + 17)">@PlanningFormat.Sp(column.CapacitySp) SP capacity</text>
        </g>
    };

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (_chart.IsEmpty || !PlanningGridKeys.Handles(e))
        {
            return;
        }

        var (col, pos) = Locate(SelectedId);
        switch (e.Key)
        {
            case "ArrowUp":
                await MoveAsync(Math.Max(col, 0), pos + 1);
                break;
            case "ArrowDown":
                await MoveAsync(Math.Max(col, 0), pos - 1);
                break;
            case "ArrowRight":
                await MoveAsync(col + 1, pos);
                break;
            case "ArrowLeft":
                await MoveAsync(col - 1, pos);
                break;
            case "Home":
                await MoveAsync(Math.Max(col, 0), 0);
                break;
            case "End":
                await MoveAsync(Math.Max(col, 0), int.MaxValue);
                break;
            case "Enter":
                if (SelectedId is { } selected)
                {
                    await ShowDetailsAsync(selected);
                }

                break;
        }
    }

    private (int Column, int Position) Locate(string? id)
    {
        if (id is null)
        {
            return (-1, -1);
        }

        for (var c = 0; c < _chart.Columns.Count; c++)
        {
            var column = _chart.Columns[c];
            if (column.Row.Id == id)
            {
                return (c, -1);
            }

            for (var i = 0; i < column.Segments.Count; i++)
            {
                if (column.Segments[i].Row.Id == id)
                {
                    return (c, i);
                }
            }

            for (var i = 0; i < column.BelowLine.Count; i++)
            {
                if (column.BelowLine[i].Row.Id == id)
                {
                    return (c, column.Segments.Count + i);
                }
            }
        }

        return (-1, -1);
    }

    private async Task MoveAsync(int col, int pos)
    {
        col = Math.Clamp(col, 0, _chart.Columns.Count - 1);
        var column = _chart.Columns[col];
        var count = column.Segments.Count + column.BelowLine.Count;
        pos = Math.Clamp(pos, -1, count - 1);
        var id = pos < 0
            ? column.Row.Id
            : pos < column.Segments.Count
                ? column.Segments[pos].Row.Id
                : column.BelowLine[pos - column.Segments.Count].Row.Id;
        if (id != SelectedId)
        {
            _scrollToSelected = true;
            await SelectAsync(id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToSelected)
        {
            return;
        }

        _scrollToSelected = false;
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.wl-scroll .wl-col.selected > .wl-head, .wl-scroll g.selected:not(.wl-col)')?.scrollIntoView({block:'nearest',inline:'nearest'})");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }
}
